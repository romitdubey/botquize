{
  "version": 2,
  "builds": [
    {"src": "package.json", "use": "@vercel/static-build", "config": {"distDir": "dist"}},
    {"src": "api/index.py", "use": "@vercel/python", "config": {"excludeFiles": "{.venv/**,tests/**,tmp/**,output/**,data/**,.git/**}"}}
  ],
  "routes": [
    {"src": "/api/(.*)", "dest": "/api/index.py"},
    {"src": "/webhook", "dest": "/api/index.py"},
    {"handle": "filesystem"},
    {"src": "/(.*)", "dest": "/index.html"}
  ]
}
