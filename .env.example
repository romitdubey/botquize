# ──────────────────────────────────────────────────────────────────────────────
# Required
# ──────────────────────────────────────────────────────────────────────────────

# Telegram Bot Token from @BotFather
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Your personal Telegram user ID (numeric, e.g. 123456789)
ADMIN_USER_ID=YOUR_TELEGRAM_USER_ID

# Telegram channel ID where quiz polls will be posted (e.g. -1001234567890)
CHANNEL_ID=YOUR_CHANNEL_ID

# ──────────────────────────────────────────────────────────────────────────────
# Deployment (Render)
# ──────────────────────────────────────────────────────────────────────────────

# Full HTTPS URL of your Render deployment, e.g. https://my-quiz-bot.onrender.com
# Telegram will POST updates to <WEBHOOK_URL>/webhook
WEBHOOK_URL=https://YOUR_APP_NAME.onrender.com

# Port to listen on (Render sets this automatically)
PORT=8080

# ──────────────────────────────────────────────────────────────────────────────
# Optional / Tuning
# ──────────────────────────────────────────────────────────────────────────────

# Seconds between posting each question to the channel
QUESTION_DELAY=2

# Maximum JSON upload size in MB
MAX_JSON_SIZE_MB=10

# Wrong questions shown per page in /review
REVIEW_PAGE_SIZE=3

# History entries shown per page in /history
HISTORY_PAGE_SIZE=5

# SQLite must be on a durable disk/volume in production, not an ephemeral filesystem.
DATABASE_PATH=./data/quizbot.db
STUDY_TIMEZONE=Asia/Kolkata

# Optional: force a particular learner. Otherwise the first answer binds each quiz.
# Both mentor and friend can remain in ADMIN_USER_ID as comma-separated IDs.
LEARNER_USER_ID=0

# Independent Notion integration for the deployed bot (the Codex plugin is separate).
# Share a chosen parent page with this integration. Never paste the token in Telegram.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# Optional override; otherwise derived from BOT_TOKEN. Set automatically on webhook setup.
WEBHOOK_SECRET=
