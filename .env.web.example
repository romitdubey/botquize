# Copy these into .env and into Vercel Project > Settings > Environment Variables.
# Backend-only secret. NEVER prefix this with VITE_ or NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_OR_SECRET_KEY
# Public anon (legacy JWT) / publishable key, safe to return to the sign-in form.
SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
# Invite-only access. Create these users in Supabase Authentication first.
STUDY_ALLOWED_EMAILS=your@example.com,friend@example.com
# Keep your existing Telegram token and numeric ADMIN_USER_ID.
BOT_TOKEN=YOUR_EXISTING_BOT_TOKEN
ADMIN_USER_ID=YOUR_NUMERIC_TELEGRAM_ID
APP_URL=https://YOUR_SITE.vercel.app
# Optional: a long random string. If omitted, a token-derived secret is used.
WEBHOOK_SECRET=
# Optional separate read-only mentor login (also include mentor email above).
# A login bound with /account me has independent test progress instead of mentor mapping.
# Copy the friend's UUID from Supabase Authentication > Users.
STUDY_MENTOR_EMAIL=
STUDY_LEARNER_ID=

# Optional Resend notifications: one recipient, independent of login emails.
# For resend.dev testing, use the API key from the account registered with RESEND_TO_EMAIL.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Study Grove <onboarding@resend.dev>
RESEND_TO_EMAIL=dhankarvishu293@gmail.com
