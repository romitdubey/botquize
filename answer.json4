{"success":true,"data":{"68953435ef177aa03fbacfcf":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Given:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Initial radius of the balloon = 10 cm\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Initial area of the color patch = 25 cm\u0026lt;sup\u0026gt;2\u0026lt;/sup\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Final radius of the balloon = 50 cm\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Formula Used:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Area of the color patch is proportional to the square of the radius of the sphere.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\text{Final Area} = \\text{Initial Area} × \\left( \\frac{\\text{Final Radius}}{\\text{Initial Radius}} \\right)^2\\)\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Calculation:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Initial Area = 25 cm\u0026lt;sup\u0026gt;2\u0026lt;/sup\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Initial Radius = 10 cm\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Final Radius = 50 cm\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\text{Final Area} = 25 × \\left( \\frac{50}{10} \\right)^2\\)\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Final Area\u0026amp;nbsp;= 25 \u0026amp;times; (5)\u0026lt;sup\u0026gt;2\u0026lt;/sup\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Final Area\u0026amp;nbsp;= 25 \u0026amp;times; 25\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; Final Area = 625 cm\u0026lt;sup\u0026gt;2\u0026lt;/sup\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;The area of the color patch after expansion is 625 cm\u0026lt;sup\u0026gt;2\u0026lt;/sup\u0026gt;.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;दिया गया है:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;गुब्बारे की प्रारंभिक त्रिज्या = 10 सेमी\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;रंगीन पैच का प्रारंभिक क्षेत्रफल = 25 सेमी\u0026lt;sup\u0026gt;2\u0026lt;/sup\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;गुब्बारे की अंतिम त्रिज्या = 50 सेमी\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;प्रयुक्त सूत्र:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;रंगीन पैच का क्षेत्रफल, गोले की त्रिज्या के वर्ग के समानुपाती होता है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\text{Final Area} = \\text{Initial Area} × \\left( \\frac{\\text{Final Radius}}{\\text{Initial Radius}} \\right)^2\\)\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;गणना:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;प्रारंभिक क्षेत्रफल = 25 सेमी\u0026lt;sup\u0026gt;2\u0026lt;/sup\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;प्रारंभिक त्रिज्या = 10 सेमी\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;अंतिम त्रिज्या = 50 सेमी\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\text{Final Area} = 25 × \\left( \\frac{50}{10} \\right)^2\\)\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;अंतिम क्षेत्रफल = 25 \u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;times;\u0026lt;/span\u0026gt; (5)\u0026lt;sup\u0026gt;2\u0026lt;/sup\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;अंतिम क्षेत्रफल = 25 \u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;times;\u0026lt;/span\u0026gt; 25\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; अंतिम क्षेत्रफल = 625 सेमी\u0026lt;sup\u0026gt;2\u0026lt;/sup\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;विस्तार के बाद रंगीन पैच का क्षेत्रफल 625 सेमी\u0026lt;sup\u0026gt;2\u0026lt;/sup\u0026gt; है।\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Mensuration"],"globalConcept":[{"s":{"id":"5eea6a1039140f30f369e7e7","title":"Quantitative Aptitude"},"c":{"id":"5eea6a1039140f30f369e829","title":"Mensuration"},"t":{"id":"5eea6a1039140f30f369e82a","title":"Solid Figures"},"st":{"id":"5eea6a1039140f30f369e82d","title":"Sphere"},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":44.947413061916876,"attempts":{"correct":210,"incorrect":237,"partial":0,"skipped":732,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":1,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689534418aebc97d87cfb971":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Given:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Average age of 20 students = 10 years\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Average age of 20 students and 5 teachers = 14 years\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Age of Ramesh Sir = Average age of all 5 teachers\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;We need to find the sum of the ages of all 20 students and Ramesh Sir.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Formula Used:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;1. Total age = Average age × Number of people\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;2. Sum of ages of teachers = Average age of teachers × Number of teachers\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Calculation:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Total age of 20 students = 10 × 20 = 200\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Total age of 20 students and 5 teachers = 14 × 25 = 350\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Total age of 5 teachers = 350 - 200 = 150\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Average age of 5 teachers = Total age of 5 teachers / Number of teachers\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;⇒ Average age of 5 teachers = 150 / 5 = 30\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Age of Ramesh Sir = Average age of 5 teachers = 30\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Sum of ages of all 20 students and Ramesh Sir = Total age of 20 students + Age of Ramesh Sir\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;⇒ Sum = 200 + 30 = 230\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;The sum of the ages of all the students and Ramesh Sir is 230.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;दिया गया है:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;20 छात्रों की औसत आयु = 10 वर्ष\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;20 छात्रों और 5 शिक्षकों की औसत आयु = 14 वर्ष\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;रमेश सर की आयु = सभी 5 शिक्षकों की औसत आयु\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;हमें सभी 20 छात्रों और रमेश सर की आयु का योग ज्ञात करना है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;प्रयुक्त सूत्र:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;1. कुल आयु = औसत आयु × व्यक्तियों की संख्या\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;2. शिक्षकों की आयु का योग = शिक्षकों की औसत आयु × शिक्षकों की संख्या\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;गणना:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;20 छात्रों की कुल आयु = 10 × 20 = 200\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;20 छात्रों और 5 शिक्षकों की कुल आयु = 14 × 25 = 350\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;5 शिक्षकों की कुल आयु = 350 - 200 = 150\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;5 शिक्षकों की औसत आयु = 5 शिक्षकों की कुल आयु / शिक्षकों की संख्या\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;⇒ 5 शिक्षकों की औसत आयु = 150 / 5 = 30\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;रमेश सर की आयु = 5 शिक्षकों की औसत आयु = 30\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;सभी 20 छात्रों और रमेश सर की आयु का योग = 20 छात्रों की कुल आयु + रमेश सर की आयु\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;⇒ योग = 200 + 30 = 230\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;सभी छात्रों और रमेश सर की आयु का योग 230 है।\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Average"],"globalConcept":[{"s":{"id":"5eea6a1039140f30f369e7e7","title":"Quantitative Aptitude"},"c":{"id":"5eea6a1039140f30f369e7e8","title":"Average"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":52.9491094147583,"attempts":{"correct":215,"incorrect":198,"partial":0,"skipped":766,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":1,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895344c3005e0e058595ea2":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Given:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Total journey = 115 km\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;First day distance = 7 km\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Distance increases by 2 km daily until it reaches 15 km per day\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;After reaching 15 km per day, the pilgrim continues at this pace till the journey ends\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Formula Used:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Total distance = Sum of distances covered each day\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Sum of n terms in arithmetic progression (AP) = n/2 \u0026amp;times; (First term + Last term)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Calculation:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;The pilgrim starts with 7 km on the first day and adds 2 km daily:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Sequence: 7, 9, 11, 13, 15\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;This sequence forms an AP with:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;First term (a) = 7\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Last term (l) = 15\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Common difference (d) = 2\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Find the number of terms (n) in this sequence:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;l = a + (n - 1) \u0026amp;times; d\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; 15 = 7 + (n - 1) \u0026amp;times; 2\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; 15 - 7 = (n - 1) \u0026amp;times; 2\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; 8 = 2 \u0026amp;times; (n - 1)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; n - 1 = 4\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; n = 5\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;In the first 5 days, he covers:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Sum = n/2 \u0026amp;times; (a + l)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; Sum = 5/2 \u0026amp;times; (7 + 15)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; Sum = 5/2 \u0026amp;times; 22\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; Sum = 55 km\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Remaining distance = Total distance - Distance covered in the first 5 days\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; Remaining distance = 115 - 55\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; Remaining distance = 60 km\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;After the 5\u0026lt;sup\u0026gt;th\u0026lt;/sup\u0026gt; day, he covers 15 km per day:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Number of days to cover 60 km = Remaining distance / Daily distance\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; Number of days = 60 / 15\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; Number of days = 4\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Total days = Days for the first 55 km + Days for the remaining 60 km\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; Total days = 5 + 4\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; Total days = 9\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;The pilgrim will take 9 days to complete the journey.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;दिया गया है:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;कुल यात्रा = 115 किमी\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;पहले दिन की दूरी = 7 किमी\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;दूरी प्रतिदिन 2 किमी बढ़ती है जब तक कि यह प्रतिदिन 15 किमी तक नहीं पहुँच जाती\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;प्रतिदिन 15 किमी तक पहुँचने के बाद, तीर्थयात्री इस गति से यात्रा समाप्त होने तक जारी रखता है\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;प्रयुक्त सूत्र:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;कुल दूरी = प्रत्येक दिन तय की गई दूरियों का योग\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;समांतर श्रेणी (AP) में n पदों का योग = n/2 \u0026amp;times; (प्रथम पद + अंतिम पद)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;गणना:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;तीर्थयात्री पहले दिन 7 किमी से शुरू होता है और प्रतिदिन 2 किमी जोड़ता है:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;श्रेणी: 7, 9, 11, 13, 15\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;यह श्रेणी एक AP बनाती है जिसका:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;प्रथम पद (a) = 7\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;अंतिम पद (l) = 15\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;समांतर\u0026amp;nbsp;अंतर (d) = 2\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;इस श्रेणी में पदों की संख्या (n) ज्ञात कीजिए:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;l = a + (n - 1) \u0026amp;times; d\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; 15 = 7 + (n - 1) \u0026amp;times; 2\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; 15 - 7 = (n - 1) \u0026amp;times; 2\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; 8 = 2 \u0026amp;times; (n - 1)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; n - 1 = 4\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; n = 5\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;पहले 5 दिनों में, वह तय करता है:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;योग = n/2 \u0026amp;times; (a + l)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; योग = 5/2 \u0026amp;times; (7 + 15)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; योग = 5/2 \u0026amp;times; 22\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; योग = 55 किमी\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;शेष दूरी = कुल दूरी - पहले 5 दिनों में तय की गई दूरी\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; शेष दूरी = 115 - 55\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; शेष दूरी = 60 किमी\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;5वें दिन के बाद, वह प्रतिदिन 15 किमी तय करता है:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;60 किमी तय करने के लिए दिनों की संख्या = शेष दूरी / दैनिक दूरी\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; दिनों की संख्या = 60 / 15\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; दिनों की संख्या = 4\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;कुल दिन = पहले 55 किमी के लिए दिन + शेष 60 किमी के लिए दिन\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; कुल दिन = 5 + 4\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; कुल दिन = 9\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;तीर्थयात्री को यात्रा पूरी करने में 9 दिन लगेंगे।\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Speed Time and Distance"],"globalConcept":[{"s":{"id":"5eea6a1039140f30f369e7e7","title":"Quantitative Aptitude"},"c":{"id":"5eea6a1039140f30f369e861","title":"Speed Time and Distance"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":75.29516539440206,"attempts":{"correct":293,"incorrect":210,"partial":0,"skipped":676,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":1,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895345fef177aa03fbad053":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Given:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Width of the wooden strip = 2 cm\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Dimensions of the photo = 40 cm \u0026amp;times; 30 cm\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Formula Used:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Perimeter of a rectangle = 2 \u0026amp;times; (Length + Breadth)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Calculation:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;To fix the wooden strip along all four sides of the photo, we need the length of the wooden strip equal to the perimeter of the photo.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Length of the photo = 40 cm\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Breadth of the photo = 30 cm\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Perimeter = 2 \u0026amp;times; (Length + Breadth)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; Perimeter = 2 \u0026amp;times; (40 + 30)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; Perimeter = 2 \u0026amp;times; 70\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; Perimeter = 140 cm\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Minimum length of the wooden strip required is 140 cm.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;दिया गया है:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;लकड़ी की पट्टी की चौड़ाई = 2 सेमी\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;फोटो का आयाम = 40 सेमी \u0026amp;times; 30 सेमी\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;प्रयुक्त सूत्र:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;आयत का परिमाप = 2 \u0026amp;times; (लंबाई + चौड़ाई)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;गणना:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;फोटो के चारों तरफ लकड़ी की पट्टी लगाने के लिए हमें लकड़ी की पट्टी की लंबाई फोटो की परिधि के बराबर चाहिए।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;फोटो की लंबाई = 40 सेमी\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;फोटो की चौड़ाई = 30 सेमी\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;परिमाप = 2 \u0026amp;times; (लंबाई + चौड़ाई)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; परिमाप = 2 \u0026amp;times; (40 + 30)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; परिमाप = 2 \u0026amp;times; 70\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; परिमाप = 140 सेमी\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;लकड़ी की पट्टी की न्यूनतम लंबाई 140 सेमी आवश्यक है।\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Mensuration"],"globalConcept":[{"s":{"id":"5eea6a1039140f30f369e7e7","title":"Quantitative Aptitude"},"c":{"id":"5eea6a1039140f30f369e829","title":"Mensuration"},"t":{"id":"5eea6a1039140f30f369e837","title":"Plane Figures"},"st":{"id":"5eea6a1039140f30f369e83f","title":"Rectangle"},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":36.31891433418145,"attempts":{"correct":165,"incorrect":287,"partial":0,"skipped":727,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":1,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895348f3005e0e05859610e":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Given:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Population data (2000\u0026amp;ndash;2007):\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;2000 = 50000, 2001 = 50400, 2002 = 51600, 2003 = 53600, 2004 = 56400, 2005 = 60000, 2006 = 64400, 2007 = 69600\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Step 1: Yearly increase\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;2000\u0026amp;ndash;2001: +400\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;2001\u0026amp;ndash;2002: +1200\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;2002\u0026amp;ndash;2003: +2000\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;2003\u0026amp;ndash;2004: +2800\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;2004\u0026amp;ndash;2005: +3600\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;2005\u0026amp;ndash;2006: +4400\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;2006\u0026amp;ndash;2007: +5200\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Step 2: Check pattern\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Increase in population is not constant \u0026amp;rarr; so not linear.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;The increments themselves (400, 1200, 2000, 2800, \u0026amp;hellip;) increase by +800 each year \u0026amp;rarr; a constant rise.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Inference:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;The \u0026lt;u\u0026gt;rate of increase of the population\u0026lt;/u\u0026gt; increased linearly.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026amp;there4; Correct option: The rate of increase of the population increased linearly.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;दिया गया है:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;जनसंख्या आँकड़े\u0026amp;nbsp;(2000-2007):\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;2000 = 50000, 2001 = 50400, 2002 = 51600, 2003 = 53600, 2004 = 56400, 2005 = 60000, 2006 = 64400, 2007 = 69600\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;चरण 1: वार्षिक वृद्धि\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;2000-2001: +400\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;2001-2002: +1200\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;2002-2003: +2000\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;2003-2004: +2800\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;2004-2005: +3600\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;2005-2006: +4400\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;2006-2007: +5200\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;चरण 2: पैटर्न की जाँच करें\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;जनसंख्या में वृद्धि स्थिर नहीं है \u0026amp;rarr; इसलिए रैखिक नहीं।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;स्वयं वृद्धि (400, 1200, 2000, 2800, \u0026amp;hellip;) प्रत्येक वर्ष +800 से बढ़ती है \u0026amp;rarr; एक स्थिर वृद्धि।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;निष्कर्ष:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;जनसंख्या वृद्धि की दर\u0026lt;/u\u0026gt; रैखिक रूप से बढ़ी थी।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026amp;there4; सही विकल्प: जनसंख्या वृद्धि की दर रैखिक रूप से बढ़ी थी।\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Line Graph"],"globalConcept":[{"s":{"id":"5eea6a1639140f30f369f555","title":"Data Interpretation"},"c":{"id":"5eea6a1639140f30f369f558","title":"Line Graph"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":98.00593723494478,"attempts":{"correct":164,"incorrect":460,"partial":0,"skipped":555,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":1,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689534b1ef177aa03fbad109":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Given:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;The question involves a book with both sides printed, and 9 papers are drawn. We need to determine the sum of their page numbers that cannot occur.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Formula Used:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Sum of page numbers on a single paper = Page number on the front + Page number on the back\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Total sum for 9 papers = Sum of all page numbers for each paper\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Calculation:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Let the page numbers on one paper be \u0026lt;span class=\u0026quot;MathJax\u0026quot; data-mathml=\u0026quot;\u0026amp;lt;math xmlns=\u0026amp;quot;http://www.w3.org/1998/Math/MathML\u0026amp;quot;\u0026amp;gt;\u0026amp;lt;mi\u0026amp;gt;x\u0026amp;lt;/mi\u0026amp;gt;\u0026amp;lt;/math\u0026amp;gt;\u0026quot; id=\u0026quot;MathJax-Element-43-Frame\u0026quot; role=\u0026quot;presentation\u0026quot; style=\u0026quot;position: relative;\u0026quot; tabindex=\u0026quot;0\u0026quot;\u0026gt;\u0026lt;nobr aria-hidden=\u0026quot;true\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;math\u0026quot; id=\u0026quot;MathJax-Span-422\u0026quot; style=\u0026quot;width: 0.717em; display: inline-block;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;display: inline-block; position: relative; width: 0.598em; height: 0px; font-size: 120%;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;position: absolute; clip: rect(1.551em, 1000.54em, 2.324em, -999.997em); top: -2.14em; left: 0em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;mrow\u0026quot; id=\u0026quot;MathJax-Span-423\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;mi\u0026quot; id=\u0026quot;MathJax-Span-424\u0026quot; style=\u0026quot;font-family: MathJax_Math-italic;\u0026quot;\u0026gt;x\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/nobr\u0026gt;\u0026lt;span class=\u0026quot;MJX_Assistive_MathML\u0026quot; role=\u0026quot;presentation\u0026quot;\u0026gt;\u0026lt;math xmlns=\u0026quot;http://www.w3.org/1998/Math/MathML\u0026quot;\u0026gt;\u0026lt;mi\u0026gt;x\u0026lt;/mi\u0026gt;\u0026lt;/math\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\n\u0026lt;script id=\u0026quot;MathJax-Element-43\u0026quot; type=\u0026quot;math/tex\u0026quot;\u0026gt;x\u0026lt;/script\u0026gt;\n(front) and \u0026lt;span class=\u0026quot;MathJax\u0026quot; data-mathml=\u0026quot;\u0026amp;lt;math xmlns=\u0026amp;quot;http://www.w3.org/1998/Math/MathML\u0026amp;quot;\u0026amp;gt;\u0026amp;lt;mi\u0026amp;gt;x\u0026amp;lt;/mi\u0026amp;gt;\u0026amp;lt;mo\u0026amp;gt;+\u0026amp;lt;/mo\u0026amp;gt;\u0026amp;lt;mn\u0026amp;gt;1\u0026amp;lt;/mn\u0026amp;gt;\u0026amp;lt;/math\u0026amp;gt;\u0026quot; id=\u0026quot;MathJax-Element-44-Frame\u0026quot; role=\u0026quot;presentation\u0026quot; style=\u0026quot;position: relative;\u0026quot; tabindex=\u0026quot;0\u0026quot;\u0026gt;\u0026lt;nobr aria-hidden=\u0026quot;true\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;math\u0026quot; id=\u0026quot;MathJax-Span-425\u0026quot; style=\u0026quot;width: 2.801em; display: inline-block;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;display: inline-block; position: relative; width: 2.324em; height: 0px; font-size: 120%;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;position: absolute; clip: rect(1.372em, 1002.26em, 2.443em, -999.997em); top: -2.199em; left: 0em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;mrow\u0026quot; id=\u0026quot;MathJax-Span-426\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;mi\u0026quot; id=\u0026quot;MathJax-Span-427\u0026quot; style=\u0026quot;font-family: MathJax_Math-italic;\u0026quot;\u0026gt;x\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;mo\u0026quot; id=\u0026quot;MathJax-Span-428\u0026quot; style=\u0026quot;font-family: MathJax_Main; padding-left: 0.241em;\u0026quot;\u0026gt;+\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;mn\u0026quot; id=\u0026quot;MathJax-Span-429\u0026quot; style=\u0026quot;font-family: MathJax_Main; padding-left: 0.241em;\u0026quot;\u0026gt;1\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/nobr\u0026gt;\u0026lt;span class=\u0026quot;MJX_Assistive_MathML\u0026quot; role=\u0026quot;presentation\u0026quot;\u0026gt;\u0026lt;math xmlns=\u0026quot;http://www.w3.org/1998/Math/MathML\u0026quot;\u0026gt;\u0026lt;mi\u0026gt;x\u0026lt;/mi\u0026gt;\u0026lt;mo\u0026gt;+\u0026lt;/mo\u0026gt;\u0026lt;mn\u0026gt;1\u0026lt;/mn\u0026gt;\u0026lt;/math\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\n\u0026lt;script id=\u0026quot;MathJax-Element-44\u0026quot; type=\u0026quot;math/tex\u0026quot;\u0026gt;x+1\u0026lt;/script\u0026gt;\n(back). For any paper, the sum of page numbers = x + (x+1) = 2x + 1.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;For 9 papers, the total sum of page numbers = 9 \u0026amp;times; (2x + 1) = 18x + 9.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Now, let\u0026amp;#39;s analyze the given options:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;(1) \u0026lt;span class=\u0026quot;MathJax\u0026quot; data-mathml=\u0026quot;\u0026amp;lt;math xmlns=\u0026amp;quot;http://www.w3.org/1998/Math/MathML\u0026amp;quot;\u0026amp;gt;\u0026amp;lt;mn\u0026amp;gt;9\u0026amp;lt;/mn\u0026amp;gt;\u0026amp;lt;mo\u0026amp;gt;\u0026amp;amp;#xD7;\u0026amp;lt;/mo\u0026amp;gt;\u0026amp;lt;mo stretchy=\u0026amp;quot;false\u0026amp;quot;\u0026amp;gt;(\u0026amp;lt;/mo\u0026amp;gt;\u0026amp;lt;mn\u0026amp;gt;9\u0026amp;lt;/mn\u0026amp;gt;\u0026amp;lt;mo\u0026amp;gt;+\u0026amp;lt;/mo\u0026amp;gt;\u0026amp;lt;mn\u0026amp;gt;1\u0026amp;lt;/mn\u0026amp;gt;\u0026amp;lt;mo stretchy=\u0026amp;quot;false\u0026amp;quot;\u0026amp;gt;)\u0026amp;lt;/mo\u0026amp;gt;\u0026amp;lt;mrow class=\u0026amp;quot;MJX-TeXAtom-ORD\u0026amp;quot;\u0026amp;gt;\u0026amp;lt;mo\u0026amp;gt;/\u0026amp;lt;/mo\u0026amp;gt;\u0026amp;lt;/mrow\u0026amp;gt;\u0026amp;lt;mn\u0026amp;gt;2\u0026amp;lt;/mn\u0026amp;gt;\u0026amp;lt;mo\u0026amp;gt;=\u0026amp;lt;/mo\u0026amp;gt;\u0026amp;lt;mn\u0026amp;gt;45\u0026amp;lt;/mn\u0026amp;gt;\u0026amp;lt;/math\u0026amp;gt;\u0026quot; id=\u0026quot;MathJax-Element-45-Frame\u0026quot; role=\u0026quot;presentation\u0026quot; style=\u0026quot;position: relative;\u0026quot; tabindex=\u0026quot;0\u0026quot;\u0026gt;\u0026lt;nobr aria-hidden=\u0026quot;true\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;math\u0026quot; id=\u0026quot;MathJax-Span-430\u0026quot; style=\u0026quot;width: 9.824em; display: inline-block;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;display: inline-block; position: relative; width: 8.158em; height: 0px; font-size: 120%;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;position: absolute; clip: rect(1.253em, 1008.1em, 2.622em, -999.997em); top: -2.199em; left: 0em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;mrow\u0026quot; id=\u0026quot;MathJax-Span-431\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;mn\u0026quot; id=\u0026quot;MathJax-Span-432\u0026quot; style=\u0026quot;font-family: MathJax_Main;\u0026quot;\u0026gt;9\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;mo\u0026quot; id=\u0026quot;MathJax-Span-433\u0026quot; style=\u0026quot;font-family: MathJax_Main; padding-left: 0.241em;\u0026quot;\u0026gt;\u0026amp;times;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;mo\u0026quot; id=\u0026quot;MathJax-Span-434\u0026quot; style=\u0026quot;font-family: MathJax_Main; padding-left: 0.241em;\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;mn\u0026quot; id=\u0026quot;MathJax-Span-435\u0026quot; style=\u0026quot;font-family: MathJax_Main;\u0026quot;\u0026gt;9\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;mo\u0026quot; id=\u0026quot;MathJax-Span-436\u0026quot; style=\u0026quot;font-family: MathJax_Main; padding-left: 0.241em;\u0026quot;\u0026gt;+\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;mn\u0026quot; id=\u0026quot;MathJax-Span-437\u0026quot; style=\u0026quot;font-family: MathJax_Main; padding-left: 0.241em;\u0026quot;\u0026gt;1\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;mo\u0026quot; id=\u0026quot;MathJax-Span-438\u0026quot; style=\u0026quot;font-family: MathJax_Main;\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;texatom\u0026quot; id=\u0026quot;MathJax-Span-439\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;mrow\u0026quot; id=\u0026quot;MathJax-Span-440\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;mo\u0026quot; id=\u0026quot;MathJax-Span-441\u0026quot; style=\u0026quot;font-family: MathJax_Main;\u0026quot;\u0026gt;/\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;mn\u0026quot; id=\u0026quot;MathJax-Span-442\u0026quot; style=\u0026quot;font-family: MathJax_Main;\u0026quot;\u0026gt;2\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;mo\u0026quot; id=\u0026quot;MathJax-Span-443\u0026quot; style=\u0026quot;font-family: MathJax_Main; padding-left: 0.301em;\u0026quot;\u0026gt;=\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;mn\u0026quot; id=\u0026quot;MathJax-Span-444\u0026quot; style=\u0026quot;font-family: MathJax_Main; padding-left: 0.301em;\u0026quot;\u0026gt;45\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/nobr\u0026gt;\u0026lt;span class=\u0026quot;MJX_Assistive_MathML\u0026quot; role=\u0026quot;presentation\u0026quot;\u0026gt;\u0026lt;math xmlns=\u0026quot;http://www.w3.org/1998/Math/MathML\u0026quot;\u0026gt;\u0026lt;mn\u0026gt;9\u0026lt;/mn\u0026gt;\u0026lt;mo\u0026gt;\u0026amp;times;\u0026lt;/mo\u0026gt;\u0026lt;mo stretchy=\u0026quot;false\u0026quot;\u0026gt;(\u0026lt;/mo\u0026gt;\u0026lt;mn\u0026gt;9\u0026lt;/mn\u0026gt;\u0026lt;mo\u0026gt;+\u0026lt;/mo\u0026gt;\u0026lt;mn\u0026gt;1\u0026lt;/mn\u0026gt;\u0026lt;mo stretchy=\u0026quot;false\u0026quot;\u0026gt;)\u0026lt;/mo\u0026gt;\u0026lt;mrow class=\u0026quot;MJX-TeXAtom-ORD\u0026quot;\u0026gt;\u0026lt;mo\u0026gt;/\u0026lt;/mo\u0026gt;\u0026lt;/mrow\u0026gt;\u0026lt;mn\u0026gt;2\u0026lt;/mn\u0026gt;\u0026lt;mo\u0026gt;=\u0026lt;/mo\u0026gt;\u0026lt;mn\u0026gt;45\u0026lt;/mn\u0026gt;\u0026lt;/math\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\n\u0026lt;script id=\u0026quot;MathJax-Element-45\u0026quot; type=\u0026quot;math/tex\u0026quot;\u0026gt;9 × (9+1) / 2 = 45\u0026lt;/script\u0026gt;\n: Incorrect as this does not fit the equation 18x + 9.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;(2) Divisible by 3: Correct, as every sum (18x + 9) will be divisible by 3.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;(3) 179: Incorrect as it is not of the form 18x + 9.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;(4) 171: Correct as 171 = 18x + 9 for x = 9.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Conclusion:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;The sum of page numbers can NEVER be divisible by 3 (Option 2).\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;दिया गया है:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;प्रश्न में एक दोनो तरफ छपी हुई किताब शामिल है, और 9 कागज निकाले जाते हैं। हमें उनके पृष्ठ संख्याओं के योग का निर्धारण करना होगा जो संभव नहीं है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;प्रयुक्त सूत्र:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;एक कागज पर पृष्ठ संख्याओं का योग = सामने का पृष्ठ संख्या + पीछे का पृष्ठ संख्या\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;9 कागजों\u0026amp;nbsp;के लिए कुल योग = प्रत्येक कागज के सभी पृष्ठ संख्याओं का योग\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;गणना:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;मान लीजिए\u0026amp;nbsp;एक कागज पर पृष्ठ संख्याएँ \u0026lt;span class=\u0026quot;MathJax\u0026quot; data-mathml=\u0026quot;\u0026amp;lt;math xmlns=\u0026amp;quot;http://www.w3.org/1998/Math/MathML\u0026amp;quot;\u0026amp;gt;\u0026amp;lt;mi\u0026amp;gt;x\u0026amp;lt;/mi\u0026amp;gt;\u0026amp;lt;/math\u0026amp;gt;\u0026quot; id=\u0026quot;MathJax-Element-46-Frame\u0026quot; role=\u0026quot;presentation\u0026quot; style=\u0026quot;position: relative;\u0026quot; tabindex=\u0026quot;0\u0026quot;\u0026gt;\u0026lt;nobr aria-hidden=\u0026quot;true\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;math\u0026quot; id=\u0026quot;MathJax-Span-445\u0026quot; style=\u0026quot;width: 0.717em; display: inline-block;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;display: inline-block; position: relative; width: 0.598em; height: 0px; font-size: 120%;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;position: absolute; clip: rect(1.551em, 1000.54em, 2.324em, -999.997em); top: -2.14em; left: 0em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;mrow\u0026quot; id=\u0026quot;MathJax-Span-446\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;mi\u0026quot; id=\u0026quot;MathJax-Span-447\u0026quot; style=\u0026quot;font-family: MathJax_Math-italic;\u0026quot;\u0026gt;x\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/nobr\u0026gt;\u0026lt;span class=\u0026quot;MJX_Assistive_MathML\u0026quot; role=\u0026quot;presentation\u0026quot;\u0026gt;\u0026lt;math xmlns=\u0026quot;http://www.w3.org/1998/Math/MathML\u0026quot;\u0026gt;\u0026lt;mi\u0026gt;x\u0026lt;/mi\u0026gt;\u0026lt;/math\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\n\u0026lt;script id=\u0026quot;MathJax-Element-46\u0026quot; type=\u0026quot;math/tex\u0026quot;\u0026gt;x\u0026lt;/script\u0026gt;\n(सामने) और \u0026lt;span class=\u0026quot;MathJax\u0026quot; data-mathml=\u0026quot;\u0026amp;lt;math xmlns=\u0026amp;quot;http://www.w3.org/1998/Math/MathML\u0026amp;quot;\u0026amp;gt;\u0026amp;lt;mi\u0026amp;gt;x\u0026amp;lt;/mi\u0026amp;gt;\u0026amp;lt;mo\u0026amp;gt;+\u0026amp;lt;/mo\u0026amp;gt;\u0026amp;lt;mn\u0026amp;gt;1\u0026amp;lt;/mn\u0026amp;gt;\u0026amp;lt;/math\u0026amp;gt;\u0026quot; id=\u0026quot;MathJax-Element-47-Frame\u0026quot; role=\u0026quot;presentation\u0026quot; style=\u0026quot;position: relative;\u0026quot; tabindex=\u0026quot;0\u0026quot;\u0026gt;\u0026lt;nobr aria-hidden=\u0026quot;true\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;math\u0026quot; id=\u0026quot;MathJax-Span-448\u0026quot; style=\u0026quot;width: 2.801em; display: inline-block;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;display: inline-block; position: relative; width: 2.324em; height: 0px; font-size: 120%;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;position: absolute; clip: rect(1.372em, 1002.26em, 2.443em, -999.997em); top: -2.199em; left: 0em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;mrow\u0026quot; id=\u0026quot;MathJax-Span-449\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;mi\u0026quot; id=\u0026quot;MathJax-Span-450\u0026quot; style=\u0026quot;font-family: MathJax_Math-italic;\u0026quot;\u0026gt;x\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;mo\u0026quot; id=\u0026quot;MathJax-Span-451\u0026quot; style=\u0026quot;font-family: MathJax_Main; padding-left: 0.241em;\u0026quot;\u0026gt;+\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;mn\u0026quot; id=\u0026quot;MathJax-Span-452\u0026quot; style=\u0026quot;font-family: MathJax_Main; padding-left: 0.241em;\u0026quot;\u0026gt;1\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/nobr\u0026gt;\u0026lt;span class=\u0026quot;MJX_Assistive_MathML\u0026quot; role=\u0026quot;presentation\u0026quot;\u0026gt;\u0026lt;math xmlns=\u0026quot;http://www.w3.org/1998/Math/MathML\u0026quot;\u0026gt;\u0026lt;mi\u0026gt;x\u0026lt;/mi\u0026gt;\u0026lt;mo\u0026gt;+\u0026lt;/mo\u0026gt;\u0026lt;mn\u0026gt;1\u0026lt;/mn\u0026gt;\u0026lt;/math\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\n\u0026lt;script id=\u0026quot;MathJax-Element-47\u0026quot; type=\u0026quot;math/tex\u0026quot;\u0026gt;x+1\u0026lt;/script\u0026gt;\n(पीछे) हैं। किसी भी कागज के लिए, पृष्ठ संख्याओं का योग = x + (x+1) = 2x + 1.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;9 कागजों\u0026amp;nbsp;के लिए, पृष्ठ संख्याओं का कुल योग = 9 \u0026amp;times; (2x + 1) = 18x + 9.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;अब, दिए गए विकल्पों का विश्लेषण करते हैं:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;(1) \u0026lt;span class=\u0026quot;MathJax\u0026quot; data-mathml=\u0026quot;\u0026amp;lt;math xmlns=\u0026amp;quot;http://www.w3.org/1998/Math/MathML\u0026amp;quot;\u0026amp;gt;\u0026amp;lt;mn\u0026amp;gt;9\u0026amp;lt;/mn\u0026amp;gt;\u0026amp;lt;mo\u0026amp;gt;\u0026amp;amp;#xD7;\u0026amp;lt;/mo\u0026amp;gt;\u0026amp;lt;mo stretchy=\u0026amp;quot;false\u0026amp;quot;\u0026amp;gt;(\u0026amp;lt;/mo\u0026amp;gt;\u0026amp;lt;mn\u0026amp;gt;9\u0026amp;lt;/mn\u0026amp;gt;\u0026amp;lt;mo\u0026amp;gt;+\u0026amp;lt;/mo\u0026amp;gt;\u0026amp;lt;mn\u0026amp;gt;1\u0026amp;lt;/mn\u0026amp;gt;\u0026amp;lt;mo stretchy=\u0026amp;quot;false\u0026amp;quot;\u0026amp;gt;)\u0026amp;lt;/mo\u0026amp;gt;\u0026amp;lt;mrow class=\u0026amp;quot;MJX-TeXAtom-ORD\u0026amp;quot;\u0026amp;gt;\u0026amp;lt;mo\u0026amp;gt;/\u0026amp;lt;/mo\u0026amp;gt;\u0026amp;lt;/mrow\u0026amp;gt;\u0026amp;lt;mn\u0026amp;gt;2\u0026amp;lt;/mn\u0026amp;gt;\u0026amp;lt;mo\u0026amp;gt;=\u0026amp;lt;/mo\u0026amp;gt;\u0026amp;lt;mn\u0026amp;gt;45\u0026amp;lt;/mn\u0026amp;gt;\u0026amp;lt;/math\u0026amp;gt;\u0026quot; id=\u0026quot;MathJax-Element-48-Frame\u0026quot; role=\u0026quot;presentation\u0026quot; style=\u0026quot;position: relative;\u0026quot; tabindex=\u0026quot;0\u0026quot;\u0026gt;\u0026lt;nobr aria-hidden=\u0026quot;true\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;math\u0026quot; id=\u0026quot;MathJax-Span-453\u0026quot; style=\u0026quot;width: 9.824em; display: inline-block;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;display: inline-block; position: relative; width: 8.158em; height: 0px; font-size: 120%;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;position: absolute; clip: rect(1.253em, 1008.1em, 2.622em, -999.997em); top: -2.199em; left: 0em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;mrow\u0026quot; id=\u0026quot;MathJax-Span-454\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;mn\u0026quot; id=\u0026quot;MathJax-Span-455\u0026quot; style=\u0026quot;font-family: MathJax_Main;\u0026quot;\u0026gt;9\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;mo\u0026quot; id=\u0026quot;MathJax-Span-456\u0026quot; style=\u0026quot;font-family: MathJax_Main; padding-left: 0.241em;\u0026quot;\u0026gt;\u0026amp;times;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;mo\u0026quot; id=\u0026quot;MathJax-Span-457\u0026quot; style=\u0026quot;font-family: MathJax_Main; padding-left: 0.241em;\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;mn\u0026quot; id=\u0026quot;MathJax-Span-458\u0026quot; style=\u0026quot;font-family: MathJax_Main;\u0026quot;\u0026gt;9\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;mo\u0026quot; id=\u0026quot;MathJax-Span-459\u0026quot; style=\u0026quot;font-family: MathJax_Main; padding-left: 0.241em;\u0026quot;\u0026gt;+\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;mn\u0026quot; id=\u0026quot;MathJax-Span-460\u0026quot; style=\u0026quot;font-family: MathJax_Main; padding-left: 0.241em;\u0026quot;\u0026gt;1\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;mo\u0026quot; id=\u0026quot;MathJax-Span-461\u0026quot; style=\u0026quot;font-family: MathJax_Main;\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;texatom\u0026quot; id=\u0026quot;MathJax-Span-462\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;mrow\u0026quot; id=\u0026quot;MathJax-Span-463\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;mo\u0026quot; id=\u0026quot;MathJax-Span-464\u0026quot; style=\u0026quot;font-family: MathJax_Main;\u0026quot;\u0026gt;/\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;mn\u0026quot; id=\u0026quot;MathJax-Span-465\u0026quot; style=\u0026quot;font-family: MathJax_Main;\u0026quot;\u0026gt;2\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;mo\u0026quot; id=\u0026quot;MathJax-Span-466\u0026quot; style=\u0026quot;font-family: MathJax_Main; padding-left: 0.301em;\u0026quot;\u0026gt;=\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;mn\u0026quot; id=\u0026quot;MathJax-Span-467\u0026quot; style=\u0026quot;font-family: MathJax_Main; padding-left: 0.301em;\u0026quot;\u0026gt;45\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/nobr\u0026gt;\u0026lt;span class=\u0026quot;MJX_Assistive_MathML\u0026quot; role=\u0026quot;presentation\u0026quot;\u0026gt;\u0026lt;math xmlns=\u0026quot;http://www.w3.org/1998/Math/MathML\u0026quot;\u0026gt;\u0026lt;mn\u0026gt;9\u0026lt;/mn\u0026gt;\u0026lt;mo\u0026gt;\u0026amp;times;\u0026lt;/mo\u0026gt;\u0026lt;mo stretchy=\u0026quot;false\u0026quot;\u0026gt;(\u0026lt;/mo\u0026gt;\u0026lt;mn\u0026gt;9\u0026lt;/mn\u0026gt;\u0026lt;mo\u0026gt;+\u0026lt;/mo\u0026gt;\u0026lt;mn\u0026gt;1\u0026lt;/mn\u0026gt;\u0026lt;mo stretchy=\u0026quot;false\u0026quot;\u0026gt;)\u0026lt;/mo\u0026gt;\u0026lt;mrow class=\u0026quot;MJX-TeXAtom-ORD\u0026quot;\u0026gt;\u0026lt;mo\u0026gt;/\u0026lt;/mo\u0026gt;\u0026lt;/mrow\u0026gt;\u0026lt;mn\u0026gt;2\u0026lt;/mn\u0026gt;\u0026lt;mo\u0026gt;=\u0026lt;/mo\u0026gt;\u0026lt;mn\u0026gt;45\u0026lt;/mn\u0026gt;\u0026lt;/math\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\n\u0026lt;script id=\u0026quot;MathJax-Element-48\u0026quot; type=\u0026quot;math/tex\u0026quot;\u0026gt;9 × (9+1) / 2 = 45\u0026lt;/script\u0026gt;\n: गलत क्योंकि यह समीकरण 18x + 9 में उपयुक्त\u0026amp;nbsp;नहीं होता है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;(2) 3 से विभाज्य: सही, क्योंकि प्रत्येक योग (18x + 9) 3 से विभाज्य होगा।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;(3) 179: गलत क्योंकि यह 18x + 9 के रूप का नहीं है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;(4) 171: सही क्योंकि 171 = 18x + 9, जहाँ x = 9.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;निष्कर्ष:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;पृष्ठ संख्याओं का योग कभी भी 3 से विभाज्य (विकल्प 2) नहीं हो सकता है।\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Permutation and Combination"],"globalConcept":[{"s":{"id":"5eea6a1039140f30f369e7e7","title":"Quantitative Aptitude"},"c":{"id":"5eea6a1039140f30f369e81d","title":"Permutation and Combination"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":29.391009329940626,"attempts":{"correct":127,"incorrect":314,"partial":0,"skipped":738,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":1,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895351e4bf9040e58ef69cb":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p style=\u0026quot;color: #212529;\u0026quot;\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;CONCEPT\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Comparing E\u0026amp;times;ponential Powers like\u0026amp;nbsp;\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\( \\pi^\\pi, e^{e^e}, 3^{3^3}\\)\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;When comparing numbers of the form a^{b^c} , evaluate the **innermost e\u0026amp;times;ponent first** and then compute the outer e\u0026amp;times;ponential.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;These e\u0026amp;times;pressions grow very rapidly due to repeated e\u0026amp;times;ponentiation.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;To compare, we either appro\u0026amp;times;imate the values or take logarithms.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;EXPLANATION\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Appro\u0026amp;times;imate values:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(e \\approx 2.718\\)\u0026lt;/span\u0026gt;\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\pi \\approx 3.1416\\)\u0026lt;/span\u0026gt;\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Evaluate:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(e^e \\approx 2.718^{2.718} \\approx 15.15 \\\\ e^{e^e} \\approx 2.718^{15.15} \\approx 3.6 \\times 10^6 \\\\ 3^3 = 27 \\Rightarrow 3^{27} \\approx 7.6 \\times 10^{12}\\)\u0026lt;/span\u0026gt;\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\pi^\\pi \\approx 3.1416^{3.1416} \\approx 36.46 \\Rightarrow \\pi^{\\pi^\\pi} \\approx 3.1416^{36.46} \\approx 1.1 \\times 10^{18}\\)\u0026lt;/span\u0026gt;\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Now arrange in increasing order:\n\t\u0026lt;p\u0026gt;\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(e^{e^e} \\approx 3.6 \\times 10^6 \\\\ 3^{3^3} \\approx 7.6 \\times 10^{12} \\\\ \\pi^{\\pi^\\pi} \\approx 1.1 \\times 10^{18}\\)\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt; \u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p style=\u0026quot;color: #212529;\u0026quot;\u0026gt;\u0026lt;strong\u0026gt;Therefore, the correct answer is\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\rm e^{e^e}\u0026amp;lt;3^{3^3} \u0026amp;lt;\\pi^{\\pi^\\pi}\\)\u0026lt;/span\u0026gt;\u0026lt;u\u0026gt; \u0026lt;/u\u0026gt;.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p style=\u0026quot;color: #212529;\u0026quot;\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\( \\pi^\\pi, e^{e^e}, 3^{3^3}\\)\u0026lt;/span\u0026gt; जैसे घातीय घातों की तुलना करें\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;a^{b^c} के रूप की संख्याओं की तुलना करते समय, सबसे पहले **आंतरिक घात** का मूल्यांकन करें और फिर बाहरी घातांक की गणना करें।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;बार-बार घातांक के कारण ये व्यंजक बहुत तेजीसे बढ़ते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;तुलना करने के लिए, हम या तो मानों का अनुमान लगाते हैं या लघुगणक लेते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;मानों का अनुमान लगायें:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(e \\approx 2.718\\)\u0026lt;/span\u0026gt;\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\pi \\approx 3.1416\\)\u0026lt;/span\u0026gt;\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;मूल्यांकन करें:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(e^e \\approx 2.718^{2.718} \\approx 15.15 \\\\ e^{e^e} \\approx 2.718^{15.15} \\approx 3.6 \\times 10^6 \\\\ 3^3 = 27 \\Rightarrow 3^{27} \\approx 7.6 \\times 10^{12}\\)\u0026lt;/span\u0026gt;\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\pi^\\pi \\approx 3.1416^{3.1416} \\approx 36.46 \\Rightarrow \\pi^{\\pi^\\pi} \\approx 3.1416^{36.46} \\approx 1.1 \\times 10^{18}\\)\u0026lt;/span\u0026gt;\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;अब बढ़ते क्रम में व्यवस्थित करें:\n\t\u0026lt;p\u0026gt;\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(e^{e^e} \\approx 3.6 \\times 10^6 \\\\ 3^{3^3} \\approx 7.6 \\times 10^{12} \\\\ \\pi^{\\pi^\\pi} \\approx 1.1 \\times 10^{18}\\)\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt; \u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p style=\u0026quot;color: #212529;\u0026quot;\u0026gt;\u0026lt;strong\u0026gt;इसलिए, सही उत्तर \u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\rm e^{e^e}\u0026amp;lt;3^{3^3} \u0026amp;lt;\\pi^{\\pi^\\pi}\\)\u0026lt;/span\u0026gt; है।\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":null,"globalConcept":[{"s":{"id":"5eea6a1039140f30f369e7e7","title":"Quantitative Aptitude"},"c":{"id":""},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":12.367260390161158,"attempts":{"correct":117,"incorrect":291,"partial":0,"skipped":771,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":1,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689535374bf9040e58ef69f0":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Given:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Country A: 2014 = 200, 2024 = 150\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Country B: 2014 = 400, 2024 = 320\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Country C: 2014 = 150, 2024 = 120\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Country D: 2014 = 600, 2024 = 550\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Formula used:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Percentage loss = \u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\dfrac{(Initial - Final)}{Initial}\\times100 \\)\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Calculation:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Country A \u0026amp;rArr; \u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\dfrac{200-150}{200}\\times100 = 25\\% \\)\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Country B \u0026amp;rArr; \u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\dfrac{400-320}{400}\\times100 = 20\\% \\)\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Country C \u0026amp;rArr; \u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\dfrac{150-120}{150}\\times100 = 20\\% \\)\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Country D \u0026amp;rArr; \u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\dfrac{600-550}{600}\\times100 = 8.33\\% \\)\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026amp;there4; Minimum percentage of deforestation is in Country D.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;दिया गया है:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;देश A: 2014 = 200, 2024 = 150\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;देश B: 2014 = 400, 2024 = 320\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;देश C: 2014 = 150, 2024 = 120\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;देश D: 2014 = 600, 2024 = 550\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;प्रयुक्त सूत्र:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;प्रतिशत हानि = \u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\dfrac{(Initial - Final)}{Initial}\\times100 \\)\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;गणना:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;देश A \u0026amp;rArr; \u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\dfrac{200-150}{200}\\times100 = 25\\% \\)\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;देश B \u0026amp;rArr; \u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\dfrac{400-320}{400}\\times100 = 20\\% \\)\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;देश C \u0026amp;rArr; \u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\dfrac{150-120}{150}\\times100 = 20\\% \\)\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;देश D \u0026amp;rArr; \u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\dfrac{600-550}{600}\\times100 = 8.33\\% \\)\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026amp;there4; वनों की कटाई का न्यूनतम प्रतिशत देश D में है।\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Bar Graph"],"globalConcept":[{"s":{"id":"5eea6a1639140f30f369f555","title":"Data Interpretation"},"c":{"id":"5eea6a1639140f30f369f55b","title":"Bar Graph"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":38.11535199321465,"attempts":{"correct":150,"incorrect":486,"partial":0,"skipped":543,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":1,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689535444bf9040e58ef6a03":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Given:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Dimensions of the marble block = 5 m × 4 m × 2 m\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Dimensions of each tile = 1 m × 0.5 m × 0.1 m\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Wastage in cutting = 10%\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Formula Used:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Number of tiles = (Total Volume of Marble × (1 - Wastage)) / Volume of each tile\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Calculation:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Total Volume of Marble = 5 × 4 × 2 = 40 m\u0026lt;sup\u0026gt;3\u0026lt;/sup\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Volume of each tile = 1 × 0.5 × 0.1 = 0.05 m\u0026lt;sup\u0026gt;3\u0026lt;/sup\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Wastage = 10%, so usable marble = 90% of total volume\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Usable Volume = 40 × 90/100 = 36 m\u0026lt;sup\u0026gt;3\u0026lt;/sup\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Number of tiles = Usable Volume / Volume of each tile\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;⇒ Number of tiles = 36 / 0.05\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;⇒ Number of tiles = 720\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;The number of tiles made is 720.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;दिया गया है:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;संगमरमर के ब्लॉक के आयाम = 5 मीटर × 4 मीटर × 2 मीटर\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;प्रत्येक टाइल के आयाम = 1 मीटर × 0.5 मीटर × 0.1 मीटर\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;काटने में बर्बादी = 10%\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;प्रयुक्त सूत्र:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;टाइलों की संख्या = (संगमरमर का कुल आयतन × (1 - बर्बादी)) / प्रत्येक टाइल का आयतन\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;गणना:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;संगमरमर का कुल आयतन = 5 × 4 × 2 = 40 मीटर\u0026lt;sup\u0026gt;3\u0026lt;/sup\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;प्रत्येक टाइल का आयतन = 1 × 0.5 × 0.1 = 0.05 मीटर\u0026lt;sup\u0026gt;3\u0026lt;/sup\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;बर्बादी = 10%, इसलिए प्रयोग करने योग्य संगमरमर = कुल आयतन का 90%\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;प्रयोग करने योग्य आयतन = 40 × 90/100 = 36 मीटर\u0026lt;sup\u0026gt;3\u0026lt;/sup\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;टाइलों की संख्या = प्रयोग करने योग्य आयतन / प्रत्येक टाइल का आयतन\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;⇒ टाइलों की संख्या = 36 / 0.05\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;⇒ टाइलों की संख्या = 720\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;बनी टाइलों की संख्या 720 है।\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Mensuration"],"globalConcept":[{"s":{"id":"5eea6a1039140f30f369e7e7","title":"Quantitative Aptitude"},"c":{"id":"5eea6a1039140f30f369e829","title":"Mensuration"},"t":{"id":"5eea6a1039140f30f369e837","title":"Plane Figures"},"st":{"id":"5eea6a1039140f30f369e83c","title":"Two Figures"},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":28.419847328244263,"attempts":{"correct":126,"incorrect":204,"partial":0,"skipped":849,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":1,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953569a25b7b429e6d85a6":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Given:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Expression: 2023\u0026lt;sup\u0026gt;2024\u0026lt;/sup\u0026gt; + 2025\u0026lt;sup\u0026gt;2024\u0026lt;/sup\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Divisor: 2024\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Formula Used:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Remainder when a\u0026lt;sup\u0026gt;n\u0026lt;/sup\u0026gt; + b\u0026lt;sup\u0026gt;n\u0026lt;/sup\u0026gt;\u0026amp;nbsp;is divided by m can be calculated using modular arithmetic properties.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Calculation:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;2023 \u0026amp;equiv; -1 (mod 2024) since 2023 = 2024 - 1\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;2025 \u0026amp;equiv; 1 (mod 2024) since 2025 = 2024 + 1\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Now substitute these values into the expression:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;2023\u0026lt;sup\u0026gt;2024\u0026lt;/sup\u0026gt; \u0026amp;equiv; (-1)\u0026lt;sup\u0026gt;2024\u0026lt;/sup\u0026gt; (mod 2024)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;(-1)\u0026lt;sup\u0026gt;2024\u0026lt;/sup\u0026gt; = 1\u0026amp;nbsp;because 2024 is even.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;2025\u0026lt;sup\u0026gt;2024\u0026lt;/sup\u0026gt; \u0026amp;equiv; (1)\u0026lt;sup\u0026gt;2024\u0026lt;/sup\u0026gt; (mod 2024)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;1\u0026lt;sup\u0026gt;2024\u0026lt;/sup\u0026gt; = 1\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Now add the two results:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;(-1)\u0026lt;sup\u0026gt;2024\u0026lt;/sup\u0026gt; + (1)\u0026lt;sup\u0026gt;2024\u0026lt;/sup\u0026gt; \u0026amp;equiv; 1 + 1 \u0026amp;equiv; 2 (mod 2024)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;The remainder when 2023\u0026lt;sup\u0026gt;2024\u0026lt;/sup\u0026gt; + 2025\u0026lt;sup\u0026gt;2024\u0026lt;/sup\u0026gt;\u0026amp;nbsp;is divided by 2024 is 2.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;दिया गया है:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;व्यंजक: 2023\u0026lt;sup\u0026gt;2024\u0026lt;/sup\u0026gt; + 2025\u0026lt;sup\u0026gt;2024\u0026lt;/sup\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;भाजक: 2024\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;प्रयुक्त सूत्र:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;जब a\u0026lt;sup\u0026gt;n\u0026lt;/sup\u0026gt; + b\u0026lt;sup\u0026gt;n\u0026lt;/sup\u0026gt; को m से विभाजित किया जाता है, तो शेषफल मॉड्यूलर अंकगणित गुणों का उपयोग करके गणना किया जा सकता है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;गणना:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;2023 \u0026amp;equiv; -1 (mod 2024) क्योंकि 2023 = 2024 - 1\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;2025 \u0026amp;equiv; 1 (mod 2024) क्योंकि 2025 = 2024 + 1\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;अब इन मानों को व्यंजक में प्रतिस्थापित करें:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;2023\u0026lt;sup\u0026gt;2024\u0026lt;/sup\u0026gt; \u0026amp;equiv; (-1)\u0026lt;sup\u0026gt;2024\u0026lt;/sup\u0026gt; (mod 2024)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;(-1)\u0026lt;sup\u0026gt;2024\u0026lt;/sup\u0026gt; = 1 क्योंकि 2024 सम है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;2025\u0026lt;sup\u0026gt;2024\u0026lt;/sup\u0026gt; \u0026amp;equiv; (1)\u0026lt;sup\u0026gt;2024\u0026lt;/sup\u0026gt; (mod 2024)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;1\u0026lt;sup\u0026gt;2024\u0026lt;/sup\u0026gt; = 1\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;अब दो परिणामों को जोड़ें:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;(-1)\u0026lt;sup\u0026gt;2024\u0026lt;/sup\u0026gt; + (1)\u0026lt;sup\u0026gt;2024\u0026lt;/sup\u0026gt; \u0026amp;equiv; 1 + 1 \u0026amp;equiv; 2 (mod 2024)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;जब 2023\u0026lt;sup\u0026gt;2024\u0026lt;/sup\u0026gt; + 2025\u0026lt;sup\u0026gt;2024\u0026lt;/sup\u0026gt; को 2024 से विभाजित किया जाता है, तो शेषफल 2 प्राप्त होता\u0026amp;nbsp;है।\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Number System"],"globalConcept":[{"s":{"id":"5eea6a1039140f30f369e7e7","title":"Quantitative Aptitude"},"c":{"id":"5eea6a1039140f30f369e843","title":"Number System"},"t":{"id":"5eea6a1039140f30f369e84c","title":"Divisibility and Remainder"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":23.46140797285834,"attempts":{"correct":173,"incorrect":251,"partial":0,"skipped":755,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":1,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689535784bf9040e58ef6a8b":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is\u0026amp;nbsp;\u0026lt;strong\u0026gt;It did not rain\u0026amp;nbsp;\u0026amp;nbsp;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;From the statements given:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;If there is rainfall, it leads to flowers blooming.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;If flowers bloom, it leads to celebrations.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Since the flowers did not bloom, it indicates that the initial condition (rainfall) did not occur\u0026amp;nbsp;because rainfall leads to flowers blooming. Therefore, it is certain that it did not rain.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर है:\u0026amp;nbsp;\u0026lt;strong\u0026gt;बारिश नहीं हुई है\u0026amp;nbsp;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;दिए गए कथनों से:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;यदि बारिश होती है, तो इससे फूल खिलते हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;यदि फूल खिलते हैं, तो इससे उत्सव होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;चूँकि फूल नहीं खिले, यह दर्शाता है कि प्रारंभिक स्थिति (बारिश) नहीं हुई क्योंकि बारिश से फूल खिलते हैं। इसलिए, यह निश्चित है कि बारिश नहीं हुई है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":null,"globalConcept":[{"s":{"id":"5eea6a0e39140f30f369e41d","title":"Logical Reasoning"},"c":{"id":""},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":29.63189143341815,"attempts":{"correct":429,"incorrect":295,"partial":0,"skipped":455,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":1,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895358fa25b7b429e6d867b":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;FOREST\u0026lt;/strong\u0026gt;.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The relationship between \u0026amp;quot;MAN\u0026amp;quot; and \u0026amp;quot;CROWD\u0026amp;quot; is that a man is a single individual, and a crowd consists of many individuals.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Just as \u0026amp;quot;CROWD\u0026amp;quot; is composed of many individuals (men), \u0026amp;quot;FOREST\u0026amp;quot; is composed of many trees.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;Therefore, the correct analogy is \u0026amp;quot;TREE\u0026amp;quot; is to \u0026amp;quot;FOREST\u0026amp;quot; as \u0026amp;quot;MAN\u0026amp;quot; is to \u0026amp;quot;CROWD\u0026amp;quot;.\u0026amp;nbsp;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;जंगल\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026quot;आदमी\u0026quot; और \u0026quot;भीड़\u0026quot; के बीच संबंध यह है कि एक आदमी एक व्यक्ति है, और भीड़ में कई व्यक्ति होते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जिस प्रकार \u0026quot;भीड़\u0026quot; कई व्यक्तियों (आदमियों) से मिलकर बनती है, उसी प्रकार \u0026quot;जंगल\u0026quot; कई पेड़ों से मिलकर बनता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;इसलिए, सही सादृश्य है \u0026quot;पेड़\u0026quot; का संबंध \u0026quot;जंगल\u0026quot; से है, जैसे \u0026quot;आदमी\u0026quot; का संबंध \u0026quot;भीड़\u0026quot; से है।\u0026lt;/p\u0026gt;","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":null,"globalConcept":[{"s":{"id":"5eea6a0e39140f30f369e41d","title":"Logical Reasoning"},"c":{"id":""},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":12.519083969465644,"attempts":{"correct":646,"incorrect":120,"partial":0,"skipped":413,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":1,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689535ab7625035107692194":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p style=\u0026quot;color: #212529;\u0026quot;\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;CONCEPT\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Conservation of Mechanical Energy on a Hill\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;When a cyclist is coasting (no pedaling or braking), mechanical energy is conserved.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Total mechanical energy = Kinetic Energy (KE) + Potential Energy (PE)\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Potential energy depends on height: \u0026lt;strong\u0026gt;PE = mgh\u0026lt;/strong\u0026gt;\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;As the cyclist moves downhill, PE decreases and KE increases, thus velocity increases.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Maximum velocity occurs where the height h(d) is minimum\u0026lt;/strong\u0026gt;.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;EXPLANATION\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The height function is given by:\n\t\u0026lt;p\u0026gt;h(d) = 10d⁴ - 5d\u0026amp;sup2;\u0026lt;/p\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;To find where h(d) is minimum (i.e., cyclist reaches lowest point), take derivative:\n\t\u0026lt;p\u0026gt;h\u0026amp;#39;(d) = d/d(d) [10d⁴ - 5d\u0026amp;sup2;] = 40d\u0026amp;sup3; - 10d\u0026lt;/p\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Set h\u0026amp;#39;(d) = 0 for critical points:\n\t\u0026lt;p\u0026gt;40d\u0026amp;sup3; - 10d = 0 \u0026amp;rArr; 10d(4d\u0026amp;sup2; - 1) = 0\u0026lt;/p\u0026gt;\n\n\t\u0026lt;p\u0026gt;\u0026amp;rArr; d = 0, d = \u0026amp;plusmn;1/2\u0026lt;/p\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Now test the second derivative to determine minima:\n\t\u0026lt;p\u0026gt;h\u0026amp;#39;\u0026amp;#39;(d) = d\u0026amp;sup2;h/dd\u0026amp;sup2; = 120d\u0026amp;sup2; - 10\u0026lt;/p\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;At d = 0: h\u0026amp;#39;\u0026amp;#39;(0) = -10 \u0026amp;rarr; Maximum\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;At d = \u0026amp;plusmn;1/2: h\u0026amp;#39;\u0026amp;#39;(\u0026amp;plusmn;1/2) = 120(1/4) - 10 = 30 - 10 = 20 \u0026amp;rarr; Positive \u0026amp;rarr; \u0026lt;strong\u0026gt;Minimum\u0026lt;/strong\u0026gt;\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Therefore, the height is minimum at d = \u0026amp;plusmn;1/2, and hence the velocity is \u0026lt;strong\u0026gt;maximum\u0026lt;/strong\u0026gt; there.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p style=\u0026quot;color: #212529;\u0026quot;\u0026gt;\u0026lt;strong\u0026gt;Therefore, the correct answer is \u0026lt;u\u0026gt;d = 1/2\u0026lt;/u\u0026gt;.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p style=\u0026quot;color: #212529;\u0026quot;\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;पहाड़ी पर यांत्रिक ऊर्जा का संरक्षण\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;जब कोई साइकिल चालक बिना पैडलिंग या ब्रेक लगाए साइकिल चला रहा होता है, तो यांत्रिक ऊर्जा संरक्षित रहती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;कुल यांत्रिक ऊर्जा = गतिज ऊर्जा (KE) + स्थितिज ऊर्जा (PE)\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;स्थितिज ऊर्जा ऊँचाई पर निर्भर करती है: \u0026lt;strong\u0026gt;PE = mgh\u0026lt;/strong\u0026gt;\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जैसे ही साइकिल चालक नीचे की ओर जाता है, PE घटती है और KE बढ़ती है, इस प्रकार वेग बढ़ता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;अधिकतम वेग तब होता है जब ऊँचाई h(d) न्यूनतम होती है।\u0026lt;/strong\u0026gt;\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;ऊँचाई फलन दिया गया है:\n\t\u0026lt;p\u0026gt;h(d) = 10d⁴ - 5d\u0026amp;sup2;\u0026lt;/p\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह ज्ञात करने के लिए कि h(d) न्यूनतम कहाँ है (अर्थात, साइकिल चालक सबसे निचले बिंदु पर पहुँचता है), अवकलज लें:\n\t\u0026lt;p\u0026gt;h\u0026amp;#39;(d) = d/d(d) [10d⁴ - 5d\u0026amp;sup2;] = 40d\u0026amp;sup3; - 10d\u0026lt;/p\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;क्रांतिक बिंदुओं के लिए h\u0026amp;#39;(d) = 0\u0026amp;nbsp;करें:\n\t\u0026lt;p\u0026gt;40d\u0026amp;sup3; - 10d = 0 \u0026amp;rArr; 10d(4d\u0026amp;sup2; - 1) = 0\u0026lt;/p\u0026gt;\n\n\t\u0026lt;p\u0026gt;\u0026amp;rArr; d = 0, d = \u0026amp;plusmn;1/2\u0026lt;/p\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;अब न्यूनतम निर्धारित करने के लिए द्वितीय अवकलज का परीक्षण करें:\n\t\u0026lt;p\u0026gt;h\u0026amp;#39;\u0026amp;#39;(d) = d\u0026amp;sup2;h/dd\u0026amp;sup2; = 120d\u0026amp;sup2; - 10\u0026lt;/p\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;d = 0 पर: h\u0026amp;#39;\u0026amp;#39;(0) = -10 \u0026amp;rarr; अधिकतम\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;d = \u0026amp;plusmn;1/2 पर: h\u0026amp;#39;\u0026amp;#39;(\u0026amp;plusmn;1/2) = 120(1/4) - 10 = 30 - 10 = 20 \u0026amp;rarr; धनात्मक \u0026amp;rarr; \u0026lt;strong\u0026gt;न्यूनतम\u0026lt;/strong\u0026gt;\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इसलिए, ऊँचाई d = \u0026amp;plusmn;1/2 पर न्यूनतम है, और इसलिए वहाँ वेग \u0026lt;strong\u0026gt;अधिकतम\u0026lt;/strong\u0026gt; है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p style=\u0026quot;color: #212529;\u0026quot;\u0026gt;\u0026lt;strong\u0026gt;इसलिए, सही उत्तर \u0026lt;u\u0026gt;d = 1/2\u0026lt;/u\u0026gt; है।\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Motion in Two and Three Dimensions"],"globalConcept":[{"s":{"id":"5eea6a1339140f30f369eeee","title":"Physics"},"c":{"id":"5eea6a1339140f30f369ef37","title":"Motion in Two and Three Dimensions"},"t":{"id":"5eea6a1339140f30f369ef3f","title":"Average Velocity and Instantaneous Velocity"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":14.734520780322283,"attempts":{"correct":83,"incorrect":153,"partial":0,"skipped":943,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":1,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689535c9cc49566a430d756f":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Given:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;∛0.99\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Formula used:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;If x is close to 1, then ∛x \u0026amp;asymp; 1 - (1 - x)/3\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Calculations:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;x = 0.99\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;1 - x = 1 - 0.99 = 0.01\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; ∛0.99 \u0026amp;asymp; 1 - (0.01 \u0026amp;divide; 3)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; ∛0.99 \u0026amp;asymp; 1 - 0.0033\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; ∛0.99 \u0026amp;asymp; 0.9967\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026amp;there4; ∛0.99 is closest to 0.99 (option 3).\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;दिया गया:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt; ∛0.99\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt; \u0026lt;strong\u0026gt;प्रयुक्त सूत्र:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt; यदि x, 1 के करीब है, तो ∛x ≈ 1 - (1 - x)/3\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt; \u0026lt;strong\u0026gt;गणना:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt; x = 0.99\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt; 1 - x = 1 - 0.99 = 0.01\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt; ⇒ ∛0.99 ≈ 1 - (0.01 ÷ 3)\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt; ⇒ ∛0.99 ≈ 1 - 0.0033\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt; ⇒ ∛0.99 ≈ 0.9967\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt; \u0026lt;strong\u0026gt;∴ ∛0.99, 0.99 के सबसे निकट है (विकल्प 3)।\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Number System"],"globalConcept":[{"s":{"id":"5eea6a1039140f30f369e7e7","title":"Quantitative Aptitude"},"c":{"id":"5eea6a1039140f30f369e843","title":"Number System"},"t":{"id":"621f7d94e5c6a94072b9e1ab","title":"Square and Square Root"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":18.831212892281606,"attempts":{"correct":221,"incorrect":339,"partial":0,"skipped":619,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":1,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689535ee3005e0e058596582":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Given:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;White balls in the box = 4\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Black balls in the box = 6\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Total balls in the box initially = 4 + 6 = 10\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Formula Used:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Probability = (Number of favorable outcomes) / (Total number of outcomes)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Calculation:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Step 1: First Draw\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Probability of drawing a white ball = 4 / 10 = 2 / 5\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Probability of drawing a black ball = 6 / 10 = 3 / 5\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Step 2: After the first draw\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;If the ball drawn is white:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;White balls in the box = 4 + 2 = 6\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Black balls in the box = 6\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Total balls = 6 + 6 = 12\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;If the ball drawn is black:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;White balls in the box = 4\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Black balls in the box = 6 - 2 = 4\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Total balls = 4 + 4 = 8\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Step 3: Second Draw\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Case 1: If the first ball is white, probability of drawing a black ball in the second draw:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; (Black balls / Total balls) = 6 / 12 = 1 / 2\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Case 2: If the first ball is black, probability of drawing a black ball in the second draw:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; (Black balls / Total balls) = 4 / 8 = 1 / 2\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Step 4: Total Probability\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Using the law of total probability:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; Probability of black ball = (Probability of first white \u0026amp;times; Probability of black in Case 1) + (Probability of first black \u0026amp;times; Probability of black in Case 2)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; Probability of black ball = (2 / 5 \u0026amp;times; 1 / 2) + (3 / 5 \u0026amp;times; 1 / 2)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; Probability of black ball = (2 / 10) + (3 / 10)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; Probability of black ball = 5 / 10\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; Probability of black ball = 1 / 2\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;The probability that the ball drawn in the second attempt is black is 1 / 2.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;दिया गया है:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;बॉक्स में सफेद गेंदें = 4\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;बॉक्स में काली गेंदें = 6\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;प्रारंभ में बॉक्स में कुल गेंदें = 4 + 6 = 10\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;प्रयुक्त सूत्र:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;प्रायिकता = (अनुकूल परिणामों की संख्या) / (कुल परिणामों की संख्या)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;गणना:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;चरण 1: पहला ड्रा\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;सफेद गेंद निकालने की प्रायिकता = 4 / 10 = 2 / 5\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;काली गेंद निकालने की प्रायिकता = 6 / 10 = 3 / 5\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;चरण 2: पहले ड्रा के बाद\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;यदि निकाली गई गेंद सफेद है:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;बॉक्स में सफेद गेंदें = 4 + 2 = 6\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;बॉक्स में काली गेंदें = 6\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;कुल गेंदें = 6 + 6 = 12\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;यदि निकाली गई गेंद काली है:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;बॉक्स में सफेद गेंदें = 4\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;बॉक्स में काली गेंदें = 6 - 2 = 4\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;कुल गेंदें = 4 + 4 = 8\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;चरण 3: दूसरा ड्रा\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;स्थिति 1: यदि पहली गेंद सफेद है, तो दूसरे ड्रा में काली गेंद निकालने की प्रायिकता:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; (काली गेंदें / कुल गेंदें) = 6 / 12 = 1 / 2\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;स्थिति 2: यदि पहली गेंद काली है, तो दूसरे ड्रा में काली गेंद निकालने की प्रायिकता:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; (काली गेंदें / कुल गेंदें) = 4 / 8 = 1 / 2\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;चरण 4: कुल प्रायिकता\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;कुल प्रायिकता के नियम का उपयोग करने पर:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; काली गेंद की प्रायिकता = (पहली सफेद की प्रायिकता \u0026amp;times; स्थिति 1 में काली की प्रायिकता) + (पहली काली की प्रायिकता \u0026amp;times; स्थिति 2 में काली की प्रायिकता)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; काली गेंद की प्रायिकता = (2 / 5 \u0026amp;times; 1 / 2) + (3 / 5 \u0026amp;times; 1 / 2)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; काली गेंद की प्रायिकता = (2 / 10) + (3 / 10)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; काली गेंद की प्रायिकता = 5 / 10\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; काली गेंद की प्रायिकता = 1 / 2\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;दूसरे प्रयास में निकाली गई गेंद के काले होने की प्रायिकता 1 / 2 है।\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Probability"],"globalConcept":[{"s":{"id":"5eea6a1039140f30f369e7e7","title":"Quantitative Aptitude"},"c":{"id":"5eea6a1039140f30f369e860","title":"Probability"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":34.0449533502969,"attempts":{"correct":113,"incorrect":259,"partial":0,"skipped":807,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":1,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689535fd3005e0e0585965c5":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;b\u0026gt;East\u0026lt;/b\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;In this case, if east becomes southeast, we need to consider the corresponding shift of all other directions based on the original compass.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;For example, moving from east to southeast represents a 45-degree clockwise rotation.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;If East is rotated by 45 degrees clockwise to become Southeast, every other direction must also rotate 45 degrees clockwise.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Northeast, which is originally at 45 degrees between North and East, would move 45 degrees clockwise to align with East.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//storage.googleapis.com/tb-img/production/21/02/F1_Pooja.S_22-02-21_Savita_D1.png\u0026quot; style=\u0026quot;color: rgb(33, 37, 41); width: 471px; height: 369px;\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Therefore, if east becomes southeast, northeast will become \u0026lt;b\u0026gt;East\u0026lt;/b\u0026gt;.\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;b\u0026gt;पूर्व\u0026lt;/b\u0026gt; है।\u0026amp;nbsp;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;इस मामले में, यदि पूर्व, दक्षिण-पूर्व हो जाता है, तो हमें मूल कम्पास के आधार पर अन्य सभी दिशाओं के संगत बदलाव पर विचार करने की आवश्यकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;उदाहरण के लिए, पूर्व से दक्षिण-पूर्व तक जाना 45 डिग्री दक्षिणावर्त घुमाव को दर्शाता\u0026amp;nbsp;है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यदि पूर्व को 45 डिग्री दक्षिणावर्त घुमाकर दक्षिण-पूर्व बनाया जाता है, तो प्रत्येक अन्य दिशा को भी 45 डिग्री दक्षिणावर्त घुमाना होगा।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;उत्तर-पूर्व, जो मूल रूप से उत्तर और पूर्व के बीच 45 डिग्री पर है, पूर्व के साथ संरेखित करने के लिए 45 डिग्री दक्षिणावर्त घूमेगा।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//storage.googleapis.com/tb-img/production/21/02/F1_Pooja.S_22-02-21_Savita_D1.png\u0026quot; style=\u0026quot;color: rgb(33, 37, 41); width: 471px; height: 369px;\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;इसलिए, यदि पूर्व, दक्षिण-पूर्व हो जाता है, तो उत्तर-पूर्व,\u0026amp;nbsp;\u0026lt;b\u0026gt;पूर्व\u0026lt;/b\u0026gt; बन जाएगा।\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Direction and Distance"],"globalConcept":[{"s":{"id":"5eea6a0e39140f30f369e41d","title":"Logical Reasoning"},"c":{"id":"5eea6a0e39140f30f369e42a","title":"Direction and Distance"},"t":{"id":"5eea6a0e39140f30f369e42b","title":"Direction and Distance Turns"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":35.78117048346057,"attempts":{"correct":343,"incorrect":244,"partial":0,"skipped":592,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":1,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895360bef177aa03fbad9e3":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;973\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;To find the largest three-digit odd numbers with all distinct digits, we need to consider numbers in descending order, ensuring all digits are unique.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The highest three-digit odd numbers have 9, 8, 7, 6, 5, 4, 3, 2, 1 as possible digits, with the last digit being odd (1, 3, 5, 7, 9).\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;The largest three-digit odd number with distinct digits is \u0026lt;strong\u0026gt;987\u0026lt;/strong\u0026gt;.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;The second largest is \u0026lt;strong\u0026gt;985\u0026lt;/strong\u0026gt;.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;The third largest is \u0026lt;strong\u0026gt;983\u0026lt;/strong\u0026gt;.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;The fourth largest is \u0026lt;strong\u0026gt;981\u0026lt;/strong\u0026gt;.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;The fifth largest is \u0026lt;strong\u0026gt;975\u0026lt;/strong\u0026gt;.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;The sixth largest is \u0026lt;strong\u0026gt;973\u0026lt;/strong\u0026gt;.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;Therefore, the sixth largest three-digit odd number among those with all digits distinct is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;973\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;.\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;973\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026amp;nbsp;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;तीन अंकों वाली सबसे बड़ी विषम संख्याएँ ज्ञात करने के लिए जिनमें सभी अंक भिन्न हों, हमें संख्याओं को अवरोही क्रम में देखना होगा, यह सुनिश्चित करते हुए कि सभी अंक अद्वितीय हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;तीन अंकों वाली सबसे बड़ी विषम संख्याओं में 9, 8, 7, 6, 5, 4, 3, 2, 1 संभावित अंक हैं, जिसमें अंतिम अंक विषम (1, 3, 5, 7, 9) होना चाहिए।\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;भिन्न अंकों वाली सबसे बड़ी तीन अंकों वाली विषम संख्या \u0026lt;strong\u0026gt;987\u0026lt;/strong\u0026gt; है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;दूसरी सबसे बड़ी \u0026lt;strong\u0026gt;985\u0026lt;/strong\u0026gt; है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;तीसरी सबसे बड़ी \u0026lt;strong\u0026gt;983\u0026lt;/strong\u0026gt; है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;चौथी सबसे बड़ी \u0026lt;strong\u0026gt;981\u0026lt;/strong\u0026gt; है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;पाँचवीं सबसे बड़ी \u0026lt;strong\u0026gt;975\u0026lt;/strong\u0026gt; है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;छठी सबसे बड़ी \u0026lt;strong\u0026gt;973\u0026lt;/strong\u0026gt; है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;इसलिए, उन तीन अंकों वाली विषम संख्याओं में से छठी सबसे बड़ी संख्या जिसमें सभी अंक भिन्न हों, \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;973\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":null,"globalConcept":[{"s":{"id":"5eea6a1039140f30f369e7e7","title":"Quantitative Aptitude"},"c":{"id":""},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":35.28244274809164,"attempts":{"correct":142,"incorrect":275,"partial":0,"skipped":762,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":1,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895361cf922825acdf5e72d":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Given:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Time taken by fresh water tap to fill the tank = 40 minutes.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Time taken by salt water tap to fill the tank = 120 minutes.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Formula Used:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;When two taps are filling the tank simultaneously, the combined rate of filling = (Rate of first tap + Rate of second tap).\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Total Time = Total tank capacity / Combined rate of filling.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Calculation:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Rate of fresh water tap = 1 / 40 (tank/min).\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Rate of salt water tap = 1 / 120 (tank/min).\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Combined rate = (1 / 40) + (1 / 120).\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; Combined rate = (3 + 1) / 120 = 4 / 120 = 1 / 30 (tank/min).\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Total Time = 1 / (1 / 30).\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; Total Time = 30 minutes.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;The tank will be filled in 30 minutes.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;दिया गया है:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;ताजे पानी के नल द्वारा टैंक को भरने में लिया गया समय = 40 मिनट।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;खारे पानी के नल द्वारा टैंक को भरने में लिया गया समय = 120 मिनट।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;प्रयुक्त सूत्र:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;जब दो नल एक साथ टैंक को भर रहे हों, तो भरने की संयुक्त दर = (पहले नल की दर + दूसरे नल की दर)।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;कुल समय = कुल टैंक क्षमता / भरने की संयुक्त दर।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;गणना:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;ताजे पानी के नल की दर = 1 / 40 (टैंक/मिनट).\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;खारे पानी के नल की दर = 1 / 120 (टैंक/मिनट).\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;संयुक्त दर = (1 / 40) + (1 / 120).\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; संयुक्त दर = (3 + 1) / 120 = 4 / 120 = 1 / 30 (टैंक/मिनट).\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;कुल समय = 1 / (1 / 30).\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;rArr; कुल समय = 30 मिनट.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;टैंक 30 मिनट में भर जाएगा।\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Time and Work"],"globalConcept":[{"s":{"id":"5eea6a1039140f30f369e7e7","title":"Quantitative Aptitude"},"c":{"id":"5eea6a1039140f30f369e855","title":"Time and Work"},"t":{"id":"5eea6a1039140f30f369e858","title":"Pipe and Cistern"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":33.19932145886344,"attempts":{"correct":235,"incorrect":74,"partial":0,"skipped":870,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":1,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895362c7ac09e469dee6975":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;All businessmen are rich\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;If all businessmen are rich, then it logically follows that if Amit is a businessman, he must also be rich.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Therefore, the statement from which the implication \u0026amp;quot;Amit is a businessman, so he must be rich\u0026amp;quot; follows is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;All businessmen are rich\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर है:\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;सभी व्यापारी अमीर होते हैं।\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यदि सभी व्यापारी अमीर हैं, तो तार्किक रूप से यह इस प्रकार है कि यदि अमित एक व्यापारी है, तो उसे भी अमीर होना चाहिए।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इसलिए, वह कथन जिससे निष्कर्ष \u0026amp;quot;अमित एक व्यापारी है, इसलिए वह अमीर होना चाहिए\u0026amp;quot; निकलता है, वह है:\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;सभी व्यापारी अमीर होते हैं\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Statements and Conclusions"],"globalConcept":[{"s":{"id":"5eea6a1539140f30f369f43d","title":"Verbal Reasoning"},"c":{"id":"5eea6a1539140f30f369f446","title":"Statements and Conclusions"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":18.764206955046664,"attempts":{"correct":297,"incorrect":218,"partial":0,"skipped":664,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":1,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953641c6cdfd92ecf7801c":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;higher\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;When the iron ball is placed in the plastic mug, the combined system (mug + iron ball) displaces a volume of water equal to the weight of the system, causing the water level in the bucket to rise.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;When the iron ball is directly placed in the water, it sinks due to its density being higher than that of water, and it displaces an amount of water equivalent to its volume.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The key difference is that in the first scenario (ball in the mug), the total weight of the system floating causes more water to be displaced compared to the second scenario (ball in water) where only the volume of the ball itself is the factor.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Since iron is denser than water, the amount of water displaced when it is inside the mug (causing the mug to float higher and displace more water) is greater than the volume of water it displaces when it sinks directly in the bucket.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;Therefore, the water level in the bucket is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;higher\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; when the iron ball is in the plastic mug as compared to when the ball is directly in the water.\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;उच्च\u0026lt;/strong\u0026gt; है।\u0026amp;nbsp;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;जब लोहे की गेंद को प्लास्टिक के मग में रखा जाता है, तो संयुक्त तंत्र (मग + लोहे की गेंद) पानी की एक मात्रा को विस्थापित करता है जो तंत्र के भार के बराबर होती है, जिससे बाल्टी में पानी का स्तर बढ़ जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जब लोहे की गेंद को सीधे पानी में रखा जाता है, तो यह पानी की तुलना में अपने घनत्व के अधिक होने के कारण डूब जाती है, और यह अपनी मात्रा के बराबर पानी की मात्रा को विस्थापित करती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;मुख्य अंतर यह है कि पहले परिदृश्य में (गेंद मग में), तैरते हुए तंत्र का कुल भार दूसरे परिदृश्य (गेंद पानी में) की तुलना में अधिक पानी को विस्थापित करता है जहाँ केवल गेंद का आयतन ही कारक होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;चूँकि लोहा पानी से सघन होता है, इसलिए जब यह मग के अंदर होता है (जिससे मग अधिक ऊपर तैरता है और अधिक पानी विस्थापित करता है) तो विस्थापित पानी की मात्रा उस पानी की मात्रा से अधिक होती है जो वह बाल्टी में सीधे डूबने पर विस्थापित करती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;इसलिए, बाल्टी में पानी का स्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;उच्च\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; होता है जब लोहे की गेंद प्लास्टिक के मग में होती है, इसकी तुलना में जब गेंद सीधे पानी में होती है।\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":null,"globalConcept":[{"s":{"id":"5eea6a0c39140f30f369dfda","title":"General Science"},"c":{"id":""},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":27.564037319762512,"attempts":{"correct":105,"incorrect":232,"partial":0,"skipped":842,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":1,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895365bef177aa03fbadb91":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Helicase\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;DNA replication is a vital process in which the DNA molecule is copied to produce two identical DNA strands, ensuring genetic information is passed on during cell division.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Several enzymes are involved in DNA replication, each playing a specific role.\u0026amp;nbsp;\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Helicase\u0026lt;/strong\u0026gt;\u0026amp;nbsp;is the enzyme responsible for unwinding the short stretches of the DNA double helix ahead of the replication fork.\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;It breaks the hydrogen bonds between the complementary base pairs of the DNA strands.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;By doing this, it creates single-stranded DNA templates required for the synthesis of the new DNA strands by DNA polymerase.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Helicase ensures that the replication machinery has access to the DNA strands, facilitating the replication process.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Other Options\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Topoisomerase:\u0026lt;/strong\u0026gt;\u0026amp;nbsp;This enzyme relieves the supercoiling and torsional stress that develops ahead of the replication fork due to the unwinding activity of helicase.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;DNA Polymerase:\u0026lt;/strong\u0026gt;\u0026amp;nbsp;DNA polymerase is responsible for synthesizing the new DNA strands by adding complementary nucleotides to the template strands.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;DNA Gyrase:\u0026lt;/strong\u0026gt;\u0026amp;nbsp;A specific type of topoisomerase found in prokaryotes, DNA gyrase introduces negative supercoils or relaxes positive supercoils to manage DNA topology during replication.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;हेलीकेज़\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;DNA प्रतिकृति एक महत्वपूर्ण प्रक्रिया है जिसमें DNA अणु की प्रतिलिपि बनाई जाती है जिससे दो समान DNA रज्जुक बनते हैं, यह सुनिश्चित करते हुए कि कोशिका विभाजन के दौरान आनुवंशिक जानकारी आगे बढ़ती रहे।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;DNA प्रतिकृति में कई एंजाइम शामिल होते हैं, प्रत्येक एक विशिष्ट भूमिका निभाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;हेलीकेज़\u0026lt;/strong\u0026gt; वह एंजाइम है जो प्रतिकृति द्विशाख के आगे DNA डबल हेलिक्स के छोटे खंडों को खोलने के लिए उत्तरदायी होता है।\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह DNA रज्जुक के पूरक बेस जोड़ों के बीच हाइड्रोजन बंधों को तोड़ता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;ऐसा करने से, यह DNA पोलीमरेज़ द्वारा नए DNA रज्जुक के संश्लेषण के लिए आवश्यक एकल-रज्जुक DNA टेम्पलेट बनाता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;हेलीकेज़ यह सुनिश्चित करता है कि प्रतिकृति तंत्र के पास DNA रज्जुक तक पहुँच हो, जिससे प्रतिकृति प्रक्रिया को सुगम बनाया जा सके।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;टोपोइसोमेरेज़:\u0026lt;/strong\u0026gt; यह एंजाइम सुपरकोइलिंग और टॉर्सनल तनाव को दूर करता है जो हेलीकेज़ की अनवाइंडिंग गतिविधि के कारण प्रतिकृति द्विशाख के आगे विकसित होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;DNA पोलीमरेज़:\u0026lt;/strong\u0026gt; DNA पोलीमरेज़ टेम्पलेट रज्जुक में पूरक न्यूक्लियोटाइड्स को जोड़कर नए DNA रज्जुक को संश्लेषित करने के लिए उत्तरदायी होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;DNA गाइरेज़:\u0026lt;/strong\u0026gt; प्रोकैरियोट्स में पाया जाने वाला एक विशिष्ट प्रकार का टोपोइसोमेरेज़, DNA गाइरेज़ प्रतिकृति के दौरान DNA टोपोलॉजी का प्रबंधन करने के लिए नकारात्मक सुपरकोइल स्थानांतरित\u0026amp;nbsp;करता है या सकारात्मक सुपरकोइल को शिथिल बनाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Fundamental Processes"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a451aec9ba648bc86fbf43","title":"Fundamental Processes"},"t":{"id":"63a451b54936ab151c928c46","title":"DNA replication, repair and recombination"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":26.370653095843934,"attempts":{"correct":486,"incorrect":370,"partial":0,"skipped":323,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895366d76250351076924ab":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;First mitotic division of a microspore\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Asymmetric cell division is a form of cell division where the resulting daughter cells are not identical in size, content, or fate. This type of division is crucial in plants for creating specialized cells and tissues, enabling development and differentiation.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In plants, asymmetric cell division is often observed during processes that lead to the formation of distinct cell types, such as guard cells, spores, and embryonic cells.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The microspore undergoes an asymmetric mitotic division to form two distinct cells: a larger vegetative cell and a smaller generative cell.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This division is critical for the development of pollen grains in plants, where the generative cell eventually gives rise to sperm cells, and the vegetative cell aids in pollen tube formation.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The unequal size and distinct roles of the daughter cells highlight the asymmetric nature of this division.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Other Options:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Formation of stomatal guard cells from a guard mother cell:\u0026lt;/strong\u0026gt;\u0026amp;nbsp;While the guard mother cell divides to form two guard cells, this division is symmetric, resulting in two identical daughter cells with similar size and function.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;First mitotic division of a megaspore:\u0026lt;/strong\u0026gt;\u0026amp;nbsp;The megaspore undergoes mitotic divisions to form the embryo sac, but these divisions are typically symmetric, producing cells of similar size and content.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Cell division in the root elongation zone:\u0026lt;/strong\u0026gt;\u0026amp;nbsp;Cell division in the root elongation zone is primarily associated with growth and enlargement of cells. These divisions are generally symmetric, contributing to the elongation of the root rather than differentiation into distinct cell types.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;लघुबीजाणु का प्रथम समसूत्री विभाजन\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;असममित कोशिका विभाजन कोशिका विभाजन का एक रूप है जहाँ परिणामी पुत्री कोशिकाएँ आकार, सामग्री या भाग्य में समान नहीं होती हैं। इस प्रकार का विभाजन पौधों में विशिष्ट कोशिकाओं और ऊतकों के निर्माण के लिए महत्वपूर्ण है, जिससे विकास और विभेदन संभव होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;पौधों में, असममित कोशिका विभाजन अक्सर उन प्रक्रियाओं के दौरान देखा जाता है जो अलग-अलग कोशिका प्रकारों के निर्माण की ओर ले जाती हैं, जैसे कि रक्षक कोशिकाएँ, बीजाणु और भ्रूणीय कोशिकाएँ।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;लघुबीजाणु दो अलग-अलग कोशिकाओं का निर्माण करने के लिए एक असममित समसूत्री विभाजन से गुजरता है: एक बड़ी कायिक कोशिका और एक छोटी जनन कोशिका।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह विभाजन पौधों में परागकणों के विकास के लिए महत्वपूर्ण है, जहाँ जनन कोशिका अंततः शुक्राणु कोशिकाओं को जन्म देती है, और कायिक कोशिका पराग नलिका निर्माण में सहायता करती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;पुत्री कोशिकाओं का असमान आकार और विशिष्ट भूमिकाएँ इस विभाजन की असममित प्रकृति को उजागर करती हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;रक्षक जनक कोशिका से रंध्र रक्षक कोशिकाओं का निर्माण:\u0026lt;/strong\u0026gt; जबकि रक्षक जनक कोशिका दो रक्षक कोशिकाओं का निर्माण करने के लिए विभाजित होती है, यह विभाजन सममित है, जिसके परिणामस्वरूप समान आकार और कार्य वाली दो समान संतति कोशिकाएँ होती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;गुरुबीजाणु का प्रथम समसूत्री विभाजन:\u0026lt;/strong\u0026gt; गुरुबीजाणु भ्रूण कोष बनाने के लिए समसूत्री विभाजन से गुजरता है, लेकिन ये विभाजन आम तौर पर सममित होते हैं, जो समान आकार और सामग्री वाली कोशिकाओं का उत्पादन करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;मूल दीर्घीकरण क्षेत्र में कोशिका विभाजन:\u0026lt;/strong\u0026gt; मूल दीर्घीकरण क्षेत्र\u0026amp;nbsp; में कोशिका विभाजन मुख्यतः कोशिकाओं की वृद्धि और दीर्घीकरण\u0026amp;nbsp;से जुड़ा होता है। ये विभाजन आमतौर पर सममित होते हैं, जो अलग-अलग कोशिका प्रकारों में विभेदन के बजाय जड़ की वृद्धि में योगदान करते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Cellular Organization"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4518aa958c4957eed4157","title":"Cellular Organization"},"t":{"id":"63a451a2b69497f2c4437bfc","title":"Cell Division and Cell Cycle"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":23.54877014418997,"attempts":{"correct":189,"incorrect":448,"partial":0,"skipped":542,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953690c6cdfd92ecf78380":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Basket cells\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The nervous system comprises two major types of cells: neurons and glial cells.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Glial cells, also called neuroglia, are non-neuronal cells that provide support, protection, and nourishment to neurons.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;There are several types of glial cells in the nervous system, each with a specific function, such as Schwann cells, ependymal cells, and satellite cells.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Basket cells are a type of inhibitory interneuron found in the cerebellar cortex and are not glial cells. They are a type of inhibitory GABAergic interneuron found in the cerebellum. Basket cells synapse on Purkinje cells and play a role in modulating the output of the cerebellum\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Other Options:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Schwann cells:\u0026lt;/strong\u0026gt; These are glial cells found in the peripheral nervous system (PNS). They are responsible for the formation of the myelin sheath around peripheral nerve fibers, which helps in the efficient transmission of electrical signals.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Ependymal cells:\u0026lt;/strong\u0026gt; These are glial cells that line the brain\u0026amp;#39;s ventricles and the central canal of the spinal cord. They produce cerebrospinal fluid (CSF) and help in its circulation, playing a crucial role in maintaining the brain\u0026amp;#39;s environment.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Satellite cells:\u0026lt;/strong\u0026gt; These are glial cells located in the peripheral nervous system. They surround the neuronal cell bodies in ganglia and provide structural support, nutrient exchange, and protection to neurons.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;बास्केट कोशिकाएँ\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;तंत्रिका तंत्र में दो प्रमुख प्रकार की कोशिकाएँ होती हैं: न्यूरॉन्स और ग्लाया कोशिकाएँ।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;ग्लाया कोशिकाएँ, जिन्हें न्यूरोग्लिया भी कहा जाता है, गैर-न्यूरोनल कोशिकाएँ हैं जो न्यूरॉन्स को सहारा, सुरक्षा और पोषण प्रदान करती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;तंत्रिका तंत्र में कई प्रकार की ग्लाया कोशिकाएँ होती हैं, जिनमें से प्रत्येक का एक विशिष्ट कार्य होता है, जैसे कि श्वान कोशिकाएँ, एपेंडाइमल कोशिकाएँ और उपग्रह कोशिकाएँ।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;बास्केट कोशिकाएँ प्रमस्तिष्क प्रांतस्था में पाई जाने वाली एक प्रकार की निरोधात्मक इंटरन्यूरॉन होती हैं और ये ग्लाया कोशिकाएँ नहीं होती हैं। वे प्रमस्तिष्क में पाई जाने वाली एक प्रकार की निरोधात्मक GABAergic इंटरन्यूरॉन हैं। बास्केट कोशिकाएँ पुरकिंजे कोशिकाओं पर सिनैप्स करती हैं और प्रमस्तिष्क के आउटपुट को नियंत्रित करने में भूमिका निभाती हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;श्वान कोशिकाएँ:\u0026lt;/strong\u0026gt; ये परिधीय तंत्रिका तंत्र (PNS) में पाई जाने वाली ग्लाया कोशिकाएँ हैं। वे परिधीय तंत्रिका तंतुओं के चारों ओर माइलिन शीथ के निर्माण के लिए उत्तरदायी होती हैं, जो विद्युत संकेतों के कुशल संचरण में मदद करती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;एपेंडाइमल कोशिकाएँ:\u0026lt;/strong\u0026gt; ये ग्लाया कोशिकाएँ हैं जो मस्तिष्क के निलयों और मेरुरज्जु के केंद्रीय नाल को रेखाबद्ध करती हैं। वे सेरेब्रोस्पाइनल द्रव (CSF) का उत्पादन करती हैं और इसके परिसंचरण में मदद करती हैं, मस्तिष्क के पर्यावरण को बनाए रखने में महत्वपूर्ण भूमिका निभाती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;उपग्रह कोशिकाएँ:\u0026lt;/strong\u0026gt; ये परिधीय तंत्रिका तंत्र में स्थित ग्लाया कोशिकाएँ हैं। वे गैंग्लिया में न्यूरोनल कोशिका निकायों को घेरती हैं और न्यूरॉन्स को संरचनात्मक सहारा, पोषक तत्वों का विनिमय और सुरक्षा प्रदान करती हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["System Physiology Animal"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a452e28f21ac91a2eba7a5","title":"System Physiology Animal"},"t":{"id":"63a452f1abc201e6b11e7e45","title":"Nervous system"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":13.225614927905008,"attempts":{"correct":246,"incorrect":361,"partial":0,"skipped":572,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689536a2af69335e709ff6da":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Compositional heterogeneity causing long-branch attraction\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;16S rRNA gene-based phylogenetic trees are widely used for studying evolutionary relationships among prokaryotic organisms.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Maximum-likelihood (ML) methods estimate the tree that most likely explains the observed data under a specific evolutionary model.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;A long branch in phylogenetic trees can indicate potential artefacts, such as biases in sequence composition, which can lead to incorrect grouping of distantly related taxa. This phenomenon is referred to as long-branch attraction (LBA).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;LBA occurs when sequences with similar compositional bias are incorrectly inferred to be closely related, even if they are not truly so.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Compositional heterogeneity causing long-branch attraction:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Compositional heterogeneity refers to differences in the nucleotide or amino acid composition among sequences being analyzed.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In phylogenetics, when taxa exhibit large compositional differences, these differences can result in a long branch in the tree.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Long-branch attraction occurs when unrelated taxa with similar compositional bias are incorrectly grouped together. This is a common artefact in ML and parsimony-based methods.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In this case, the long branch at the node connecting the Actinobacteria clade to the Proteobacteria clade suggests compositional heterogeneity is likely causing this artefact.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Other Options:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Homoplasy in peptidoglycan cross-link pattern:\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Homoplasy refers to the independent evolution of similar traits, which can obscure true evolutionary relationships.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Inaccurate rooting due to midpoint placement causing long-branch attraction:\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Midpoint rooting is a method to root a tree by placing the root at the midpoint of the longest branch. While midpoint rooting may introduce inaccuracies, the artefact described here (long branch connecting Actinobacteria and Proteobacteria) is more likely due to compositional heterogeneity, not rooting issues.\u0026amp;nbsp;\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Over-parametrization of the GTR+G model:\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;The General Time Reversible (GTR) model with Gamma distribution (G) is a complex model often used in ML phylogenetics to account for rate heterogeneity among sites.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Over-parametrization refers to using an overly complex model that might fit noise instead of the true signal. However, this does not explain the long-branch attraction.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर है-\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;रचनात्मक विषमता लंबी-शाखा आकर्षण का कारण बनती है\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;16S rRNA जीन-आधारित फ़ाइलोजेनेटिक वृक्षों का व्यापक रूप से प्रोकैरियोटिक जीवों के बीच विकासवादी संबंधों का अध्ययन करने के लिए उपयोग किया जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;अधिकतम-संभावना (ML) विधियाँ उस वृक्ष का अनुमान लगाती हैं जो एक विशिष्ट विकासवादी मॉडल के तहत देखे गए डेटा की सबसे अधिक संभावना बताती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;फ़ाइलोजेनेटिक वृक्षों में एक लंबी शाखा संभावित कलाकृतियों का संकेत दे सकती है, जैसे कि अनुक्रम संरचना में पूर्वाग्रह, जो दूर से संबंधित टैक्सों के गलत समूहीकरण का कारण बन सकता है। इस घटना को लंबी-शाखा आकर्षण (LBA) कहा जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;LBA तब होता है जब समान संरचनात्मक पूर्वाग्रह वाले अनुक्रमों को गलत तरीके से निकटता से संबंधित माना जाता है, भले ही वे वास्तव में ऐसा न हों।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;रचनात्मक विषमता लंबी-शाखा आकर्षण का कारण बनती है:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;रचनात्मक विषमता विश्लेषण किए जा रहे अनुक्रमों के बीच न्यूक्लियोटाइड या अमीनो एसिड संरचना में अंतर को संदर्भित करती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;फ़ाइलोजेनेटिक्स में, जब टैक्सोन बड़े संरचनात्मक अंतर प्रदर्शित करते हैं, तो ये अंतर वृक्ष में एक लंबी शाखा का परिणाम दे सकते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;लंबी-शाखा आकर्षण तब होता है जब समान संरचनात्मक पूर्वाग्रह वाले असंबंधित टैक्सोन को गलत तरीके से एक साथ समूहीकृत किया जाता है। यह ML और पार्सिमनी-आधारित विधियों में एक सामान्य कलाकृत है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इस मामले में, एक्टिनोबैक्टीरिया कुलाच को प्रोटीओबैक्टीरिया कुलाच से जोड़ने वाले नोड पर लंबी शाखा से पता चलता है कि यह कलाकृत संभवतः रचनात्मक विषमता के कारण है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;पेप्टिडोग्लाइकन क्रॉस-लिंक पैटर्न में होमोप्लासी:\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;होमोप्लासी का तात्पर्य समान लक्षणों के स्वतंत्र विकास से है, जो वास्तविक विकासवादी संबंधों को अस्पष्ट कर सकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;strong\u0026gt;मध्य-बिंदु प्लेसमेंट के कारण गलत रूटिंग लंबी-शाखा आकर्षण का कारण बनती है:\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;मध्य-बिंदु रूटिंग सबसे लंबी शाखा के मध्य बिंदु पर जड़ रखकर एक वृक्ष को जड़ करने की एक विधि है। जबकि मध्य-बिंदु रूटिंग अशुद्धियाँ पेश कर सकती है, यहाँ वर्णित कलाकृत (एक्टिनोबैक्टीरिया और प्रोटीओबैक्टीरिया को जोड़ने वाली लंबी शाखा) अधिक संभावना है कि रचनात्मक विषमता के कारण, रूटिंग के मुद्दों के कारण नहीं।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;GTR+G मॉडल का अति-पैरामीटरीकरण:\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;गामा वितरण (G) के साथ सामान्य समय प्रतिवर्ती (GTR) मॉडल एक जटिल मॉडल है जिसका उपयोग अक्सर ML फ़ाइलोजेनेटिक्स में साइटों के बीच दर विषमता के लिए किया जाता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;अति-पैरामीटरीकरण का अर्थ है एक अत्यधिक जटिल मॉडल का उपयोग करना जो वास्तविक सिग्नल के बजाय शोर को समायोजित कर सकता है। हालाँकि, यह लंबी-शाखा आकर्षण की व्याख्या नहीं करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Fundamental Processes"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a451aec9ba648bc86fbf43","title":"Fundamental Processes"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":20.655640373197613,"attempts":{"correct":70,"incorrect":234,"partial":0,"skipped":875,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689536b37ac09e469dee6bdd":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Canthaxanthin\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Non-photochemical quenching (NPQ) is a photoprotective mechanism in plants that helps dissipate excess light energy absorbed by chlorophyll molecules in the form of heat. This protects the photosynthetic apparatus from damage caused by overexcitation under high-light conditions.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Carotenoids play a crucial role in NPQ. The xanthophyll cycle, which involves the interconversion of violaxanthin, antheraxanthin, and zeaxanthin, is particularly important in facilitating this process.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Canthaxanthin, although a carotenoid, is not part of the xanthophyll cycle and does not play a role in NPQ in plants.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Zeaxanthin:\u0026lt;/strong\u0026gt;\u0026amp;nbsp;Zeaxanthin is a key carotenoid involved in NPQ. It is formed from violaxanthin via antheraxanthin in the xanthophyll cycle under high light conditions. Zeaxanthin is directly involved in dissipating excess energy as heat, preventing damage to photosystem II.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Violaxanthin:\u0026lt;/strong\u0026gt;\u0026amp;nbsp;Violaxanthin is the precursor in the xanthophyll cycle. Under low light conditions, it is the predominant form, but it is converted to antheraxanthin and then to zeaxanthin under high light conditions. It plays an indirect role in NPQ by being a substrate for zeaxanthin formation.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Antheraxanthin:\u0026lt;/strong\u0026gt;\u0026amp;nbsp;Antheraxanthin is an intermediate in the xanthophyll cycle. It is formed from violaxanthin and is subsequently converted to zeaxanthin. While it is not as active as zeaxanthin in NPQ, it still contributes to the energy dissipation process.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage689a25d04f2f291bcc884acb.png\u0026quot; /\u0026gt;​\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;em\u0026gt;Fig: Interconversions of zeaxanthin, antheraxanthin, and violaxanthin in the xanthophyll cycle (\u0026lt;a href=\u0026quot;https://www.mdpi.com/1420-3049/25/24/5825\u0026quot;\u0026gt;Source\u0026lt;/a\u0026gt;)\u0026lt;/em\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Canthaxanthin:\u0026lt;/strong\u0026gt;\u0026amp;nbsp;Canthaxanthin is a carotenoid but is not involved in NPQ or the xanthophyll cycle. It is not converted to zeaxanthin or any other molecule involved in energy dissipation in plants. Its role in plants is more associated with pigmentation rather than photoprotection.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;कैन्थैक्सैन्थिन\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;गैर-प्रकाश रासायनिक शमन (NPQ) पौधों में एक प्रकाश सुरक्षात्मक तंत्र है जो क्लोरोफिल अणुओं द्वारा अवशोषित अतिरिक्त प्रकाश ऊर्जा को ऊष्मा के रूप में नष्ट करने में मदद करता है। यह उच्च-प्रकाश स्थितियों के तहत अति-उत्तेजना के कारण होने वाले नुकसान से प्रकाश संश्लेषक तंत्र की रक्षा करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;NPQ में कैरोटीनॉइड महत्वपूर्ण भूमिका निभाते हैं। ज़ैंथोफिल चक्र, जिसमें वायोलैक्सैन्थिन, एंथेरेक्सैन्थिन और ज़ेक्सैन्थिन का अंतर्संबंध शामिल है, इस प्रक्रिया को सुविधाजनक बनाने में विशेष रूप से महत्वपूर्ण है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;कैन्थैक्सैन्थिन, हालांकि एक कैरोटीनॉइड है, ज़ैंथोफिल चक्र का हिस्सा नहीं है और पौधों में NPQ में भूमिका नहीं निभाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;ज़ेक्सैन्थिन:\u0026lt;/strong\u0026gt; ज़ेक्सैन्थिन NPQ में शामिल एक प्रमुख कैरोटीनॉइड है। यह उच्च प्रकाश स्थितियों में ज़ैंथोफिल चक्र में वायोलैक्सैन्थिन से एंथेरेक्सैन्थिन के माध्यम से बनता है। ज़ेक्सैन्थिन अतिरिक्त ऊर्जा को ऊष्मा के रूप में नष्ट करने में प्रत्यक्ष रूप से शामिल होता है, जिससे प्रकाशतंत्र II को होने वाली क्षति को रोका जा सकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;वायोलैक्सैन्थिन:\u0026lt;/strong\u0026gt; वायोलैक्सैन्थिन ज़ैंथोफिल चक्र में अग्रदूत है। कम प्रकाश की स्थिति में, यह प्रमुख रूप है, लेकिन उच्च प्रकाश की स्थिति में इसे एंथेरेक्सैन्थिन और फिर ज़ेक्सैन्थिन में बदल दिया जाता है। यह ज़ेक्सैन्थिन निर्माण के लिए एक सब्सट्रेट होने के कारण NPQ में अप्रत्यक्ष भूमिका निभाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;एंथेरेक्सैन्थिन:\u0026lt;/strong\u0026gt; एंथेरेक्सैन्थिन ज़ैंथोफिल चक्र में एक मध्यवर्ती है। यह वायोलैक्सैन्थिन से बनता है और बाद में ज़ेक्सैन्थिन में परिवर्तित हो जाता है। हालांकि यह NPQ में ज़ेक्सैन्थिन जितना सक्रिय नहीं है, फिर भी यह ऊर्जा अपव्यय प्रक्रिया में योगदान देता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage689a25d04f2f291bcc884acb.png\u0026quot; /\u0026gt;​\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;em\u0026gt;चित्र: ज़ैंथोफिल चक्र में ज़ेक्सैन्थिन, एंथेरेक्सैन्थिन और वायोलैक्सैन्थिन का अंतर्संबंध (\u0026lt;a href=\u0026quot;https://www.mdpi.com/1420-3049/25/24/5825\u0026quot;\u0026gt;स्रोत\u0026lt;/a\u0026gt;)\u0026lt;/em\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कैन्थैक्सैन्थिन:\u0026lt;/strong\u0026gt; कैन्थैक्सैन्थिन एक कैरोटीनॉइड है लेकिन NPQ या ज़ैंथोफिल चक्र में शामिल नहीं है। यह ज़ेक्सैन्थिन या पौधों में ऊर्जा अपव्यय में शामिल किसी अन्य अणु में परिवर्तित नहीं होता है। पौधों में इसकी भूमिका प्रकाश सुरक्षा के बजाय वर्णक से अधिक जुड़ी हुई है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["System Physiology Plant"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4526f5db927c0ec7fb376","title":"System Physiology Plant"},"t":{"id":"63a45275fb84f8fa3aec3144","title":"Photosynthesis"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":16.733672603901635,"attempts":{"correct":178,"incorrect":355,"partial":0,"skipped":646,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689536c28aebc97d87cfc3c4":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:rgb(33, 37, 41);\u0026quot;\u0026gt;Mitochondria\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The Steroidogenic Acute Regulatory Protein (StAR) is a key protein involved in the production of steroid hormones. It plays a central role in the process of steroidogenesis, which occurs in specialized cells of endocrine organs such as the adrenal glands, testes, and ovaries.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;Mitochondria are the primary sub-cellular organelles where the initial steps of steroidogenesis occur.\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;StAR protein facilitates the transfer of cholesterol, the precursor molecule for steroid hormone synthesis, from the outer mitochondrial membrane to the inner mitochondrial membrane, where the first enzymatic step of steroidogenesis occurs.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This transfer of cholesterol is crucial because the enzyme cytochrome P450 side-chain cleavage enzyme (P450scc), which converts cholesterol into pregnenolone (the first steroid hormone precursor), resides in the inner mitochondrial membrane.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Biophysical data show that only the carboxyl-terminal \u0026amp;alpha;-helix of StAR interacts with the outer membrane.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Spectroscopic data and molecular dynamics simulations show that StAR\u0026amp;#39;s interactions with protonated phospholipid head groups on the outer mitochondrial membrane induce a conformational change (molten globule transition) needed for StAR\u0026amp;#39;s activity\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage689a2784cb6b67b1f6db33f9.png\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;em\u0026gt;Fig: Steroidogenic acute regulatory protein (StAR), a novel mitochondrial cholesterol transporter\u0026lt;/em\u0026gt; \u0026lt;em\u0026gt;(\u0026lt;a href=\u0026quot;https://www.sciencedirect.com/science/article/abs/pii/S1388198107000431\u0026quot;\u0026gt;Source\u0026lt;/a\u0026gt;)\u0026lt;/em\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:rgb(33, 37, 41);\u0026quot;\u0026gt;माइटोकॉन्ड्रिया\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;स्टेरॉयडोजेनिक तीव्र नियामक प्रोटीन (StAR) स्टेरॉयड हार्मोन के उत्पादन में शामिल एक प्रमुख प्रोटीन है। यह स्टेरॉयडोजेनेसिस की प्रक्रिया में एक केंद्रीय भूमिका निभाता है, जो अंतःस्रावी अंगों जैसे अधिवृक्क ग्रंथियों, वृषण और अंडाशय की विशिष्ट कोशिकाओं में होती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;माइटोकॉन्ड्रिया प्राथमिक उप-कोशिकीय कोशिकांग हैं जहाँ स्टेरॉयडोजेनेसिस के प्रारंभिक चरण होते हैं।\u0026lt;/span\u0026gt;\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;StAR प्रोटीन कोलेस्ट्रॉल के स्थानांतरण को सुगम बनाता है, जो स्टेरॉयड हार्मोन संश्लेषण के लिए पूर्वगामी अणु है, बाहरी माइटोकॉन्ड्रियल झिल्ली से आंतरिक माइटोकॉन्ड्रियल झिल्ली तक, जहाँ स्टेरॉयडोजेनेसिस का पहला एंजाइमेटिक चरण होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;कोलेस्ट्रॉल का यह स्थानांतरण महत्वपूर्ण है क्योंकि एंजाइम साइटोक्रोम P450 साइड-चेन क्लिंज एंजाइम (P450scc), जो कोलेस्ट्रॉल को प्रीग्नेनोलोन (पहला स्टेरॉयड हार्मोन पूर्वगामी) में परिवर्तित करता है, आंतरिक माइटोकॉन्ड्रियल झिल्ली में रहता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;बायोफिजिकल डेटा दिखाते हैं कि केवल StAR का कार्बोक्सिल-टर्मिनल \u0026amp;alpha;-हेलिक्स बाहरी झिल्ली के साथ अंतःक्रिया करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;स्पेक्ट्रोस्कोपिक डेटा और आणविक गतिशीलता सिमुलेशन से पता चलता है कि बाहरी माइटोकॉन्ड्रियल झिल्ली पर प्रोटोनेटेड फॉस्फोलिपिड हेड समूहों के साथ StAR की अंतःक्रिया, StAR की गतिविधि के लिए आवश्यक एक संरूपण परिवर्तन (गलित ग्लोब्यूल संक्रमण) को प्रेरित करती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage689a2784cb6b67b1f6db33f9.png\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;em\u0026gt;चित्र: स्टेरॉयडोजेनिक तीव्र नियामक प्रोटीन (StAR), एक नया माइटोकॉन्ड्रियल कोलेस्ट्रॉल ट्रांसपोर्टर\u0026lt;/em\u0026gt; \u0026lt;em\u0026gt;(\u0026lt;a href=\u0026quot;https://www.sciencedirect.com/science/article/abs/pii/S1388198107000431\u0026quot;\u0026gt;स्रोत\u0026lt;/a\u0026gt;)\u0026lt;/em\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Cellular Organization"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4518aa958c4957eed4157","title":"Cellular Organization"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":19.710771840542865,"attempts":{"correct":186,"incorrect":436,"partial":0,"skipped":557,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689536e8f922825acdf5eb9d":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Archean \u0026amp;rarr; Proterozoic \u0026amp;rarr; Phanerozoic\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Archean Era (Oldest):\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;The Archean era spans from approximately 4 billion to 2.5 billion years ago.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;It marks the early stages of Earth\u0026amp;#39;s formation, including the development of the planet\u0026amp;#39;s crust and the appearance of the first known life forms, primarily simple single-celled organisms like prokaryotes.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;The atmosphere during this time was primarily composed of methane, ammonia, and other gases, with little to no oxygen.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Proterozoic Era:\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;The Proterozoic era spans from about 2.5 billion to 541 million years ago.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;This era saw significant changes, such as the accumulation of oxygen in the atmosphere (the \u0026amp;quot;Great Oxygenation Event\u0026amp;quot;) and the emergence of more complex life forms, including eukaryotic cells.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Multicellular organisms started to appear toward the end of this era.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Phanerozoic Era (Youngest):\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;The Phanerozoic era began approximately 541 million years ago and continues to the present day.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;This era is characterized by the rapid evolution and diversification of life, including the appearance of complex animals and plants.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;It includes three major periods: the Paleozoic, Mesozoic, and Cenozoic eras, during which events like the Cambrian explosion, the rise of dinosaurs, and the eventual dominance of mammals occurred.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//storage.googleapis.com/tb-img/production/23/07/F3_Vinanti_Teaching_05.07.23_D1.png\u0026quot; style=\u0026quot;color: rgb(33, 37, 41); height: 486px; width: 461px;\u0026quot; /\u0026gt;​\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;आर्कियन \u0026amp;rarr; प्रोटेरोज़ोइक \u0026amp;rarr; फैनरोज़ोइक\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;है।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;आर्कियन युग (सबसे पुराना):\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;आर्कियन युग लगभग 4 अरब से 2.5 अरब वर्ष पूर्व तक फैला हुआ है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह पृथ्वी के निर्माण के शुरुआती चरणों को दर्शाता है, जिसमें ग्रह की पर्पटी का विकास और पहले ज्ञात जीवन रूपों की उपस्थिति शामिल है, मुख्य रूप से सरल एककोशिकीय जीव जैसे प्रोकैरियोट्स।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;इस समय के दौरान वातावरण मुख्य रूप से मीथेन, अमोनिया और अन्य गैसों से बना था, जिसमें ऑक्सीजन बहुत कम या बिलकुल नहीं थी।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;प्रोटेरोज़ोइक युग:\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;प्रोटेरोज़ोइक युग लगभग 2.5 अरब से 541 मिलियन वर्ष पूर्व तक फैला हुआ है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;इस युग में महत्वपूर्ण परिवर्तन देखे गए, जैसे कि वातावरण में ऑक्सीजन का संचय (\u0026amp;quot;महान ऑक्सीकरण घटना\u0026amp;quot;) और अधिक जटिल जीवन रूपों का उदय, जिसमें यूकेरियोटिक कोशिकाएँ शामिल हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;इस युग के अंत में बहुकोशिकीय जीव दिखाई देने लगे।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;फैनरोज़ोइक युग (सबसे नया):\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;फैनरोज़ोइक युग लगभग 541 मिलियन वर्ष पूर्व शुरू हुआ और आज तक जारी है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह युग जीवन के तेजी से विकास और विविधीकरण की विशेषता है, जिसमें जटिल जानवरों और पौधों की उपस्थिति शामिल है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;इसमें तीन प्रमुख काल शामिल हैं: पैलियोज़ोइक, मेसोज़ोइक और सेनोज़ोइक युग, जिसके दौरान कैम्ब्रियन विस्फोट, डायनासोर का उदय और स्तनधारियों का अंतिम प्रभुत्व जैसी घटनाएँ हुईं।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//storage.googleapis.com/tb-img/production/23/07/F3_Vinanti_Teaching_05.07.23_D1.png\u0026quot; style=\u0026quot;color: rgb(33, 37, 41); height: 486px; width: 461px;\u0026quot; /\u0026gt;​\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Evolution and Behavior"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4557fe52da32add2b08e9","title":"Evolution and Behavior"},"t":{"id":"63a455aef5a3f50e8fc1c22b","title":"Evolutionary Mechanisms"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":18.727735368956754,"attempts":{"correct":324,"incorrect":320,"partial":0,"skipped":535,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689536f8af69335e709ff80f":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;em\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:rgb(33, 37, 41);\u0026quot;\u0026gt;Fusarium oxysporum\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/em\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Tomato plants are susceptible to a variety of diseases caused by pathogens including fungi, oomycetes, bacteria, and viruses. Proper identification of the pathogen is critical to managing the disease effectively.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The symptoms described\u0026amp;mdash;progressive wilting, interveinal chlorosis, root rot, and rapid disease progression in humid conditions along with the presence of coenocytic hyphae and thick-walled oospores, point to an oomycete pathogen.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Oomycetes such as \u0026lt;em\u0026gt;Pythium\u0026lt;/em\u0026gt; and \u0026lt;em\u0026gt;Phytophthora\u0026lt;/em\u0026gt; are characterized by their coenocytic (non-septate) hyphae and production of oospores, which are thick-walled sexual spores.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;em\u0026gt;Fusarium oxysporum\u0026lt;/em\u0026gt;, on the other hand, is a fungal pathogen and does not produce coenocytic hyphae or oospores. This is a soil-borne fungal pathogen that causes Fusarium wilt in tomatoes. It produces septate hyphae and does not form oospores. While it causes wilting and vascular discoloration, the presence of coenocytic hyphae and oospores in the laboratory analysis rules out \u0026lt;em\u0026gt;Fusarium oxysporum\u0026lt;/em\u0026gt; as the pathogen.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Other Options:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;em\u0026gt;Pythium aphanidermatum:\u0026lt;/em\u0026gt;\u0026lt;/strong\u0026gt; This is an oomycete pathogen that produces coenocytic hyphae and oospores. It thrives in humid conditions and causes damping-off and root rot in many plants, including tomatoes.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;em\u0026gt;Phytophthora nicotianae:\u0026lt;/em\u0026gt;\u0026lt;/strong\u0026gt; Another oomycete pathogen, it produces coenocytic hyphae and oospores. It causes diseases such as root rot, stem rot, and leaf blight in tomatoes and other crops, especially in humid conditions.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;em\u0026gt;Phytophthora infestans:\u0026lt;/em\u0026gt;\u0026lt;/strong\u0026gt; Known for causing late blight in tomatoes and potatoes, this oomycete pathogen also produces coenocytic hyphae and is associated with humid conditions. While it typically affects foliage, it can also infect stems and fruits.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;em\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:rgb(33, 37, 41);\u0026quot;\u0026gt;फ्यूजेरियम ऑक्सीस्पोरम\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/em\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;टमाटर के पौधे कवक, ऊमाइसीटीज़, बैक्टीरिया और वायरस सहित रोगजनकों द्वारा उत्पन्न विभिन्न प्रकार के रोगों के प्रति संवेदनशील होते हैं। रोग के प्रभावी प्रबंधन के लिए रोगजनक की उचित पहचान अत्यंत महत्वपूर्ण है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;वर्णित लक्षण - प्रगतिशील मुरझाना, अंतरशिरा हरित हीनता, जड़ सड़न, तथा आर्द्र परिस्थितियों में रोग की तीव्र प्रगति के साथ-साथ कोनोसाइटिक हाइफे और मोटी दीवार वाले ओस्पोर्स की उपस्थिति, एक ऊमाइसीट रोगजनक की ओर संकेत करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;em\u0026gt;पायथियम\u0026lt;/em\u0026gt; और \u0026lt;em\u0026gt;फाइटोफ्थोरा\u0026lt;/em\u0026gt; जैसे ऊमाइसीट्स की विशेषता उनके कोएनोसाइटिक (गैर-सेप्टेट) हाइफे और ऊस्पोर्स के उत्पादन से होती है, जो मोटी दीवार वाले यौन बीजाणु होते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;दूसरी ओर, \u0026lt;em\u0026gt;फ्यूजेरियम ऑक्सीस्पोरम\u0026lt;/em\u0026gt; एक कवक रोगजनक है और यह कोएनोसाइटिक हाइफ़े या ओस्पोर उत्पन्न नहीं करता। यह एक मृदा जनित कवक रोगजनक है जो टमाटरों में फ्यूजेरियम विल्ट रोग उत्पन्न करता है। यह सेप्टेट हाइफ़े उत्पन्न करता है और ओस्पोर नहीं बनाता। हालाँकि यह मुरझान और संवहनी रंग परिवर्तन का कारण बनता है, लेकिन प्रयोगशाला विश्लेषण में कोएनोसाइटिक हाइफ़े और ओस्पोर की उपस्थिति \u0026lt;em\u0026gt;फ्यूजेरियम ऑक्सीस्पोरम को\u0026lt;/em\u0026gt; रोगजनक के रूप में खारिज करती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;em\u0026gt;पाइथियम एफैनिडर्मेटम:\u0026lt;/em\u0026gt;\u0026lt;/strong\u0026gt; यह एक ऊमाइसीट रोगजनक है जो कोएनोसाइटिक हाइफ़े और ऊस्पोर उत्पन्न करता है। यह आर्द्र परिस्थितियों में पनपता है और टमाटर सहित कई पौधों में डैम्पिंग-ऑफ़ और जड़ सड़न का कारण बनता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;em\u0026gt;फाइटोफ्थोरा निकोटियाने:\u0026lt;/em\u0026gt;\u0026lt;/strong\u0026gt; एक अन्य ऊमाइसीट रोगजनक, यह कोएनोसाइटिक हाइफ़े और ऊस्पोर उत्पन्न करता है। यह टमाटर और अन्य फसलों में, विशेष रूप से आर्द्र परिस्थितियों में, जड़ सड़न, तना सड़न और पत्ती झुलसा जैसे रोग उत्पन्न करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;em\u0026gt;फाइटोफ्थोरा इन्फेस्टैन्स:\u0026lt;/em\u0026gt;\u0026lt;/strong\u0026gt; टमाटर और आलू में लेट ब्लाइट पैदा करने के लिए जाना जाने वाला यह ऊमाइसीट रोगाणु कोएनोसाइटिक हाइफ़े भी पैदा करता है और आर्द्र परिस्थितियों से जुड़ा होता है। हालाँकि यह आमतौर पर पत्तियों को प्रभावित करता है, लेकिन यह तनों और फलों को भी संक्रमित कर सकता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Diversity of Life Forms"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a45511ef5b5403de57d744","title":"Diversity of Life Forms"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":21.457167090754886,"attempts":{"correct":140,"incorrect":269,"partial":0,"skipped":770,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895370c9eb05a9f9ac77979":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;They are branched polysaccharides, usually made up of repeating units of a sulphated amino sugar and a uronic acid.\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;b\u0026gt;\u0026lt;u\u0026gt;Explanation:\u0026lt;/u\u0026gt;\u0026lt;/b\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Glycosaminoglycans (GAGs)\u0026lt;/strong\u0026gt;\u0026amp;nbsp;are long, unbranched polysaccharides consisting of repeating disaccharide units. They play a critical role in the extracellular matrix and contribute to structural integrity, lubrication, and cellular signaling.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;GAGs are composed of two types of sugars: a sulphated amino sugar (such as N-acetylglucosamine or N-acetylgalactosamine) and a uronic acid (such as glucuronic acid or iduronic acid).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;They are highly anionic molecules due to the presence of sulphate and carboxyl groups, which allow them to attract water and ions.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;GAGs are \u0026lt;strong\u0026gt;unbranched polysaccharides\u0026lt;/strong\u0026gt;. They consist of linear chains of repeating disaccharide units, making them distinct from branched polysaccharides like glycogen or starch.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The repeating disaccharide units in GAGs are sulphated amino sugars and uronic acids, but the chains are strictly linear and not branched.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Overview of Other Options:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;GAGs are distinguished by their sugars, the type of linkage between the sugars, and the number and location of sulphate groups: \u0026lt;/strong\u0026gt;This statement is \u0026lt;strong\u0026gt;correct\u0026lt;/strong\u0026gt;. GAGs are classified based on these structural features, such as the type of sugar and sulphation patterns, which dictate their biological functions.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;They are one of the most anionic molecules made by animal cells\u0026lt;/strong\u0026gt;:\u0026amp;nbsp;This statement is \u0026lt;strong\u0026gt;correct\u0026lt;/strong\u0026gt;. Due to the high density of negatively charged sulphate and carboxyl groups, GAGs are among the most negatively charged molecules produced by animal cells, which contributes to their ability to bind water and ions.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Severe loss of GAGs can lead to premature aging: \u0026lt;/strong\u0026gt;This statement is \u0026lt;strong\u0026gt;correct\u0026lt;/strong\u0026gt;. GAGs are essential for maintaining the structural integrity of the extracellular matrix and skin. A decline in GAG levels is associated with reduced hydration and elasticity, contributing to aging-related changes in tissues.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर है-\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;वे शाखित पॉलीसेकेराइड होते हैं, जो आमतौर पर एक सल्फेटेड एमिनो शर्करा और एक यूरोनिक अम्ल की दोहराई जाने वाली इकाइयों से बने होते हैं।\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;b\u0026gt;\u0026lt;u\u0026gt;व्याख्या:\u0026lt;/u\u0026gt;\u0026lt;/b\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;ग्लूकोसामिनोग्लाइकैन (GAGs)\u0026lt;/strong\u0026gt; लंबे, अशाखित पॉलीसेकेराइड होते हैं जिनमें दोहराई जाने वाली डिसैकेराइड इकाइयाँ होती हैं। वे बाह्य कोशिकीय मैट्रिक्स में एक महत्वपूर्ण भूमिका निभाते हैं और संरचनात्मक अखंडता, स्नेहन और कोशिकीय सिग्नलिंग में योगदान करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;GAGs दो प्रकार की शर्करा से बने होते हैं: एक सल्फेटेड एमिनो शर्करा (जैसे N-एसिटाइलग्लूकोसामाइन या N-एसिटाइलगैलेक्टोसामाइन) और एक यूरोनिक अम्ल (जैसे ग्लुकुरोनिक अम्ल या आइडुरोनिक अम्ल)।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;सल्फेट और कार्बोक्सिल समूहों की उपस्थिति के कारण वे अत्यधिक ऋणायनिक अणु होते हैं, जो उन्हें पानी और आयनों को आकर्षित करने की अनुमति देते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;GAGs \u0026lt;strong\u0026gt;अशाखित पॉलीसेकेराइड\u0026lt;/strong\u0026gt; होते हैं। वे दोहराई जाने वाली डिसैकेराइड इकाइयों की रैखिक शृंखलाओं से मिलकर बनते हैं, जो उन्हें ग्लाइकोजन या स्टार्च जैसे शाखित पॉलीसेकेराइड से अलग करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;GAGs में दोहराई जाने वाली डिसैकेराइड इकाइयाँ सल्फेटेड एमिनो शर्करा और यूरोनिक अम्ल होती हैं, लेकिन शृंखलाएँ सख्ती से रैखिक होती हैं और शाखित नहीं होती हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्पों का अवलोकन:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;GAGs को उनके शर्करा, शर्करा के बीच बंधन के प्रकार और सल्फेट समूहों की संख्या और स्थान से पहचाना जाता है:\u0026lt;/strong\u0026gt; यह कथन \u0026lt;strong\u0026gt;सही\u0026lt;/strong\u0026gt; है। GAGs को इन संरचनात्मक विशेषताओं के आधार पर वर्गीकृत किया जाता है, जैसे कि शर्करा का प्रकार और सल्फेशन पैटर्न, जो उनके जैविक कार्यों को निर्धारित करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;वे जंतु कोशिकाओं द्वारा बनाए गए सबसे ऋणायनिक अणुओं में से एक हैं:\u0026lt;/strong\u0026gt; यह कथन \u0026lt;strong\u0026gt;सही\u0026lt;/strong\u0026gt; है। ऋणात्मक रूप से आवेशित सल्फेट और कार्बोक्सिल समूहों के उच्च घनत्व के कारण, GAGs जंतु कोशिकाओं द्वारा उत्पादित सबसे ऋणात्मक रूप से आवेशित अणुओं में से हैं, जो पानी और आयनों को बांधने की उनकी क्षमता में योगदान करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;GAGs का गंभीर नुकसान समय से पहले बूढ़ा होने का कारण बन सकता है:\u0026lt;/strong\u0026gt; यह कथन \u0026lt;strong\u0026gt;सही\u0026lt;/strong\u0026gt; है। GAGs बाह्य कोशिकीय मैट्रिक्स और त्वचा की संरचनात्मक अखंडता को बनाए रखने के लिए आवश्यक हैं। GAG के स्तर में गिरावट हाइड्रेशन और लोच में कमी से जुड़ी होती है, जो ऊतकों में उम्र से संबंधित परिवर्तनों में योगदान करती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Cellular Organization"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4518aa958c4957eed4157","title":"Cellular Organization"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":29.050042408821035,"attempts":{"correct":214,"incorrect":258,"partial":0,"skipped":707,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689537243005e0e058596bba":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Individual subpopulations should have realistic chances of extinction and recolonization.\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The classical metapopulation model, introduced by Richard Levins in 1969 and 1970, describes a population structure where individuals are distributed across multiple spatially separated subpopulations occupying distinct patches of habitat.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;A metapopulation is characterized by dynamics that include local extinction and recolonization of these patches.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;Conditions for a true metapopulation:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Patches are suitable for the species but separated in space.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Subpopulations experience local extinctions and recolonization events.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The overall metapopulation persists because colonization rate \u0026amp;gt; extinction rate.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation of the Correct Answer:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Individual subpopulations should have realistic chances of extinction and recolonization:\u0026lt;/strong\u0026gt; This is the foundational condition for a population to be considered a metapopulation. In a true metapopulation, subpopulations within different patches face the risk of extinction due to factors like environmental changes, demographic stochasticity, or other disturbances. However, these patches can be recolonized by individuals dispersing from other patches. This dynamic interplay between local extinction and recolonization ensures the persistence of the metapopulation as a whole.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The extinction-recolonization balance is a key element of the metapopulation model. Without the possibility of extinction and recolonization, the population structure would not align with the definition of a metapopulation.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Other Options:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;The dynamics of the subpopulations should be dependent on each other:\u0026lt;/strong\u0026gt; While subpopulations in a metapopulation are connected through dispersal, their dynamics are not entirely dependent on each other. Each subpopulation can exhibit independent dynamics, but recolonization events depend on dispersal between patches. This option incorrectly implies a strict interdependence that is not required in the classical metapopulation model.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Recolonization of a patch after extinction should be mainly through dispersal from the mainland patch:\u0026lt;/strong\u0026gt; This describes a \u0026amp;quot;mainland-island\u0026amp;quot; metapopulation model, which is a specific variation of the metapopulation concept. The classical metapopulation model does not require a mainland patch, as recolonization can occur from any other patch within the network.\u0026amp;nbsp;\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Option 4: Population dynamics in the various patches should be synchronous:\u0026lt;/strong\u0026gt; Synchrony in population dynamics across patches is not a requirement for a metapopulation. Asynchronous dynamics are often observed, which can enhance metapopulation persistence by reducing the risk of simultaneous extinction across all patches.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर है-\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;व्यक्तिगत उप-जनसंख्याओं में विलुप्त होने और पुनर्वासन की यथार्थवादी संभावनाएँ होनी चाहिए।\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;1969 और 1970 में रिचर्ड लेविंस द्वारा प्रस्तुत शास्त्रीय मेटापॉपुलेशन मॉडल, एक जनसंख्या संरचना का वर्णन करता है जहाँ व्यक्ति आवास के अलग-अलग पैचों पर कब्जा करने वाली कई स्थानिक रूप से अलग उप-जनसंख्याओं में वितरित होते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;एक मेटापॉपुलेशन की विशेषता गतिशीलता है जिसमें इन पैचों का स्थानीय विलुप्त होना और पुनर्वास शामिल है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;एक वास्तविक मेटापॉपुलेशन के लिए शर्तें:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;पैच प्रजातियों के लिए उपयुक्त हैं लेकिन अंतरिक्ष में अलग हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;उप-जनसंख्याएँ स्थानीय विलुप्त होने और पुनर्वास की घटनाओं का अनुभव करती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;कुल मिलाकर मेटापॉपुलेशन बनी रहती है क्योंकि उपनिवेशीकरण दर \u0026amp;gt; विलुप्त होने की दर।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;सही उत्तर की व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;व्यक्तिगत उप-जनसंख्याओं में विलुप्त होने और पुनर्वासन की यथार्थवादी संभावनाएँ होनी चाहिए:\u0026lt;/strong\u0026gt; किसी जनसंख्या को मेटापॉपुलेशन माना जाने के लिए यह मौलिक शर्त है। एक वास्तविक मेटापॉपुलेशन में, विभिन्न पैचों के भीतर उप-जनसंख्याएँ पर्यावरणीय परिवर्तन, जनसांख्यिकीय स्टोकेस्टिसिटी या अन्य गड़बड़ियों जैसे कारकों के कारण विलुप्त होने के जोखिम का सामना करती हैं। हालाँकि, इन पैचों को अन्य पैचों से फैलने वाले व्यक्तियों द्वारा पुनर्वासित किया जा सकता है। स्थानीय विलुप्त होने और पुनर्वास के बीच यह गतिशील अंतःक्रिया समग्र रूप से मेटापॉपुलेशन के दृढ़ता को सुनिश्चित करती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;विलुप्ति-पुनःउपनिवेशीकरण संतुलन मेटापॉपुलेशन मॉडल का एक प्रमुख तत्व है। विलुप्ति और पुनःउपनिवेशीकरण की संभावना के बिना, जनसंख्या संरचना मेटापॉपुलेशन की परिभाषा के अनुरूप नहीं होगी।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;उप-जनसंख्याओं की गतिशीलता एक-दूसरे पर निर्भर होनी चाहिए:\u0026lt;/strong\u0026gt; जबकि एक मेटापॉपुलेशन में उप-जनसंख्याएँ फैलाव के माध्यम से जुड़ी हुई हैं, उनकी गतिशीलता पूरी तरह से एक-दूसरे पर निर्भर नहीं है। प्रत्येक उप-जनसंख्या स्वतंत्र गतिशीलता प्रदर्शित कर सकती है, लेकिन पुनर्वास की घटनाएँ पैचों के बीच फैलाव पर निर्भर करती हैं। यह विकल्प गलत तरीके से एक सख्त अन्योन्याश्रयता का अर्थ बताता है जो शास्त्रीय मेटापॉपुलेशन मॉडल में आवश्यक नहीं है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;विलुप्त होने के बाद किसी पैच का पुनर्वास मुख्य रूप से मुख्य भूमि पैच से फैलाव के माध्यम से होना चाहिए:\u0026lt;/strong\u0026gt; यह एक \u0026amp;quot;मुख्य भूमि-द्वीप\u0026amp;quot; मेटापॉपुलेशन मॉडल का वर्णन करता है, जो मेटापॉपुलेशन अवधारणा का एक विशिष्ट रूप है। शास्त्रीय मेटापॉपुलेशन मॉडल को मुख्य भूमि पैच की आवश्यकता नहीं है, क्योंकि पुनर्वास नेटवर्क के भीतर किसी भी अन्य पैच से हो सकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;विकल्प 4: विभिन्न पैचों में जनसंख्या की गतिशीलता समकालीन होनी चाहिए:\u0026lt;/strong\u0026gt; विभिन्न पैचों में जनसंख्या गतिशीलता में समकालिकता मेटापॉपुलेशन के लिए आवश्यक नहीं है। अतुल्यकालिक गतिशीलता अक्सर देखी जाती है, जो सभी पैचों में एक साथ विलुप्त होने के जोखिम को कम करके मेटापॉपुलेशन स्थायित्व को बढ़ा सकती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Ecological Principles"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a45541e89684161ccd7911","title":"Ecological Principles"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":26.49194232400338,"attempts":{"correct":118,"incorrect":284,"partial":0,"skipped":777,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689537383005e0e058596c2c":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;What mechanism underlies the association between floral odour and reward in bees?\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;In ethology, Tinbergen\u0026amp;#39;s Four Questions provide a framework for understanding animal behavior by examining it through four dimensions:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Causation (mechanism),\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Development (ontogeny),\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Function (adaptive value),\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Evolution (phylogeny).\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;The question focuses on the role of dopamine release in the mushroom bodies of honey bees and its effect on learning floral odors associated with nectar rewards. This aligns with Tinbergen\u0026amp;#39;s \u0026amp;quot;causation\u0026amp;quot; or \u0026amp;quot;mechanism\u0026amp;quot; dimension, which seeks to uncover the physiological or biochemical processes underlying a specific behavior.\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;In this context, the researchers are investigating the neural mechanism that enables honey bees to learn and associate floral odors with the presence of nectar.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;What mechanism underlies the association between floral odour and reward in bees?\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This study explores how dopamine release in the mushroom bodies, a key brain region in insects affects the honey bee\u0026amp;#39;s ability to learn and remember floral odors linked to nectar rewards.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;It addresses the \u0026amp;quot;causation\u0026amp;quot; question in Tinbergen\u0026amp;#39;s framework by focusing on the neurological and biochemical processes that enable this learning behavior.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Mechanistic studies like this provide insights into how specific brain structures and neurotransmitters contribute to complex behaviors such as foraging and learning.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Other Options:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;What is the evolutionary origin of odour-based learning in hymenopterans?\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;This option addresses the \u0026amp;quot;evolutionary\u0026amp;quot; or \u0026amp;quot;phylogenetic\u0026amp;quot; dimension of Tinbergen\u0026amp;#39;s framework.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;It would focus on how odour-based learning evolved in the lineage of hymenopterans (bees, ants, wasps) and the selective pressures that led to its development.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;How does floral odour learning improve foraging efficiency and reproductive success?\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;This option addresses the \u0026amp;quot;function\u0026amp;quot; or \u0026amp;quot;adaptive value\u0026amp;quot; question in Tinbergen\u0026amp;#39;s framework.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;It would investigate the role of floral odor learning in enhancing the bee\u0026amp;#39;s foraging success and how this contributes to its survival and reproductive fitness.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;How does floral odour learning change over the lifespan of a honey bee?\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;This option pertains to the \u0026amp;quot;development\u0026amp;quot; or \u0026amp;quot;ontogeny\u0026amp;quot; dimension of Tinbergen\u0026amp;#39;s framework.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;It would examine how the ability to learn floral odors evolves as the honey bee matures or ages.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;The study does not address lifespan-related changes in learning ability but instead focuses on the immediate neural processes involved in learning, making this option incorrect.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर है \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;मधुमक्खियों में पुष्पीय गंध और पुरस्कार के बीच संबंध किस तंत्र द्वारा निर्धारित होता है?\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;संप्रत्यय:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;इथोलॉजी में, टिनबर्गेन के चार प्रश्न चार आयामों के माध्यम से पशु व्यवहार को समझने के लिए एक रूपरेखा प्रदान करते हैं:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;कारण (तंत्र),\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;विकास (ऑन्टोजेनी),\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;कार्य (अनुकूली मान),\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;विकास (फाइलोजेनी).\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;यह प्रश्न मधुमक्खियों के मशरूम काय में डोपामाइन के निकलने की भूमिका और मधु पुरस्कारों से जुड़ी पुष्पीय गंधों को सीखने पर इसके प्रभाव पर केंद्रित है। यह टिनबर्गेन के \u0026amp;quot;कारण\u0026amp;quot; या \u0026amp;quot;तंत्र\u0026amp;quot; आयाम के साथ संरेखित होता है, जो किसी विशिष्ट व्यवहार के अंतर्निहित शारीरिक या जैव रासायनिक प्रक्रियाओं का पता लगाना चाहता है।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;इस संदर्भ में, शोधकर्ता उस तंत्रिका तंत्र की जांच कर रहे हैं जो मधुमक्खियों को फूलों की गंध को पराग की उपस्थिति के साथ सीखने और संबद्ध करने में सक्षम बनाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;मधुमक्खियों में पुष्पीय गंध और पुरस्कार के बीच संबंध किस तंत्र द्वारा निर्धारित होता है?\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह अध्ययन पता लगाता है कि मशरूम काय में डोपामाइन का निकलना, जो कीटों में एक प्रमुख मस्तिष्क क्षेत्र है, मधुमक्खी की मधु पुरस्कारों से जुड़ी पुष्पीय गंधों को सीखने और याद रखने की क्षमता को कैसे प्रभावित करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह टिनबर्गेन के ढांचे में \u0026amp;quot;कारण\u0026amp;quot; प्रश्न को संबोधित करता है, जो तंत्रिका और जैव रासायनिक प्रक्रियाओं पर केंद्रित है जो इस अधिगम व्यवहार को सक्षम बनाते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इस तरह के यांत्रिक अध्ययन इस बात में अंतर्दृष्टि प्रदान करते हैं कि विशिष्ट मस्तिष्क संरचनाएं और न्यूरोट्रांसमीटर भोजन-संग्रहण और अधिगम जैसे जटिल व्यवहारों में कैसे योगदान करते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;हाइमेनोप्टेरान में गंध-आधारित अधिगम की विकासवादी उत्पत्ति क्या है?\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह विकल्प टिनबर्गेन के ढांचे के \u0026amp;quot;विकासवादी\u0026amp;quot; या \u0026amp;quot;फाइलोजेनेटिक\u0026amp;quot; आयाम को संबोधित करता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह इस बात पर ध्यान केंद्रित करेगा कि हाइमेनोप्टेरान (मधुमक्खी, चींटियाँ, ततैया) के वंश में गंध-आधारित अधिगम कैसे विकसित हुआ और इसके विकास के लिए चयनात्मक दबाव क्या थे।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;पुष्पीय गंध अधिगम भोजन-संग्रहण दक्षता और प्रजनन सफलता को कैसे बेहतर बनाता है?\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह विकल्प टिनबर्गेन के ढांचे में \u0026amp;quot;कार्य\u0026amp;quot; या \u0026amp;quot;अनुकूली मान\u0026amp;quot; प्रश्न को संबोधित करता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह जांच करेगा कि पुष्पीय गंध अधिगम मधुमक्खी की भोजन-संग्रहण सफलता को बढ़ाने में कैसे भूमिका निभाता है और यह इसके अस्तित्व और प्रजनन फिटनेस में कैसे योगदान देता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;एक मधुमक्खी के जीवनकाल में पुष्पीय गंध अधिगम कैसे बदलता है?\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह विकल्प टिनबर्गेन के ढांचे के \u0026amp;quot;विकास\u0026amp;quot; या \u0026amp;quot;ऑन्टोजेनी\u0026amp;quot; आयाम से संबंधित है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह जांच करेगा कि जैसे-जैसे मधुमक्खी परिपक्व या वृद्ध होती है, पुष्पीय गंधों को सीखने की क्षमता कैसे विकसित होती है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;अध्ययन अधिगम क्षमता में जीवनकाल से संबंधित परिवर्तनों को संबोधित नहीं करता है, बल्कि सीखने में शामिल तत्काल तंत्रिका प्रक्रियाओं पर केंद्रित है, जिससे यह विकल्प गलत हो जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Evolution and Behavior"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4557fe52da32add2b08e9","title":"Evolution and Behavior"},"t":{"id":"63a455bd5fcd1b1e5d1fa7be","title":"Brain, Behavior and Evolution"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":29.224766751484314,"attempts":{"correct":184,"incorrect":245,"partial":0,"skipped":750,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953748a25b7b429e6d8fb3":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Monoterpenes and Sesquiterpenes\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;b\u0026gt;\u0026lt;u\u0026gt;Explanation:\u0026lt;/u\u0026gt;\u0026lt;/b\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Terpenes are a large class of organic compounds produced by plants, particularly conifers, and some insects. They serve as the primary constituents of essential oils and are responsible for the aromatic properties of many herbs and spices.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Terpenes are classified based on the number of isoprene units they contain. Subclasses include monoterpenes, sesquiterpenes, diterpenes, triterpenes, and tetraterpenes.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The subclasses of terpenes that are generally volatile and stored in glandular hairs or secretory cavities of leaves and fruits are monoterpenes and sesquiterpenes.\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Monoterpenes:\u0026lt;/strong\u0026gt; These consist of two isoprene units (C\u0026lt;sub\u0026gt;10\u0026lt;/sub\u0026gt;H\u0026lt;sub\u0026gt;16\u0026lt;/sub\u0026gt;) and are highly volatile. They are commonly found in essential oils derived from plants and are known for their aromatic properties. Examples include limonene, pinene, and menthol.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Sesquiterpenes:\u0026lt;/strong\u0026gt; These consist of three isoprene units (C\u0026lt;sub\u0026gt;15\u0026lt;/sub\u0026gt;H\u0026lt;sub\u0026gt;24\u0026lt;/sub\u0026gt;). They are slightly less volatile than monoterpenes but still contribute significantly to the aroma and medicinal properties of plants. Examples include farnesol and humulene.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Both monoterpenes and sesquiterpenes are stored in specialized structures like glandular hairs or secretory cavities in plants. These structures help protect the plant from herbivores and pathogens and attract pollinators.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;They are widely studied for their applications in aromatherapy, medicine, and flavor industries due to their bioactive properties.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Other Options:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Triterpenes consist of six isoprene units (C\u0026lt;sub\u0026gt;30\u0026lt;/sub\u0026gt;H\u0026lt;sub\u0026gt;48\u0026lt;/sub\u0026gt;) and are larger, more complex molecules. They are typically involved in structural roles (e.g., sterols like cholesterol) and are not stored in glandular hairs or secretory cavities.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;​Tetraterpenes include compounds like carotenoids, which are pigments responsible for the color in fruits and vegetables, but they do not contribute to the aroma of plants.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;मोनोटर्पीन और सेस्क्विटर्पीन\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;b\u0026gt;\u0026lt;u\u0026gt;व्याख्या:\u0026lt;/u\u0026gt;\u0026lt;/b\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;टर्पीन कार्बनिक यौगिकों का एक बड़ा वर्ग है जो पौधों, विशेष रूप से कोनिफ़र, और कुछ कीड़ों द्वारा उत्पादित होता है। वे आवश्यक तेलों के प्राथमिक घटक के रूप में काम करते हैं और कई जड़ी-बूटियों और मसालों के सुगंधित गुणों के लिए उत्तरदायी होते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;टर्पीन को उनके द्वारा रखे गए आइसोप्रीन इकाइयों की संख्या के आधार पर वर्गीकृत किया जाता है। उपवर्गों में मोनोटर्पीन, सेस्क्विटर्पीन, डाइटर्पीन, ट्राइटर्पीन और टेट्रेटर्पीन शामिल हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;टर्पीन के उपवर्ग जो आमतौर पर वाष्पशील होते हैं और पत्तियों और फलों के ग्रंथिल रोम या स्रावी गुहाओं में संग्रहीत होते हैं, वे हैं मोनोटर्पीन और सेस्क्विटर्पीन।\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;मोनोटर्पीन:\u0026lt;/strong\u0026gt; इनमें दो आइसोप्रीन इकाइयाँ (C\u0026lt;sub\u0026gt;10\u0026lt;/sub\u0026gt;H\u0026lt;sub\u0026gt;16\u0026lt;/sub\u0026gt;) होती हैं और ये अत्यधिक वाष्पशील होती हैं। वे आमतौर पर पौधों से प्राप्त आवश्यक तेलों में पाए जाते हैं और अपने सुगंधित गुणों के लिए जाने जाते हैं। उदाहरणों में लिमोनीन, पाइनिन और मेन्थॉल शामिल हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;सेस्क्विटर्पीन:\u0026lt;/strong\u0026gt; इनमें तीन आइसोप्रीन इकाइयाँ (C\u0026lt;sub\u0026gt;15\u0026lt;/sub\u0026gt;H\u0026lt;sub\u0026gt;24\u0026lt;/sub\u0026gt;) होती हैं। वे मोनोटर्पीन की तुलना में थोड़े कम वाष्पशील होते हैं लेकिन फिर भी पौधों की सुगंध और औषधीय गुणों में महत्वपूर्ण योगदान देते हैं। उदाहरणों में फ़ार्नेसोल और ह्यूमुलिन शामिल हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;मोनोटर्पीन और सेस्क्विटर्पीन दोनों पौधों में विशेष संरचनाओं जैसे ग्रंथिल रोम या स्रावी गुहाओं में संग्रहीत होते हैं। ये संरचनाएँ पौधे को शाकाहारी और रोगजनकों से बचाने और परागणकों को आकर्षित करने में मदद करती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;उनके जैविक गुणों के कारण उनका एरोमाथेरेपी, चिकित्सा और स्वाद उद्योगों में व्यापक रूप से अध्ययन किया जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;ट्राइटर्पीन में छह आइसोप्रीन इकाइयाँ (C\u0026lt;sub\u0026gt;30\u0026lt;/sub\u0026gt;H\u0026lt;sub\u0026gt;48\u0026lt;/sub\u0026gt;) होती हैं और ये बड़े, अधिक जटिल अणु होते हैं। वे आमतौर पर संरचनात्मक भूमिकाओं (जैसे, कोलेस्ट्रॉल जैसे स्टेरॉल) में शामिल होते हैं और ग्रंथिल रोम या स्रावी गुहाओं में संग्रहीत नहीं होते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;टेट्रेटर्पीन में कैरोटीनॉइड जैसे यौगिक शामिल हैं, जो फलों और सब्जियों में रंग के लिए उत्तरदायी वर्णक हैं, लेकिन वे पौधों की सुगंध में योगदान नहीं करते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["System Physiology Plant"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4526f5db927c0ec7fb376","title":"System Physiology Plant"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":16.955894826123817,"attempts":{"correct":155,"incorrect":314,"partial":0,"skipped":710,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895375ac6cdfd92ecf78727":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:rgb(33, 37, 41);\u0026quot;\u0026gt;Neither ATP nor NADPH would be produced\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Photosynthesis is the process by which plants convert light energy into chemical energy stored in glucose. It consists of two main stages: the light reactions and the Calvin cycle.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The light reactions occur in the thylakoid membranes of the chloroplasts and are responsible for producing ATP and NADPH, which are used as energy carriers in the Calvin cycle.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Photosystem II (PSII) and Photosystem I (PSI) are two protein-pigment complexes involved in the light reactions. They are crucial for electron transport and the synthesis of ATP and NADPH.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;If a herbicide blocks electron transport in both PSII and PSI, it disrupts the entire flow of electrons, which is essential for producing ATP and NADPH.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In the light reactions, electrons are excited by sunlight and flow through the electron transport chain, starting with PSII and ending with PSI. This electron flow is coupled with the synthesis of ATP (via chemiosmosis) and NADPH.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;When a herbicide blocks electron transport in both PSII and PSI, the electron flow is halted. As a result:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;The proton gradient required for ATP synthesis cannot be generated, leading to no ATP production.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;NADP\u0026lt;sup\u0026gt;+\u0026lt;/sup\u0026gt; cannot accept electrons to form NADPH, so no NADPH is produced.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Since ATP and NADPH are both required for the Calvin cycle, the absence of these molecules would also indirectly disrupt the Calvin cycle.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Other Options:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Increased production of NADPH and ATP:\u0026lt;/strong\u0026gt; This is incorrect because blocking electron transport prevents the production of both ATP and NADPH. Increased production would require uninterrupted electron flow.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Only ATP would be produced but not NADPH:\u0026lt;/strong\u0026gt; This is incorrect because ATP production depends on the proton gradient, which is established through electron transport. If electron flow is blocked, ATP cannot be synthesized.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;The Calvin cycle would operate more efficiently:\u0026lt;/strong\u0026gt; This is incorrect because the Calvin cycle relies on ATP and NADPH as energy sources. If neither is produced, the Calvin cycle cannot proceed efficiently.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;न तो ATP और न ही NADPH का उत्पादन होगा\u0026amp;nbsp;\u0026lt;/span\u0026gt;है\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;प्रकाश संश्लेषण वह प्रक्रिया है जिसके द्वारा पौधे प्रकाश ऊर्जा को ग्लूकोज में संग्रहीत रासायनिक ऊर्जा में परिवर्तित करते हैं। इसमें दो मुख्य चरण होते हैं: प्रकाश अभिक्रियाएँ और कैल्विन चक्र।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;प्रकाश अभिक्रियाएँ क्लोरोप्लास्ट के थाइलेकोइड झिल्लियों में होती हैं और ATP और NADPH के उत्पादन के लिए उत्तरदायी होती हैं, जिनका उपयोग कैल्विन चक्र में ऊर्जा वाहक के रूप में किया जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;प्रकाश संश्लेषण तंत्र II (PSII) और प्रकाश संश्लेषण तंत्र I (PSI) प्रकाश अभिक्रियाओं में शामिल दो प्रोटीन-रंजक कॉम्प्लेक्स हैं। वे इलेक्ट्रॉन परिवहन और ATP और NADPH के संश्लेषण के लिए महत्वपूर्ण हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यदि कोई शाकनाशी PSII और PSI दोनों में इलेक्ट्रॉन परिवहन को अवरुद्ध करता है, तो यह इलेक्ट्रॉनों के संपूर्ण प्रवाह को बाधित करता है, जो ATP और NADPH के उत्पादन के लिए आवश्यक है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;प्रकाश अभिक्रियाओं में, इलेक्ट्रॉनों को सूर्य के प्रकाश द्वारा उत्तेजित किया जाता है और इलेक्ट्रॉन परिवहन शृंखला के माध्यम से प्रवाहित होता है, जो PSII से शुरू होकर PSI पर समाप्त होता है। यह इलेक्ट्रॉन प्रवाह ATP (रासायनिक परासरण द्वारा) और NADPH के संश्लेषण के साथ जुड़ा हुआ है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जब कोई शाकनाशी PSII और PSI दोनों में इलेक्ट्रॉन परिवहन को अवरुद्ध करता है, तो इलेक्ट्रॉन प्रवाह रुक जाता है। परिणामस्वरूप:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;ATP संश्लेषण के लिए आवश्यक प्रोटॉन प्रवणता उत्पन्न नहीं की जा सकती है, जिससे कोई ATP उत्पादन नहीं होता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;NADP\u0026lt;sup\u0026gt;+\u0026lt;/sup\u0026gt; NADPH बनाने के लिए इलेक्ट्रॉनों को स्वीकार नहीं कर सकता है, इसलिए कोई NADPH उत्पादित नहीं होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;चूँकि कैल्विन चक्र के लिए ATP और NADPH दोनों आवश्यक हैं, इसलिए इन अणुओं की अनुपस्थिति भी परोक्ष रूप से कैल्विन चक्र को बाधित करेगी।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;NADPH और ATP का उत्पादन बढ़ना:\u0026lt;/strong\u0026gt; यह गलत है क्योंकि इलेक्ट्रॉन परिवहन को अवरुद्ध करने से ATP और NADPH दोनों का उत्पादन रुक जाता है। उत्पादन में वृद्धि के लिए निर्बाध इलेक्ट्रॉन प्रवाह की आवश्यकता होगी।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;केवल ATP का उत्पादन होगा लेकिन NADPH नहीं:\u0026lt;/strong\u0026gt; यह गलत है क्योंकि ATP उत्पादन प्रोटॉन प्रवणता पर निर्भर करता है, जो इलेक्ट्रॉन परिवहन के माध्यम से स्थापित होता है। यदि इलेक्ट्रॉन प्रवाह अवरुद्ध है, तो ATP का संश्लेषण नहीं हो सकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कैल्विन चक्र अधिक कुशलता से संचालित होगा:\u0026amp;nbsp;\u0026lt;/strong\u0026gt;यह गलत है क्योंकि केल्विन चक्र ऊर्जा स्रोतों के रूप में ATP और NADPH पर निर्भर करता है। यदि इनमें से कोई भी उत्पन्न नहीं होता है, तो केल्विन चक्र कुशलता से आगे नहीं बढ़ सकता।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["System Physiology Plant"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4526f5db927c0ec7fb376","title":"System Physiology Plant"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":21.44698897370654,"attempts":{"correct":349,"incorrect":266,"partial":0,"skipped":564,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895376b4bf9040e58ef73c2":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;Mice containing Lox P sites on both 5\u0026amp;#39; and 3\u0026amp;#39; ends of the gene were mated with mice that are transgenic for Cre recombinase under control of an inducible promoter.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The Cre-lox system is a widely used genetic tool for site-specific recombination in organisms. It allows for precise deletion, insertion, or modification of genes in a tissue-specific or inducible manner.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The system involves two key components:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Cre recombinase:\u0026lt;/strong\u0026gt; An enzyme derived from bacteriophage P1 that recognizes specific DNA sequences known as LoxP sites.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;LoxP sites:\u0026lt;/strong\u0026gt; Specific 34-base pair DNA sequences that act as recombination sites. The orientation and location of these sites determine the genetic modification (deletion, inversion, or translocation).\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;By placing LoxP sites around a gene of interest and expressing Cre recombinase under a specific promoter, the gene can be conditionally deleted in a specific cell type or under certain conditions.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Mice containing LoxP sites on both 5\u0026amp;#39; and 3\u0026amp;#39; ends of the gene were mated with mice that are transgenic for Cre recombinase under control of an inducible promoter.\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;To delete a gene specifically in T cells, LoxP sites must flank the target gene at both its 5\u0026amp;#39; and 3\u0026amp;#39; ends. This ensures that the entire gene can be excised when recombination occurs.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Mice with the floxed gene (gene flanked by LoxP sites) are crossed with another mouse line expressing Cre recombinase under a T cell-specific promoter, such as the CD4 or Lck promoter.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;The Cre recombinase is expressed only in T cells, leading to gene deletion specifically in those cells while leaving other cell types unaffected.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;The use of an inducible promoter allows further control over when the gene deletion occurs, adding temporal specificity.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Other Options:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;LoxP recombination sequences were introduced in tandem at the 5\u0026amp;#39; end of the gene.\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;This is incorrect because placing LoxP sites only at the 5\u0026amp;#39; end of the gene does not allow for recombination to excise the gene. Both 5\u0026amp;#39; and 3\u0026amp;#39; LoxP sites are necessary to flank the gene for successful deletion.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;LoxP recombination sequences were introduced at the 3\u0026amp;#39; end of the gene.\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;This is incorrect because LoxP sites at only one end of the gene cannot facilitate excision. Both ends must be flanked to enable proper recombination.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Mutant LoxP sites were introduced on either side of the gene and mice were infected with bacteriophage P1 to provide Cre recombinase.\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;This is incorrect because mutant LoxP sites would not allow proper recombination, and bacteriophage P1 infection is not used in vivo to deliver Cre recombinase. Instead, a Cre transgene under a tissue-specific promoter is used in genetically engineered mice.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर है-\u0026amp;nbsp;\u0026lt;strong\u0026gt;जीन के 5\u0026amp;#39; और 3\u0026amp;#39; दोनों सिरों पर Lox P स्थल वाले चूहे\u0026amp;nbsp;\u0026lt;/strong\u0026gt;\u0026lt;strong\u0026gt;को उन चूहों\u0026amp;nbsp;\u0026lt;/strong\u0026gt;\u0026lt;strong\u0026gt;के साथ जोड़ा गया था जो एक प्रेरक उन्नायक के नियंत्रण में Cre पुनर्संयोजक के लिए ट्रांसजेनिक हैं।\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Cre-lox सिस्टम जीवों में साइट-विशिष्ट पुनर्संयोजन के लिए व्यापक रूप से उपयोग किया जाने वाला आनुवंशिक उपकरण है। यह ऊतक-विशिष्ट या प्रेरक तरीके से जीन के सटीक विलोपन, सम्मिलन या संशोधन करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इस सिस्टम में दो प्रमुख घटक शामिल हैं:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Cre पुनर्संयोजक:\u0026lt;/strong\u0026gt; बैक्टीरियोफेज P1 से प्राप्त एक एंजाइम जो LoxP स्थलों के रूप में जाने वाले विशिष्ट DNA अनुक्रमों को पहचानता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;LoxP स्थल:\u0026lt;/strong\u0026gt; विशिष्ट 34-क्षार युग्म\u0026amp;nbsp;DNA अनुक्रम जो पुनर्संयोजन स्थलों के रूप में कार्य करते हैं। इन स्थलों का उन्मुखीकरण और स्थान आनुवंशिक संशोधन (विलोपन, व्युत्क्रमण या स्थानांतरण) को निर्धारित करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;रुचि के जीन के चारों ओर LoxP स्थल रखकर और एक विशिष्ट उन्नायक के तहत Cre पुनर्संयोजक को व्यक्त करके, जीन को एक विशिष्ट कोशिका प्रकार में या कुछ शर्तों के तहत सशर्त रूप से हटाया जा सकता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;जीन के 5\u0026amp;#39; और 3\u0026amp;#39; दोनों सिरों पर LoxP स्थल वाले चूहे को उन चूहों के साथ जोड़ा गया था जो एक प्रेरक उन्नायक के नियंत्रण में Cre पुनर्संयोजक के लिए ट्रांसजेनिक हैं।\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;T कोशिकाओं में विशेष रूप से किसी जीन को हटाने के लिए, LoxP स्थलों को इसके 5\u0026amp;#39; और 3\u0026amp;#39; दोनों सिरों पर लक्षित जीन को फ़्लैंक करना चाहिए। यह सुनिश्चित करता है कि पुनर्संयोजन होने पर पूरे जीन को बाहर निकाला जा सकता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;फ्लॉक्स्ड जीन (LoxP स्थलों द्वारा फ़्लैंक किया गया जीन) वाले चूहे को एक अन्य चूहे लाइन के साथ पार किया जाता है जो T कोशिका-विशिष्ट उन्नायक, जैसे CD4 या Lck उन्नायक के तहत Cre पुनर्संयोजक को व्यक्त करता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Cre पुनर्संयोजक केवल T कोशिकाओं में व्यक्त किया जाता है, जिससे उन कोशिकाओं में विशेष रूप से जीन विलोपन होता है जबकि अन्य कोशिका प्रकार अप्रभावित रहते हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;एक प्रेरक उन्नायक का उपयोग जीन विलोपन कब होता है, इस पर और नियंत्रण करने में सहायता करता\u0026amp;nbsp;है, जिससे लौकिक विशिष्टता जुड़ती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;जीन के 5\u0026amp;#39; सिरे पर LoxP पुनर्संयोजन अनुक्रमों को एक साथ प्रस्तुत किया गया था।\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह गलत है क्योंकि जीन के केवल 5\u0026amp;#39; सिरे पर LoxP स्थल रखने से जीन को बाहर निकालने के लिए पुनर्संयोजन की सहायता मिलती है। सफल विलोपन के लिए जीन को फ़्लैंक करने के लिए 5\u0026amp;#39; और 3\u0026amp;#39; दोनों LoxP स्थल आवश्यक हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जीन के 3\u0026amp;#39; सिरे पर LoxP पुनर्संयोजन अनुक्रमों को प्रस्तुत किया गया था।\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह गलत है क्योंकि जीन के केवल एक सिरे पर LoxP स्थल उचित पुनर्संयोजन की सुविधा नहीं प्रदान कर सकते हैं। उचित पुनर्संयोजन को सक्षम करने के लिए दोनों सिरों को फ़्लैंक किया जाना चाहिए।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जीन के दोनों ओर उत्परिवर्ती LoxP स्थलों को प्रस्तुत किया गया था और चूहे को Cre पुनर्संयोजक प्रदान करने के लिए बैक्टीरियोफेज P1 से संक्रमित किया गया था।\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह गलत है क्योंकि उत्परिवर्ती LoxP स्थल उचित पुनर्संयोजन की अनुमति नहीं देंगे, और Cre पुनर्संयोजक को वितरित करने के लिए इन विवो में बैक्टीरियोफेज P1 संक्रमण का उपयोग नहीं किया जाता है। इसके बजाय, आनुवंशिक रूप से इंजीनियर किए गए चूहों में एक ऊतक-विशिष्ट उन्नायक के तहत एक Cre ट्रांसजीन का उपयोग किया जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Fundamental Processes"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a451aec9ba648bc86fbf43","title":"Fundamental Processes"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":16.4817642069551,"attempts":{"correct":145,"incorrect":210,"partial":0,"skipped":824,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895377b8aebc97d87cfc635":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;em\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Xylella fastidiosa\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/em\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;b\u0026gt;\u0026lt;u\u0026gt;Explanation:\u0026lt;/u\u0026gt;\u0026lt;/b\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;em\u0026gt;\u0026lt;strong\u0026gt;Xylella fastidiosa\u0026lt;/strong\u0026gt;\u0026lt;/em\u0026gt; is a phytopathogenic bacterium known for its unique ability to infect plants and cause severe diseases in crops, trees, and ornamental plants. Unlike other bacteria, \u0026lt;em\u0026gt;Xylella fastidiosa \u0026lt;/em\u0026gt;is predominantly transmitted by insects, specifically sap-feeding insects such as sharpshooters and spittlebugs. These insects serve as vectors, spreading the bacterium from one plant to another.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The bacterium colonizes the xylem vessels of plants, leading to obstruction of water transport and causing symptoms like leaf scorch, stunted growth, and plant death. It is responsible for devastating diseases like Pierce\u0026amp;rsquo;s disease in grapes and olive quick decline syndrome in olive trees.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;It affects a wide range of plants, including grapevines, citrus plants, olive trees, almond trees, and ornamental plants.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The bacterium colonizes the xylem vessels of plants, disrupting water flow and causing symptoms like leaf scorch, wilting, and plant death.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Other Options:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;em\u0026gt;Xanthomonas oryzae\u0026lt;/em\u0026gt;:\u0026lt;/strong\u0026gt; This bacterium causes bacterial leaf blight in rice. It is primarily transmitted through infected seeds, water, and plant contact rather than insects.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;em\u0026gt;\u0026lt;strong\u0026gt;Ralstonia solanacearum:\u0026lt;/strong\u0026gt;\u0026lt;/em\u0026gt; This bacterium causes bacterial wilt in various plants. It is transmitted through contaminated soil, water, and plant material, not predominantly by insects.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;em\u0026gt;\u0026lt;strong\u0026gt;Pseudomonas syringae:\u0026lt;/strong\u0026gt;\u0026lt;/em\u0026gt; This bacterium causes diseases like bacterial speck and canker in plants. It spreads through water splashes, plant wounds, and infected seeds, not insect vectors.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;em\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;ज़ाइलेला फास्टिडिओसा\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/em\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;है।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;b\u0026gt;\u0026lt;u\u0026gt;व्याख्या:\u0026lt;/u\u0026gt;\u0026lt;/b\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;em\u0026gt;\u0026lt;strong\u0026gt;ज़ाइलेला फ़ास्टिडियोसा\u0026lt;/strong\u0026gt;\u0026lt;/em\u0026gt; एक पादप-रोगजनक जीवाणु है जो पौधों को संक्रमित करने और फसलों, पेड़ों और सजावटी पौधों में गंभीर रोग पैदा करने की अपनी अनोखी क्षमता के लिए जाना जाता है। अन्य जीवाणुओं के विपरीत, \u0026lt;em\u0026gt;ज़ाइलेला फ़ास्टिडियोसा\u0026lt;/em\u0026gt; मुख्य रूप से कीड़ों द्वारा फैलता है, विशेष रूप से शार्पशूटर और स्पिटलबग जैसे रस-भक्षी कीटों द्वारा। ये कीट वाहक के रूप में कार्य करते हैं और जीवाणु को एक पौधे से दूसरे पौधे में फैलाते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह जीवाणु पौधों की जाइलम वाहिकाओं में बस जाता है, जिससे जल परिवहन बाधित होता है और पत्तियों का झुलसना, विकास अवरुद्ध होना और पौधों की मृत्यु जैसे लक्षण उत्पन्न होते हैं। यह अंगूरों में पियर्स रोग और जैतून के पेड़ों में जैतून के शीघ्र क्षय सिंड्रोम जैसी विनाशकारी बीमारियों के लिए उत्तरदायी है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह कई प्रकार के पौधों को प्रभावित करता है, जिनमें अंगूर, नींबू वर्गीय पौधे, जैतून के पेड़, बादाम के पेड़ और सजावटी पौधे शामिल हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह जीवाणु पौधों की जाइलम वाहिकाओं में बस जाता है, जिससे जल प्रवाह बाधित होता है तथा पत्तियों का झुलसना, मुरझाना और पौधों की मृत्यु जैसे लक्षण उत्पन्न होते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;em\u0026gt;ज़ैंथोमोनस ओराइज़ी\u0026lt;/em\u0026gt; :\u0026lt;/strong\u0026gt; यह जीवाणु चावल में बैक्टीरियल लीफ ब्लाइट रोग उत्पन्न करता है। यह मुख्यतः कीड़ों के बजाय संक्रमित बीजों, पानी और पौधों के संपर्क से फैलता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;em\u0026gt;\u0026lt;strong\u0026gt;राल्स्टोनिया सोलानेसीरम:\u0026lt;/strong\u0026gt;\u0026lt;/em\u0026gt; यह जीवाणु विभिन्न पौधों में जीवाणुजनित विल्ट उत्पन्न करता है। यह मुख्यतः कीड़ों द्वारा नहीं, बल्कि दूषित मिट्टी, पानी और पौधों की सामग्री के माध्यम से फैलता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;em\u0026gt;\u0026lt;strong\u0026gt;स्यूडोमोनास सिरिंजे:\u0026lt;/strong\u0026gt;\u0026lt;/em\u0026gt; यह जीवाणु पौधों में जीवाणु धब्बों और कैंकर जैसी बीमारियाँ पैदा करता है। यह पानी के छींटों, पौधों के घावों और संक्रमित बीजों से फैलता है, कीटों के वाहकों से नहीं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Diversity of Life Forms"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a45511ef5b5403de57d744","title":"Diversity of Life Forms"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":12.832909245122979,"attempts":{"correct":145,"incorrect":307,"partial":0,"skipped":727,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895378caf69335e709ffb85":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Vestigial expression is essential for wing development\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;In Drosophila, the development of specific body structures, such as wings, legs, and antennae, is tightly regulated by the expression of specific genes and proteins.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The Vestigial (Vg) protein is a key regulator in wing development. Its expression in certain imaginal discs, such as the wing disc, specifies those tissues to develop into wings.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Imaginal discs in Drosophila are groups of undifferentiated cells in the larval stage that give rise to adult structures during metamorphosis.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Ectopic expression of the Vestigial protein (i.e., expression in tissues where it is not normally expressed) can convert non-wing tissues such as eye, antennae, and leg discs into wing tissue, demonstrating its essential role in wing specification.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Other Options:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Cells in the eye, antennae, and leg discs are incompetent for wing tissue specification.\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;This is incorrect because ectopic expression of Vestigial in these tissues successfully converts them into wing-like structures. This demonstrates that these cells are competent for wing tissue specification when provided with the correct molecular signals.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Vestigial is downstream of the same Hox genes in all developing segments.\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;This is incorrect because Hox genes, which determine segmental identity, regulate different sets of target genes in different segments of the body. Vestigial is not universally downstream of the same Hox genes in all segments.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;For example, wing and leg discs are influenced by different combinations of Hox genes, and Vestigial\u0026amp;#39;s regulation is context-dependent.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Leg and wing discs originate from distinct embryonic precursors.\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;This is incorrect because both wing and leg imaginal discs originate from similar pools of embryonic precursor cells. The specific fate of these discs is determined later during development through segment-specific gene expression patterns.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर है-\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;पंख के विकास के लिए वेस्टीजियल अभिव्यक्ति आवश्यक है।\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;ड्रोसोफिला में, विशिष्ट शरीर संरचनाओं, जैसे पंख, पैर और ऐंटीना का विकास, विशिष्ट जीन और प्रोटीन की अभिव्यक्ति द्वारा कड़ाई से नियंत्रित होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;वेस्टीजियल (Vg) प्रोटीन पंख के विकास में एक प्रमुख नियामक है। पंख डिस्क जैसी कुछ इमेजिनल डिस्क में इसकी अभिव्यक्ति उन ऊतकों को पंखों में विकसित करने के लिए निर्दिष्ट करती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;ड्रोसोफिला में इमेजिनल डिस्क लार्वा अवस्था में अविकसित कोशिकाओं के समूह होते हैं जो कायांतरण के दौरान वयस्क संरचनाओं को जन्म देते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;वेस्टीजियल प्रोटीन की एक्टोपिक अभिव्यक्ति (अर्थात, उन ऊतकों में अभिव्यक्ति जहाँ यह सामान्य रूप से व्यक्त नहीं होता है) गैर-पंख ऊतकों जैसे आँख, ऐंटीना और पैर डिस्क को पंख जैसे ऊतक में बदल सकती है, जो पंख विशिष्टता में इसकी आवश्यक भूमिका को दर्शाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;आँख, ऐंटीना और पैर डिस्क की कोशिकाएँ पंख ऊतक विशिष्टता के लिए अक्षम हैं।\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह गलत है क्योंकि इन ऊतकों में वेस्टीजियल की एक्टोपिक अभिव्यक्ति उन्हें सफलतापूर्वक पंख जैसी संरचनाओं में बदल देती है। यह दर्शाता है कि सही आणविक संकेत दिए जाने पर ये कोशिकाएँ पंख ऊतक विशिष्टता के लिए सक्षम हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;वेस्टीजियल सभी विकासशील खंडों में समान होक्स जीन के डाउनस्ट्रीम में है।\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह गलत है क्योंकि होक्स जीन, जो खंडीय पहचान निर्धारित करते हैं, शरीर के विभिन्न खंडों में लक्ष्य जीन के विभिन्न सेटों को नियंत्रित करते हैं। वेस्टीजियल सभी खंडों में समान होक्स जीन के डाउनस्ट्रीम में सार्वभौमिक रूप से नहीं है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;उदाहरण के लिए, पंख और पैर की डिस्क हॉक्स जीन के विभिन्न संयोजनों से प्रभावित होती हैं, और वेस्टीजियल का विनियमन संदर्भ पर निर्भर होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;strong\u0026gt;पैर और पंख डिस्क अलग-अलग भ्रूणीय पूर्वगामीों से उत्पन्न होते हैं।\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह गलत है क्योंकि पंख और पैर दोनों इमेजिनल डिस्क भ्रूणीय पूर्वगामी कोशिकाओं के समान पूल से उत्पन्न होते हैं। इन डिस्क का विशिष्ट भाग्य बाद में विकास के दौरान खंड-विशिष्ट जीन अभिव्यक्ति पैटर्न के माध्यम से निर्धारित होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Developmental Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4523f152a060341b327ed","title":"Developmental Biology"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":24.86938083121288,"attempts":{"correct":128,"incorrect":316,"partial":0,"skipped":735,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895379e7ac09e469dee6fc6":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Presence of a cell wall made up of peptidoglycan\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Bacteria and archaea are two distinct domains of life that belong to the group of prokaryotes. Both lack a true nucleus and membrane-bound organelles, but they exhibit many differences in their cellular structure and biochemical properties.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Bacteria have a cell wall made of peptidoglycan, a polymer consisting of sugars and amino acids, which provides structural support and protection.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Peptidoglycan is unique to bacteria and is absent in archaea. This is a major biochemical distinction between the two domains.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Archaea have cell walls composed of other substances, such as pseudopeptidoglycan (pseudomurein) or proteins, which differ significantly in structure and composition from peptidoglycan.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Other Options:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Absence of a nuclear membrane:\u0026amp;nbsp;\u0026lt;/strong\u0026gt;Both bacteria and archaea lack a nuclear membrane, as they are prokaryotic organisms. This feature does not differentiate the two groups. Instead, their genetic material is present in the nucleoid region, which is not enclosed by a membrane.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Presence of a single circular chromosome:\u0026amp;nbsp;\u0026lt;/strong\u0026gt;Both bacteria and archaea typically have a single circular chromosome, although there are some exceptions. This characteristic is shared by both domains and hence cannot be used to differentiate them.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Presence of multi-cistronic operons:\u0026amp;nbsp;\u0026lt;/strong\u0026gt;Multi-cistronic operons, where a single mRNA encodes multiple proteins, are found in both bacteria and archaea.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;पेप्टिडोग्लाइकन से बनी कोशिका भित्ति की उपस्थिति\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;है।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;जीवाणु और आर्किया जीवन के दो अलग-अलग डोमेन हैं जो प्रोकैरियोट्स के समूह से संबंधित हैं। दोनों में एक वास्तविक केंद्रक और झिल्ली से बंधे अंग नहीं होते हैं, लेकिन वे अपनी कोशिकीय संरचना और जैव रासायनिक गुणों में कई अंतर प्रदर्शित करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जीवाणुओं में पेप्टिडोग्लाइकन से बनी कोशिका भित्ति होती है, जो शर्करा और एमिनो अम्ल से युक्त एक बहुलक है, जो संरचनात्मक सहारा और सुरक्षा प्रदान करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;पेप्टिडोग्लाइकन जीवाणुओं के लिए अद्वितीय है और आर्किया में अनुपस्थित है। यह दो डोमेन के बीच एक प्रमुख जैव रासायनिक अंतर है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;आर्किया में अन्य पदार्थों से बनी कोशिका भित्ति होती है, जैसे कि स्यूडोपेप्टिडोग्लाइकन (स्यूडोम्यूरिन) या प्रोटीन, जो संरचना और संघटक\u0026amp;nbsp;में पेप्टिडोग्लाइकन से काफी भिन्न होते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;केन्द्रक झिल्ली की अनुपस्थिति:\u0026lt;/strong\u0026gt; जीवाणु और आर्किया दोनों में केंद्रक झिल्ली का अभाव होता है, क्योंकि वे प्रोकैरियोटिक जीव हैं। यह विशेषता दोनों समूहों को अलग नहीं करती है। इसके बजाय, उनकी आनुवंशिक सामग्री न्यूक्लियॉइड क्षेत्र में मौजूद होती है, जो झिल्ली से घिरा नहीं होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;एकल वृत्ताकार गुणसूत्र की उपस्थिति:\u0026lt;/strong\u0026gt; जीवाणु और आर्किया दोनों में आमतौर पर एक ही वृत्ताकार गुणसूत्र होता है, हालाँकि कुछ अपवाद भी हैं। यह विशेषता दोनों डोमेन में समान होती है और इसलिए इसका उपयोग उन्हें अलग करने के लिए नहीं किया जा सकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;बहु-सिस्ट्रोनिक ओपेरॉन की उपस्थिति:\u0026lt;/strong\u0026gt; बहु-सिस्ट्रोनिक ओपेरॉन, जहाँ एक एकल mRNA कई प्रोटीन को एन्कोड करता है, जीवाणु और आर्किया दोनों में पाए जाते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Cellular Organization"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4518aa958c4957eed4157","title":"Cellular Organization"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":16.12553011026294,"attempts":{"correct":432,"incorrect":254,"partial":0,"skipped":493,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689537ecef177aa03fbae3b2":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is\u0026lt;strong\u0026gt;\u0026amp;nbsp;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;V\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative;  line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;A\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;/ V\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative;  line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;T\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Narrow sense heritability (h\u0026amp;sup2;):\u0026lt;/strong\u0026gt; It refers to the proportion of phenotypic variance in a population that is attributable to additive genetic variance (V\u0026lt;sub\u0026gt;A\u0026lt;/sub\u0026gt;), which can be directly passed from parents to offspring.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;It is a measure of how much genetic factors contribute to the variation in traits, excluding dominance variance (V\u0026lt;sub\u0026gt;D\u0026lt;/sub\u0026gt;), interaction variance (V\u0026lt;sub\u0026gt;I\u0026lt;/sub\u0026gt;), and other environmental factors.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The formula for narrow sense heritability is: \u0026lt;strong\u0026gt;h\u0026amp;sup2; = \u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;\u0026amp;nbsp;V\u0026lt;span style=\u0026quot;position: relative; line-height: 0; vertical-align: baseline; bottom: -0.25em; font-size:10.5px;\u0026quot;\u0026gt;A\u0026lt;/span\u0026gt;\u0026amp;nbsp;/ V\u0026lt;span style=\u0026quot;position: relative; line-height: 0; vertical-align: baseline; bottom: -0.25em; font-size:10.5px;\u0026quot;\u0026gt;T\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;, where V\u0026lt;sub\u0026gt;T \u0026lt;/sub\u0026gt;is the total phenotypic variance (sum of genetic and environmental variances).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;V\u0026lt;sub\u0026gt;A\u0026lt;/sub\u0026gt;, the additive genetic variance, is critical because it reflects the genetic contribution that is predictable and inheritable.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर\u0026lt;strong\u0026gt;\u0026amp;nbsp;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;V\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative;  line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;A\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt; / V\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative;  line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;T\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;है।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;संकीर्ण अर्थ में वंशागति (h\u0026amp;sup2;):\u0026lt;/strong\u0026gt; यह किसी समष्टि में लक्षण-प्ररूपी भिन्नता के उस भाग को संदर्भित करता है जो योगात्मक आनुवंशिक भिन्नता (V\u0026lt;sub\u0026gt;A\u0026lt;/sub\u0026gt;) के कारण होता है, जिसे सीधे माता-पिता से संतति में स्थानांतरित किया जा सकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह इस बात का माप है कि आनुवंशिक कारक लक्षणों में विचरण में कितना योगदान करते हैं, जिसमें प्रभाविता भिन्नता (V\u0026lt;sub\u0026gt;D\u0026lt;/sub\u0026gt;), अन्योन्यक्रिया भिन्नता (V\u0026lt;sub\u0026gt;I\u0026lt;/sub\u0026gt;), और अन्य पर्यावरणीय कारक शामिल नहीं हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;संकीर्ण अर्थ में वंशागति का सूत्र है: \u0026lt;strong\u0026gt;h\u0026amp;sup2; = \u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt; V\u0026lt;span style=\u0026quot;position: relative; line-height: 0; vertical-align: baseline; bottom: -0.25em; font-size:10.5px;\u0026quot;\u0026gt;A\u0026lt;/span\u0026gt; / V\u0026lt;span style=\u0026quot;position: relative; line-height: 0; vertical-align: baseline; bottom: -0.25em; font-size:10.5px;\u0026quot;\u0026gt;T\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;, जहाँ V\u0026lt;sub\u0026gt;T\u0026lt;/sub\u0026gt; कुल लक्षण-प्ररूपी भिन्नता (आनुवंशिक और पर्यावरणीय भिन्नता का योग) है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;V\u0026lt;sub\u0026gt;A\u0026lt;/sub\u0026gt;, योगात्मक आनुवंशिक भिन्नता, महत्वपूर्ण है क्योंकि यह उस आनुवंशिक योगदान को दर्शाता है जो पूर्वानुमेय और वंशानुगत है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Methods in Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4566d978874fc5c7a0d11","title":"Methods in Biology"},"t":{"id":"63a456cbd3b5fd9703bb87c8","title":"Biostatistical Methods"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":36.920271416454646,"attempts":{"correct":68,"incorrect":233,"partial":0,"skipped":878,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689538024bf9040e58ef7777":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:rgb(33, 37, 41);\u0026quot;\u0026gt;association with cyclin A\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Cdks (Cyclin-dependent kinases) are key regulators of the cell cycle in eukaryotic cells. These kinases are activated by forming complexes with specific cyclins, which are proteins that regulate their activity in a stage-specific manner.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Cdk2\u0026amp;nbsp;is a critical kinase involved in the regulation of the S phase of the cell cycle, where DNA replication occurs.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;For Cdk2 to be activated, it must associate with cyclin A or cyclin E, and this association induces conformational changes, leading to its activation.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Cyclin A binds to Cdk2, forming an active cyclin-Cdk2 complex that facilitates progression through the cell cycle.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This association is essential for the phosphorylation of target proteins that regulate DNA replication and other S-phase-specific events.\u0026amp;nbsp;\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage6717e120bc6dc9640c5d8aaf.png\u0026quot; style=\u0026quot;color: rgb(33, 37, 41); height: 300px; width: 450px;\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:rgb(33, 37, 41);\u0026quot;\u0026gt;साइक्लिन A के साथ सहयोग\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Cdks (साइक्लिन-निर्भर काइनेज) यूकेरियोटिक कोशिकाओं में कोशिका चक्र के प्रमुख नियामक हैं। ये काइनेज विशिष्ट साइक्लिन के साथ संकुल बनाकर सक्रिय होते हैं, जो प्रोटीन होते हैं जो उनकी गतिविधि को चरण-विशिष्ट तरीके से नियंत्रित करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Cdk2 एक महत्वपूर्ण काइनेज है जो कोशिका चक्र के S चरण के नियमन में शामिल है, जहाँ DNA प्रतिकृति होती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Cdk2 के सक्रिय होने के लिए, इसे साइक्लिन A या साइक्लिन E के साथ जुड़ना चाहिए, और यह जुड़ाव संरचनात्मक परिवर्तन को प्रेरित करता है, जिससे इसका सक्रियण होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;साइक्लिन A, Cdk2 से जुड़ता है, एक सक्रिय साइक्लिन-Cdk2 संकुल बनाता है जो कोशिका चक्र के माध्यम से प्रगति को सुगम बनाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह सहयोग लक्ष्य प्रोटीन के फॉस्फोराइलेशन के लिए आवश्यक है जो DNA प्रतिकृति और अन्य S-चरण-विशिष्ट घटनाओं को नियंत्रित करते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage6717e120bc6dc9640c5d8aaf.png\u0026quot; style=\u0026quot;color: rgb(33, 37, 41); height: 300px; width: 450px;\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Cellular Organization"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4518aa958c4957eed4157","title":"Cellular Organization"},"t":{"id":"63a451a2b69497f2c4437bfc","title":"Cell Division and Cell Cycle"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":14.653944020356231,"attempts":{"correct":338,"incorrect":246,"partial":0,"skipped":595,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689538127ac09e469dee7123":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Allelic\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;When two mutations are allelic, they occur in the same gene, and their combination in a diploid organism does not result in a functional wild-type phenotype.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;When two temperature-sensitive mutants of Escherichia coli were mated and the resulting exconjugants failed to show the wild-type phenotype, it indicates that the two mutations affect the same gene (i.e., they are allelic).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The lack of a wild-type phenotype in the exconjugants suggests that there is no complementation between the two mutations. Complementation occurs when two mutations are in different genes (non-allelic), resulting in a wild-type phenotype in the diploid organism.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Thus, the observation that no wild-type phenotype is restored means the mutations must be allelic (affecting the same gene).\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Other Options:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Non-allelic\u0026lt;/strong\u0026gt;\u0026amp;nbsp;If the mutations were non-allelic (in different genes), complementation could occur. This would result in the restoration of the wild-type phenotype in the exconjugants. However, the absence of a wild-type phenotype in the exconjugants indicates that the mutations are not in different genes and are therefore not non-allelic.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Recessive\u0026lt;/strong\u0026gt;\u0026amp;nbsp;While temperature-sensitive mutations are often recessive, this information does not directly explain the inability to restore the wild-type phenotype in the exconjugants.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;​\u0026lt;strong\u0026gt;Dominant-negative: \u0026lt;/strong\u0026gt;Dominant-negative mutations are a specific type of mutation where the mutant gene product interferes with the function of the wild-type gene product. In this case, there is no indication that the mutations are dominant-negative. The lack of a wild-type phenotype is explained by the allelic nature of the mutations, not by dominance relationships.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;विकल्पी\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;जब दो उत्परिवर्तन विकल्पी होते हैं, तो वे एक ही जीन में होते हैं, और द्विगुणित जीव में उनका संयोजन एक कार्यात्मक जंगली प्रकार के फेनोटाइप के परिणामस्वरूप नहीं होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जब एस्चेरिचिया कोलाई के दो तापमान-संवेदनशील उत्परिवर्ती को संयुग्मित किया गया और परिणामी पूर्वसंयुग्मी जंगली प्रकार का फेनोटाइप दिखाने में विफल रहे, तो यह इंगित करता है कि दो उत्परिवर्तन एक ही जीन को प्रभावित करते हैं (अर्थात, वे विकल्पी हैं)।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;पूर्वसंयुग्मी में जंगली प्रकार के फेनोटाइप की कमी से पता चलता है कि दो उत्परिवर्तनों के बीच कोई पूरकता नहीं है। पूरकता तब होती है जब दो उत्परिवर्तन विभिन्न जीनों (गैर-विकल्पी) में होते हैं, जिसके परिणामस्वरूप द्विगुणित जीव में जंगली प्रकार का फेनोटाइप होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इस प्रकार, यह अवलोकन कि जंगली प्रकार का फेनोटाइप बहाल नहीं है, इसका मतलब है कि उत्परिवर्तन विकल्पी होने चाहिए (एक ही जीन को प्रभावित करना)।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;गैर-विकल्पी\u0026lt;/strong\u0026gt; यदि उत्परिवर्तन गैर-विकल्पी (विभिन्न जीनों में) होते, तो पूरकता हो सकती है। इसके परिणामस्वरूप पूर्वसंयुग्मी में जंगली प्रकार के फेनोटाइप की बहाली होगी। हालांकि, पूर्वसंयुग्मी में जंगली प्रकार के फेनोटाइप की अनुपस्थिति इंगित करती है कि उत्परिवर्तन विभिन्न जीनों में नहीं हैं और इसलिए गैर-विकल्पी नहीं हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;अप्रभावी\u0026lt;/strong\u0026gt; जबकि तापमान-संवेदनशील उत्परिवर्तन अक्सर अप्रभावी होते हैं, यह जानकारी सीधे पूर्वसंयुग्मी में जंगली प्रकार के फेनोटाइप को बहाल करने में असमर्थता की व्याख्या नहीं करती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;​\u0026lt;strong\u0026gt;प्रभावी-ऋणात्मक:\u0026lt;/strong\u0026gt; प्रभावी-ऋणात्मक उत्परिवर्तन एक विशिष्ट प्रकार का उत्परिवर्तन है जहाँ उत्परिवर्ती जीन उत्पाद जंगली प्रकार के जीन उत्पाद के कार्य में हस्तक्षेप करता है। इस मामले में, कोई संकेत नहीं है कि उत्परिवर्तन प्रभावी-ऋणात्मक हैं। जंगली प्रकार के फेनोटाइप की कमी उत्परिवर्तन की विकल्पी प्रकृति से समझाई जाती है, न कि प्रभुत्व संबंधों से।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Inheritance Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a453102b304a00e31e93c8","title":"Inheritance Biology"},"t":{"id":"63a454cace3d67ae7cc71836","title":"Mutation"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":21.16709075487698,"attempts":{"correct":127,"incorrect":421,"partial":0,"skipped":631,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953823ef177aa03fbae42e":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;Survival\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Life history attributes refer to the biological characteristics and strategies of an organism that influence its survival, growth, reproduction, and overall fitness in a given environment.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;These attributes are shaped by evolutionary pressures and are adapted to specific environmental conditions.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The ability of an organism to survive often depends on its capacity to tolerate a wide range of environmental conditions such as temperature, humidity, nutrient availability, and predation pressures.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Survival:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Survival is the most fundamental life history attribute because an organism must stay alive to perform other functions such as growth, reproduction, and fecundity.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Organisms often evolve adaptations that allow them to tolerate a broad range of environmental conditions, ensuring survival in diverse or changing habitats.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;For example, some species of bacteria can survive in extreme environments such as hydrothermal vents, while certain plants can thrive in deserts or tundra regions.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Survival is often prioritized in extreme or fluctuating environments where resources may be scarce or conditions highly variable.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Other Options:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Growth:\u0026lt;/strong\u0026gt;\u0026amp;nbsp;Growth refers to the increase in size, mass, or complexity of an organism over time. While growth is crucial for reaching reproductive maturity, it is not as closely associated with environmental tolerance as survival.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Reproduction:\u0026lt;/strong\u0026gt;\u0026amp;nbsp;Reproduction involves the production of offspring to ensure the continuation of a species. Environmental conditions significantly influence reproduction, but organisms typically require stable or favorable conditions to reproduce successfully.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Fecundity:\u0026lt;/strong\u0026gt;\u0026amp;nbsp;Fecundity refers to the reproductive capacity of an organism, including the number of offspring it can produce over its lifetime.Fecundity is highly dependent on resource availability and environmental stability, making it less adaptable to a wide range of environmental conditions compared to survival\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;जीवित रहना\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;है।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;जीवन इतिहास गुण किसी जीव की जैविक विशेषताओं और रणनीतियों को संदर्भित करते हैं जो किसी दिए गए पर्यावरण में उसके जीवित रहने, वृद्धि, प्रजनन और समग्र फिटनेस को प्रभावित करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;ये गुण विकासवादी दबावों द्वारा आकार दिए जाते हैं और विशिष्ट पर्यावरणीय परिस्थितियों के अनुकूल होते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;किसी जीव के जीवित रहने की क्षमता अक्सर तापमान, आर्द्रता, पोषक तत्वों की उपलब्धता और परभक्षण दबाव जैसी विभिन्न पर्यावरणीय परिस्थितियों को सहन करने की उसकी क्षमता पर निर्भर करती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;जीवित रहना:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;जीवित रहना सबसे मौलिक जीवन इतिहास गुण है क्योंकि किसी जीव को विकास, प्रजनन और प्रजनन क्षमता जैसे अन्य कार्य करने के लिए जीवित रहना चाहिए।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जीव अक्सर ऐसे अनुकूलन विकसित करते हैं जो उन्हें विभिन्न पर्यावरणीय परिस्थितियों को सहन करने की अनुमति देते हैं, जिससे विविध या बदलते आवासों में जीवित रहना सुनिश्चित होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;उदाहरण के लिए, बैक्टीरिया की कुछ प्रजातियाँ चरम वातावरण जैसे हाइड्रोथर्मल वेंट में जीवित रह सकती हैं, जबकि कुछ पौधे रेगिस्तान या टुंड्रा क्षेत्रों में पनप सकते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जीवित रहने को अक्सर चरम या उतार-चढ़ाव वाले वातावरण में प्राथमिकता दी जाती है, जहां संसाधन दुर्लभ हो सकते हैं या परिस्थितियां अत्यधिक परिवर्तनशील हो सकती हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;वृद्धि\u0026lt;/strong\u0026gt;\u0026lt;strong\u0026gt;:\u0026lt;/strong\u0026gt; वृद्धि समय के साथ किसी जीव के आकार, द्रव्यमान या जटिलता में वृद्धि को संदर्भित करती है। जबकि प्रजनन परिपक्वता तक पहुँचने के लिए विकास महत्वपूर्ण है, यह जीवित रहने के रूप में पर्यावरणीय सहनशीलता से इतना निकटता से जुड़ा नहीं है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;प्रजनन:\u0026lt;/strong\u0026gt; प्रजनन में किसी प्रजाति की निरंतरता सुनिश्चित करने के लिए संतानों का उत्पादन शामिल है। पर्यावरणीय परिस्थितियाँ प्रजनन को महत्वपूर्ण रूप से प्रभावित करती हैं, लेकिन जीवों को आमतौर पर सफलतापूर्वक प्रजनन करने के लिए स्थिर या अनुकूल परिस्थितियों की आवश्यकता होती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;प्रजनन क्षमता:\u0026lt;/strong\u0026gt; प्रजनन क्षमता किसी जीव की प्रजनन क्षमता को संदर्भित करती है, जिसमें उसके जीवनकाल में उत्पन्न संतानों की संख्या शामिल है। प्रजनन क्षमता संसाधनों की उपलब्धता और पर्यावरणीय स्थिरता पर अत्यधिक निर्भर करती है, जिससे यह जीवित रहने की तुलना में पर्यावरणीय परिस्थितियों की एक विस्तृत शृंखला के लिए कम अनुकूलनीय हो जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Ecological Principles"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a45541e89684161ccd7911","title":"Ecological Principles"},"t":{"id":"63a4554f8f21ac91a2ebcf46","title":"Population Ecology"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":23.703986429177284,"attempts":{"correct":305,"incorrect":376,"partial":0,"skipped":498,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953834f922825acdf5f25f":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Sixteen\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;em\u0026gt;Drosophila melanogaster \u0026lt;/em\u0026gt;has 4 pairs of chromosomes, totaling 8 chromosomes in its cells. These include 3 pairs of autosomes and 1 pair of sex chromosomes.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In this species, recombination (the exchange of genetic material between homologous chromosomes during meiosis) does not occur in males. Therefore, the gametes produced by males are formed based solely on the independent assortment of chromosomes during meiosis.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;During meiosis, homologous chromosome pairs are separated and distributed randomly into gametes.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;For an organism with \u0026lt;em\u0026gt;n\u0026lt;/em\u0026gt; pairs of chromosomes, the number of possible combinations of chromosomes in gametes is given by the formula \u0026lt;strong\u0026gt;2\u0026lt;sup\u0026gt;n\u0026lt;/sup\u0026gt;\u0026lt;/strong\u0026gt;, where \u0026lt;em\u0026gt;n\u0026lt;/em\u0026gt; is the number of chromosome pairs.\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Since there are 4 pairs of chromosomes, the number of possible combinations of chromosomes in gametes is:\n\t\t\u0026lt;ul\u0026gt;\n\t\t\t\u0026lt;li\u0026gt;2\u0026lt;sup\u0026gt;4\u0026lt;/sup\u0026gt; = 16\u0026lt;/li\u0026gt;\n\t\t\u0026lt;/ul\u0026gt;\n\t\t\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;span id=\u0026quot;cke_bm_13466C\u0026quot; style=\u0026quot;display: none;\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt;Hence, the correct answer is \u0026lt;strong\u0026gt;Sixteen\u0026lt;/strong\u0026gt;.\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;सोलह\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;em\u0026gt;ड्रोसोफिला मेलेनोगैस्टर\u0026lt;/em\u0026gt; में गुणसूत्रों के 4 जोड़े होते हैं, जिसकी कोशिकाओं में कुल 8 गुणसूत्र होते हैं। इनमें ऑटोसोम के 3 जोड़े और लिंग गुणसूत्रों का 1 जोड़ा शामिल है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इस प्रजाति में, नर में पुनर्संयोजन (अर्धसूत्री विभाजन के दौरान समजातीय गुणसूत्रों के बीच आनुवंशिक पदार्थ का विनिमय) नहीं होता है। इसलिए, नर द्वारा निर्मित युग्मक केवल अर्धसूत्री विभाजन के दौरान गुणसूत्रों के स्वतंत्र वर्गीकरण के आधार पर बनते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;अर्धसूत्रीविभाजन के दौरान, समजात गुणसूत्र जोड़े अलग हो जाते हैं और युग्मकों में यादृच्छिक रूप से वितरित हो जाते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;em\u0026gt;n\u0026lt;/em\u0026gt; गुणसूत्र जोड़ों वाले जीव के लिए, युग्मकों में गुणसूत्रों के संभावित संयोजनों की संख्या सूत्र \u0026lt;strong\u0026gt;2\u0026lt;sup\u0026gt;n\u0026lt;/sup\u0026gt;\u0026lt;/strong\u0026gt; द्वारा दी जाती है, जहाँ \u0026lt;em\u0026gt;n\u0026lt;/em\u0026gt; गुणसूत्र जोड़ों की संख्या है।\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;चूँकि गुणसूत्रों के 4 जोड़े हैं, इसलिए युग्मकों में गुणसूत्रों के संभावित संयोजनों की संख्या है:\n\t\t\u0026lt;ul\u0026gt;\n\t\t\t\u0026lt;li\u0026gt;2\u0026lt;sup\u0026gt;4\u0026lt;/sup\u0026gt; = 16\u0026lt;/li\u0026gt;\n\t\t\u0026lt;/ul\u0026gt;\n\t\t\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;इसलिए, सही उत्तर \u0026lt;strong\u0026gt;सोलह\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Inheritance Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a453102b304a00e31e93c8","title":"Inheritance Biology"},"t":{"id":"63a453221af18910c978bf34","title":"Extensions of Mendelian principles"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":21.17217981340119,"attempts":{"correct":241,"incorrect":308,"partial":0,"skipped":630,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895384fa25b7b429e6d93ec":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;The correct answer is\u0026amp;nbsp;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Loss of function\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;u\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\n\t\u0026lt;li\u0026gt;Genes are composed of exons (coding regions) and introns (non-coding regions). Exons are expressed as proteins, while introns are spliced out during RNA processing.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Mutations in exons can impact the final protein product, depending on the type and location of the mutation.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;A mutation at the 6th nucleotide position in the exon changes the DNA sequence, which may lead to changes in the RNA transcript and, subsequently, the protein structure and function.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;u\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;The wildtype sequence is ATGTATCGA ... , and the mutant is ATGTAACGA ....\u0026lt;/p\u0026gt;\n\n\u0026lt;p style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;The mutation is\u0026amp;nbsp;T\u0026amp;nbsp;\u0026amp;rarr;\u0026amp;nbsp;\u0026amp;nbsp;A at the 6th position, changing the codon sequence.\u0026lt;/p\u0026gt;\n\n\u0026lt;p style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;Wildtype first codons:\u0026amp;nbsp;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;ATG | TAT | CGA\u0026lt;/span\u0026gt;\u0026amp;nbsp;\u0026amp;nbsp;\u0026amp;rarr;\u0026amp;nbsp;AUG (Met) | UAU (Tyr) | CGA (Arg)\u0026lt;/p\u0026gt;\n\n\u0026lt;p style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;Mutant first\u0026amp;nbsp;codons:\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;\u0026amp;nbsp;ATG | TAA | CGA\u0026lt;/span\u0026gt;\u0026amp;nbsp;\u0026amp;nbsp;\u0026amp;rarr;\u0026amp;nbsp;AUG (Met) | UAA (Stop) | CGA (Arg)\u0026lt;/p\u0026gt;\n\n\u0026lt;p style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;The mutation introduces a premature stop codon (UAA) in place of Tyr which\u0026amp;nbsp;results in early termination\u0026amp;nbsp;of translation, producing a truncated, likely non-functional protein.\u0026lt;/p\u0026gt;\n\n\u0026lt;ul style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\n\t\u0026lt;li\u0026gt;Such a mutation can disrupt the normal structure and function of the protein, rendering it non-functional. This is categorized as a \u0026amp;quot;loss of function\u0026amp;quot; mutation.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Loss-of-function mutations are often harmful because the protein fails to perform its normal role in the cell, which can lead to various consequences, such as diseases or developmental defects.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;u\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Other Options:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Gain of function:\u0026lt;/span\u0026gt;\u0026amp;nbsp;This refers to mutations that result in a protein gaining a new or enhanced function.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;No change:\u0026lt;/span\u0026gt;\u0026amp;nbsp;A mutation resulting in \u0026amp;quot;no change\u0026amp;quot; occurs when the altered nucleotide does not affect the amino acid sequence (silent mutation).\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;सही उत्तर\u0026amp;nbsp;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;कार्य की हानि\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;है।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;u\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;स्पष्टीकरण:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\n\t\u0026lt;li\u0026gt;जीन एक्सॉन (कोडिंग क्षेत्र) और इंट्रॉन (गैर-कोडिंग क्षेत्र) से बने होते हैं। एक्सॉन प्रोटीन के रूप में व्यक्त होते हैं, जबकि इंट्रॉन RNA प्रसंस्करण के दौरान विभाजित हो जाते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;एक्सॉन में उत्परिवर्तन, उत्परिवर्तन के प्रकार और स्थान के आधार पर, अंतिम प्रोटीन उत्पाद को प्रभावित कर सकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;एक्सॉन में 6वें न्यूक्लियोटाइड स्थान पर उत्परिवर्तन से डीएनए अनुक्रम में परिवर्तन होता है, जिसके परिणामस्वरूप RNA अनुलेख में परिवर्तन हो सकता है, तथा तत्पश्चात प्रोटीन संरचना और कार्य में भी परिवर्तन हो सकता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;u\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;स्पष्टीकरण:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;वाइल्डटाइप अनुक्रम ATGTATCGA है ..., और उत्परिवर्ती ATGTAACGA है ....\u0026lt;/p\u0026gt;\n\n\u0026lt;p style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;उत्परिवर्तन 6वें स्थान पर T \u0026amp;rarr; A है, जो कोडॉन अनुक्रम को बदल देता है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;वाइल्डटाइप प्रथम कोडॉन: \u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;ATG | TAT | CGA\u0026lt;/span\u0026gt; \u0026amp;rarr; AUG (Met) | UAU (Tyr) | CGA (Arg)\u0026lt;/p\u0026gt;\n\n\u0026lt;p style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;उत्परिवर्ती प्रथम कोडॉन: \u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;ATG | TAA | CGA\u0026lt;/span\u0026gt; \u0026amp;rarr; AUG (Met) | UAA (Stop) | CGA (Arg)\u0026lt;/p\u0026gt;\n\n\u0026lt;p style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;उत्परिवर्तन, Tyr के स्थान पर एक समयपूर्व स्टॉप कोडॉन (UAA) प्रस्तुत करता है, जिसके परिणामस्वरूप स्थानांतरण का समय से पहले ही समापन हो जाता है, तथा एक छोटा, संभवतः गैर-क्रियात्मक प्रोटीन उत्पन्न होता है।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\n\t\u0026lt;li\u0026gt;ऐसा उत्परिवर्तन प्रोटीन की सामान्य संरचना और कार्य को बाधित कर सकता है, जिससे यह निष्क्रिय हो जाता है। इसे \u0026amp;quot;कार्यक्षति\u0026amp;quot; उत्परिवर्तन के रूप में वर्गीकृत किया जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;कार्य-क्षति उत्परिवर्तन प्रायः हानिकारक होते हैं, क्योंकि प्रोटीन कोशिका में अपनी सामान्य भूमिका निभाने में असफल हो जाता है, जिसके परिणामस्वरूप विभिन्न परिणाम उत्पन्न हो सकते हैं, जैसे रोग या विकासात्मक दोष।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;u\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;अन्य विकल्प:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;कार्य में वृद्धि:\u0026lt;/span\u0026gt; यह उन उत्परिवर्तनों को संदर्भित करता है जिसके परिणामस्वरूप प्रोटीन को एक नया या उन्नत कार्य प्राप्त होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;कोई परिवर्तन नहीं:\u0026lt;/span\u0026gt; \u0026amp;quot;कोई परिवर्तन नहीं\u0026amp;quot; वाला उत्परिवर्तन तब होता है जब परिवर्तित न्यूक्लियोटाइड अमीनो अम्ल अनुक्रम को प्रभावित नहीं करता (मौन उत्परिवर्तन)।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Inheritance Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a453102b304a00e31e93c8","title":"Inheritance Biology"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":27.731128074639507,"attempts":{"correct":121,"incorrect":382,"partial":0,"skipped":676,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895385b7625035107692b64":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Creatine kinase\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;b\u0026gt;\u0026lt;u\u0026gt;Explanation:\u0026lt;/u\u0026gt;\u0026lt;/b\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Creatine kinase is an enzyme found in the heart, brain, skeletal muscles, and other tissues. It plays a vital role in the production of energy in cells. When there is damage to muscle tissue, including the heart muscle, CK is released into the bloodstream. Elevated levels of CK in the blood can indicate cardiac muscle injury, making it a crucial marker for diagnosing heart conditions such as myocardial infarction (heart attack).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Specifically, a subtype of CK, called CK-MB (Creatine kinase-MB), is more specific to the heart and is often measured to assess cardiac damage.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;CK levels begin to rise within 4\u0026amp;ndash;6 hours of cardiac injury, peak at around 24 hours, and return to normal within 2\u0026amp;ndash;3 days, making it an important tool for early diagnosis and monitoring of cardiac events.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Other Options:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Creatine:\u0026lt;/strong\u0026gt; Creatine is a compound that is naturally present in muscle cells. It helps produce energy during high-intensity activities.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Peroxidase:\u0026lt;/strong\u0026gt; Peroxidase is an enzyme that catalyzes the oxidation of specific substances in the presence of hydrogen peroxide. While it plays a role in various biological processes and is used in some laboratory tests, it is not relevant for detecting cardiac damage.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Urea:\u0026lt;/strong\u0026gt; Urea is a waste product formed in the liver and excreted by the kidneys. Blood urea levels are typically measured to assess kidney function rather than heart health. Elevated urea levels may indicate kidney dysfunction or dehydration, but they are not directly linked to cardiac damage.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;क्रिएटिन काइनेज\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;b\u0026gt;\u0026lt;u\u0026gt;व्याख्या:\u0026lt;/u\u0026gt;\u0026lt;/b\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;क्रिएटिन काइनेज एक एंजाइम है जो हृदय, मस्तिष्क, कंकाल की पेशियों और अन्य ऊतकों में पाया जाता है। यह कोशिकाओं में ऊर्जा के उत्पादन में महत्वपूर्ण भूमिका निभाता है। जब हृदय की पेशियों सहित पेशियों के ऊतकों को क्षति होती है, तो CK रक्त में मुक्त हो जाता है। रक्त में CK के उच्च स्तर हृदय की पेशियों की चोट का संकेत दे सकते हैं, जिससे यह मायोकार्डियल इंफार्क्शन (हृदयघात) जैसी हृदय स्थितियों के निदान के लिए एक महत्वपूर्ण चिन्हक बन जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;विशेष रूप से, CK का एक उपप्रकार, जिसे CK-MB (क्रिएटिन काइनेज-MB) कहा जाता है, हृदय के लिए अधिक विशिष्ट है और अक्सर हृदय की क्षति का आकलन करने के लिए मापा जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;हृदय की चोट के 4-6 घंटों के भीतर CK का स्तर बढ़ना शुरू हो जाता है, लगभग 24 घंटों में चरम पर पहुँच जाता है, और 2-3 दिनों के भीतर सामान्य हो जाता है, जिससे यह हृदय संबंधी घटनाओं के शीघ्र निदान और निगरानी के लिए एक महत्वपूर्ण उपकरण बन जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;क्रिएटिन:\u0026lt;/strong\u0026gt; क्रिएटिन एक यौगिक है जो स्वाभाविक रूप से पेशी कोशिकाओं में मौजूद होता है। यह उच्च तीव्रता वाली गतिविधियों के दौरान ऊर्जा उत्पन्न करने में मदद करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;पेरोक्साइडेज:\u0026lt;/strong\u0026gt; पेरोक्साइडेज एक एंजाइम है जो हाइड्रोजन पेरोक्साइड की उपस्थिति में विशिष्ट पदार्थों के ऑक्सीकरण को उत्प्रेरित करता है। जबकि यह विभिन्न जैविक प्रक्रियाओं में भूमिका निभाता है और कुछ प्रयोगशाला परीक्षणों में उपयोग किया जाता है, यह हृदय की क्षति का पता लगाने के लिए प्रासंगिक नहीं है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;यूरिया:\u0026lt;/strong\u0026gt; यूरिया यकृत में बनने वाला और वृक्क द्वारा उत्सर्जित होने वाला एक अपशिष्ट उत्पाद है। रक्त यूरिया के स्तर को आमतौर पर वृक्क के कार्य का आकलन करने के बजाय हृदय के स्वास्थ्य का आकलन करने के लिए मापा जाता है। यूरिया के उच्च\u0026amp;nbsp;स्तर वृक्क की शिथिलता या निर्जलीकरण का संकेत दे सकते हैं, लेकिन वे सीधे हृदय की क्षति से जुड़े नहीं हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Applied Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a455cbce3d67ae7cc72e05","title":"Applied Biology"},"t":{"id":"63a456647bcd5bdb5cf4d662","title":"Biosensors"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":16.180661577608152,"attempts":{"correct":332,"incorrect":290,"partial":0,"skipped":557,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895386e8aebc97d87cfcb0b":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Biogenic laminated structures that have been influenced by phototrophic microbial mats\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Stromatolites are layered sedimentary formations created by the activity of microbial communities, primarily phototrophic microorganisms such as cyanobacteria. These are among the earliest forms of evidence for life on Earth, dating back to nearly 3.5 billion years ago.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The unique biogenic features of stromatolites, such as their laminated structures, are a result of microbial mats trapping, binding, and precipitating minerals over time.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Microbial mats, primarily composed of cyanobacteria, trap and bind sediment particles, while also precipitating minerals. Over time, this repetitive process forms the characteristic laminated structures of stromatolites.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;These structures are significant as they are direct evidence of ancient microbial activity and provide clues about early Earth\u0026amp;#39;s biosphere and its interaction with the environment.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The phototrophic nature of the microorganisms involved indicates their role in oxygenic photosynthesis, which played a critical part in the oxygenation of Earth\u0026amp;#39;s atmosphere.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर है-\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;जैविक स्तरित संरचनाएँ जो प्रकाशसंश्लेषी सूक्ष्मजीवी मैट से प्रभावित हुई हैं\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;स्ट्रोमेटोलाइट्स सूक्ष्मजीव समुदायों, मुख्य रूप से प्रकाशसंश्लेषी सूक्ष्मजीवों जैसे साइनोबैक्टीरिया की गतिविधि द्वारा बनाई गई स्तरित अवसादी संरचनाएँ हैं। ये पृथ्वी पर जीवन के सबसे शुरुआती प्रमाणों में से हैं, जो लगभग 3.5 अरब साल पहले के हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;स्ट्रोमेटोलाइट्स की अनूठी जैविक विशेषताएँ, जैसे कि उनकी स्तरित संरचनाएँ, समय के साथ सूक्ष्मजीवी मैट के फँसाने, बंधन और खनिजों को अवक्षेपित करने का परिणाम हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;सूक्ष्मजीवी मैट, जो मुख्यतः सायनोबैक्टीरिया से बने होते हैं, तलछट कणों को फँसाते और बाँधते हैं, साथ ही खनिजों का अवक्षेपण भी करते हैं। समय के साथ, यह दोहरावदार प्रक्रिया स्ट्रोमेटोलाइट्स की विशिष्ट परतदार संरचनाएँ बनाती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;ये संरचनाएँ महत्वपूर्ण हैं क्योंकि वे प्राचीन सूक्ष्मजीव गतिविधि के प्रत्यक्ष प्रमाण हैं और प्रारंभिक पृथ्वी के जीवमंडल और पर्यावरण के साथ इसके संपर्क के बारे में सुराग प्रदान करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;शामिल सूक्ष्मजीवों की प्रकाशसंश्लेषी प्रकृति ऑक्सीजनिक प्रकाश संश्लेषण में उनकी भूमिका को इंगित करती है, जिसने पृथ्वी के वायुमंडल के ऑक्सीकरण में महत्वपूर्ण भूमिका निभाई।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Evolution and Behavior"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4557fe52da32add2b08e9","title":"Evolution and Behavior"},"t":{"id":"63a455a5ebdb38d1b04c0d7c","title":"Evolutionary History"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":18.080576759966075,"attempts":{"correct":157,"incorrect":257,"partial":0,"skipped":765,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895387f9eb05a9f9ac78262":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Activation of telomerase\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Aging in humans is a complex biological process influenced by genetic, environmental, and lifestyle factors. Several mechanisms, such as oxidative stress, DNA damage, telomere shortening, and inflammation, contribute to the aging process.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Telomerase is an enzyme responsible for maintaining the length of telomeres, which are protective caps at the ends of chromosomes. Telomeres naturally shorten as cells divide, which eventually leads to cellular aging and senescence.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Telomerase helps prevent telomere shortening during cell division, effectively delaying cellular aging. While uncontrolled activation of telomerase can lead to cancer, its role in maintaining telomere length is associated with promoting longevity and slowing the aging process. This is why activation of telomerase does NOT promote aging in humans.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Other Options\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Increased oxidative stress:\u0026lt;/strong\u0026gt; Oxidative stress occurs when there is an imbalance between free radicals and antioxidants in the body. Excessive oxidative stress damages cellular components, including DNA, proteins, and lipids, accelerating the aging process.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Defects in DNA repair enzymes:\u0026lt;/strong\u0026gt; DNA repair mechanisms are crucial for correcting damage caused by environmental factors and normal cellular processes. Defective DNA repair enzymes lead to the accumulation of mutations, genomic instability, and accelerated aging.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Reduced biosynthesis of leukotrienes:\u0026lt;/strong\u0026gt; Leukotrienes are lipid molecules involved in inflammation. Reduced biosynthesis of leukotrienes might impair immune responses and exacerbate aging-related diseases indirectly.\u0026amp;nbsp;\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;टेलोमेरेज़ का सक्रियण\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;है।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;मानवों में उम्र बढ़ना एक जटिल जैविक प्रक्रिया है जो आनुवंशिक, पर्यावरणीय और जीवनशैली कारकों से प्रभावित होती है। कई तंत्र, जैसे ऑक्सीडेटिव तनाव, DNA क्षति, टेलोमेयर छोटा होना और सूजन, उम्र बढ़ने की प्रक्रिया में योगदान करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;टेलोमेरेज़ एक एंजाइम है जो टेलोमेयर की लंबाई को बनाए रखने के लिए जिम्मेदार है, जो गुणसूत्रों के सिरों पर सुरक्षात्मक कैप होते हैं। कोशिकाओं के विभाजित होने पर टेलोमेयर स्वाभाविक रूप से छोटे होते जाते हैं, जिससे अंततः कोशिकीय उम्र बढ़ना और बुढ़ापा होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;टेलोमेरेज़ कोशिका विभाजन के दौरान टेलोमेयर के छोटे होने को रोकने में मदद करता है, जिससे कोशिकीय उम्र बढ़ने में देरी होती है। जबकि टेलोमेरेज़ का अनियंत्रित सक्रियण कैंसर का कारण बन सकता है, टेलोमेयर की लंबाई को बनाए रखने में इसकी भूमिका दीर्घायु को बढ़ावा देने और उम्र बढ़ने की प्रक्रिया को धीमा करने से जुड़ी है। यही कारण है कि टेलोमेरेज़ का सक्रियण मानवों में उम्र बढ़ने को बढ़ावा नहीं देता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;ऑक्सीडेटिव तनाव में वृद्धि:\u0026lt;/strong\u0026gt; ऑक्सीडेटिव तनाव तब होता है जब शरीर में मुक्त कणों और एंटीऑक्सीडेंट के बीच असंतुलन होता है। अत्यधिक ऑक्सीडेटिव तनाव DNA, प्रोटीन और लिपिड सहित कोशिकीय घटकों को नुकसान पहुंचाता है, जिससे उम्र बढ़ने की प्रक्रिया तेज होती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;DNA मरम्मत एंजाइमों में दोष:\u0026lt;/strong\u0026gt; पर्यावरणीय कारकों और सामान्य कोशिकीय प्रक्रियाओं के कारण होने वाले नुकसान को ठीक करने के लिए DNA मरम्मत तंत्र महत्वपूर्ण हैं। दोषपूर्ण DNA मरम्मत एंजाइम उत्परिवर्तन, जीनोमिक अस्थिरता और त्वरित उम्र बढ़ने के संचय को जन्म देते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;ल्यूकोट्रिएन के कम जैव संश्लेषण:\u0026lt;/strong\u0026gt; ल्यूकोट्रिएन सूजन में शामिल लिपिड अणु हैं। ल्यूकोट्रिएन के कम जैव संश्लेषण से प्रतिरक्षा प्रतिक्रियाएं बाधित हो सकती हैं और अप्रत्यक्ष रूप से उम्र बढ़ने से संबंधित बीमारियों को बढ़ा सकती हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Fundamental Processes"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a451aec9ba648bc86fbf43","title":"Fundamental Processes"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":16.901611535199358,"attempts":{"correct":315,"incorrect":370,"partial":0,"skipped":494,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689538a0cc49566a430d8309":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;The pKa decreases because the hydrogen bonding with histidine stabilizes serine side chain\u0026amp;#39;s deprotonated state.\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;In enzymes like trypsin, the catalytic triad comprises three amino acid residues: serine, histidine, and aspartate. These residues work together to enhance the enzyme\u0026amp;#39;s catalytic efficiency in breaking peptide bonds.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Serine plays a critical role in nucleophilic attack, while histidine and aspartate work to stabilize the transition state and facilitate proton transfers.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Hydrogen bonding between the serine hydroxyl group (-OH) and the histidine imidazole side chain is a crucial interaction that affects the pKa of serine, making it more reactive during catalysis.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage68a4361dcb822e4cf7b33e4b.png\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;em\u0026gt;Fig:\u0026amp;nbsp;Schematic representation of the charge relay in Ser‐His‐Asp catalytic triad in trypsin and related serine proteases. (\u0026lt;a href=\u0026quot;https://www.researchgate.net/figure/Schematic-representation-of-the-charge-relay-in-Ser-His-Asp-catalytic-triad-in-trypsin_fig1_379510987\u0026quot;\u0026gt;Source\u0026lt;/a\u0026gt;)\u0026lt;/em\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;pKa is a measure of the tendency of a functional group to lose a proton (H+). A decrease in pKa means the group is more likely to lose a proton, becoming deprotonated.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In the catalytic triad, hydrogen bonding between serine and histidine stabilizes the deprotonated state of serine.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This stabilization lowers the energy of the deprotonated form, effectively decreasing the pKa of serine. As a result, serine\u0026amp;#39;s hydroxyl (-OH) group can lose its proton more easily, making it a stronger nucleophile.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The lowered pKa of serine ensures that it can act as a nucleophile during the enzymatic cleavage of peptide bonds.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Histidine acts as a base, accepting the proton from serine and facilitating its deprotonation, while aspartate helps stabilize histidine\u0026amp;#39;s positive charge during this process.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर है-\u0026amp;nbsp;\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;pKa घटता है क्योंकि हिस्टिडीन के साथ हाइड्रोजन बंधन सेरीन पार्श्व शृंखला की विप्रोटॉनित अवस्था को स्थिर करता है।\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;संप्रत्यय:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;ट्रिप्सिन जैसे एंजाइमों में, उत्प्रेरकीय त्रिक में तीन अमीनो अम्ल अवशेष होते हैं: सेरीन, हिस्टिडीन और एस्पार्टेट। ये अवशेष पेप्टाइड बंधों को तोड़ने में एंजाइम की उत्प्रेरकीय दक्षता को बढ़ाने के लिए एक साथ काम करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;सेरीन नाभिकरागी आक्रमण में एक महत्वपूर्ण भूमिका निभाता है, जबकि हिस्टिडीन और एस्पार्टेट संक्रमण अवस्था को स्थिर करने और प्रोटॉन स्थानान्तरण की सुविधा प्रदान करने का काम करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;सेरीन हाइड्रॉक्सिल समूह (-OH) और हिस्टिडीन इमिडाज़ोल पार्श्व शृंखला के बीच हाइड्रोजन बंधन एक महत्वपूर्ण अंतःक्रिया है जो सेरीन के pKa को प्रभावित करता है, जिससे यह उत्प्रेरण के दौरान अधिक अभिक्रियाशील हो जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage68a4361dcb822e4cf7b33e4b.png\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;em\u0026gt;चित्र: ट्रिप्सिन और संबंधित सेरीन प्रोटीएज में Ser-His-Asp उत्प्रेरकीय त्रिक में आवेश रिले का योजनाबद्ध निरूपण। (\u0026lt;a href=\u0026quot;https://www.researchgate.net/figure/Schematic-representation-of-the-charge-relay-in-Ser-His-Asp-catalytic-triad-in-trypsin_fig1_379510987\u0026quot;\u0026gt;स्रोत\u0026lt;/a\u0026gt;)\u0026lt;/em\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;pKa एक कार्यात्मक समूह की प्रोटॉन (H+) को खोने की प्रवृत्ति का माप है। pKa में कमी का मतलब है कि समूह प्रोटॉन खोने की अधिक संभावना है, जो विप्रोटॉनित हो जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;उत्प्रेरकीय त्रिक में, सेरीन और हिस्टिडीन के बीच हाइड्रोजन बंधन सेरीन की विप्रोटॉनित अवस्था को स्थिर करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह स्थिरीकरण विप्रोटॉनित रूप की ऊर्जा को कम करता है, प्रभावी रूप से सेरीन के pKa को कम करता है। परिणामस्वरूप, सेरीन का हाइड्रॉक्सिल (-OH) समूह अपना प्रोटॉन अधिक आसानी से खो सकता है, जिससे यह एक मजबूत नाभिकरागी बन जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;सेरीन का कम pKa यह सुनिश्चित करता है कि यह पेप्टाइड बंधों के एंजाइमी विखंडन के दौरान नाभिकरागी के रूप में कार्य कर सकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;हिस्टिडीन एक क्षार के रूप में कार्य करता है, सेरीन से प्रोटॉन को स्वीकार करता है और इसके विप्रोटॉनन की सुविधा प्रदान करता है, जबकि एस्पार्टेट इस प्रक्रिया के दौरान हिस्टिडीन के धनात्मक आवेश को स्थिर करने में मदद करता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Biochemistry"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a45131905ad063f1a82ade","title":"Biochemistry"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":16.099236641221395,"attempts":{"correct":71,"incorrect":188,"partial":0,"skipped":920,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689538b2cc49566a430d8345":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Differential Interference Contrast (DIC) Microscope\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Early embryogenesis events in organisms like \u0026lt;em\u0026gt;C. elegans\u0026lt;/em\u0026gt; involve dynamic processes such as cell division, migration, and differentiation. To study these events, live microscopy is preferred as it allows real-time observation without disrupting the natural development of the embryo.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Unstained embryos need imaging techniques that can enhance contrast and provide high-resolution visualization of transparent specimens like \u0026lt;em\u0026gt;C. elegans\u0026lt;/em\u0026gt; embryos.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Differential Interference Contrast (DIC) microscopy\u0026lt;/strong\u0026gt;, also known as Nomarski microscopy, is ideal for observing live, unstained specimens as it provides detailed, high-contrast images of transparent samples.\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;DIC microscopy uses polarized light and specialized optics to enhance contrast in transparent specimens.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;It is particularly suitable for studying live embryos of \u0026lt;em\u0026gt;C. elegans\u0026lt;/em\u0026gt;, as it provides sharp, three-dimensional-like images of structures without the need for staining or fluorescence labeling.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Early embryogenesis events such as cell divisions and organ formation can be observed in real-time due to its ability to capture dynamic processes.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;It avoids phototoxicity and photobleaching, issues commonly associated with fluorescence microscopy, making it ideal for extended live imaging.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Other Options:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Confocal Microscope:\u0026lt;/strong\u0026gt;\u0026amp;nbsp;Confocal microscopy is used for imaging fluorescently labeled samples and provides high-resolution, three-dimensional reconstructions.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Fluorescence Microscope:\u0026lt;/strong\u0026gt;\u0026amp;nbsp;Fluorescence microscopy relies on fluorophores to visualize specific structures within a specimen. Since unstained embryos do not have inherent fluorescence, this technique would not be suitable without introducing labeling, which can interfere with natural embryogenesis.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Super-resolution Microscope:\u0026lt;/strong\u0026gt;\u0026amp;nbsp;Super-resolution microscopy provides extremely high-resolution imaging, surpassing the diffraction limit of light. Although powerful, it generally requires fluorescent labeling and is less suited for real-time imaging of unstained, live embryos.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;डिफरेंशियल इंटरफेरेंस कॉन्ट्रास्ट (DIC) माइक्रोस्कोप\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;*सी. एलिगेंस* जैसे जीवों में प्रारंभिक भ्रूणजनन घटनाओं में गतिशील प्रक्रियाएँ शामिल होती हैं जैसे कोशिका विभाजन, प्रवासन और विभेदन। इन घटनाओं का अध्ययन करने के लिए, सक्रिय माइक्रोस्कोपी को प्राथमिकता दी जाती है क्योंकि यह भ्रूण के प्राकृतिक विकास को बाधित किए बिना वास्तविक समय अवलोकन में सहायता करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;बिना रंगे हुए भ्रूणों को इमेजिंग तकनीकों की आवश्यकता होती है जो कंट्रास्ट को बढ़ा सकती हैं और पारदर्शी नमूनों जैसे *सी. एलिगेंस* भ्रूणों का उच्च-रिज़ॉल्यूशन विज़ुअलाइज़ेशन प्रदान कर सकती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;डिफरेंशियल इंटरफेरेंस कॉन्ट्रास्ट (DIC) माइक्रोस्कोपी\u0026lt;/strong\u0026gt;, जिसे नोमार्स्की माइक्रोस्कोपी के रूप में भी जाना जाता है, सक्रिय, बिना रंगे हुए नमूनों को देखने के लिए आदर्श है क्योंकि यह पारदर्शी नमूनों की विस्तृत, उच्च-कंट्रास्ट छवियां प्रदान करता है।\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;DIC माइक्रोस्कोपी पारदर्शी नमूनों में कंट्रास्ट को बढ़ाने के लिए ध्रुवीकृत प्रकाश और विशेष प्रकाशिकी का उपयोग करता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह *सी. एलिगेंस* के सक्रिय भ्रूणों का अध्ययन करने के लिए विशेष रूप से उपयुक्त है, क्योंकि यह बिना रंगाई या फ्लोरोसेंस लेबलिंग की आवश्यकता के संरचनाओं की तेज, तीन-आयामी जैसी छवियां प्रदान करता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;इसकी गतिशील प्रक्रियाओं को कैप्चर करने की क्षमता के कारण कोशिका विभाजन और अंग निर्माण जैसी प्रारंभिक भ्रूणजनन घटनाओं को वास्तविक समय में देखा जा सकता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह फोटो विषाक्तता और फोटोब्लीचिंग से बचाता है, जो आमतौर पर फ्लोरोसेंस माइक्रोस्कोपी से जुड़ी समस्याएँ हैं, जिससे यह विस्तारित सक्रिय इमेजिंग के लिए आदर्श बन जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कॉनफोकल माइक्रोस्कोप:\u0026lt;/strong\u0026gt; कॉनफोकल माइक्रोस्कोपी का उपयोग फ्लोरोसेंट रूप से लेबल किए गए नमूनों की इमेजिंग के लिए किया जाता है और यह उच्च-रिज़ॉल्यूशन, तीन-आयामी पुनर्निर्माण प्रदान करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;फ्लोरोसेंस माइक्रोस्कोप:\u0026lt;/strong\u0026gt; फ्लोरोसेंस माइक्रोस्कोपी एक नमूने के भीतर विशिष्ट संरचनाओं की कल्पना करने के लिए फ्लोरोफोर्स पर निर्भर करता है। चूँकि बिना रंगे हुए भ्रूणों में अंतर्निहित फ्लोरोसेंस नहीं होता है, इसलिए लेबलिंग शुरू किए बिना यह तकनीक उपयुक्त नहीं होगी, जो प्राकृतिक भ्रूणजनन में हस्तक्षेप कर सकती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;सुपर-रिज़ॉल्यूशन माइक्रोस्कोप:\u0026lt;/strong\u0026gt; सुपर-रिज़ॉल्यूशन माइक्रोस्कोपी प्रकाश की विवर्तन सीमा को पार करते हुए अत्यधिक उच्च-रिज़ॉल्यूशन इमेजिंग प्रदान करता है। हालांकि शक्तिशाली, इसे आम तौर पर फ्लोरोसेंट लेबलिंग की आवश्यकता होती है और यह बिना रंगे हुए, सक्रिय भ्रूणों की वास्तविक समय इमेजिंग के लिए कम उपयुक्त है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Methods in Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4566d978874fc5c7a0d11","title":"Methods in Biology"},"t":{"id":"63a45673d3b5fd9703bb8159","title":"Molecular Biology Techniques"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":14.54877014418999,"attempts":{"correct":284,"incorrect":231,"partial":0,"skipped":664,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689538c68aebc97d87cfcc70":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;They infect cervical epithelial cells and maintain themselves in a latent phase as extrachromosomal plasmids.\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Human papillomavirus (HPV) is a group of viruses that infect epithelial tissues, including the skin and mucous membranes. Some strains of HPV are associated with benign conditions like warts, while others are linked to cancer, particularly cervical cancer.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;HPV has a unique life cycle that involves infecting basal epithelial cells, where it can maintain itself in a latent phase as extrachromosomal plasmids (episomes). This allows the virus to persist in the host without integrating into the host genome.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Once inside, the virus maintains its genome in an episomal form (extrachromosomal plasmids) during its latent phase, allowing it to replicate independently of the host\u0026amp;#39;s DNA.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This latent phase is crucial for the virus\u0026amp;rsquo;s persistence and helps it evade the host immune system.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In some cases, the virus can become active, leading to cell proliferation and potentially contributing to cancer development in high-risk HPV strains.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The latent episomal state is a key characteristic of HPV infection and distinguishes it from other mechanisms of viral persistence.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage68a437b9a2dbfab10de6d65a.png\u0026quot; style=\u0026quot;height: 231px; width: 450px;\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;em\u0026gt;Fig:\u0026amp;nbsp;Pathogenesis of HPV infection. Initially, the virus was latent inside the epithelial cell and had a low proliferation rate. As the virus enters the lysogenic cycle, the rate of proliferation increases. Finally, the viruses are assembled and secreted from keratinocytes to repeat the infection cycle.\u0026lt;a href=\u0026quot;https://www.researchgate.net/figure/Pathogenesis-of-HPV-infection-Initially-the-virus-was-latent-inside-the-epithelial-cell_fig1_358145192\u0026quot;\u0026gt; (Source)\u0026lt;/a\u0026gt;\u0026lt;/em\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर है-\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;वे गर्भाशय ग्रीवा के उपकला कोशिकाओं को संक्रमित करते हैं और खुद को एक अव्यक्त चरण में अतिरिक्त गुणसूत्र प्लास्मिड के रूप में बनाए रखते हैं।\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;मानव पैपिलोमावायरस (HPV) वायरस का एक समूह है जो उपकला ऊतकों को संक्रमित करता है, जिसमें त्वचा और श्लेष्मा झिल्ली शामिल हैं। HPV के कुछ स्ट्रेन मस्सों जैसी सौम्य स्थितियों से जुड़े होते हैं, जबकि अन्य कैंसर, विशेष रूप से गर्भाशय ग्रीवा के कैंसर से जुड़े होते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;HPV का एक अनूठा जीवन चक्र होता है जिसमें बेसल एपिथीलियल कोशिकाओं को संक्रमित करना शामिल होता है, जहाँ यह एक्स्ट्राक्रोमोसोमल प्लास्मिड (एपिसोम्स) के रूप में सुप्त अवस्था में बना रह सकता है। इससे वायरस मेज़बान जीनोम में एकीकृत हुए बिना मेज़बान में बना रह सकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;एक बार अंदर जाने के बाद, वायरस अपने जीनोम को अपने अव्यक्त चरण के दौरान एक एपिसोमल रूप (अतिरिक्त गुणसूत्र प्लास्मिड) में बनाए रखता है, जिससे यह मेज़बान के डीएनए से स्वतंत्र रूप से प्रतिकृति बना सकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह अव्यक्त चरण वायरस के दृढ़ता के लिए महत्वपूर्ण है और इसे मेज़बान प्रतिरक्षा तंत्र से बचने में मदद करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;कुछ मामलों में, वायरस सक्रिय हो सकता है, जिससे कोशिका प्रसार होता है और उच्च जोखिम वाले HPV उपभेदों में संभावित रूप से कैंसर के विकास में योगदान होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;अव्यक्त एपिसोमल अवस्था HPV संक्रमण की एक प्रमुख विशेषता है और इसे वायरल दृढ़ता के अन्य तंत्रों से अलग करती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage68a437b9a2dbfab10de6d65a.png\u0026quot; style=\u0026quot;height: 231px; width: 450px;\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;em\u0026gt;चित्र: HPV संक्रमण का रोगजनन। प्रारंभ में, वायरस उपकला कोशिका के अंदर अव्यक्त था और इसकी प्रसार दर कम थी। जैसे ही वायरस लाइसोजेनिक चक्र में प्रवेश करता है, प्रसार की दर बढ़ जाती है। अंत में, वायरस को इकट्ठा किया जाता है और संक्रमण चक्र को दोहराने के लिए केराटिनोसाइट्स से स्रावित किया जाता है।\u0026lt;a href=\u0026quot;https://www.researchgate.net/figure/Pathogenesis-of-HPV-infection-Initially-the-virus-was-latent-inside-the-epithelial-cell_fig1_358145192\u0026quot;\u0026gt; (स्रोत)\u0026lt;/a\u0026gt;\u0026lt;/em\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Cell Communication and Cell Signaling"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a451cdef5b5403de57a575","title":"Cell Communication and Cell Signaling"},"t":{"id":"63a451daa1b1e0637eb18ac2","title":"Host parasite interaction"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":16.658184902459713,"attempts":{"correct":92,"incorrect":328,"partial":0,"skipped":759,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689538d78aebc97d87cfcc96":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Plasma membrane \u0026amp;gt; lysosomal membrane \u0026amp;gt; smooth ER \u0026amp;gt; inner mitochondrial membrane\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Cholesterol is a crucial component of cell membranes in animal cells. It helps maintain membrane fluidity, integrity, and permeability, and its distribution varies across different types of membranes within the cell.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The cholesterol distribution in membranes is not uniform. It depends on the specific function and lipid composition of the membrane.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The plasma membrane has the highest cholesterol content compared to other organelle membranes because it requires structural stability and controlled permeability for interactions with the external environment.\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Plasma membrane:\u0026lt;/strong\u0026gt; The plasma membrane has the highest percentage of cholesterol among all cellular membranes. Cholesterol constitutes about 20-25% of the total lipid content in the plasma membrane. This high level is essential for maintaining membrane fluidity and providing mechanical strength to the cell\u0026amp;#39;s outer boundary.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Lysosomal membrane:\u0026lt;/strong\u0026gt; The lysosomal membrane contains less cholesterol than the plasma membrane but still has a moderate amount. Cholesterol in lysosomal membranes helps maintain their stability and prevents lysosomal enzymes from leaking out.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Smooth ER (Endoplasmic Reticulum):\u0026lt;/strong\u0026gt; The smooth ER has a relatively low cholesterol content compared to the plasma membrane and lysosomal membrane. This organelle is involved in lipid synthesis, and a lower cholesterol level is sufficient to maintain its functional properties.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Inner mitochondrial membrane:\u0026lt;/strong\u0026gt; The inner mitochondrial membrane has the lowest cholesterol content among the listed membranes. This is because it needs to maintain high fluidity and permeability for the exchange of ions and molecules required for cellular respiration.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;प्लाज्मा झिल्ली \u0026amp;gt; लाइसोसोमल झिल्ली \u0026amp;gt; चिकनी ER \u0026amp;gt; आंतरिक माइटोकॉन्ड्रियल झिल्ली\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;है।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;कोलेस्ट्रॉल जंतु कोशिकाओं में कोशिका झिल्लियों का एक महत्वपूर्ण घटक है। यह झिल्ली की तरलता, अखंडता और पारगम्यता को बनाए रखने में मदद करता है, और इसका वितरण कोशिका के भीतर विभिन्न प्रकार की झिल्लियों में भिन्न होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;झिल्लियों में कोलेस्ट्रॉल का वितरण एक समान नहीं होता है। यह झिल्ली के विशिष्ट कार्य और लिपिड संरचना पर निर्भर करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;प्लाज्मा झिल्ली में अन्य ऑर्गेनेल झिल्लियों की तुलना में कोलेस्ट्रॉल की मात्रा सबसे अधिक होती है क्योंकि बाहरी वातावरण के साथ बातचीत के लिए इसे संरचनात्मक स्थिरता और नियंत्रित पारगम्यता की आवश्यकता होती है।\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;प्लाज्मा झिल्ली:\u0026lt;/strong\u0026gt; सभी कोशिकीय झिल्लियों में प्लाज्मा झिल्ली में कोलेस्ट्रॉल का प्रतिशत सबसे अधिक होता है। प्लाज्मा झिल्ली में कोलेस्ट्रॉल कुल लिपिड सामग्री का लगभग 20-25% होता है। यह उच्च स्तर झिल्ली की तरलता को बनाए रखने और कोशिका की बाहरी सीमा को यांत्रिक शक्ति प्रदान करने के लिए आवश्यक है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;लाइसोसोमल झिल्ली:\u0026lt;/strong\u0026gt; लाइसोसोमल झिल्ली में प्लाज्मा झिल्ली की तुलना में कम कोलेस्ट्रॉल होता है लेकिन फिर भी इसमें मध्यम मात्रा में कोलेस्ट्रॉल होता है। लाइसोसोमल झिल्लियों में कोलेस्ट्रॉल उनकी स्थिरता बनाए रखने और लाइसोसोमल एंजाइमों को बाहर निकलने से रोकने में मदद करता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;चिकनी ER (अन्तः प्रदव्ययी जलिका):\u0026lt;/strong\u0026gt; प्लाज्मा झिल्ली और लाइसोसोमल झिल्ली की तुलना में चिकनी ER में कोलेस्ट्रॉल की मात्रा अपेक्षाकृत कम होती है। यह ऑर्गेनेल लिपिड संश्लेषण में शामिल है, और इसके कार्यात्मक गुणों को बनाए रखने के लिए कोलेस्ट्रॉल का निम्न स्तर पर्याप्त है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;आंतरिक माइटोकॉन्ड्रियल झिल्ली:\u0026lt;/strong\u0026gt; सूचीबद्ध झिल्लियों में आंतरिक माइटोकॉन्ड्रियल झिल्ली में कोलेस्ट्रॉल की मात्रा सबसे कम होती है। ऐसा इसलिए है क्योंकि इसे कोशिकीय श्वसन के लिए आवश्यक आयनों और अणुओं के विनिमय के लिए उच्च तरलता और पारगम्यता बनाए रखने की आवश्यकता होती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Cellular Organization"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4518aa958c4957eed4157","title":"Cellular Organization"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":20.586089906700582,"attempts":{"correct":225,"incorrect":312,"partial":0,"skipped":642,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689538eccc49566a430d843a":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;extra-large Ga subunit\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Heterotrimeric G-proteins\u0026amp;nbsp;\u0026lt;/strong\u0026gt;are involved in signal transduction mechanisms in eukaryotic cells. They consist of three subunits:\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Alpha (G\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\alpha\\)\u0026lt;/span\u0026gt;),\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Beta (G\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\beta\\)\u0026lt;/span\u0026gt;),\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Gamma (G\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\gamma\\)\u0026lt;/span\u0026gt;).\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In animals, activation of these proteins typically occurs through G-protein-coupled receptors (GPCRs).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Unlike animals, plants have unique adaptations in their G-protein signaling mechanisms. One such adaptation is the presence of the \u0026amp;quot;extra-large G\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\alpha\\)\u0026lt;/span\u0026gt; subunit\u0026amp;quot; (XLG protein), which is unique to the plant lineage.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;XLG proteins are atypical\u0026amp;nbsp;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;G\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\alpha\\)\u0026lt;/span\u0026gt; subunits with a longer sequence and distinct functional domains compared to conventional \u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;G\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\alpha\\)\u0026lt;/span\u0026gt;\u0026amp;nbsp;subunits found in other organisms. They play a key role in various signaling pathways in plants, including stress responses, growth regulation, and immunity.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage68a440d219a9bc27be7938b1.png\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;em\u0026gt;Fig: \u0026lt;/em\u0026gt;A.\u0026lt;em\u0026gt;\u0026amp;nbsp;The plant G\u0026amp;alpha; structure consists of Ras-like GTPase domain and the helical domain, myristoylation and palmitoylation sites at the N-terminus end, and guanine nucleotide-binding motifs.\u0026lt;/em\u0026gt; B.\u0026amp;nbsp;\u0026lt;em\u0026gt;Non-canonical extra-large GTP-binding proteins (XLGs) have an N-terminal cysteine-rich domain, a nuclear localization signal while the C-terminal half harbors G\u0026amp;alpha;-like domain \u0026lt;a href=\u0026quot;https://www.researchgate.net/figure/Domain-structure-of-plant-G-protein-subunits-A-The-plant-Ga-structure-consists-of_fig1_359343231\u0026quot;\u0026gt;(Source)\u0026lt;/a\u0026gt;\u0026lt;/em\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;These proteins bypass the need for traditional GPCRs and interact with other signaling components directly, reflecting the unique evolutionary trajectory of plant signaling systems.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Other Options:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;GTPase-accelerating protein:\u0026lt;/strong\u0026gt; These are regulatory proteins that enhance the hydrolysis of GTP to GDP, thereby inactivating Ga subunits. While they are important in G-protein signaling, they are not unique to plants.\u0026amp;nbsp;\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;G-protein-coupled receptor (GPCR):\u0026lt;/strong\u0026gt; GPCRs are membrane proteins that activate heterotrimeric G-proteins upon binding to ligands. They are widespread in animals but limited in plants. Plants have very few canonical GPCRs, and their signaling mechanisms rely on other components, such as the extra-large\u0026amp;nbsp;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;G\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\alpha\\)\u0026lt;/span\u0026gt; subunits.\u0026amp;nbsp;\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Regulator of G-protein signaling (RGS):\u0026lt;/strong\u0026gt; RGS proteins modulate G-protein signaling by accelerating the GTPase activity of\u0026amp;nbsp;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;G\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\alpha\\)\u0026lt;/span\u0026gt; subunits. While RGS proteins are present in plants, they are not unique to the plant lineage.\u0026amp;nbsp;\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;अतिरिक्त-बड़ा Ga उपएकक\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;हेट्रोट्रिमरिक G-प्रोटीन\u0026lt;/strong\u0026gt; यूकेरियोटिक कोशिकाओं में सिग्नल ट्रांसडक्शन तंत्र में शामिल होते हैं। इनमें तीन उपएकक होते हैं:\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;अल्फा (G\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\alpha\\)\u0026lt;/span\u0026gt;),\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;बीटा (G\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\beta\\)\u0026lt;/span\u0026gt;),\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;गामा (G\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\gamma\\)\u0026lt;/span\u0026gt;).\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जानवरों में, इन प्रोटीनों का सक्रियण आमतौर पर G-प्रोटीन-युग्मित रिसेप्टर्स (GPCRs) के माध्यम से होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जानवरों के विपरीत, पौधों में उनके G-प्रोटीन संकेतन तंत्र में अनोखे अनुकूलन होते हैं। ऐसा ही एक अनुकूलन \u0026amp;quot;अतिरिक्त-बड़ा G\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\alpha\\)\u0026lt;/span\u0026gt; उपएकक\u0026amp;quot; (XLG प्रोटीन) की उपस्थिति है, जो पौधे के वंश के लिए अद्वितीय है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;XLG प्रोटीन असामान्य \u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;G\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\alpha\\)\u0026lt;/span\u0026gt; उपएकक हैं जिनमें अन्य जीवों में पाए जाने वाले पारंपरिक \u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;G\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\alpha\\)\u0026lt;/span\u0026gt; उपएकक की तुलना में एक लंबा क्रम और विशिष्ट क्रियात्मक डोमेन हैं। वे पौधों में विभिन्न संकेतन मार्गों में महत्वपूर्ण भूमिका निभाते हैं, जिसमें तनाव प्रतिक्रियाएँ, विकास विनियमन और प्रतिरक्षा शामिल हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage68a440d219a9bc27be7938b1.png\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;em\u0026gt;चित्र: \u0026lt;/em\u0026gt;A.\u0026lt;em\u0026gt; पौधे के G\u0026amp;alpha; संरचना में Ras-जैसे GTPase डोमेन और कुंडलित डोमेन, N-टर्मिनल छोर पर माय्रिस्टोयलेशन और पामिटोयलेशन साइटें, और गुआनिन न्यूक्लियोटाइड-बंधन अभिलक्षण शामिल हैं।\u0026lt;/em\u0026gt; B. \u0026lt;em\u0026gt;गैर-विहित अतिरिक्त-बड़े GTP-बंधन प्रोटीन (XLGs) में एक N-टर्मिनल सिस्टीन-समृद्ध डोमेन, एक परमाणु स्थानीयकरण संकेत होता है जबकि C-टर्मिनल आधा G\u0026amp;alpha;-जैसे डोमेन रखता है \u0026lt;a href=\u0026quot;https://www.researchgate.net/figure/Domain-structure-of-plant-G-protein-subunits-A-The-plant-Ga-structure-consists-of_fig1_359343231\u0026quot;\u0026gt;(स्रोत)\u0026lt;/a\u0026gt;\u0026lt;/em\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;ये प्रोटीन पारंपरिक GPCRs की आवश्यकता को दरकिनार करते हैं और अन्य संकेतन घटकों के साथ सीधे अंतःक्रिया करते हैं, जो पौधे संकेतन सिस्टम के अनोखे विकासवादी प्रक्षेपवक्र को दर्शाते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;GTPase-त्वरक प्रोटीन\u0026lt;/strong\u0026gt;\u0026lt;strong\u0026gt;:\u0026lt;/strong\u0026gt; ये नियामक प्रोटीन हैं जो GTP के GDP में हाइड्रोलिसिस को बढ़ाते हैं, जिससे Ga उपएकक निष्क्रिय हो जाते हैं। जबकि वे G-प्रोटीन संकेतन में महत्वपूर्ण हैं, वे पौधों के लिए अद्वितीय नहीं हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;G-प्रोटीन-युग्मित रिसेप्टर\u0026lt;/strong\u0026gt;\u0026lt;strong\u0026gt; (GPCR):\u0026lt;/strong\u0026gt; GPCRs झिल्ली प्रोटीन हैं जो लिगैंड्स से बंधने पर हेट्रोट्रिमरिक G-प्रोटीन को सक्रिय करते हैं। वे जानवरों में व्यापक हैं लेकिन पौधों में सीमित हैं। पौधों में बहुत कम कैनोनिकल GPCRs होते हैं, और उनके संकेतन तंत्र अन्य घटकों पर निर्भर करते हैं, जैसे कि अतिरिक्त-बड़ा \u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;G\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\alpha\\)\u0026lt;/span\u0026gt; उपएकक।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;G-प्रोटीन संकेतन का नियामक\u0026lt;/strong\u0026gt;\u0026lt;strong\u0026gt; (RGS):\u0026lt;/strong\u0026gt; RGS प्रोटीन \u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;G\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(\\alpha\\)\u0026lt;/span\u0026gt; उपएकक की GTPase गतिविधि को तेज करके G-प्रोटीन संकेतन को नियंत्रित करते हैं। जबकि RGS प्रोटीन पौधों में मौजूद हैं, वे पौधे के वंश के लिए अद्वितीय नहीं हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Cell Communication and Cell Signaling"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a451cdef5b5403de57a575","title":"Cell Communication and Cell Signaling"},"t":{"id":"63a451eb152a060341b32362","title":"Cell signaling"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":13.4715860899067,"attempts":{"correct":110,"incorrect":379,"partial":0,"skipped":690,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895391cc6cdfd92ecf7904f":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;C=31%, G=31%, and T=19%\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Nucleotides are the building blocks of DNA, consisting of four types: Adenine (A), Thymine (T), Cytosine (C), and Guanine (G).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;DNA is a double-stranded molecule, and its structure follows the base-pairing rule: Adenine (A) pairs with Thymine (T), while Cytosine (C) pairs with Guanine (G). Because of this base-pairing rule, the percentage of A is equal to the percentage of T, and the percentage of C is equal to the percentage of G.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The total composition of nucleotides in the genome must add up to 100%.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;According to the base-pairing rule, if 19% of the nucleotides are Adenine (A), then 19% of the nucleotides must also be Thymine (T) because A pairs with T.\u0026amp;nbsp;\u0026amp;nbsp;Since A and T together make up 38% (19% + 19%), the remaining percentage is 100% - 38% = 62%.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The 62% is split equally between C and G, resulting in 31% for Cytosine (C) and 31% for Guanine (G).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The percentages of the nucleotides are as follows: A=19%, T=19%, C=31%, and G=31%.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;C=31%, G=31%, और T=19%\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;है।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;न्यूक्लियोटाइड DNA के निर्माण खंड हैं, जिनमें चार प्रकार होते हैं: एडेनिन (A), थाइमिन (T), साइटोसिन (C), और ग्वानिन (G).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;DNA द्वी -रज्जुक अणु है, और इसकी संरचना क्षार-युग्मन\u0026amp;nbsp;नियम का पालन करती है: एडेनिन (A) थाइमिन (T) के साथ युग्म बनाता है, जबकि साइटोसिन (C) ग्वानिन (G) के साथ युग्म बनाता है। इस क्षार-युग्मन\u0026amp;nbsp;नियम के कारण, A का प्रतिशत T के प्रतिशत के बराबर होता है, और C का प्रतिशत G के प्रतिशत के बराबर होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जीनोम में न्यूक्लियोटाइड की कुल संरचना 100% तक जुड़नी चाहिए।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;क्षार-युग्मन\u0026amp;nbsp;नियम के अनुसार, यदि 19% न्यूक्लियोटाइड एडेनिन (A) हैं, तो 19% न्यूक्लियोटाइड थाइमिन (T) भी होने चाहिए क्योंकि A, T के साथ युग्म बनाता है। चूँकि A और T मिलकर 38% (19% + 19%) बनाते हैं, शेष प्रतिशत 100% - 38% = 62% है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;62% को C और G के बीच समान रूप से विभाजित किया जाता है, जिसके परिणामस्वरूप साइटोसिन (C) के लिए 31% और ग्वानिन (G) के लिए 31% होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;न्यूक्लियोटाइड का प्रतिशत इस प्रकार है: A=19%, T=19%, C=31%, और G=31%।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Fundamental Processes"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a451aec9ba648bc86fbf43","title":"Fundamental Processes"},"t":{"id":"63a451beef5b5403de57a495","title":"Protein synthesis and processing"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":21.71925360474979,"attempts":{"correct":397,"incorrect":226,"partial":0,"skipped":556,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895392df922825acdf5f61e":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:rgb(33, 37, 41);\u0026quot;\u0026gt;Reducing atmosphere with gases such as methane and ammonia\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The Oparin-Haldane hypothesis, proposed independently by Aleksandr Oparin and J.B.S. Haldane in the 1920s, suggests that life on Earth originated through a gradual chemical evolution of carbon-based molecules in the Earth\u0026amp;#39;s early atmosphere.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The early atmosphere of Earth, according to this hypothesis, was a reducing atmosphere, meaning it lacked free oxygen and was rich in gases like methane (CH\u0026lt;sub\u0026gt;4\u0026lt;/sub\u0026gt;), ammonia (NH\u0026lt;sub\u0026gt;3\u0026lt;/sub\u0026gt;), hydrogen (H\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt;), and water vapor (H\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt;O).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This environment was conducive to the formation of organic molecules, as reducing conditions favor the synthesis of complex organic compounds from simpler molecules.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Energy sources such as ultraviolet radiation, volcanic activity, and lightning provided the energy required for these chemical reactions, eventually leading to the emergence of simple life forms.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:rgb(33, 37, 41);\u0026quot;\u0026gt;मीथेन और अमोनिया जैसी गैसों वाला अपचायक वायुमंडल\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;है।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;ओपेरिन-हाल्डेन परिकल्पना, जिसे 1920 के दशक में अलेक्जेंडर ओपेरिन और जे.बी.एस. हाल्डेन ने स्वतंत्र रूप से प्रस्तावित किया था, यह सुझाव देती है कि पृथ्वी पर जीवन पृथ्वी के प्रारंभिक वायुमंडल में कार्बन-आधारित अणुओं के क्रमिक रासायनिक विकास के माध्यम से उत्पन्न हुआ।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इस परिकल्पना के अनुसार, पृथ्वी का प्रारंभिक वायुमंडल एक अपचायक वायुमंडल था, जिसका अर्थ है कि इसमें मुक्त ऑक्सीजन की कमी थी और यह मीथेन (CH\u0026lt;sub\u0026gt;4\u0026lt;/sub\u0026gt;), अमोनिया (NH\u0026lt;sub\u0026gt;3\u0026lt;/sub\u0026gt;), हाइड्रोजन (H\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt;), और जल वाष्प (H\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt;O) जैसी गैसों से भरपूर था।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह वातावरण कार्बनिक अणुओं के निर्माण के लिए अनुकूल था, क्योंकि अपचायक परिस्थितियाँ सरल अणुओं से जटिल कार्बनिक यौगिकों के संश्लेषण का समर्थन करती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;पराबैंगनी विकिरण, ज्वालामुखी गतिविधि और बिजली जैसे ऊर्जा स्रोतों ने इन रासायनिक अभिक्रियाओं के लिए आवश्यक ऊर्जा प्रदान की, जिसके परिणामस्वरूप अंततः सरल जीवन रूपों का उद्भव हुआ।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Evolution and Behavior"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4557fe52da32add2b08e9","title":"Evolution and Behavior"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":13.72688719253604,"attempts":{"correct":465,"incorrect":164,"partial":0,"skipped":550,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895393eaf69335e70a002ce":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Ribothymidine and pseudouridine\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;tRNA (transfer RNA) undergoes various chemical modifications after transcription to enhance its stability, structure, and functionality.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Uridine, one of the nucleotide residues in tRNA, is chemically altered during post-transcriptional modifications to form derivatives like ribothymidine and pseudouridine.\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Ribothymidine:\u0026lt;/strong\u0026gt; This modification involves the methylation of uridine to form ribothymidine. Ribothymidine, often found in the T-loop of tRNA, contributes to the tertiary structure and stability of the molecule.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Pseudouridine:\u0026lt;/strong\u0026gt; Pseudouridine is formed through the isomerization of uridine, where the nitrogen-carbon bond is rearranged to create a carbon-carbon bond. This modification enhances the hydrogen bonding capacity of tRNA, improving its structural integrity and functionality during translation.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;These modifications are crucial for the proper folding of tRNA and its ability to bind to ribosomes and aminoacyl-tRNA synthetases during protein synthesis.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage65b8eb45d2a0f05313b4ba2c.png\u0026quot; style=\u0026quot;color: rgb(33, 37, 41);\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;span style=\u0026quot;display: flex;gap: 6px;align-items: center;\u0026quot;\u0026gt;\u0026lt;img height=\u0026quot;26px\u0026quot; src=\u0026quot;//cdn.testbook.com/resources/lms_creative_elements/additional-information-image.png\u0026quot; width=\u0026quot;26px\u0026quot; /\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;vertical-align: middle;font-size: 21px;\u0026quot;\u0026gt;\u0026lt;u\u0026gt;Additional Information\u0026lt;/u\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/span\u0026gt;Detailed structures and features of a tRNA molecule:-\u0026lt;/p\u0026gt;\n\n\u0026lt;ul style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Acceptor Stem\u0026lt;/span\u0026gt;: This is a seven-base pair (bp) stem made by the base-pairing of the 5\u0026amp;#39;-terminal nucleotide with the 3\u0026amp;#39;-terminal nucleotide. This stem is universally conserved in tRNA. At the 3\u0026amp;rsquo; end of the tRNA,\u0026amp;nbsp;CCA sequence is found\u0026amp;nbsp;where the amino acid binds.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;D-arm:\u0026amp;nbsp;\u0026lt;/span\u0026gt;Short for \u0026amp;quot;Dihydrouridine arm,\u0026amp;quot; this is usually a four bp stem ending in a loop that contains (in many cases) several D (dihydrouridine) residues. Dihydrouridine is a modified form of the nucleoside uridine (U). The D-arm is crucial for recognition by the correct aminoacyl-tRNA synthetase, helping ensure that the right amino acid is attached to the tRNA.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Anticodon Arm:\u0026amp;nbsp;\u0026lt;/span\u0026gt;This arm contains the \u0026amp;quot;business end\u0026amp;quot; of the tRNA in terms of protein synthesis. It is a five bp stem whose loop contains the anticodon. An anticodon is a sequence of three nucleotides that is complementary to the codon in the mRNA. For example, if the codon sequence in the mRNA is AUG, then the anticodon in the tRNA will be UAC.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;T arm\u0026lt;/span\u0026gt;: Known as the \u0026amp;quot;T\u0026amp;Psi;C arm,\u0026amp;quot; this is a five bp stem with a loop containing the sequence T\u0026amp;Psi;C (where \u0026amp;Psi; is pseudouridine, a modified uridine). This section is involved in binding to the ribosome during protein synthesis.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Variable loop:\u0026lt;/span\u0026gt;\u0026amp;nbsp;This is the region that varies in length, from 3 to 21 nucleotides, and sequence among different tRNAs. Its function is not clear but may aid in the proper folding and stability of tRNA.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Intricate modifications:\u0026amp;nbsp;\u0026lt;/span\u0026gt;Various nucleobases in tRNAs are heavily and uniquely modified post-transcriptionally by specific enzymes. There are over 100 different modifications that have been found in tRNAs, contributing to their stability and function.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;L-Shaped Structure:\u0026lt;/span\u0026gt;\u0026amp;nbsp;tRNA molecules twist into an L-shaped three-dimensional structure that brings the amino acid binding site and the anticodon into proximity. The amino acid binds at one end of the molecule (the acceptor stem), while the anticodon is located at the other end.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;राइबोथाइमिडीन और स्यूडोयूरीडीन\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;है।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;tRNA (ट्रांसफर RNA) अपनी स्थिरता, संरचना और कार्यक्षमता को बढ़ाने के लिए अनुलेखन के बाद विभिन्न रासायनिक संशोधनों से गुजरता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;tRNA में न्यूक्लियोटाइड अव्ययों में से एक, यूरीडीन, पोस्ट-ट्रांसक्रिप्शनल संशोधनों के दौरान रासायनिक रूप से परिवर्तित होकर राइबोथाइमिडीन और स्यूडोयूरीडीन जैसे व्युत्पन्न बनाता है।\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;राइबोथाइमिडीन:\u0026lt;/strong\u0026gt; इस संशोधन में यूरीडीन का मिथाइलेशन शामिल है जिससे राइबोथाइमिडीन बनता है। राइबोथाइमिडीन, जो अक्सर tRNA के T-लूप में पाया जाता है, अणु की तृतीयक संरचना और स्थिरता में योगदान देता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;स्यूडोयूरीडीन:\u0026lt;/strong\u0026gt; स्यूडोयूरीडीन यूरीडीन के आइसोमेराइजेशन से बनता है, जहाँ नाइट्रोजन-कार्बन बंध को पुनर्व्यवस्थित करके कार्बन-कार्बन बंध बनाया जाता है। यह संशोधन tRNA की हाइड्रोजन बंधन क्षमता को बढ़ाता है, अनुवाद के दौरान इसकी संरचनात्मक अखंडता और कार्यक्षमता में सुधार करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;ये संशोधन tRNA के उचित तह और प्रोटीन संश्लेषण के दौरान राइबोसोम और एमिनोएसाइल-tRNA सिंथेटेस से बंधने की इसकी क्षमता के लिए महत्वपूर्ण हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage65b8eb45d2a0f05313b4ba2c.png\u0026quot; style=\u0026quot;color: rgb(33, 37, 41);\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;span style=\u0026quot;display: flex;gap: 6px;align-items: center;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;display: flex;gap: 6px;align-items: center;\u0026quot;\u0026gt;\u0026lt;img height=\u0026quot;26px\u0026quot; src=\u0026quot;//cdn.testbook.com/resources/lms_creative_elements/additional-information-image.png\u0026quot; width=\u0026quot;26px\u0026quot; /\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;vertical-align: middle;font-size: 21px;\u0026quot;\u0026gt;\u0026lt;u\u0026gt;Additional Information\u0026lt;/u\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/span\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;br /\u0026gt;\ntRNA अणु की विस्तृत संरचनाएँ और विशेषताएँ:-\u0026lt;/p\u0026gt;\n\n\u0026lt;ul style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;स्वीकर्ता स्टेम\u0026lt;/span\u0026gt;: यह सात क्षार युग्म (bp) स्टेम है जो 5\u0026amp;#39;-टर्मिनल न्यूक्लियोटाइड के 3\u0026amp;#39;-टर्मिनल न्यूक्लियोटाइड के साथ क्षारयुग्मन द्वारा बनाया गया है। यह स्टेम tRNA में सार्वभौमिक रूप से संरक्षित है। tRNA के 3\u0026amp;rsquo; सिरे पर, CCA अनुक्रम पाया जाता है जहाँ एमिनो अम्ल बंधता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;D-आर्म: \u0026lt;/span\u0026gt;संक्षेप में \u0026amp;quot;डायहाइड्रॉयूरीडीन आर्म,\u0026amp;quot; यह आमतौर पर एक चार bp स्टेम होता है जो एक लूप में समाप्त होता है जिसमें (कई मामलों में) कई D (डायहाइड्रॉयूरीडीन) अव्यय होते हैं। डायहाइड्रॉयूरीडीन न्यूक्लियोसाइड यूरीडीन (U) का एक संशोधित रूप है। D-आर्म सही एमिनोएसाइल-tRNA सिंथेटेज़ द्वारा पहचान के लिए महत्वपूर्ण है, यह सुनिश्चित करने में मदद करता है कि सही एमिनो अम्ल tRNA से जुड़ा हुआ है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;एंटीकोडोन आर्म: \u0026lt;/span\u0026gt;इस आर्म में प्रोटीन संश्लेषण के संदर्भ में tRNA का \u0026amp;quot;व्यावसायिक छोर\u0026amp;quot; होता है। यह एक पाँच bp स्टेम है जिसके लूप में एंटीकोडोन होता है। एंटीकोडोन तीन न्यूक्लियोटाइड्स का एक क्रम है जो mRNA में कोडोन के पूरक होता है। उदाहरण के लिए, यदि mRNA में कोडोन अनुक्रम AUG है, तो tRNA में एंटीकोडोन UAC होगा।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;T आर्म\u0026lt;/span\u0026gt;: जिसे \u0026amp;quot;T\u0026amp;Psi;C आर्म\u0026amp;quot; के रूप में जाना जाता है, यह एक पाँच bp स्टेम है जिसमें T\u0026amp;Psi;C अनुक्रम वाला लूप होता है (जहाँ \u0026amp;Psi; स्यूडोयूरीडीन है, एक संशोधित यूरीडीन)। यह खंड प्रोटीन संश्लेषण के दौरान राइबोसोम से बंधने में शामिल है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;चर लूप:\u0026lt;/span\u0026gt; यह वह क्षेत्र है जो विभिन्न tRNAs के बीच लंबाई में, 3 से 21 न्यूक्लियोटाइड्स तक, और अनुक्रम में भिन्न होता है। इसका कार्य स्पष्ट नहीं है लेकिन यह tRNA के उचित तह और स्थिरता में सहायता कर सकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;जटिल संशोधन: \u0026lt;/span\u0026gt;tRNAs में विभिन्न न्यूक्लियोबेस विशिष्ट एंजाइमों द्वारा पोस्ट-ट्रांसक्रिप्शनली भारी और विशिष्ट रूप से संशोधित होते हैं। tRNAs में 100 से अधिक विभिन्न संशोधन पाए गए हैं, जो उनकी स्थिरता और कार्य में योगदान करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;L-आकार की संरचना:\u0026lt;/span\u0026gt; tRNA अणु एक L-आकार की त्रि-आयामी संरचना में मुड़ते हैं जो एमिनो अम्ल बंधन स्थल और एंटीकोडोन को निकटता में लाता है। एमिनो अम्ल अणु के एक छोर (स्वीकर्ता स्टेम) पर बंधता है, जबकि एंटीकोडोन दूसरे छोर पर स्थित होता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"\u003cp\u003eসঠিক উত্তর হল \u003cstrong\u003e\u003cspan style=\"color:(33, 37, 41);\"\u003eরাইবোথাইমিডিন এবং সিউডোরিডিন\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\n\u003cp\u003e\u003cu style=\"color: rgb(33, 37, 41);\"\u003e\u003cspan style=\"font-weight: bolder;\"\u003eব্যাখ্যা:\u003c/span\u003e\u003c/u\u003e\u003c/p\u003e\n\n\u003cul\u003e\n\t\u003cli\u003etRNA (স্থানান্তর RNA) প্রতিলিপিকরণের পরে বিভিন্ন রাসায়নিক পরিবর্তন সাধন করে এর স্থায়িত্ব, গঠন এবং কার্যকারিতা বাড়ায়।\u003c/li\u003e\n\t\u003cli\u003eইউরিডিন, tRNA-এর একটি নিউক্লিওটাইড অবশেষ, প্রতিলিপিকরণ-পরবর্তী পরিবর্তনের সময় রাইবোথাইমিডিন এবং সিউডোরিডিনের মতো ডেরিভেটিভ তৈরি করতে রাসায়নিকভাবে পরিবর্তিত হয়।\n\t\u003cul\u003e\n\t\t\u003cli\u003e\u003cstrong\u003eরাইবোথাইমিডিন:\u003c/strong\u003e এই পরিবর্তনে ইউরিডিনের মিথাইলেশন জড়িত যা রাইবোথাইমিডিন তৈরি করে। রাইবোথাইমিডিন, প্রায়শই tRNA-এর T-লুপে পাওয়া যায়, অণুর তৃতীয় কাঠামো এবং স্থায়িত্বে অবদান রাখে।\u003c/li\u003e\n\t\t\u003cli\u003e\u003cstrong\u003eসিউডোরিডিন:\u003c/strong\u003e ইউরিডিনের আইসোমারাইজেশনের মাধ্যমে সিউডোরিডিন গঠিত হয়, যেখানে নাইট্রোজেন-কার্বন বন্ধন একটি কার্বন-কার্বন বন্ধন তৈরি করার জন্য পুনরায় সাজানো হয়। এই পরিবর্তনটি tRNA-এর হাইড্রোজেন বন্ধন ক্ষমতা বাড়ায়, অনুবাদ প্রক্রিয়ার সময় এর কাঠামোগত অখণ্ডতা এবং কার্যকারিতা উন্নত করে।\u003c/li\u003e\n\t\u003c/ul\u003e\n\t\u003c/li\u003e\n\t\u003cli\u003eএই পরিবর্তনগুলি tRNA-এর সঠিক ভাঁজ এবং প্রোটিন সংশ্লেষণের সময় রাইবোসোম এবং অ্যামিনোঅ্যাসাইল-tRNA সিন্থেটেসের সাথে আবদ্ধ হওয়ার ক্ষমতার জন্য গুরুত্বপূর্ণ।\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003cp\u003e\u003cimg alt=\"\" src=\"//cdn.testbook.com/images/production/quesImages/qImage65b8eb45d2a0f05313b4ba2c.png\" style=\"color: rgb(33, 37, 41);\" /\u003e\u003c/p\u003e\n\n\u003cp\u003e\u003cspan style=\"display: flex;gap: 6px;align-items: center;\"\u003e\u003cimg height=\"26px\" src=\"//cdn.testbook.com/resources/lms_creative_elements/additional-information-image.png\" width=\"26px\" /\u003e\u003cu style=\"font-size: 20px; font-weight: 700;\"\u003eAdditional Information\u003c/u\u003e\u003c/span\u003eএকটি tRNA অণুর বিস্তারিত গঠন এবং বৈশিষ্ট্য:-\u003c/p\u003e\n\n\u003cul style=\"color: rgb(33, 37, 41);\"\u003e\n\t\u003cli\u003e\u003cspan style=\"font-weight: bolder;\"\u003eঅ্যাকসেপ্টর স্টেম\u003c/span\u003e: এটি একটি সাত-বেস পেয়ার (bp) স্টেম যা 5\u0026#39;-টার্মিনাল নিউক্লিওটাইডের সাথে 3\u0026#39;-টার্মিনাল নিউক্লিওটাইডের বেস-পেয়ারিং দ্বারা গঠিত। এই স্টেম tRNA-তে সার্বজনীনভাবে সংরক্ষিত। tRNA-এর 3\u0026rsquo; প্রান্তে, CCA ক্রম পাওয়া যায় যেখানে অ্যামিনো অ্যাসিড সংযুক্ত হয়।\u003c/li\u003e\n\t\u003cli\u003e\u003cspan style=\"font-weight: bolder;\"\u003eD-আর্ম: \u003c/span\u003e\u0026quot;ডাইহাইড্রোরিডিন আর্ম\u0026quot;-এর সংক্ষিপ্ত রূপ, এটি সাধারণত একটি চার bp স্টেম যা একটি লুপে শেষ হয় যেখানে (অনেক ক্ষেত্রে) বেশ কয়েকটি D (ডাইহাইড্রোরিডিন) অবশেষ থাকে। ডাইহাইড্রোরিডিন হল নিউক্লিওসাইড ইউরিডিন (U)-এর একটি পরিবর্তিত রূপ। D-আর্ম সঠিক অ্যামিনোঅ্যাসাইল-tRNA সিন্থেটেস দ্বারা স্বীকৃতির জন্য অত্যন্ত গুরুত্বপূর্ণ, যা নিশ্চিত করে যে সঠিক অ্যামিনো অ্যাসিড tRNA-এর সাথে সংযুক্ত হয়েছে।\u003c/li\u003e\n\t\u003cli\u003e\u003cspan style=\"font-weight: bolder;\"\u003eঅ্যান্টিকোডন আর্ম: \u003c/span\u003eএই আর্ম প্রোটিন সংশ্লেষণের ক্ষেত্রে tRNA-এর \u0026quot;কার্যকরী অংশ\u0026quot; ধারণ করে। এটি একটি পাঁচ bp স্টেম যার লুপে অ্যান্টিকোডন থাকে। একটি অ্যান্টিকোডন হল তিনটি নিউক্লিওটাইডের একটি ক্রম যা mRNA-এর কোডনের পরিপূরক। উদাহরণস্বরূপ, যদি mRNA-তে কোডন ক্রম AUG হয়, তাহলে tRNA-তে অ্যান্টিকোডন হবে UAC।\u003c/li\u003e\n\t\u003cli\u003e\u003cspan style=\"font-weight: bolder;\"\u003eT আর্ম\u003c/span\u003e: \u0026quot;T\u0026Psi;C আর্ম\u0026quot; নামে পরিচিত, এটি একটি পাঁচ bp স্টেম যার একটি লুপে T\u0026Psi;C ক্রম থাকে (যেখানে \u0026Psi; হল সিউডোরিডিন, একটি পরিবর্তিত ইউরিডিন)। এই অংশটি প্রোটিন সংশ্লেষণের সময় রাইবোসোমের সাথে আবদ্ধ হওয়ার সাথে জড়িত।\u003c/li\u003e\n\t\u003cli\u003e\u003cspan style=\"font-weight: bolder;\"\u003eভেরিয়েবল লুপ:\u003c/span\u003e এটি এমন একটি অঞ্চল যা বিভিন্ন tRNA-এর মধ্যে দৈর্ঘ্য, 3 থেকে 21 নিউক্লিওটাইড এবং অনুক্রমের মধ্যে পরিবর্তিত হয়। এর কাজ স্পষ্ট নয় তবে এটি tRNA-এর সঠিক ভাঁজ এবং স্থিতিশীলতায় সহায়তা করতে পারে।\u003c/li\u003e\n\t\u003cli\u003e\u003cspan style=\"font-weight: bolder;\"\u003eজটিল পরিবর্তন: \u003c/span\u003etRNA-তে বিভিন্ন নিউক্লিওবেস প্রতিলিপিকরণ-পরবর্তী নির্দিষ্ট এনজাইম দ্বারা ভারী এবং অনন্যভাবে পরিবর্তিত হয়। tRNA-তে 100 টিরও বেশি বিভিন্ন পরিবর্তন পাওয়া গেছে, যা তাদের স্থিতিশীলতা এবং কার্যকারিতায় অবদান রাখে।\u003c/li\u003e\n\t\u003cli\u003e\u003cspan style=\"font-weight: bolder;\"\u003eL-আকৃতির কাঠামো:\u003c/span\u003e tRNA অণুগুলি একটি L-আকৃতির ত্রি-মাত্রিক কাঠামোতে মোচড় দেয় যা অ্যামিনো অ্যাসিড বাইন্ডিং সাইট এবং অ্যান্টিকোডনকে কাছাকাছি নিয়ে আসে। অ্যামিনো অ্যাসিড অণুর এক প্রান্তে (অ্যাকসেপ্টর স্টেম) আবদ্ধ হয়, যখন অ্যান্টিকোডন অন্য প্রান্তে অবস্থিত।\u003c/li\u003e\n\u003c/ul\u003e\n","type":"tb","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Fundamental Processes"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a451aec9ba648bc86fbf43","title":"Fundamental Processes"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":12.581000848176418,"attempts":{"correct":69,"incorrect":267,"partial":0,"skipped":843,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953950a25b7b429e6d97cd":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;systemin, an 18 amino-acid peptide\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Microbe-Associated Molecular Patterns (MAMPs), also referred to as Pathogen-Associated Molecular Patterns (PAMPs), are conserved molecular motifs found in microbes. These molecules are recognized by plant innate immune systems to trigger defense responses.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;MAMPs are essential components or products of microbial metabolism and are typically conserved among a class of microbes (e.g., bacteria, fungi, viruses).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Examples of MAMPs include bacterial flagellin (e.g., flg22), elongation factors (e.g., elf26), fungal chitin, and lipopolysaccharides (LPS).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;However, certain peptides like \u0026amp;quot;systemin\u0026amp;quot; are not considered MAMPs, as they are plant-derived signaling molecules rather than microbial markers.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Systemin, an 18 amino-acid peptide:\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Systemin is a plant-derived peptide that acts as a signaling molecule in the systemic wound response of plants, particularly in tomato and other Solanaceae species.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;It is not a MAMP because it originates from the plant itself and does not represent a conserved microbial structure.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;This differentiates it from microbial molecules that are recognized as MAMPs.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;flg22, a 22 amino-acid peptide:\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Flg22 is a conserved peptide derived from the bacterial flagellin protein.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;It is a well-known MAMP that is recognized by plant pattern recognition receptors (PRRs) such as FLS2 (Flagellin-Sensitive 2) to trigger immune responses.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;pep13, a 13 amino-acid peptide:\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Pep13 is a peptide derived from a fungal elicitor protein, recognized as a MAMP by plant immune systems.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;It plays a role in activating plant defenses against fungal pathogens.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;elf26, a 26 amino-acid peptide:\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Elf26 is a peptide derived from the bacterial elongation factor Tu (EF-Tu), which is another well-characterized MAMP.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;It is detected by plant PRRs such as EFR (EF-Tu Receptor), leading to immune responses.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;सिस्टेमिन, एक 18 एमिनो-अम्ल\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;पेप्टाइड\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;\u0026amp;nbsp;हैं।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अवधारणा\u0026lt;/span\u0026gt;:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;सूक्ष्मजीव-संबद्ध आणविक प्रतिरूप (MAMPs), जिन्हें रोगजनक-संबद्ध आणविक प्रतिरूप (PAMPs) भी कहा जाता है, सूक्ष्मजीवों में पाए जाने वाले संरक्षित आणविक रूपांकन हैं। ये अणु पादप जन्मजात प्रतिरक्षा प्रणालियों द्वारा रक्षा प्रतिक्रियाओं को ट्रिगर करने के लिए पहचाने जाते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;MAMPs सूक्ष्मजीवीय \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;उपापचय\u0026amp;nbsp;\u0026lt;/span\u0026gt;के आवश्यक घटक या उत्पाद हैं और आमतौर पर सूक्ष्मजीवों के एक वर्ग (जैसे, \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;जीवाणु\u0026lt;/span\u0026gt;, कवक, \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;विषाणु\u0026lt;/span\u0026gt;) के बीच संरक्षित होते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;MAMPs के उदाहरणों में जीवाणु \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;फ्लैजेलिन\u0026amp;nbsp;\u0026lt;/span\u0026gt;(जैसे, flg22), \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;दीर्घीकरण\u0026amp;nbsp;\u0026lt;/span\u0026gt;कारक (जैसे, elf26), कवक काइटिन और लिपोपॉलीसेकेराइड (LPS) शामिल हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;हालांकि, \u0026amp;quot;सिस्टेमिन\u0026amp;quot; जैसे कुछ पेप्टाइड्स को MAMPs नहीं माना जाता है, क्योंकि वे पादप-व्युत्पन्न \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;संकेतन\u0026amp;nbsp;\u0026lt;/span\u0026gt;अणु हैं न कि सूक्ष्मजीवीय \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;चिह्नक\u0026lt;/span\u0026gt;।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;सिस्टेमिन, एक 18 एमिनो-\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अम्ल\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;strong\u0026gt;पेप्टाइड:\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;सिस्टेमिन एक पादप-व्युत्पन्न पेप्टाइड है जो पौधों की \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;दैहिक\u0026amp;nbsp;\u0026lt;/span\u0026gt;घाव प्रतिक्रिया में एक \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;संकेतन\u0026amp;nbsp;\u0026lt;/span\u0026gt;अणु के रूप में कार्य करता है, विशेष रूप से टमाटर और अन्य सोलेनेसी प्रजातियों में।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह एक MAMP नहीं है क्योंकि यह स्वयं पौधे से उत्पन्न होता है और एक संरक्षित सूक्ष्मजीवीय संरचना का प्रतिनिधित्व नहीं करता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह इसे सूक्ष्मजीवीय अणुओं से अलग करता है जिन्हें MAMPs के रूप में पहचाना जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;flg22, एक 22 एमिनो-\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अम्ल\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;strong\u0026gt;पेप्टाइड:\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Flg22 एक संरक्षित पेप्टाइड है जो जीवाणु \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;फ्लैजेलिन\u0026amp;nbsp;\u0026lt;/span\u0026gt; प्रोटीन से प्राप्त होता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह एक प्रसिद्ध MAMP है जिसे पादप पैटर्न पहचान \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;ग्राही\u0026amp;nbsp;\u0026lt;/span\u0026gt;(PRRs) जैसे FLS2 (\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;फ्लैजेलिन\u0026lt;/span\u0026gt;-संवेदनशील 2) द्वारा प्रतिरक्षा प्रतिक्रियाओं को ट्रिगर करने के लिए पहचाना जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;pep13, एक 13 एमिनो-\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अम्ल\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;strong\u0026gt;पेप्टाइड:\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Pep13 एक कवक इलिसिटर प्रोटीन से प्राप्त पेप्टाइड है, जिसे पादप प्रतिरक्षा प्रणालियों द्वारा MAMP के रूप में पहचाना जाता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह कवक रोगजनकों के खिलाफ पादप सुरक्षा को सक्रिय करने में भूमिका निभाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;elf26, एक 26 एमिनो-\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अम्ल\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;पेप्टाइड\u0026lt;/strong\u0026gt;:\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Elf26 एक पेप्टाइड है जो जीवाणु \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;दीर्घीकरण\u0026lt;/span\u0026gt;\u0026amp;nbsp;कारक Tu (EF-Tu) से प्राप्त होता है, जो एक अन्य अच्छी तरह से चिह्नित MAMP है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह पादप PRRs जैसे EFR (EF-Tu \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;ग्राही\u0026lt;/span\u0026gt;) द्वारा पता लगाया जाता है, जिससे प्रतिरक्षा प्रतिक्रियाएँ होती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["System Physiology Plant"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4526f5db927c0ec7fb376","title":"System Physiology Plant"},"t":{"id":"63a452a78f21ac91a2eba412","title":"Stress physiology"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":7.764206955046647,"attempts":{"correct":46,"incorrect":88,"partial":0,"skipped":1045,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895395f3005e0e0585975db":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;160 \u0026amp;plusmn; 20 mg/dl of blood cholesterol concentration in human athletes\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;A Gaussian or normal distribution is a bell-shaped curve, often used to describe continuous data that is symmetrically distributed around the mean.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;For a dataset to follow a Gaussian distribution, the mean and standard deviation (SD) should reflect realistic and balanced variability in the data, and the values should not violate natural constraints (e.g., negative values for inherently non-negative measurements).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Characteristics of Gaussian Data:\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Most values cluster around the mean, and fewer observations fall far from the mean.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;The standard deviation provides an estimate of the spread of the data. A smaller SD relative to the mean indicates that data points are closer to the mean.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Real-world measurements, such as blood parameters, often approximate a Gaussian distribution if measured under controlled conditions.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;For a Gaussian distribution, the data should be symmetrically distributed among the mean and should not include negative values.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;296 \u0026amp;plusmn; 190 picomolar concentration of insulin in human blood samples\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;This dataset has a very high standard deviation (190) compared to the mean (296), suggesting that the data is highly variable and spread out.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;58 \u0026amp;plusmn; 45 number of a particular species of bacteria in the rhizosphere\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Here, the standard deviation (45) is a large proportion of the mean (58), indicating significant variability. Such variability implies the possibility of non-Gaussian distribution.\u0026amp;nbsp;\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;160 \u0026amp;plusmn; 20 mg/dl of blood cholesterol concentration in human athletes (Correct Answer)\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;The mean (160) and standard deviation (20) are reasonable and proportional, indicating a controlled variability in the dataset.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Blood cholesterol concentration is a continuous variable that often follows a Gaussian distribution in healthy populations, particularly under controlled sampling conditions (e.g., human athletes).\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Furthermore, cholesterol levels are inherently non-negative, and the small SD minimizes the possibility of negative or implausible values.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;4 \u0026amp;plusmn; 8 number of insects caught in a trap from an agricultural field\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;The standard deviation (8) is twice the value of the mean (4), indicating extreme variability.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Counts of insects are discrete and non-negative, and such high variability increases the likelihood of non-Gaussian distribution. Negative values are impossible, making this dataset implausible for normal distribution.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;मानव एथलीटों में रक्त कोलेस्ट्रॉल सांद्रता का 160 \u0026amp;plusmn; 20 mg/dl\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;\u0026amp;nbsp;है।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अवधारणा\u0026lt;/span\u0026gt;:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;एक गैसियन या सामान्य वितरण एक घंटी के आकार का वक्र है, जिसका उपयोग अक्सर सतत डेटा का वर्णन करने के लिए किया जाता है जो माध्य के चारों ओर सममित रूप से वितरित होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;किसी \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;आंकड़ा समुच्चय\u0026lt;span style=\u0026quot;white-space:pre\u0026quot;\u0026gt; \u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;के लिए गैसियन वितरण का पालन करने के लिए, माध्य और मानक विचलन (SD) को डेटा में यथार्थवादी और संतुलित परिवर्तनशीलता को दर्शाना चाहिए, और मानों को प्राकृतिक बाधाओं का उल्लंघन नहीं करना चाहिए (जैसे, स्वाभाविक रूप से गैर-ऋणात्मक माप के लिए ऋणात्मक मान)।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;गैसियन डेटा की विशेषताएँ:\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;अधिकांश मान माध्य के आसपास समूहीकृत होते हैं, और कम अवलोकन माध्य से दूर होते हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;मानक विचलन डेटा के प्रसार का अनुमान प्रदान करता है। माध्य के सापेक्ष एक छोटा SD इंगित करता है कि डेटा बिंदु माध्य के करीब हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;वास्तविक दुनिया के माप, जैसे रक्त पैरामीटर, अक्सर नियंत्रित परिस्थितियों में मापा जाने पर गैसियन वितरण का अनुमान लगाते हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;गैसियन वितरण के लिए, डेटा को माध्य के बीच सममित रूप से वितरित किया जाना चाहिए और इसमें ऋणात्मक मान शामिल नहीं होने चाहिए।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;मानव रक्त के नमूनों में इंसुलिन की 296 \u0026amp;plusmn; 190 पिकोमोलर सांद्रता\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;इस \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;आंकड़ा समुच्चय\u0026lt;span style=\u0026quot;white-space:pre\u0026quot;\u0026gt; \u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;में माध्य (296) की तुलना में बहुत अधिक मानक विचलन (190) है, यह सुझाव देता है कि डेटा अत्यधिक परिवर्तनशील और फैला हुआ है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;मूलपरिवेश\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;strong\u0026gt;में एक विशेष प्रजाति के जीवाणुओं की 58 \u0026amp;plusmn; 45 संख्या\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;यहाँ, मानक विचलन (45) माध्य (58) का एक बड़ा अनुपात है, जो महत्वपूर्ण परिवर्तनशीलता को दर्शाता है। इस तरह की परिवर्तनशीलता गैर-गैसियन वितरण की संभावना का अर्थ है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;मानव एथलीटों में रक्त कोलेस्ट्रॉल सांद्रता का 160 \u0026amp;plusmn; 20 mg/dl (सही उत्तर)\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;माध्य (160) और मानक विचलन (20) उचित और आनुपातिक हैं, जो \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;आंकड़ा समुच्चय\u0026lt;span style=\u0026quot;white-space:pre\u0026quot;\u0026gt; \u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;में नियंत्रित परिवर्तनशीलता को दर्शाते हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;रक्त कोलेस्ट्रॉल सांद्रता एक सतत चर है जो अक्सर स्वस्थ आबादी में गैसियन वितरण का पालन करता है, खासकर नियंत्रित नमूनाकरण स्थितियों (जैसे, मानव एथलीट) के तहत।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;इसके अलावा, कोलेस्ट्रॉल का स्तर स्वाभाविक रूप से गैर-ऋणात्मक है, और छोटा SD ऋणात्मक या असंभव मानों की संभावना को कम करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;एक कृषि क्षेत्र से एक जाल में पकड़े गए \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;कीटों\u0026amp;nbsp;\u0026lt;/span\u0026gt;की 4 \u0026amp;plusmn; 8 संख्या\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;मानक विचलन (8) माध्य (4) के मान का दोगुना है, जो अत्यधिक परिवर्तनशीलता को दर्शाता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;कीटों\u0026amp;nbsp;\u0026lt;/span\u0026gt;की गणना असतत और गैर-ऋणात्मक है, और इस तरह की उच्च परिवर्तनशीलता गैर-गैसियन वितरण की संभावना को बढ़ाती है। ऋणात्मक मान असंभव हैं, जिससे यह \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;आंकड़ा समुच्चय\u0026lt;span style=\u0026quot;white-space:pre\u0026quot;\u0026gt; \u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;सामान्य वितरण के लिए असंभव हो जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Methods in Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4566d978874fc5c7a0d11","title":"Methods in Biology"},"t":{"id":"63a456cbd3b5fd9703bb87c8","title":"Biostatistical Methods"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":7.371501272264634,"attempts":{"correct":40,"incorrect":52,"partial":0,"skipped":1087,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895396e9eb05a9f9ac786ed":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Desert grasslands of Rajasthan\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;b\u0026gt;\u0026lt;u\u0026gt;Explanation:\u0026lt;/u\u0026gt;\u0026lt;/b\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The Great Indian Bustard (\u0026lt;em\u0026gt;Ardeotis nigriceps\u0026lt;/em\u0026gt;) is one of the most critically endangered bird species, primarily found in India. It is listed as \u0026amp;quot;Critically Endangered\u0026amp;quot; in the International Union for Conservation of Nature (IUCN) Red List.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This species is endemic to the Indian subcontinent and prefers habitats characterized by open landscapes like grasslands, scrublands, and semi-arid desert regions.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The \u0026lt;strong\u0026gt;desert grasslands of Rajasthan\u0026lt;/strong\u0026gt;, particularly the Thar Desert region, are considered its primary habitat\u0026amp;nbsp;\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;राजस्थान के रेगिस्तानी घास के मैदान\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;\u0026amp;nbsp;है।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;b\u0026gt;\u0026lt;u\u0026gt;व्याख्या:\u0026lt;/u\u0026gt;\u0026lt;/b\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;ग्रेट इंडियन बस्टर्ड (\u0026lt;em\u0026gt;आर्डियोटिस \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;नाइग्रिसेप्स\u0026lt;/span\u0026gt;\u0026lt;/em\u0026gt;) भारत में पाए जाने वाले सबसे गंभीर रूप से संकटग्रस्त पक्षी प्रजातियों में से एक है। इसे अंतर्राष्ट्रीय प्रकृति संरक्षण संघ (IUCN) की \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;लाल सूची\u0026lt;/span\u0026gt; में \u0026amp;quot;गंभीर रूप से संकटग्रस्त\u0026amp;quot; के रूप में सूचीबद्ध किया गया है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह प्रजाति भारतीय उपमहाद्वीप के लिए स्थानिक है और खुले परिदृश्य जैसे घास के मैदानों, झाड़ीदार भूमि और अर्ध-शुष्क रेगिस्तानी क्षेत्रों को प्राथमिकता देती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;राजस्थान के रेगिस्तानी घास के मैदान\u0026lt;/strong\u0026gt;, विशेष रूप से थार रेगिस्तान क्षेत्र, को इसका प्राथमिक आवास माना जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Ecological Principles"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a45541e89684161ccd7911","title":"Ecological Principles"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":9.91348600508905,"attempts":{"correct":180,"incorrect":131,"partial":0,"skipped":868,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689539808aebc97d87cfcf23":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Cyanobacteria (Blue-green algae)\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;b\u0026gt;\u0026lt;u\u0026gt;Explanation:\u0026lt;/u\u0026gt;\u0026lt;/b\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Taxonomy is the science of classifying organisms, governed by specific rules laid out in codes such as the International Code of Nomenclature for algae, fungi, and plants (ICN) and the International Code of Nomenclature of Prokaryotes (ICNP).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Cyanobacteria are a group of photosynthetic bacteria.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Because they are prokaryotes, they fall under the jurisdiction of the ICNP.\u0026amp;nbsp; However, they are also classified based on their ecological and morphological similarities to algae, thus allowing them to receive genus names under the ICN as well. Authors have the flexibility to choose the code under which they name Cyanobacteria.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This unique status arises because of their dual classification: as bacteria (prokaryotes) under ICNP and as algae-like organisms under ICN.\u0026amp;nbsp;\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Other\u0026amp;nbsp;Options:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Chlorophyta (Green algae):\u0026lt;/strong\u0026gt; Chlorophyta are eukaryotic algae and thus fall exclusively under the jurisdiction of the ICN.\u0026amp;nbsp;\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Bacillariophyta (Diatoms):\u0026lt;/strong\u0026gt; Bacillariophyta are also eukaryotic algae and are governed solely by the ICN.\u0026amp;nbsp;\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Mycetozoa (Slime molds):\u0026lt;/strong\u0026gt; Mycetozoa are eukaryotic organisms and are primarily governed by the ICN.\u0026amp;nbsp;\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;सायनोबैक्टीरिया (नील-हरित शैवाल)\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;है।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;b\u0026gt;\u0026lt;u\u0026gt;व्याख्या:\u0026lt;/u\u0026gt;\u0026lt;/b\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;वर्गीकरण\u0026amp;nbsp;जीवों को वर्गीकृत करने का विज्ञान है, जो शैवाल, कवक और पौधों के लिए अंतर्राष्ट्रीय नामकरण संहिता (ICN) और प्रोकैरियोट्स के लिए अंतर्राष्ट्रीय नामकरण संहिता (ICNP) जैसे कोड\u0026amp;nbsp;में निर्धारित विशिष्ट नियमों द्वारा शासित होता है।\u0026lt;/span\u0026gt;\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;सायनोबैक्टीरिया प्रकाश संश्लेषी जीवाणुओं का एक समूह है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;चूँकि वे प्रोकैरियोट्स हैं, इसलिए वे ICNP के अधिकार क्षेत्र में आते हैं। हालाँकि, उन्हें शैवाल से उनकी पारिस्थितिक और रूपात्मक समानताओं के आधार पर भी वर्गीकृत किया जाता है, जिससे उन्हें ICN के अंतर्गत भी वंश नाम प्राप्त करती है। लेखकों के पास सायनोबैक्टीरिया\u0026amp;nbsp;का नामकरण करने के लिए कोड चुनने की स्वतंत्रता होती है।\u0026lt;/span\u0026gt;\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अद्वितीय\u0026amp;nbsp;\u0026lt;/span\u0026gt;स्थिति उनके दोहरे वर्गीकरण के कारण उत्पन्न होती है: ICNP के अंतर्गत जीवाणु (प्रोकैरियोट्स) के रूप में और ICN के अंतर्गत शैवाल जैसे जीवों के रूप में।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;क्लोरोफाइटा (हरित शैवाल):\u0026lt;/strong\u0026gt; क्लोरोफाइटा यूकेरियोटिक शैवाल हैं और इस प्रकार विशेष रूप से ICN के अधिकार क्षेत्र में आते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;बैसिलेरियोफाइटा\u0026amp;nbsp;\u0026lt;/span\u0026gt;(डायटम):\u0026lt;/strong\u0026gt; \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;बैसिलेरियोफाइटा\u0026amp;nbsp;\u0026lt;/span\u0026gt;भी यूकेरियोटिक शैवाल हैं और केवल ICN द्वारा शासित हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;माइसिटोजोआ (स्लाइम मोल्ड्स):\u0026lt;/strong\u0026gt; माइसिटोजोआ यूकेरियोटिक जीव हैं और मुख्य रूप से ICN द्वारा शासित हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Diversity of Life Forms"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a45511ef5b5403de57d744","title":"Diversity of Life Forms"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":14.748939779474128,"attempts":{"correct":152,"incorrect":107,"partial":0,"skipped":920,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689539934bf9040e58ef7fd4":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;It forms the transcription initiation complex by interacting with RNA pol II and TBP.\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Transcription in eukaryotic cells is a highly regulated process that involves the assembly of a pre-initiation complex (PIC) at the promoter region of the DNA.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;TFIIB (Transcription Factor IIB) is one of the general transcription factors involved in the initiation phase of transcription by RNA polymerase II.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;It plays a crucial role in bridging the interaction between RNA polymerase II, the TATA-binding protein (TBP), and the promoter region, ensuring the proper assembly of the transcription initiation complex.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;TFIIB helps in recruiting RNA polymerase II to the promoter region and ensures that it is properly positioned to initiate transcription at the correct start site.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Additionally, TFIIB aids in stabilizing the interaction between other general transcription factors and the promoter, facilitating the formation of a functional pre-initiation complex.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage68a44fe208f0efe089613fa2.png\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Additional information:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;TFIID\u0026lt;/strong\u0026gt;: This is a complex protein made up of several subunits, including the TATA-binding protein (TBP) and TBP-Associated Factors (TAFs). TFIID primarily contributes to promoter recognition and binding, as it recognizes and binds to the TATA box, a sequence found in the promoter region of many genes.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;TFIIH:\u0026lt;/strong\u0026gt; This transcription factor has two main functionalities. One is the kinase activity, which phosphorylates the C-terminal domain of RNA polymerase II, marking the transition from the initiation phase of transcription to the elongation phase. The other is the ATPase/helicase activity, which unwinds the DNA at the transcription start site, breaking the hydrogen bonds between the DNA strands. This allows RNA polymerase to access the template strand and start synthesizing RNA.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;TFIIF\u0026lt;/strong\u0026gt;: This factor is known to stabilize RNA polymerase II interaction with TFIID and TFIIB and plays a significant role in the elongation phase of transcription. It helps RNA polymerase II in the locating the start point of transcription.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;TFIIE\u0026lt;/strong\u0026gt;: This factor helps recruit TFIIH to the pre-initiation complex during the initiation of transcription. It also plays a significant role in facilitating TFIIH\u0026amp;#39;s helicase activity, but it doesn\u0026amp;#39;t itself exhibit ATPase or helicase activities.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर है \u0026lt;strong\u0026gt;-\u0026amp;nbsp;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;यह RNA pol II और TBP के साथ अंत:क्रिया करके अनुलेखन\u0026amp;nbsp; आरंभ संकुल बनाता है।\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यूकेरियोटिक कोशिकाओं में \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अनुलेखन\u0026lt;/span\u0026gt;\u0026amp;nbsp;एक अत्यधिक विनियमित प्रक्रिया है जिसमें DNA के \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;प्रवर्तक\u0026amp;nbsp;\u0026lt;/span\u0026gt;क्षेत्र में पूर्व-आरंभ संकुल (PIC) का संयोजन शामिल है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;TFIIB (\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अनुलेखन\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;कारक\u0026amp;nbsp;\u0026lt;/span\u0026gt;IIB) RNA पॉलीमरेज़ II द्वारा \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अनुलेखन\u0026amp;nbsp;\u0026lt;/span\u0026gt;के आरंभ चरण में शामिल सामान्य \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अनुलेखन\u0026amp;nbsp; \u0026lt;/span\u0026gt;कारकों में से एक है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह RNA पॉलीमरेज़ II, TATA-बंधन प्रोटीन (TBP), और \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;प्रवर्तक\u0026amp;nbsp;\u0026lt;/span\u0026gt;क्षेत्र के बीच \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अंत:क्रिया\u0026lt;span style=\u0026quot;white-space:pre\u0026quot;\u0026gt; \u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;को जोड़ने में एक महत्वपूर्ण भूमिका निभाता है, जिससे \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अनुलेखन\u0026amp;nbsp;\u0026lt;/span\u0026gt;आरंभ संकुल का उचित संयोजन सुनिश्चित होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;TFIIB RNA पॉलीमरेज़ II को \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;प्रवर्तक\u0026amp;nbsp;\u0026lt;/span\u0026gt;क्षेत्र में भर्ती करने में मदद करता है और यह सुनिश्चित करता है कि यह सही प्रारंभ स्थल पर \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अनुलेखन\u0026amp;nbsp;\u0026lt;/span\u0026gt;शुरू करने के लिए ठीक से स्थित है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इसके अतिरिक्त, TFIIB अन्य सामान्य \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अनुलेखन\u0026amp;nbsp;\u0026lt;/span\u0026gt;कारकों और \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;प्रवर्तक\u0026amp;nbsp;\u0026lt;/span\u0026gt;के बीच \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अंत:क्रिया\u0026lt;span style=\u0026quot;white-space:pre\u0026quot;\u0026gt; \u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;को स्थिर करने में मदद करता है, जिससे एक कार्यात्मक पूर्व-आरंभ संकुल का निर्माण होता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage68a44fe208f0efe089613fa2.png\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;अतिरिक्त जानकारी:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;TFIID\u0026lt;/strong\u0026gt;: यह एक जटिल प्रोटीन है जो कई \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;उपइकाई\u0026amp;nbsp;\u0026lt;/span\u0026gt;से बना होता है, जिसमें TATA-बंधन प्रोटीन (TBP) और TBP-संबद्ध कारक (TAFs) शामिल हैं। TFIID मुख्य रूप से \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;प्रवर्तक\u0026amp;nbsp; \u0026lt;/span\u0026gt;पहचान और बंधन में योगदान देता है, क्योंकि यह TATA बॉक्स को पहचानता है और उससे जुड़ता है, जो कई जीनों के \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;प्रवर्तक\u0026amp;nbsp;\u0026lt;/span\u0026gt;क्षेत्र में पाया जाने वाला एक क्रम है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;TFIIH:\u0026lt;/strong\u0026gt; इस \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अनुलेखन\u0026amp;nbsp;\u0026lt;/span\u0026gt;कारक के दो मुख्य कार्य हैं। एक है \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;काइनेज\u0026amp;nbsp;प्रतिक्रिया\u0026lt;/span\u0026gt;, जो RNA पॉलीमरेज़ II के C-टर्मिनल \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;क्षेत्र\u0026amp;nbsp;\u0026lt;/span\u0026gt;को \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;फॉस्फोरिलीकृत\u0026amp;nbsp;\u0026lt;/span\u0026gt;करती है, जो \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अनुलेखन\u0026amp;nbsp;\u0026lt;/span\u0026gt;के आरंभ चरण से दीर्घीकरण चरण में संक्रमण को चिह्नित करता है। दूसरा है ATPase/हेलीकेज़ \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;प्रतिक्रिया\u0026lt;/span\u0026gt;, जो \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अनुलेखन\u0026amp;nbsp;\u0026lt;/span\u0026gt;प्रारंभ स्थल पर DNA को खोलती है, DNA \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;रज्जुकों\u0026amp;nbsp;\u0026lt;/span\u0026gt;के बीच हाइड्रोजन बंध\u0026amp;nbsp;को तोड़ती है। यह RNA पॉलीमरेज़ को टेम्पलेट \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;रज्जुक\u0026amp;nbsp;\u0026lt;/span\u0026gt;तक पहुँचने और RNA का संश्लेषण शुरू करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;TFIIF\u0026lt;/strong\u0026gt;: यह कारक TFIID और TFIIB के साथ RNA पॉलीमरेज़ II की \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अंत:क्रिया\u0026lt;span style=\u0026quot;white-space:pre\u0026quot;\u0026gt; \u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;को स्थिर करने के लिए जाना जाता है और \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अनुलेखन\u0026amp;nbsp;\u0026lt;/span\u0026gt;के दीर्घीकरण चरण में एक महत्वपूर्ण भूमिका निभाता है। यह RNA पॉलीमरेज़ II को \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अनुलेखन\u0026amp;nbsp;\u0026lt;/span\u0026gt;के प्रारंभ बिंदु का पता लगाने में मदद करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;TFIIE\u0026lt;/strong\u0026gt;: यह कारक \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अनुलेखन\u0026amp;nbsp;\u0026lt;/span\u0026gt;के आरंभ के दौरान पूर्व-आरंभ संकुल में TFIIH को भर्ती करने में मदद करता है। यह TFIIH की हेलीकेज़ \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;प्रतिक्रिया\u0026amp;nbsp;\u0026lt;/span\u0026gt;को सुविधाजनक बनाने में भी महत्वपूर्ण भूमिका निभाता है, लेकिन यह स्वयं ATPase या हेलीकेज़ \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;प्रतिक्रिया\u0026amp;nbsp;\u0026lt;/span\u0026gt;का प्रदर्शन नहीं करता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Fundamental Processes"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a451aec9ba648bc86fbf43","title":"Fundamental Processes"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":13.762510602205264,"attempts":{"correct":164,"incorrect":153,"partial":0,"skipped":862,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689539a3cc49566a430d85f2":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;E\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;ndocytic vesicles\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Lipid monolayers are structures composed of a single layer of lipid molecules. They are commonly found in certain biological and biochemical systems where they surround hydrophobic cores or serve as a boundary layer for specific organelles or particles.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In contrast, most cellular membranes, such as those of vesicles, are composed of lipid bilayers. A lipid bilayer is made up of two layers of lipid molecules that form a barrier separating the internal environment from the external surroundings.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Lipid droplet:\u0026lt;/strong\u0026gt;\u0026amp;nbsp;Lipid droplets are intracellular organelles primarily involved in lipid storage. They are composed of a hydrophobic core of neutral lipids (e.g., triglycerides and cholesterol esters) surrounded by a phospholipid monolayer. The monolayer structure is necessary because the hydrophobic core does not require the additional protection of a bilayer, as it is not exposed to aqueous environments internally.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Very low-density lipoprotein (VLDL):\u0026lt;/strong\u0026gt;\u0026amp;nbsp;VLDLs are a class of lipoproteins that transport lipids (such as triglycerides) through the bloodstream. These particles have a hydrophobic core of triglycerides and cholesterol esters surrounded by a phospholipid monolayer, along with embedded apolipoproteins. The monolayer facilitates their function in lipid transport.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Endocytic vesicles:\u0026lt;/strong\u0026gt;\u0026amp;nbsp;Endocytic vesicles are cellular structures involved in the internalization of materials (e.g., nutrients, signaling molecules) from the extracellular environment. These vesicles are composed of lipid bilayers, not monolayers. The bilayer structure is essential for encapsulating and transporting materials within the aqueous environment of the cytoplasm.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Chylomicrons:\u0026lt;/strong\u0026gt;\u0026amp;nbsp;Chylomicrons are lipoprotein particles that transport dietary lipids (e.g., triglycerides, cholesterol) from the intestines to other tissues in the body. Similar to VLDLs, they have a hydrophobic core surrounded by a lipid monolayer with embedded proteins.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अंतःपुटी अंतर्वलन\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;\u0026amp;nbsp;हैं।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अवधारणा\u0026lt;/span\u0026gt;:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;लिपिड \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;एकस्तर\u0026amp;nbsp;\u0026lt;/span\u0026gt;लिपिड अणुओं की एकल परत से बनी संरचनाएँ हैं। वे कुछ जैविक और जैव रासायनिक प्रणालियों में सामान्यतः पाए जाते हैं जहाँ वे \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;जलविरागी\u0026amp;nbsp;\u0026lt;/span\u0026gt;कोर को घेरते हैं या विशिष्ट कोशिकांगों या कणों के लिए एक सीमा परत के रूप में कार्य करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इसके विपरीत, अधिकांश कोशिकीय झिल्लियाँ, जैसे पुटिकाओं की, लिपिड \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;दोहरी परत\u0026amp;nbsp;\u0026lt;/span\u0026gt;से बनी होती हैं। एक लिपिड \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;दोहरी परत\u0026amp;nbsp;\u0026lt;/span\u0026gt;लिपिड अणुओं की दो परतों से बना होता है जो आंतरिक वातावरण को बाहरी परिवेश से अलग करने वाली बाधा बनाती हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;लिपिड \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;बिंदुक\u0026lt;/span\u0026gt;:\u0026lt;/strong\u0026gt; लिपिड \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;बिंदुक\u0026amp;nbsp;\u0026lt;/span\u0026gt;अंतःकोशिकीय कोशिकांग हैं जो मुख्य रूप से लिपिड भंडारण में शामिल हैं। वे \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;उदासीन\u0026amp;nbsp;\u0026lt;/span\u0026gt;लिपिड (जैसे, ट्राइग्लिसराइड्स और कोलेस्ट्रॉल एस्टर) के एक \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;जलविरागी\u0026amp;nbsp;\u0026lt;/span\u0026gt;कोर से बने होते हैं जो एक फॉस्फोलिपिड \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;एकस्तर\u0026amp;nbsp;\u0026lt;/span\u0026gt;से घिरे होते हैं। \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;एकस्तर\u0026amp;nbsp;\u0026lt;/span\u0026gt;संरचना आवश्यक है क्योंकि \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;जलविरागी\u0026amp;nbsp;\u0026lt;/span\u0026gt;कोर को \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;दोहरी परत\u0026amp;nbsp;\u0026lt;/span\u0026gt;के अतिरिक्त संरक्षण की आवश्यकता नहीं होती है, क्योंकि यह आंतरिक रूप से जलीय वातावरण के संपर्क में नहीं होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;बहुत कम घनत्व वाला लिपोप्रोटीन (VLDL):\u0026lt;/strong\u0026gt; VLDL लिपोप्रोटीन का एक वर्ग है जो रक्त प्रवाह के माध्यम से लिपिड (जैसे, ट्राइग्लिसराइड्स) का परिवहन करता है। इन कणों में ट्राइग्लिसराइड्स और कोलेस्ट्रॉल एस्टर का एक \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;जलविरागी\u0026amp;nbsp; \u0026lt;/span\u0026gt;कोर होता है जो एक फॉस्फोलिपिड \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;एकस्तर\u0026amp;nbsp;\u0026lt;/span\u0026gt;से घिरा होता है, साथ ही \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;सन्निहित\u0026amp;nbsp;\u0026lt;/span\u0026gt;एपोलिपोप्रोटीन भी होते हैं। \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;एकस्तर\u0026amp;nbsp;\u0026lt;/span\u0026gt;लिपिड परिवहन में उनके कार्य को सुविधाजनक बनाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अंतःपुटी अंतर्वलन\u0026lt;/span\u0026gt;:\u0026lt;/strong\u0026gt; \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अंतःपुटी अंतर्वलन\u0026lt;/span\u0026gt; कोशिकीय संरचनाएँ हैं जो बाह्य वातावरण से पदार्थों (जैसे, पोषक तत्व, \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;संकेतन\u0026amp;nbsp; \u0026lt;/span\u0026gt;अणु) के आंतरिककरण में शामिल हैं। ये पुटिकाएँ लिपिड \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;दोहरी परत\u0026amp;nbsp;\u0026lt;/span\u0026gt;से बनी होती हैं, न कि \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;एकस्तर\u0026amp;nbsp;\u0026lt;/span\u0026gt;से। कोशिका द्रव्य के जलीय वातावरण में पदार्थों को \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;प्रावरण\u0026amp;nbsp;\u0026lt;/span\u0026gt;और परिवहन करने के लिए \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;दोहरी परत\u0026amp;nbsp;\u0026lt;/span\u0026gt;संरचना आवश्यक है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;वसालसीकाणु\u0026lt;/span\u0026gt;:\u0026lt;/strong\u0026gt; \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;वसालसीकाणु\u0026amp;nbsp;\u0026lt;/span\u0026gt;लिपोप्रोटीन कण हैं जो आंतों से शरीर के अन्य ऊतकों तक आहार लिपिड (जैसे, ट्राइग्लिसराइड्स, कोलेस्ट्रॉल) का परिवहन करते हैं। VLDL के समान, उनमें एक \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;जलविरागी\u0026amp;nbsp;\u0026lt;/span\u0026gt;कोर होता है जो \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;सन्निहित\u0026amp;nbsp; \u0026lt;/span\u0026gt;प्रोटीन के साथ एक लिपिड \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;एकस्तर\u0026amp;nbsp;\u0026lt;/span\u0026gt;से घिरा होता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Cellular Organization"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4518aa958c4957eed4157","title":"Cellular Organization"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":11.25530110262935,"attempts":{"correct":169,"incorrect":218,"partial":0,"skipped":792,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689539b33005e0e0585976f0":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Claudin-16\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The thick ascending limb of the loop of Henle \u0026amp;nbsp;is a part of the nephron in the kidney that plays a critical role in magnesium (Mg\u0026lt;sup\u0026gt;2+\u0026lt;/sup\u0026gt;) and calcium (Ca\u0026lt;sup\u0026gt;2+\u0026lt;/sup\u0026gt;) reabsorption. This occurs through paracellular pathways, which are regulated by tight junction proteins.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Tight junctions are complexes of proteins that regulate the selective permeability of ions, including Mg\u0026lt;sup\u0026gt;2+\u0026lt;/sup\u0026gt;, through the spaces between tubular cells.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Claudin proteins are a family of transmembrane proteins that are key components of tight junctions, contributing to their selective permeability.\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Claudin-16 is a specific tight junction protein that is essential for the paracellular transport of Mg\u0026lt;sup\u0026gt;2+\u0026lt;/sup\u0026gt; in the thick ascending limb of Henle\u0026amp;#39;s loop.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;It creates a selective pathway for Mg\u0026lt;sup\u0026gt;2+\u0026lt;/sup\u0026gt; and Ca\u0026lt;sup\u0026gt;2+\u0026lt;/sup\u0026gt; to move across the tight junctions, contributing to their reabsorption in the nephron.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Mutations or dysfunction in the Claudin-16 protein can lead to disorders like familial hypomagnesemia, hypercalciuria, and nephrocalcinosis, highlighting its critical role in magnesium homeostasis.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Other\u0026amp;nbsp;Options:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Claudin-2: I\u0026lt;/strong\u0026gt;t is primarily involved in the permeability of small cations such as sodium (Na\u0026lt;sup\u0026gt;+\u0026lt;/sup\u0026gt;) and water, rather than Mg\u0026lt;sup\u0026gt;2+\u0026lt;/sup\u0026gt;. It is more commonly expressed in the proximal tubule and is not specifically involved in Mg\u0026lt;sup\u0026gt;2+\u0026lt;/sup\u0026gt; transport in the thick ascending limb.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;ZO-1:\u0026lt;/strong\u0026gt;\u0026amp;nbsp;ZO-1 (Zonula Occludens-1) is a scaffolding protein that helps anchor Claudin proteins to the cytoskeleton within tight junctions. While it plays a structural role in tight junction assembly, it does not directly mediate the permeability of Mg\u0026lt;sup\u0026gt;2+\u0026lt;/sup\u0026gt;.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;ZO-3:\u0026lt;/strong\u0026gt;\u0026amp;nbsp;ZO-3 (Zonula Occludens-3) is another scaffolding protein that interacts with tight junction components to maintain their structural integrity. Like ZO-1, it does not directly contribute to Mg\u0026lt;sup\u0026gt;2+\u0026lt;/sup\u0026gt; permeability.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;क्लॉडिन\u0026amp;nbsp;-16\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;\u0026amp;nbsp;हैं।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;हेनले \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;लूप\u0026lt;/span\u0026gt; का घना आरोही भाग \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;वृक्क\u0026amp;nbsp;\u0026lt;/span\u0026gt;में नेफ्रॉन का एक भाग है जो मैग्नीशियम (Mg\u0026lt;sup\u0026gt;2+\u0026lt;/sup\u0026gt;) और कैल्शियम (Ca\u0026lt;sup\u0026gt;2+\u0026lt;/sup\u0026gt;) के पुनरावशोषण में महत्वपूर्ण भूमिका निभाता है। यह \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;परिकोशिकीय\u0026lt;/span\u0026gt;\u0026amp;nbsp;मार्गों के माध्यम से होता है, जो \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;दृढ़\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;संधि\u0026amp;nbsp;\u0026lt;/span\u0026gt;प्रोटीन द्वारा नियंत्रित होते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;दृढ़ संधि प्रोटीन के ऐसे संकुल होते हैं जो नलिकाकार कोशिकाओं के बीच रिक्त स्थान के माध्यम से Mg\u0026lt;sup\u0026gt;2+\u0026lt;/sup\u0026gt; सहित आयनों की चयनात्मक पारगम्यता को नियंत्रित करते हैं।\u0026lt;/span\u0026gt;\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;क्लॉडिन\u0026amp;nbsp;\u0026lt;/span\u0026gt;प्रोटीन \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;पारझिल्ली\u0026amp;nbsp;\u0026lt;/span\u0026gt;प्रोटीन का एक परिवार है जो \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;दृढ़\u0026amp;nbsp;\u0026lt;/span\u0026gt;संधियों के प्रमुख घटक हैं, जो उनकी चयनात्मक पारगम्यता में योगदान करते हैं।\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;क्लॉडिन\u0026lt;/span\u0026gt;-16 एक विशिष्ट \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;दृढ़\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;संधि\u0026amp;nbsp;\u0026lt;/span\u0026gt;प्रोटीन है जो हेनले \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;लूप\u0026amp;nbsp;\u0026lt;/span\u0026gt;के \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;मोटी\u0026amp;nbsp;\u0026lt;/span\u0026gt;आरोही भाग में Mg\u0026lt;sup\u0026gt;2+\u0026lt;/sup\u0026gt; के \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;परिकोशिकीय\u0026amp;nbsp;\u0026lt;/span\u0026gt;परिवहन के लिए आवश्यक है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह Mg\u0026lt;sup\u0026gt;2+\u0026lt;/sup\u0026gt; और Ca\u0026lt;sup\u0026gt;2+\u0026lt;/sup\u0026gt; के लिए एक चयनात्मक मार्ग बनाता है ताकि वे \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;दृढ़\u0026amp;nbsp;\u0026lt;/span\u0026gt;संधियों को पार कर सकें, नेफ्रॉन में उनके पुनरावशोषण में योगदान कर सकें।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;क्लॉडिन\u0026lt;/span\u0026gt;-16 प्रोटीन में उत्परिवर्तन या शिथिलता से पारिवारिक \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अवमैग्नीशियमरक्तता\u0026lt;/span\u0026gt;, \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अतिकैल्सिमूत्रता\u0026amp;nbsp;\u0026lt;/span\u0026gt;और \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;वृक्ककैल्सियमता\u0026amp;nbsp;\u0026lt;/span\u0026gt;जैसे विकार हो सकते हैं, जो मैग्नीशियम \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;समस्थिति\u0026amp;nbsp;\u0026lt;/span\u0026gt;में इसकी महत्वपूर्ण भूमिका को उजागर करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;क्लॉडिन\u0026lt;/span\u0026gt;-2:\u0026lt;/strong\u0026gt; यह मुख्य रूप से सोडियम (Na\u0026lt;sup\u0026gt;+\u0026lt;/sup\u0026gt;) और पानी जैसे छोटे धनायनों की पारगम्यता में शामिल है, न कि Mg\u0026lt;sup\u0026gt;2+\u0026lt;/sup\u0026gt; में। यह अधिक सामान्यतः समीपस्थ नलिका में व्यक्त किया जाता है और विशेष रूप से \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;मोटी\u0026amp;nbsp;\u0026lt;/span\u0026gt;आरोही भाग में Mg\u0026lt;sup\u0026gt;2+\u0026lt;/sup\u0026gt; परिवहन में शामिल नहीं है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;ZO-1:\u0026lt;/strong\u0026gt; ZO-1 (ज़ोनुला ऑक्लूडेंस-1) एक मचान प्रोटीन है जो \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;क्लॉडिन\u0026amp;nbsp;\u0026lt;/span\u0026gt;प्रोटीन को \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;दृढ़\u0026amp;nbsp;\u0026lt;/span\u0026gt;संधियों के भीतर \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;कोशिकापंजर\u0026amp;nbsp;\u0026lt;/span\u0026gt;में जोड़ने में मदद करता है। जबकि यह \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;दृढ़\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;संधि\u0026amp;nbsp;\u0026lt;/span\u0026gt;असेंबली में एक संरचनात्मक भूमिका निभाता है, यह सीधे Mg\u0026lt;sup\u0026gt;2+\u0026lt;/sup\u0026gt; की पारगम्यता का मध्यस्थता नहीं करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;ZO-3:\u0026lt;/strong\u0026gt; ZO-3 (ज़ोनुला ऑक्लूडेंस-3) एक और मचान प्रोटीन है जो उनकी संरचनात्मक अखंडता को बनाए रखने के लिए \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;दृढ़\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;संधि\u0026amp;nbsp;\u0026lt;/span\u0026gt;घटकों के साथ \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अंत:क्रिया\u0026lt;span style=\u0026quot;white-space:pre\u0026quot;\u0026gt; \u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;करता है। ZO-1 की तरह, यह सीधे Mg\u0026lt;sup\u0026gt;2+\u0026lt;/sup\u0026gt; पारगम्यता में योगदान नहीं करता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["System Physiology Animal"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a452e28f21ac91a2eba7a5","title":"System Physiology Animal"},"t":{"id":"63a452f95db927c0ec7fbbd7","title":"Excretory system"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":9.306191687871078,"attempts":{"correct":98,"incorrect":62,"partial":0,"skipped":1019,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689539cdc6cdfd92ecf7929b":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Weight-specific basal metabolic rate decreases non-linearly with body size\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The basal metabolic rate (BMR) is the amount of energy expended by an organism at rest to maintain basic physiological functions such as breathing, circulation, and cellular processes.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;BMR is influenced by several factors, including body size, body composition, age, and temperature regulation.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In organisms within a taxonomic group, the relationship between BMR and body size is not linear\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Larger organisms tend to have a higher absolute BMR, but their weight-specific BMR (energy expenditure per unit of body weight) decreases as body size increases.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Weight-specific basal metabolic rate decreases non-linearly with body size because larger organisms have a lower metabolic rate per unit of body weight compared to smaller organisms. This is due to the allometric scaling of metabolic processes, where metabolic rate scales to body mass to the power of approximately 0.75 (Kleiber\u0026amp;#39;s Law).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;For example, while an elephant has a much higher absolute metabolic rate than a mouse, the energy expenditure per gram of body weight is lower in the elephant compared to the mouse.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The decrease in weight-specific BMR with increasing body size reflects the efficiency of energy use in larger organisms, as they lose heat more slowly due to their smaller surface area-to-volume ratio.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर है \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;भार-विशिष्ट आधारी उपापचयी दर शरीर के आकार के साथ अरैखिक रूप से घटता है।\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;आधारी उपापचयी दर\u0026amp;nbsp;\u0026lt;/span\u0026gt;(BMR) वह ऊर्जा की मात्रा है जो एक जीव विश्राम अवस्था में बुनियादी शारीरिक कार्यों जैसे साँस लेना, परिसंचरण और कोशिकीय प्रक्रियाओं को बनाए रखने के लिए व्यय करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;BMR कई कारकों से प्रभावित होता है, जिसमें शरीर का आकार, शरीर की संरचना, आयु और तापमान नियंत्रण शामिल हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;किसी वर्गीकरण समूह के जीवों में, BMR और शरीर के आकार के बीच संबंध रैखिक नहीं होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;बड़े जीवों में उच्च निरपेक्ष BMR होता है, लेकिन उनका भार-विशिष्ट BMR (शरीर के वजन की प्रति इकाई ऊर्जा व्यय) शरीर के आकार में वृद्धि के साथ घटता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;भार-विशिष्ट \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;आधारी उपापचयी दर\u0026lt;/span\u0026gt; शरीर के आकार के साथ अरैखिक रूप से घटता है क्योंकि बड़े जीवों में छोटे जीवों की तुलना में प्रति इकाई शरीर के वजन पर \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;उपापचयी\u0026amp;nbsp;\u0026lt;/span\u0026gt;दर कम होती है। यह \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;उपापचयी\u0026amp;nbsp;\u0026lt;/span\u0026gt;प्रक्रियाओं के \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;सापेक्षमितिक\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;सोपानन\u0026amp;nbsp; \u0026lt;/span\u0026gt;के कारण है, जहाँ \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;उपापचयी\u0026amp;nbsp;\u0026lt;/span\u0026gt;दर शरीर के द्रव्यमान के लगभग 0.75 (क्लेबर का नियम) की शक्ति के लिए स्केल करती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;उदाहरण के लिए, जबकि हाथी में चूहे की तुलना में बहुत अधिक निरपेक्ष \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;उपापचयी\u0026amp;nbsp;\u0026lt;/span\u0026gt;दर होती है, हाथी में चूहे की तुलना में प्रति ग्राम शरीर के वजन पर ऊर्जा व्यय कम होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;बढ़ते शरीर के आकार के साथ भार-विशिष्ट BMR में कमी बड़े जीवों में ऊर्जा के उपयोग की दक्षता को दर्शाती है, क्योंकि वे अपने छोटे सतह क्षेत्र-से-आयतन अनुपात के कारण धीरे-धीरे \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;ऊष्मा\u0026amp;nbsp;\u0026lt;/span\u0026gt;खोते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Ecological Principles"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a45541e89684161ccd7911","title":"Ecological Principles"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":16.357082273112834,"attempts":{"correct":76,"incorrect":153,"partial":0,"skipped":950,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689539e2a2471c5930455d7f":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;B and C\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The urea cycle, also known as the ornithine cycle, is a metabolic pathway that removes excess nitrogen from the body by converting ammonia into urea, which is excreted in the urine.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This cycle occurs in two different cellular compartments: the mitochondria and the cytosol.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Several intermediates of the cycle are synthesized and modified in these compartments, requiring their transportation across the mitochondrial inner membrane.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage68a45e49b248bd71ca31436d.png\u0026quot; style=\u0026quot;height: 285px; width: 450px;\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;em\u0026gt;Fig:\u0026amp;nbsp;The urea cycle. (Mourad M et al. 2016)\u0026lt;/em\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Citrulline\u0026lt;/strong\u0026gt; is synthesized in the mitochondria from carbamoyl phosphate and ornithine. Citrulline must be transported out of the mitochondria into the cytosol for the continuation of the urea cycle.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Ornithine\u0026lt;/strong\u0026gt; is regenerated in the cytosol after the cleavage of argininosuccinate. Ornithine is transported back into the mitochondria to participate in another round of the cycle.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Both citrulline and ornithine must cross the mitochondrial inner membrane, making them the intermediates that require transport between compartments.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;B और C\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;है।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यूरिया चक्र, जिसे ऑर्निथिन चक्र के रूप में भी जाना जाता है, एक \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;उपापचयी\u0026amp;nbsp;\u0026lt;/span\u0026gt;पथ है जो शरीर से अतिरिक्त नाइट्रोजन को हटाता है, अमोनिया को यूरिया में परिवर्तित करके, जिसे मूत्र में उत्सर्जित किया जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह चक्र दो अलग-अलग कोशिकीय \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;कक्षों\u0026amp;nbsp;\u0026lt;/span\u0026gt;में होता है: माइटोकॉन्ड्रिया और कोशिका द्रव्य।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;चक्र के कई मध्यवर्ती उत्पाद इन \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;कक्षों\u0026amp;nbsp;\u0026lt;/span\u0026gt;में संश्लेषित और संशोधित होते हैं, जिसके लिए माइटोकॉन्ड्रियल आंतरिक झिल्ली के आर-पार उनका परिवहन आवश्यक होता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage68a45e49b248bd71ca31436d.png\u0026quot; style=\u0026quot;height: 285px; width: 450px;\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;em\u0026gt;चित्र: यूरिया चक्र। (Mourad M et al. 2016)\u0026lt;/em\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;सिट्रुलिन\u0026lt;/strong\u0026gt; का संश्लेषण माइटोकॉन्ड्रिया में \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;कार्बेमॉइल\u0026amp;nbsp;\u0026lt;/span\u0026gt;फॉस्फेट और ऑर्निथिन से होता है। यूरिया चक्र की निरंतरता के लिए सिट्रुलिन को माइटोकॉन्ड्रिया से कोशिका द्रव्य में ले जाया जाना चाहिए।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;आर्जिनोसक्सिनेट के विखंडन के बाद \u0026lt;strong\u0026gt;ऑर्निथिन\u0026lt;/strong\u0026gt; कोशिका द्रव्य में पुनर्जीवित होता है। चक्र के एक और दौर में भाग लेने के लिए ऑर्निथिन को वापस माइटोकॉन्ड्रिया में ले जाया जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;सिट्रुलिन और ऑर्निथिन दोनों को माइटोकॉन्ड्रियल आंतरिक झिल्ली को पार करना चाहिए, जिससे वे मध्यवर्ती उत्पाद बन जाते हैं जिन्हें \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;कक्षों\u0026amp;nbsp;\u0026lt;/span\u0026gt;के बीच परिवहन की आवश्यकता होती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Biochemistry"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a45131905ad063f1a82ade","title":"Biochemistry"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":12.877014418999153,"attempts":{"correct":136,"incorrect":144,"partial":0,"skipped":899,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689539f676250351076931f1":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Pro-Pro \u0026amp;lt; Phe-Phe ~ Ala-Ala \u0026amp;lt; Gly-Gly\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The Ramachandran map is a graphical representation of the allowed regions of dihedral angles (phi and psi) in the polypeptide backbone of amino acids in proteins.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The map is used to analyze the sterically allowed conformations of amino acids based on their side chains and chemical structure.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Dipeptides (two amino acids linked by a peptide bond) vary in the area of allowed regions on the Ramachandran map depending on steric hindrance caused by their side chains.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Amino acids like glycine, proline, alanine, and phenylalanine differ in flexibility and steric hindrance, influencing their Ramachandran map regions.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Pro-Pro:\u0026lt;/strong\u0026gt; Proline has a cyclic structure that restricts its phi angle, resulting in the smallest area of allowed regions on the Ramachandran map. When two prolines are linked, steric constraints are even more pronounced, making Pro-Pro occupy the least allowed area.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Phe-Phe ~ Ala-Ala:\u0026lt;/strong\u0026gt; Phenylalanine has a bulky aromatic side chain, while alanine has a small methyl side chain. Both exhibit moderate steric hindrance, leading to similar allowed regions. However, their areas are larger compared to Pro-Pro.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Gly-Gly:\u0026lt;/strong\u0026gt; Glycine lacks a side chain (it has only a hydrogen atom as its R-group), allowing for the greatest flexibility. Gly-Gly occupies the largest area of allowed regions on the Ramachandran map.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Pro-Pro \u0026amp;lt; Phe-Phe ~ Ala-Ala \u0026amp;lt; Gly-Gly\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;है।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अवधारणा\u0026lt;/span\u0026gt;:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;रामचंद्रन\u0026amp;nbsp;\u0026lt;/span\u0026gt;मानचित्र प्रोटीन में एमिनो अम्लों की पॉलीपेप्टाइड \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;आधार\u0026amp;nbsp;\u0026lt;/span\u0026gt;में द्विफलकीय कोणों (फाई और साई) के अनुमत क्षेत्रों का एक चित्रमय निरूपण है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;मानचित्र का उपयोग उनके पार्श्व \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;शृंखला\u0026lt;/span\u0026gt;ओं और रासायनिक संरचना के आधार पर एमिनो अम्लों के त्रिविमीय रूप से अनुमत संघटनों का विश्लेषण करने के लिए किया जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;डाइपेप्टाइड्स (पेप्टाइड बंध द्वारा जुड़े दो एमिनो अम्ल) \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;रामचंद्रन\u0026amp;nbsp;\u0026lt;/span\u0026gt;मानचित्र पर अनुमत क्षेत्रों के क्षेत्र में भिन्न होते हैं जो उनके पार्श्व \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;शृंखला\u0026lt;/span\u0026gt;ओं द्वारा उत्पन्न त्रिविमीय बाधा पर निर्भर करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;ग्लाइसिन, प्रोलिन, एलनिन और फेनिलएलनिन जैसे एमिनो अम्ल लचीलेपन और त्रिविमीय बाधा में भिन्न होते हैं, जो उनके \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;रामचंद्रन\u0026amp;nbsp;\u0026lt;/span\u0026gt;मानचित्र क्षेत्रों को प्रभावित करते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Pro-Pro:\u0026lt;/strong\u0026gt; प्रोलिन में एक चक्रीय संरचना होती है जो इसके फाई कोण को प्रतिबंधित करती है, जिसके परिणामस्वरूप \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;रामचंद्रन\u0026amp;nbsp;\u0026lt;/span\u0026gt;मानचित्र पर अनुमत क्षेत्रों का सबसे छोटा क्षेत्र होता है। जब दो प्रोलिन जुड़े होते हैं, तो त्रिविमीय बाधाएँ और भी अधिक स्पष्ट होती हैं, जिससे Pro-Pro सबसे कम अनुमत क्षेत्र घेरता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Phe-Phe ~ Ala-Ala:\u0026lt;/strong\u0026gt; फेनिलएलनिन में एक भारी \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;एरोमेटिक\u0026amp;nbsp;\u0026lt;/span\u0026gt;पार्श्व \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;शृंखला\u0026amp;nbsp;\u0026lt;/span\u0026gt;होती है, जबकि एलनिन में एक छोटी \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;मेथिल\u0026amp;nbsp;\u0026lt;/span\u0026gt;पार्श्व \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;शृंखला\u0026amp;nbsp;\u0026lt;/span\u0026gt;होती है। दोनों मध्यम त्रिविमीय बाधा प्रदर्शित करते हैं, जिससे समान अनुमत क्षेत्र बनते हैं। हालांकि, Pro-Pro की तुलना में उनके क्षेत्र बड़े होते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Gly-Gly:\u0026lt;/strong\u0026gt; ग्लाइसिन में एक पार्श्व \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;शृंखला\u0026amp;nbsp;\u0026lt;/span\u0026gt;का अभाव होता है (इसमें केवल एक हाइड्रोजन परमाणु इसके R-समूह के रूप में होता है), जिससे सबसे अधिक लचीलापन मिलता है। Gly-Gly \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;रामचंद्रन\u0026amp;nbsp;\u0026lt;/span\u0026gt;मानचित्र पर अनुमत क्षेत्रों का सबसे बड़ा क्षेत्र घेरता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Biochemistry"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a45131905ad063f1a82ade","title":"Biochemistry"},"t":{"id":"63a451424936ab151c92844a","title":"Biomolecules"},"st":{"id":"63a4514ae89684161ccd3c09","title":"Composition \u0026 Functions"},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":9.750636132315524,"attempts":{"correct":175,"incorrect":106,"partial":0,"skipped":898,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953a06cc49566a430d87f8":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Bio-ethanol\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Biofuels are renewable energy sources derived from organic materials such as plants, agricultural residues, and animal waste. They are categorized into three generations based on their feedstock and production methods.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;First-generation biofuels are produced directly from food crops such as corn, sugarcane, and wheat. These biofuels rely on traditional fermentation or chemical processes.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Second-generation biofuels use non-food biomass (e.g., lignocellulosic materials) as feedstock, while third-generation biofuels primarily involve advanced technologies such as algal biofuels.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Bio-ethanol:\u0026lt;/strong\u0026gt; Bio-ethanol is classified as a first-generation biofuel. It is produced through the fermentation of food crops like sugarcane, corn, and wheat. These feedstocks contain high levels of sugars or starches that can be easily converted into ethanol.\u0026amp;nbsp;\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Cellulosic ethanol:\u0026lt;/strong\u0026gt; This is a second-generation biofuel derived from non-food biomass such as agricultural residues, wood, and grasses. It uses lignocellulosic materials, which require advanced enzymatic or chemical processes for conversion into ethanol.\u0026amp;nbsp;\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Lignin-based biofuels:\u0026lt;/strong\u0026gt; These fall under second-generation biofuels. Lignin is a complex polymer found in plant cell walls, and its conversion into biofuels involves advanced technologies like pyrolysis or gasification.\u0026amp;nbsp;\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Algal biofuels:\u0026lt;/strong\u0026gt; These are third-generation biofuels produced using algae. Algae can grow in various environments and do not require arable land or freshwater, making them highly sustainable. Algal biofuels use advanced technologies to extract lipids for biodiesel production.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;जैव-इथेनॉल\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;\u0026amp;nbsp;है।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अवधारणा\u0026lt;/span\u0026gt;:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;जैव ईंधन नवीकरणीय ऊर्जा स्रोत हैं जो पौधों, कृषि अवशेषों और पशु अपशिष्ट जैसे कार्बनिक पदार्थों से प्राप्त होते हैं। इन्हें उनके कच्चे माल और उत्पादन विधियों के आधार पर तीन पीढ़ियों में वर्गीकृत किया जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;प्रथम पीढ़ी के जैव ईंधन मक्का, गन्ना और गेहूं जैसे खाद्य फसलों से सीधे उत्पादित होते हैं। ये जैव ईंधन पारंपरिक किण्वन या रासायनिक प्रक्रियाओं पर निर्भर करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;द्वितीय पीढ़ी के जैव ईंधन गैर-खाद्य \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;जैवभार\u0026amp;nbsp;\u0026lt;/span\u0026gt;(जैसे, लिग्नोसेल्यूलोसिक सामग्री) का उपयोग कच्चे माल के रूप में करते हैं, जबकि तीसरी पीढ़ी के जैव ईंधन में मुख्य रूप से शैवाल जैव ईंधन जैसी उन्नत तकनीकें शामिल हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;जैव\u0026lt;/span\u0026gt;-इथेनॉल:\u0026lt;/strong\u0026gt; \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;जैव\u0026lt;/span\u0026gt;-इथेनॉल को प्रथम पीढ़ी के जैव ईंधन के रूप में वर्गीकृत किया गया है। यह गन्ना, मक्का और गेहूं जैसी खाद्य फसलों के किण्वन के माध्यम से उत्पादित होता है। इन कच्चे माल में उच्च स्तर की शर्करा या स्टार्च होती है जिन्हें आसानी से इथेनॉल में परिवर्तित किया जा सकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;सेलुलोसिक इथेनॉल:\u0026lt;/strong\u0026gt; यह एक दूसरी पीढ़ी का जैव ईंधन है जो गैर-खाद्य \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;जैवभार\u0026amp;nbsp;\u0026lt;/span\u0026gt;जैसे कृषि अवशेषों, लकड़ी और घास से प्राप्त होता है। इसमें लिग्नोसेल्यूलोसिक सामग्री का उपयोग किया जाता है, जिसके लिए इथेनॉल में रूपांतरण के लिए उन्नत एंजाइमेटिक या रासायनिक प्रक्रियाओं की आवश्यकता होती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;लिग्निन-आधारित जैव ईंधन:\u0026lt;/strong\u0026gt; ये दूसरी पीढ़ी के जैव ईंधन के अंतर्गत आते हैं। लिग्निन पौधे की कोशिका भित्तियों में पाया जाने वाला एक जटिल बहुलक है, और जैव ईंधन में इसके रूपांतरण में \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;तापीय अपघटन\u0026amp;nbsp;\u0026lt;/span\u0026gt;या गैसीकरण जैसी उन्नत तकनीकें शामिल हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;शैवाल जैव ईंधन:\u0026lt;/strong\u0026gt; ये तीसरी पीढ़ी के जैव ईंधन हैं जो शैवाल का उपयोग करके उत्पादित होते हैं। शैवाल विभिन्न वातावरणों में विकसित हो सकते हैं और उन्हें कृषि योग्य भूमि या \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अलवण जल\u0026amp;nbsp;\u0026lt;/span\u0026gt;की आवश्यकता नहीं होती है, जिससे वे अत्यधिक \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;संपोषणीय\u0026amp;nbsp;\u0026lt;/span\u0026gt;होते हैं। शैवाल जैव ईंधन बायोडीजल उत्पादन के लिए लिपिड निकालने के लिए उन्नत तकनीकों का उपयोग करते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"\u003cp\u003eসঠিক উত্তর হল \u003cstrong\u003e\u003cspan style=\"color:(33, 37, 41);\"\u003eবায়ো-ইথানল\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\n\u003cp\u003e\u003cu\u003e\u003cstrong\u003eধারণা:\u003c/strong\u003e\u003c/u\u003e\u003c/p\u003e\n\n\u003cul\u003e\n\t\u003cli\u003eজৈব জ্বালানি হল নবায়নযোগ্য শক্তির উৎস যা জৈব পদার্থ যেমন গাছপালা, কৃষিজ অবশিষ্টাংশ এবং পশুর বর্জ্য থেকে উদ্ভূত হয়। এগুলি তাদের কাঁচামাল এবং উৎপাদন পদ্ধতির উপর ভিত্তি করে তিনটি প্রজন্মে শ্রেণীবদ্ধ করা হয়।\u003c/li\u003e\n\t\u003cli\u003eপ্রথম প্রজন্মের জৈব জ্বালানি সরাসরি খাদ্য শস্য যেমন ভুট্টা, আখ এবং গম থেকে উৎপন্ন হয়। এই জৈব জ্বালানিগুলি ঐতিহ্যবাহী গাঁজন বা রাসায়নিক প্রক্রিয়ার উপর নির্ভর করে।\u003c/li\u003e\n\t\u003cli\u003eদ্বিতীয় প্রজন্মের জৈব জ্বালানিগুলি অ-খাদ্য জীবভর (যেমন, লিগনোসেলুলোসিক পদার্থ) কাঁচামাল হিসাবে ব্যবহার করে, যখন তৃতীয় প্রজন্মের জৈব জ্বালানিগুলি প্রাথমিকভাবে শৈবাল-ভিত্তিক জৈব জ্বালানির মতো উন্নত প্রযুক্তি জড়িত।\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003cp\u003e\u003cu\u003e\u003cstrong\u003eব্যাখ্যা:\u003c/strong\u003e\u003c/u\u003e\u003c/p\u003e\n\n\u003cul\u003e\n\t\u003cli\u003e\u003cstrong\u003eবায়ো-ইথানল:\u003c/strong\u003e বায়ো-ইথানলকে প্রথম প্রজন্মের জৈব জ্বালানি হিসাবে শ্রেণীবদ্ধ করা হয়। এটি আখ, ভুট্টা এবং গমের মতো খাদ্য শস্যের গাঁজনের মাধ্যমে উৎপন্ন হয়। এই কাঁচামালগুলিতে উচ্চ মাত্রার শর্করা বা স্টার্চ থাকে যা সহজেই ইথানলে রূপান্তরিত হতে পারে।\u003c/li\u003e\n\t\u003cli\u003e\u003cstrong\u003eসেলুলোসিক ইথানল:\u003c/strong\u003e এটি একটি দ্বিতীয় প্রজন্মের জৈব জ্বালানি যা কৃষি বর্জ্য, কাঠ এবং ঘাসের মতো অ-খাদ্য জীবভর থেকে উদ্ভূত হয়। এটি লিগনোসেলুলোসিক পদার্থ ব্যবহার করে, যা ইথানলে রূপান্তরের জন্য উন্নত এনজাইমেটিক বা রাসায়নিক প্রক্রিয়ার প্রয়োজন।\u003c/li\u003e\n\t\u003cli\u003e\u003cstrong\u003eলিগনিন-ভিত্তিক জৈব জ্বালানি:\u003c/strong\u003e এগুলি দ্বিতীয় প্রজন্মের জৈব জ্বালানির অধীনে পড়ে। লিগনিন হল উদ্ভিদ কোষ প্রাচীরে পাওয়া একটি জটিল পলিমার এবং জৈব জ্বালানিতে এর রূপান্তর পাইরোলাইসিস বা গ্যাসফিকেশন-এর মতো উন্নত প্রযুক্তি জড়িত।\u003c/li\u003e\n\t\u003cli\u003e\u003cstrong\u003eশৈবাল-ভিত্তিক জৈব জ্বালানি:\u003c/strong\u003e এগুলি তৃতীয় প্রজন্মের জৈব জ্বালানি যা শৈবাল ব্যবহার করে উৎপন্ন হয়। শৈবাল বিভিন্ন পরিবেশে বৃদ্ধি পেতে পারে এবং আবাদযোগ্য জমি বা স্বাদু জলের প্রয়োজন হয় না, যা তাদের অত্যন্ত টেকসই করে তোলে। শৈবাল-ভিত্তিক জৈব জ্বালানিগুলি বায়োডিজেল উৎপাদনের জন্য লিপিড নিষ্কাশনের জন্য উন্নত প্রযুক্তি ব্যবহার করে।\u003c/li\u003e\n\u003c/ul\u003e\n","type":"tb","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Applied Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a455cbce3d67ae7cc72e05","title":"Applied Biology"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":11.441899915182365,"attempts":{"correct":188,"incorrect":191,"partial":0,"skipped":800,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953a174bf9040e58ef8278":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;the translated nascent chain which carries a signal allowing interaction with SRP receptor on the ER.\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The endoplasmic reticulum (ER) is an essential cellular organelle involved in protein and lipid synthesis. Ribosomes, responsible for protein synthesis, can attach to the ER, forming the rough ER.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This attachment is critical for the synthesis of proteins that are destined for secretion, insertion into cellular membranes, or transport to lysosomes.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The process of ribosome attachment to the ER is mediated by specific signals and molecular mechanisms to ensure that the correct proteins are synthesized at the right location.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Ribosomes attach to the ER through the translated nascent chain, which carries a signal peptide. This peptide acts as a \u0026amp;quot;zip code\u0026amp;quot; directing the ribosome to the ER membrane.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Once the signal peptide emerges from the ribosome during translation, it is recognized by the Signal Recognition Particle (SRP), a ribonucleoprotein complex.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The SRP temporarily halts translation and guides the ribosome-nascent chain complex to the SRP receptor located on the ER membrane.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This interaction allows the ribosome to dock on the ER membrane, where translation resumes, and the growing polypeptide chain is translocated into the ER lumen or inserted into the ER membrane.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This process ensures that proteins are properly localized within the cell and can perform their designated functions.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage68a462fad2d22602d1bf0f56.png\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर है -\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अनुवादित नवजात शृंखला\u0026amp;nbsp;जिसमें एक संकेत होता है जो ER पर SRP ग्राही\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;के साथ \u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;\u0026lt;strong\u0026gt;अंत:क्रिया\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;white-space:pre\u0026quot;\u0026gt; \u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;करता है।\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अंतःप्रद्रव्य जालिका\u0026lt;/span\u0026gt;\u0026amp;nbsp;(ER) एक आवश्यक कोशिकीय \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;कोशिकांग\u0026amp;nbsp;\u0026lt;/span\u0026gt;है जो प्रोटीन और लिपिड संश्लेषण में शामिल है। राइबोसोम, जो प्रोटीन संश्लेषण के लिए \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;उत्तरदायी\u0026amp;nbsp;\u0026lt;/span\u0026gt;हैं, ER से जुड़ सकते हैं, जिससे \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;खुरदरी\u0026amp;nbsp;\u0026lt;/span\u0026gt;ER बनता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;जुड़ाव\u0026amp;nbsp;\u0026lt;/span\u0026gt;उन प्रोटीनों के संश्लेषण के लिए महत्वपूर्ण है जो स्राव के लिए, कोशिकीय झिल्लियों में सम्मिलन के लिए या लाइसोसोम में परिवहन के लिए नियत हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;ER से राइबोसोम के \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;जुड़ाव\u0026amp;nbsp;\u0026lt;/span\u0026gt;की प्रक्रिया विशिष्ट संकेतों और आणविक तंत्रों द्वारा मध्यस्थता की जाती है ताकि यह सुनिश्चित हो सके कि सही प्रोटीन सही स्थान पर संश्लेषित होते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;राइबोसोम अनुवादित नवजात \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;शृंखला\u0026amp;nbsp;\u0026lt;/span\u0026gt;के माध्यम से ER से जुड़ते हैं, जिसमें एक \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;संकेत\u0026amp;nbsp;\u0026lt;/span\u0026gt;पेप्टाइड होता है। यह पेप्टाइड एक \u0026amp;quot;ज़िप कोड\u0026amp;quot; के रूप में कार्य करता है जो राइबोसोम को ER झिल्ली तक निर्देशित करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;एक बार जब अनुवाद\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;न\u0026lt;/span\u0026gt; के दौरान \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;संकेत\u0026amp;nbsp;\u0026lt;/span\u0026gt;पेप्टाइड राइबोसोम से निकलता है, तो इसे \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;संकेत\u0026amp;nbsp;पहचान\u0026amp;nbsp;कण\u0026amp;nbsp;\u0026lt;/span\u0026gt;(SRP), एक राइबोन्यूक्लियोप्रोटीन \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;संकुल\u0026amp;nbsp;\u0026lt;/span\u0026gt;द्वारा पहचाना जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;SRP अस्थायी रूप से अनुवाद\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;न\u0026lt;/span\u0026gt; को रोकता है और राइबोसोम-नवजात \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;शृंखला\u0026amp;nbsp;संकुल\u0026amp;nbsp;\u0026lt;/span\u0026gt;को ER झिल्ली पर स्थित SRP \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;ग्राही\u0026amp;nbsp;\u0026lt;/span\u0026gt;तक ले जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अंत:क्रिया\u0026lt;span style=\u0026quot;white-space:pre\u0026quot;\u0026gt; \u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;राइबोसोम को ER झिल्ली पर डॉक करती है, जहाँ अनुवाद\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;न\u0026lt;/span\u0026gt; फिर से शुरू होता है, और बढ़ती पॉलीपेप्टाइड \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;शृंखला\u0026amp;nbsp;\u0026lt;/span\u0026gt;को ER ल्यूमेन में स्थानांतरित कर दिया जाता है या ER झिल्ली में सम्मिलित कर दिया जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह प्रक्रिया सुनिश्चित करती है कि प्रोटीन कोशिका के भीतर ठीक से स्थानीयकृत हैं और अपने निर्दिष्ट कार्य कर सकते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage68a462fad2d22602d1bf0f56.png\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Fundamental Processes"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a451aec9ba648bc86fbf43","title":"Fundamental Processes"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":13.516539440203573,"attempts":{"correct":123,"incorrect":172,"partial":0,"skipped":884,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953a24f922825acdf5fa26":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Fructose\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The transport of nutrients, including sugars, from the intestinal lumen into enterocytes (intestinal cells) involves specific mechanisms and transport proteins.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Glucose transporters (GLUTs) are a family of facilitative transport proteins that mediate the passive movement of glucose and other sugars across the cell membrane.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Different GLUTs exhibit specificity for different sugars.\u0026amp;nbsp;\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Fructose is transported into enterocytes from the intestinal lumen primarily by GLUT5, a member of the GLUT family of transporters.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;GLUT5 is specifically tailored to facilitate the uptake of fructose across the apical membrane of enterocytes. Once inside the enterocytes, fructose is either metabolized or transported into the bloodstream via another transporter, GLUT2.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This mechanism is passive, relying on the concentration gradient of fructose between the intestinal lumen and the interior of the enterocyte.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage64a7a8df15ed3ccdfd3e6a09.png\u0026quot; style=\u0026quot;color: rgb(33, 37, 41);\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Other Options:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Glucose:\u0026lt;/strong\u0026gt; Glucose\u0026amp;nbsp;is absorbed into enterocytes via the sodium-glucose linked transporter 1 (SGLT1), which uses active transport driven by a sodium gradient.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Galactose:\u0026lt;/strong\u0026gt; Similar to glucose, galactose is transported into enterocytes using the SGLT1 transporte.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Lactose:\u0026lt;/strong\u0026gt; Lactose is a disaccharide and cannot be directly transported into enterocytes. It is first broken down into glucose and galactose by the enzyme lactase in the intestinal lumen before absorption occurs through the SGLT1 transporter.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;फ्रुक्टोज\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;संप्रत्यय:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;पोषक तत्वों, जिसमें शर्करा भी शामिल है, का आंतों के लुमेन से एंटरोसाइट्स (आंतों की कोशिकाएँ) में परिवहन विशिष्ट तंत्रों और परिवहन प्रोटीन को शामिल करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;ग्लूकोज ट्रांसपोर्टर (GLUTs) सुसाध्य परिवहन प्रोटीन का एक परिवार है जो कोशिका झिल्ली के पार ग्लूकोज और अन्य शर्करा की निष्क्रिय गति को मध्यस्थता करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;विभिन्न GLUTs विभिन्न शर्करा के लिए विशिष्टता प्रदर्शित करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;फ्रुक्टोज को आंतों के लुमेन से एंटरोसाइट्स में मुख्य रूप से GLUT5 द्वारा पहुँचाया जाता है, जो GLUT परिवहन प्रोटीन के परिवार का एक सदस्य है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;GLUT5 विशेष रूप से एंटरोसाइट्स की एपिकल झिल्ली के पार फ्रुक्टोज के अवशोषण को सुविधाजनक बनाने के लिए तैयार किया गया है। एंटरोसाइट्स के अंदर एक बार, फ्रुक्टोज या तो चयापचय होता है या एक अन्य ट्रांसपोर्टर, GLUT2 के माध्यम से रक्तप्रवाह में पहुँचाया जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह तंत्र निष्क्रिय है, जो आंतों के लुमेन और एंटरोसाइट के आंतरिक भाग के बीच फ्रुक्टोज के सांद्रता प्रवणता पर निर्भर करता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage64a7a8df15ed3ccdfd3e6a09.png\u0026quot; style=\u0026quot;color: rgb(33, 37, 41);\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;ग्लूकोज:\u0026lt;/strong\u0026gt; ग्लूकोज को सोडियम-ग्लूकोज लिंक्ड ट्रांसपोर्टर 1 (SGLT1) के माध्यम से एंटरोसाइट्स में अवशोषित किया जाता है, जो सोडियम प्रवणता द्वारा संचालित सक्रिय परिवहन का उपयोग करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;गैलेक्टोज:\u0026lt;/strong\u0026gt; ग्लूकोज के समान, गैलेक्टोज को SGLT1 ट्रांसपोर्टर का उपयोग करके एंटरोसाइट्स में पहुँचाया जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;लैक्टोज:\u0026lt;/strong\u0026gt; लैक्टोज एक डिसैकराइड है और सीधे एंटरोसाइट्स में पहुँचाया नहीं जा सकता है। अवशोषण होने से पहले आंतों के लुमेन में एंजाइम लैक्टेज द्वारा इसे पहले ग्लूकोज और गैलेक्टोज में तोड़ा जाता है, जो SGLT1 ट्रांसपोर्टर के माध्यम से होता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"\u003cp\u003eসঠিক উত্তর হল \u003cstrong\u003e\u003cspan style=\"color:(33, 37, 41);\"\u003eফ্রুক্টোজ\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\n\u003cp\u003e\u003cu\u003e\u003cstrong\u003eধারণা:\u003c/strong\u003e\u003c/u\u003e\u003c/p\u003e\n\n\u003cul\u003e\n\t\u003cli\u003eশর্করা সহ পুষ্টির পরিবহন, অন্ত্রের লুমেন থেকে এন্টারোসাইট (আন্ত্রিক কোষ) এ নির্দিষ্ট প্রক্রিয়া এবং পরিবহন প্রোটিন জড়িত।\u003c/li\u003e\n\t\u003cli\u003eগ্লুকোজ ট্রান্সপোর্টার (GLUTs) হল ফেসিলিটেটিভ ট্রান্সপোর্ট প্রোটিনের একটি পরিবার যা কোষের ঝিল্লি জুড়ে গ্লুকোজ এবং অন্যান্য শর্করার নিষ্ক্রিয় গতিবিধি\u0026nbsp;মধ্যস্থতা করে।\u003c/li\u003e\n\t\u003cli\u003eবিভিন্ন GLUTs বিভিন্ন শর্করার জন্য নির্দিষ্টতা প্রদর্শন করে।\u003c/li\u003e\n\t\u003cli\u003eফ্রুক্টোজ প্রাথমিকভাবে GLUT5 দ্বারা অন্ত্রের লুমেন থেকে এন্টারোসাইটে পরিবাহিত হয়, এটি ট্রান্সপোর্টারদের GLUT পরিবারের সদস্য।\u003c/li\u003e\n\t\u003cli\u003eGLUT5 বিশেষভাবে এন্টারোসাইটগুলির অ্যাপিকাল মেমব্রেন জুড়ে ফ্রুক্টোজ গ্রহণকে সহজতর করার জন্য তৈরি করা হয়েছে। এন্টারোসাইটের ভিতরে একবার, ফ্রুক্টোজ হয় বিপাক হয় বা অন্য একটি ট্রান্সপোর্টার, GLUT2 এর মাধ্যমে রক্তপ্রবাহে পরিবাহিত হয়।\u003c/li\u003e\n\t\u003cli\u003eএই প্রক্রিয়াটি নিষ্ক্রিয়, অন্ত্রের লুমেন এবং এন্টারোসাইটের অভ্যন্তরের মধ্যে ফ্রুক্টোজের ঘনত্ব গ্রেডিয়েন্টের উপর নির্ভর করে।\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003cp\u003e\u003cimg alt=\"\" src=\"//cdn.testbook.com/images/production/quesImages/qImage64a7a8df15ed3ccdfd3e6a09.png\" style=\"color: rgb(33, 37, 41);\" /\u003e\u003c/p\u003e\n\n\u003cp\u003e\u003cu\u003e\u003cstrong\u003eঅন্যান্য বিকল্প:\u003c/strong\u003e\u003c/u\u003e\u003c/p\u003e\n\n\u003cul\u003e\n\t\u003cli\u003e\u003cstrong\u003eগ্লুকোজ:\u003c/strong\u003e গ্লুকোজ সোডিয়াম-গ্লুকোজ লিঙ্কড ট্রান্সপোর্টার 1 (SGLT1) এর মাধ্যমে এন্টারোসাইটে শোষিত হয়, যা সোডিয়াম গ্রেডিয়েন্ট দ্বারা চালিত সক্রিয় পরিবহন ব্যবহার করে।\u003c/li\u003e\n\t\u003cli\u003e\u003cstrong\u003eগ্যালাকটোজ:\u003c/strong\u003e গ্লুকোজের মতো, গ্যালাকটোজ SGLT1 ট্রান্সপোর্টার ব্যবহার করে এন্টারোসাইটে পরিবাহিত হয়।\u003c/li\u003e\n\t\u003cli\u003e\u003cstrong\u003eল্যাকটোজ:\u003c/strong\u003e ল্যাকটোজ একটি ডিস্যাকারাইড এবং সরাসরি এন্টারোসাইটে পরিবাহিত হতে পারে না। শোষণ SGLT1 ট্রান্সপোর্টারের মাধ্যমে হওয়ার আগে এটি প্রথমে ল্যাকটেজ উৎসেচক দ্বারা অন্ত্রের লুমেনে গ্লুকোজ এবং গ্যালাকটোজে ভেঙে যায়।\u003c/li\u003e\n\u003c/ul\u003e\n","type":"tb","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Cell Communication and Cell Signaling"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a451cdef5b5403de57a575","title":"Cell Communication and Cell Signaling"},"t":{"id":"63a451efa1b1e0637eb18d73","title":"Cellular communication"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":7.853265479219671,"attempts":{"correct":178,"incorrect":196,"partial":0,"skipped":805,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953a34c6cdfd92ecf793ce":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Transformation of one segment into another\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Homeotic genes are a class of regulatory genes that control the development of anatomical structures in organisms during early embryonic development.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In Drosophila (fruit flies), homeotic genes specify the identity of body segments along the anterior-posterior (A-P) axis.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Mutations in homeotic genes can lead to changes in the identity of segments, causing one segment to develop characteristics of another segment, rather than affecting overall segment number or polarity.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;nbsp;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Homeotic gene mutations often cause specific body segments to transform into the identity and characteristics of a different segment. For example, in Drosophila, a mutation in the Antennapedia gene can result in the transformation of antennae into legs. This phenomenon is known as \u0026amp;quot;homeotic transformation\u0026amp;quot; and is a hallmark of mutations in homeotic genes.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Homeotic genes include Hox genes, which play a critical role in determining the fate of segments and ensuring proper segment identity during development.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;एक खंड का दूसरे खंड में रूपांतरण\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;\u0026amp;nbsp;हैं।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;समापवर्धी\u0026amp;nbsp;\u0026lt;/span\u0026gt;जीन नियामक जीनों का एक वर्ग है जो भ्रूण के प्रारंभिक विकास के दौरान जीवों में शारीरिक संरचनाओं के विकास को नियंत्रित करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;ड्रोसोफिला (फल मक्खियों) में, \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;समापवर्धी\u0026amp;nbsp;\u0026lt;/span\u0026gt;जीन \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अग्र-पश्च\u0026lt;/span\u0026gt; (A-P) अक्ष के साथ शरीर के खंडों की पहचान निर्दिष्ट करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;समापवर्धी\u0026amp;nbsp;\u0026lt;/span\u0026gt;जीन में उत्परिवर्तन से खंडों की पहचान में परिवर्तन हो सकते हैं, जिससे एक खंड दूसरे खंड की विशेषताओं को विकसित करता है, बजाय समग्र खंड संख्या या ध्रुवता को प्रभावित करने के।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;nbsp;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;समापवर्धी\u0026amp;nbsp;\u0026lt;/span\u0026gt;जीन उत्परिवर्तन अक्सर विशिष्ट शरीर खंडों को एक अलग खंड की पहचान और विशेषताओं में बदलने का कारण बनते हैं। उदाहरण के लिए, ड्रोसोफिला में, \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;शृंगिकापद\u0026amp;nbsp;\u0026lt;/span\u0026gt;जीन में उत्परिवर्तन से एंटीना का पैरों में रूपांतरण हो सकता है। इस घटना को \u0026amp;quot;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;समापवर्धी\u0026amp;nbsp;\u0026lt;/span\u0026gt;रूपांतरण\u0026amp;quot; के रूप में जाना जाता है और यह \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;समापवर्धी\u0026amp;nbsp;\u0026lt;/span\u0026gt;जीन में उत्परिवर्तन का एक लक्षण है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;समापवर्धी\u0026amp;nbsp;\u0026lt;/span\u0026gt;जीन में Hox जीन शामिल हैं, जो खंडों के भाग्य को निर्धारित करने और विकास के दौरान उचित खंड पहचान सुनिश्चित करने में महत्वपूर्ण भूमिका निभाते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Developmental Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4523f152a060341b327ed","title":"Developmental Biology"},"t":{"id":"63a4525f905ad063f1a84044","title":"Morphogenesis and organogenesis in plants"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":10.00678541136556,"attempts":{"correct":86,"incorrect":92,"partial":0,"skipped":1001,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953a47ef177aa03fbaee25":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;ancestral chromosomes (n = 12)\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The circular synteny maps of the Poaceae family are graphical representations that provide insights into the organization, origin, and evolutionary relationships of grass genomes.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Synteny refers to the conservation of blocks of genes across different species.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The innermost circle in such maps typically represents the ancestral genome, which serves as the reference point for comparing the derived genomes of other species within the family.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The outer circles show how the genomes of modern species like rice, maize and sorghum have evolved from this ancestor through processes like chromosome fusions, fissions and rearrangements.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The ancestral genome represents the evolutionary starting point, providing a basis to understand how modern genomes evolved through processes such as chromosomal rearrangements, duplications, and losses.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Arabidopsis thaliana chromosomes (n = 5)\u0026lt;/strong\u0026gt;:\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;em\u0026gt;Arabidopsis thaliana\u0026lt;/em\u0026gt; is not part of the Poaceae family; it belongs to the Brassicaceae family. Therefore, its genome is irrelevant to circular synteny maps of Poaceae.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Maize chromosomes (n = 10)\u0026lt;/strong\u0026gt;:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Maize (\u0026lt;em\u0026gt;Zea mays\u0026lt;/em\u0026gt;) is part of the Poaceae family and has undergone significant genome evolution, including whole-genome duplication and chromosomal rearrangements.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;However, maize chromosomes represent a derived genome rather than the ancestral genome.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Rice chromosomes (n = 12)\u0026lt;/strong\u0026gt;:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Rice (\u0026lt;em\u0026gt;Oryza sativa\u0026lt;/em\u0026gt;) is another member of the Poaceae family with a well-studied genome. It is often used as a model organism for monocotyledonous plants. While rice has 12 chromosomes, its genome has also undergone evolutionary changes. It does not represent the ancestral genome but a modern derived genome.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Ancestral chromosomes (n = 12)\u0026lt;/strong\u0026gt;:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;The ancestral genome is reconstructed based on comparative genomics and represents the hypothetical common ancestor of all grass species in the Poaceae family.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;It serves as the evolutionary baseline for studying synteny and understanding the diversification of modern grass genomes.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Being the origin point, it logically occupies the innermost circle in circular synteny maps.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;पूर्वज गुणसूत्र (n = 12)\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;\u0026amp;nbsp;हैं।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;अवधारणा\u0026lt;/span\u0026gt;:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;पोएसी कुल के वृत्ताकार सिंटेनी मानचित्र ग्राफिकल निरूपण हैं जो घास जीनोम के संगठन, उत्पत्ति और विकासात्मक संबंधों में अंतर्दृष्टि प्रदान करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;सिंटेनी विभिन्न प्रजातियों में जीनों के \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;खंड\u0026amp;nbsp;\u0026lt;/span\u0026gt;के संरक्षण को संदर्भित करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इस तरह के मानचित्रों में सबसे भीतरी वृत्त आमतौर पर पूर्वज जीनोम का प्रतिनिधित्व करता है, जो परिवार के भीतर अन्य प्रजातियों के व्युत्पन्न जीनोम की तुलना करने के लिए संदर्भ बिंदु के रूप में कार्य करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;बाहरी वृत्त दिखाते हैं कि कैसे आधुनिक प्रजातियों जैसे चावल, मक्का और ज्वार के जीनोम इस पूर्वज से गुणसूत्र संलयन, विखंडन और पुनर्व्यवस्था जैसे प्रक्रियाओं के माध्यम से विकसित हुए हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;पूर्वज जीनोम विकासात्मक शुरुआती बिंदु का प्रतिनिधित्व करता है, यह समझने का आधार प्रदान करता है कि आधुनिक जीनोम गुणसूत्रीय पुनर्व्यवस्था, \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;प्रतिलिपिकरण\u0026amp;nbsp;\u0026lt;/span\u0026gt;और हानि जैसी प्रक्रियाओं के माध्यम से कैसे विकसित हुए।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;em\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;एरेबिडोप्सिस थालियाना\u0026lt;/span\u0026gt;\u0026lt;/em\u0026gt; गुणसूत्र (n = 5):\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;em\u0026gt;\u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;एरेबिडोप्सिस थालियाना\u0026lt;/span\u0026gt;\u0026lt;/em\u0026gt; पोएसी कुल का हिस्सा नहीं है; यह ब्रेसिसेसी कुल से संबंधित है। इसलिए, इसका जीनोम पोएसी के वृत्ताकार सिंटेनी मानचित्रों के लिए अप्रासंगिक है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;मक्का गुणसूत्र (n = 10):\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;मक्का (\u0026lt;em\u0026gt;ज़िया मेज़\u0026lt;/em\u0026gt;) पोएसी कुल का हिस्सा है और इसमें महत्वपूर्ण जीनोम विकास हुआ है, जिसमें संपूर्ण जीनोम \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;प्रतिलिपिकरण\u0026amp;nbsp;\u0026lt;/span\u0026gt;और गुणसूत्रीय पुनर्व्यवस्था शामिल हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;हालांकि, मक्का गुणसूत्र पूर्वज जीनोम के बजाय एक व्युत्पन्न जीनोम का प्रतिनिधित्व करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;चावल गुणसूत्र (n = 12):\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;चावल (\u0026lt;em\u0026gt;ओराइज़ा सैटाइवा\u0026lt;/em\u0026gt;) पोएसी कुल का एक अन्य सदस्य है जिसका जीनोम अच्छी तरह से अध्ययन किया गया है। इसे अक्सर \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;एकबीजपत्री\u0026amp;nbsp;\u0026lt;/span\u0026gt;पौधों के लिए एक मॉडल जीव के रूप में उपयोग किया जाता है। जबकि चावल में 12 गुणसूत्र होते हैं, इसके जीनोम में भी विकासात्मक परिवर्तन हुए हैं। यह पूर्वज जीनोम का नहीं बल्कि एक आधुनिक व्युत्पन्न जीनोम का प्रतिनिधित्व करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;पूर्वज गुणसूत्र (n = 12):\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;पूर्वज जीनोम तुलनात्मक जीनोमिक्स के आधार पर पुनर्निर्मित किया जाता है और पोएसी कुल में सभी घास प्रजातियों के काल्पनिक सामान्य पूर्वज का प्रतिनिधित्व करता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह सिंटेनी का अध्ययन करने और आधुनिक घास जीनोम के विविधीकरण को समझने के लिए विकासात्मक आधार रेखा के रूप में कार्य करता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;उत्पत्ति बिंदु होने के कारण, यह तार्किक रूप से वृत्ताकार सिंटेनी मानचित्रों में सबसे \u0026lt;span style=\u0026quot;\u0026quot;\u0026gt;भीतरी वृत्त पर स्थित होता है।\u0026lt;/span\u0026gt;\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Evolution and Behavior"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4557fe52da32add2b08e9","title":"Evolution and Behavior"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":10.805767599660745,"attempts":{"correct":18,"incorrect":79,"partial":0,"skipped":1082,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953a5e76250351076933d1":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Haploid\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;In plants, embryo-lethal recessive mutations prevent the development of viable embryos unless the wild-type gene is provided externally (e.g., via a transgene like R-comp).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The study of chromosome segregation defects helps us understand how errors in chromosome division during cell division (meiosis or mitosis) can lead to unusual chromosome numbers in resultant cells or organisms.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The female plant used in the cross is homozygous for the R-comp transgene, meaning it has two copies of the GFP-tagged wild-type \u0026amp;quot;R\u0026amp;quot; gene on chromosome 4. This transgene rescues the embryo-lethal phenotype caused by the recessive \u0026amp;quot;R\u0026amp;quot; mutation on chromosome 1.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The male plant is homozygous for the purple-colored mutant allele, which does not affect the R gene but provides a phenotypic marker for identifying offspring.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;When the cross is performed, some F1 embryos show chromosome segregation defects. This indicates that errors occurred during meiosis, leading to abnormal chromosome distribution in the gametes.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The resultant F1 plants that regenerate from these embryos are purple (indicating they lack the R-comp transgene) and sterile. The absence of the R-comp transgene confirms that these plants have only the wild-type \u0026amp;quot;R\u0026amp;quot; gene from chromosome 1 and not the GFP-tagged \u0026amp;quot;R-comp\u0026amp;quot; transgene from chromosome 4.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The sterility and other phenotypic observations (purple color, lack of the transgene) suggest that these F1 plants are haploid, containing only one set of chromosomes (n). The chromosome segregation defects likely resulted in gametes that carried only one set of chromosomes, leading to haploid progeny.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Other Options:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Triploid:\u0026lt;/strong\u0026gt; Triploid cells contain three sets of chromosomes (3n). Triploidy often results from the fertilization of an egg by two sperm or the fusion of diploid and haploid gametes. In this case, the F1 plants are not triploid because they lack the transgene and exhibit haploid characteristics.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Chromosome 4 trisomy:\u0026lt;/strong\u0026gt; Trisomy refers to the presence of an extra chromosome (2n+1). If the F1 plants had chromosome 4 trisomy, they would likely have retained the R-comp transgene on chromosome 4, which is not observed here.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Monosomic diploid:\u0026lt;/strong\u0026gt; Monosomy refers to the loss of one chromosome from a diploid set (2n-1). While this can lead to sterility, the observed characteristics of the F1 plants (absence of R-comp and haploid nature) do not support this option.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;अगुणित\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;पौधों में, भ्रूण-घातक अप्रभावी उत्परिवर्तन व्यवहार्य भ्रूणों के विकास को रोकते हैं जब तक कि जंगली-प्रकार जीन बाहरी रूप से प्रदान नहीं किया जाता है (जैसे, R-comp जैसे ट्रांसजीन के माध्यम से)।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;गुणसूत्र पृथक्करण दोषों का अध्ययन हमें यह समझने में मदद करता है कि कोशिका विभाजन (अर्धसूत्रीविभाजन या समसूत्रीविभाजन) के दौरान गुणसूत्र विभाजन में त्रुटियां परिणामी कोशिकाओं या जीवों में असामान्य गुणसूत्र संख्याओं को कैसे जन्म दे सकती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;संकरण में प्रयुक्त मादा पौधा R-comp ट्रांसजीन के लिए समयुग्मजी है, जिसका अर्थ है कि गुणसूत्र 4 पर GFP-टैग्ड जंगली-प्रकार \u0026amp;quot;R\u0026amp;quot; जीन की दो प्रतियाँ हैं। यह ट्रांसजीन गुणसूत्र 1 पर अप्रभावी \u0026amp;quot;R\u0026amp;quot; उत्परिवर्तन के कारण होने वाले भ्रूण-घातक लक्षण को बचाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;नर पौधा बैंगनी रंग के उत्परिवर्ती एलील के लिए समयुग्मजी है, जो R जीन को प्रभावित नहीं करता है लेकिन संतति की पहचान के लिए एक लक्षणिक मार्कर प्रदान करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जब संकरण किया जाता है, तो कुछ F1 भ्रूण गुणसूत्र पृथक्करण दोष दिखाते हैं। यह इंगित करता है कि अर्धसूत्रीविभाजन के दौरान त्रुटियां हुईं, जिससे युग्मकों में असामान्य गुणसूत्र वितरण हुआ।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इन भ्रूणों से पुनर्जीवित परिणामी F1 पौधे बैंगनी (यह दर्शाता है कि उनमें R-comp ट्रांसजीन की कमी है) और बाँझ हैं। R-comp ट्रांसजीन की अनुपस्थिति पुष्टि करती है कि इन पौधों में केवल गुणसूत्र 1 से जंगली-प्रकार \u0026amp;quot;R\u0026amp;quot; जीन है और गुणसूत्र 4 से GFP-टैग्ड \u0026amp;quot;R-comp\u0026amp;quot; ट्रांसजीन नहीं है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;बाँझपन और अन्य लक्षणिक अवलोकन (बैंगनी रंग, ट्रांसजीन की कमी) बताते हैं कि ये F1 पौधे अगुणित हैं, जिसमें गुणसूत्रों का केवल एक सेट (n) है। गुणसूत्र पृथक्करण दोषों के परिणामस्वरूप युग्मक हुए जो केवल गुणसूत्रों के एक सेट को ले जाते थे, जिससे अगुणित संतति हुई।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;त्रिगुणित:\u0026lt;/strong\u0026gt; त्रिगुणित कोशिकाओं में गुणसूत्रों के तीन सेट (3n) होते हैं। त्रिगुणिता अक्सर एक अंडे के दो शुक्राणुओं द्वारा निषेचन या द्विगुणित और अगुणित युग्मकों के संलयन से होती है। इस मामले में, F1 पौधे त्रिगुणित नहीं हैं क्योंकि उनमें ट्रांसजीन की कमी है और वे अगुणित लक्षण प्रदर्शित करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;गुणसूत्र 4 त्रिसूत्रता:\u0026lt;/strong\u0026gt; त्रिसूत्रता एक अतिरिक्त गुणसूत्र (2n+1) की उपस्थिति को संदर्भित करता है। यदि F1 पौधों में गुणसूत्र 4 त्रिसूत्रता होती, तो वे गुणसूत्र 4 पर R-comp ट्रांसजीन को बनाए रखते, जो यहां नहीं देखा जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;एकगुणित द्विगुणित:\u0026lt;/strong\u0026gt; एकगुणिता द्विगुणित सेट (2n-1) से एक गुणसूत्र के नुकसान को संदर्भित करता है। जबकि इससे बाँझपन हो सकता है, F1 पौधों के देखे गए लक्षण (R-comp की अनुपस्थिति और अगुणित प्रकृति) इस विकल्प का समर्थन नहीं करते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Inheritance Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a453102b304a00e31e93c8","title":"Inheritance Biology"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":27.092451229855808,"attempts":{"correct":94,"incorrect":174,"partial":0,"skipped":911,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953a78f922825acdf5fc63":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;34 - 36 kJ/mol and 0.6 - 0.61 mol\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Gastric juice has a very low pH (1.5), indicating a high concentration of H\u0026lt;sup\u0026gt;+\u0026lt;/sup\u0026gt; ions compared to blood plasma, which has a pH of 7.4. This process of pumping H\u0026lt;sup\u0026gt;+\u0026lt;/sup\u0026gt; ions against the concentration gradient into the stomach requires energy.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;The energy required for this transport can be calculated using thermodynamics and the Gibbs free energy change formula:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026amp;Delta;G = RT ln(C\u0026lt;sub\u0026gt;final\u0026lt;/sub\u0026gt;/C\u0026lt;sub\u0026gt;initial\u0026lt;/sub\u0026gt;)\u0026lt;/strong\u0026gt;, where\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;R is the gas constant,\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;T is the temperature in Kelvin, and\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;C\u0026lt;sub\u0026gt;final\u0026lt;/sub\u0026gt;/C\u0026lt;sub\u0026gt;initial\u0026lt;/sub\u0026gt; represents the ratio of H\u0026lt;sup\u0026gt;+\u0026lt;/sup\u0026gt; concentrations.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;ATP hydrolysis provides the energy required for this process.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Under cellular conditions, the free energy change for ATP hydrolysis is approximately -58 kJ/mol.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Calculate H\u0026lt;sup\u0026gt;+\u0026lt;/sup\u0026gt; concentration:\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;The pH of a solution is defined as pH = -log[H\u0026lt;sup\u0026gt;+\u0026lt;/sup\u0026gt;].\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;For gastric juice (pH 1.5), [H\u0026lt;sup\u0026gt;+\u0026lt;/sup\u0026gt;] = 10\u0026lt;sup\u0026gt;-1.5\u0026lt;/sup\u0026gt; = 0.0316 M.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;For blood plasma (pH 7.4), [H\u0026lt;sup\u0026gt;+\u0026lt;/sup\u0026gt;] = 10\u0026lt;sup\u0026gt;-7.4\u0026lt;/sup\u0026gt; = 3.98 \u0026amp;times; 10\u0026lt;sup\u0026gt;-8\u0026lt;/sup\u0026gt; M.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;The ratio of [H\u0026lt;sup\u0026gt;+\u0026lt;/sup\u0026gt;] in gastric juice to blood plasma is C\u0026lt;sub\u0026gt;final\u0026lt;/sub\u0026gt;/C\u0026lt;sub\u0026gt;initial\u0026lt;/sub\u0026gt; = 0.0316 / (3.98 \u0026amp;times; 10\u0026lt;sup\u0026gt;-8\u0026lt;/sup\u0026gt;) \u0026amp;asymp; 794,000.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Calculate \u0026amp;Delta;G:\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Using the formula \u0026amp;Delta;G = RT ln(C\u0026lt;sub\u0026gt;final\u0026lt;/sub\u0026gt;/C\u0026lt;sub\u0026gt;initial\u0026lt;/sub\u0026gt;), where R = 8.315 J/mol/K and T = 310 K (37\u0026amp;deg;C in Kelvin):\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026amp;Delta;G = 8.315 \u0026amp;times; 310 \u0026amp;times; ln(794,000) = 8.315 \u0026amp;times; 310 \u0026amp;times; 13.58 \u0026amp;asymp; 35,000 J/mol or 35 kJ/mol.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Calculate ATP required:\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;The energy required to pump 1 mole of H\u0026lt;sup\u0026gt;+\u0026lt;/sup\u0026gt; ions is approximately 35 kJ. Since ATP hydrolysis releases 58 kJ/mol, the number of ATP molecules required for one mole of H\u0026lt;sup\u0026gt;+\u0026lt;/sup\u0026gt; transport is 35 / 58 \u0026amp;asymp; 0.6.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;For 1 litre of gastric juice, approximately 0.6 - 0.61 moles of ATP are hydrolyzed.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;34 - 36 kJ/mol और 0.6 - 0.61 mol\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;जठर रस का pH बहुत कम (1.5) होता है, जो रक्त प्लाज्मा की तुलना में H\u0026lt;sup\u0026gt;+\u0026lt;/sup\u0026gt; आयनों की उच्च सांद्रता को दर्शाता है, जिसका pH 7.4 होता है। H\u0026lt;sup\u0026gt;+\u0026lt;/sup\u0026gt; आयनों को सांद्रता प्रवणता के विरुद्ध पेट में पंप करने की इस प्रक्रिया के लिए ऊर्जा की आवश्यकता होती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;इस परिवहन के लिए आवश्यक ऊर्जा की गणना ऊष्मागतिकी और गिब्स मुक्त ऊर्जा परिवर्तन सूत्र का उपयोग करके की जा सकती है:\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026amp;Delta;G = RT ln(C\u0026lt;sub\u0026gt;अंतिम\u0026lt;/sub\u0026gt;/C\u0026lt;sub\u0026gt;प्रारंभिक\u0026lt;/sub\u0026gt;)\u0026lt;/strong\u0026gt;, जहाँ\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;R गैस स्थिरांक है,\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;T केल्विन में तापमान है, और\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;C\u0026lt;sub\u0026gt;अंतिम\u0026lt;/sub\u0026gt;/C\u0026lt;sub\u0026gt;प्रारंभिक\u0026lt;/sub\u0026gt; H\u0026lt;sup\u0026gt;+\u0026lt;/sup\u0026gt; सांद्रताओं के अनुपात का प्रतिनिधित्व करता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;ATP जल अपघटन इस प्रक्रिया के लिए आवश्यक ऊर्जा प्रदान करता है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;कोशिकीय परिस्थितियों में, ATP जल अपघटन के लिए मुक्त ऊर्जा परिवर्तन लगभग -58 kJ/mol है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;H\u0026lt;sup\u0026gt;+\u0026lt;/sup\u0026gt; सांद्रता की गणना करें:\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;किसी विलयन का pH pH = -log[H\u0026lt;sup\u0026gt;+\u0026lt;/sup\u0026gt;] द्वारा परिभाषित किया गया है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;जठर रस (pH 1.5) के लिए, [H\u0026lt;sup\u0026gt;+\u0026lt;/sup\u0026gt;] = 10\u0026lt;sup\u0026gt;-1.5\u0026lt;/sup\u0026gt; = 0.0316 M।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;रक्त प्लाज्मा (pH 7.4) के लिए, [H\u0026lt;sup\u0026gt;+\u0026lt;/sup\u0026gt;] = 10\u0026lt;sup\u0026gt;-7.4\u0026lt;/sup\u0026gt; = 3.98 x 10\u0026lt;sup\u0026gt;-8\u0026lt;/sup\u0026gt; M।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;जठर रस में [H\u0026lt;sup\u0026gt;+\u0026lt;/sup\u0026gt;] का रक्त प्लाज्मा के लिए अनुपात C\u0026lt;sub\u0026gt;अंतिम\u0026lt;/sub\u0026gt;/C\u0026lt;sub\u0026gt;प्रारंभिक\u0026lt;/sub\u0026gt; = 0.0316 / (3.98 x 10\u0026lt;sup\u0026gt;-8\u0026lt;/sup\u0026gt;) \u0026amp;asymp; 794,000 है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;\u0026amp;Delta;G की गणना करें:\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026amp;Delta;G = RT ln(C\u0026lt;sub\u0026gt;अंतिम\u0026lt;/sub\u0026gt;/C\u0026lt;sub\u0026gt;प्रारंभिक\u0026lt;/sub\u0026gt;) सूत्र का उपयोग करते हुए, जहाँ R = 8.315 J/mol/K और T = 310 K (केल्विन में 37\u0026amp;deg;C):\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026amp;Delta;G = 8.315 x 310 x ln(794,000) = 8.315 x 310 x 13.58 \u0026amp;asymp; 35,000 J/mol या 35 kJ/mol\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;आवश्यक ATP की गणना करें:\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;1 मोल H\u0026lt;sup\u0026gt;+\u0026lt;/sup\u0026gt; आयनों को पंप करने के लिए आवश्यक ऊर्जा लगभग 35 kJ है। चूँकि ATP जल अपघटन 58 kJ/mol मुक्त करता है, इसलिए 1 मोल H\u0026lt;sup\u0026gt;+\u0026lt;/sup\u0026gt; परिवहन के लिए आवश्यक ATP अणुओं की संख्या 35 / 58 \u0026amp;asymp; 0.6 है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;1 लीटर जठर रस के लिए, लगभग 0.6 - 0.61 मोल ATP जल अपघटित होते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Biochemistry"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a45131905ad063f1a82ade","title":"Biochemistry"},"t":{"id":"63a4516831b306cb01f70f41","title":"Biophysical chemistry"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":11.368956743002546,"attempts":{"correct":60,"incorrect":167,"partial":0,"skipped":952,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953aa27ac09e469dee7b62":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;A, B, and C only\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Microtubule nucleation is a critical process during spindle assembly in mitosis. It involves the formation of new microtubules, which are essential for chromosome alignment and segregation.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The spindle apparatus contains various regulatory proteins and complexes that influence microtubule dynamics, nucleation, and stabilization.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Among the factors listed, some directly impact microtubule nucleation, while others contribute to separate aspects of spindle assembly such as microtubule organization, transport, or stability.\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;A. \u0026amp;gamma;-TuRCs (Gamma-Tubulin Ring Complexes):\u0026lt;/strong\u0026gt; These are essential for microtubule nucleation. \u0026amp;gamma;-TuRCs act as templates for microtubule formation by providing a scaffold for \u0026amp;alpha;- and \u0026amp;beta;-tubulin dimers to assemble. They are localized at centrosomes and other microtubule-organizing centers (MTOCs) and play a direct role in initiating microtubule polymerization.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;B. Augmin:\u0026lt;/strong\u0026gt; This protein complex enhances microtubule nucleation within the spindle by recruiting \u0026amp;gamma;-TuRCs to existing microtubules. This branching microtubule nucleation mechanism significantly contributes to spindle assembly and stability during mitosis.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;C. TPX2 (Targeting Protein for Xklp2):\u0026lt;/strong\u0026gt; TPX2 is another critical factor involved in promoting microtubule nucleation. It facilitates the formation of microtubules near chromatin and stabilizes spindle microtubules. It also works in coordination with other factors like Aurora A kinase, to regulate spindle dynamics.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;D. Dynein:\u0026lt;/strong\u0026gt; While dynein is an important motor protein involved in spindle assembly, it primarily contributes to microtubule organization, transport of cellular components, and spindle positioning. It does not directly participate in microtubule nucleation.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर\u0026amp;nbsp;\u0026lt;strong\u0026gt;केवल A, B, और C\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;है।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;सूक्ष्मनलिकाओं का केन्द्रकीयकरण समसूत्री विभाजन में धुरी संयोजन के दौरान एक महत्वपूर्ण प्रक्रिया है। इसमें नए सूक्ष्मनलिकाओं का निर्माण शामिल है, जो गुणसूत्र संरेखण और पृथक्करण के लिए आवश्यक हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;धुरी तंत्र में विभिन्न नियामक प्रोटीन और कॉम्प्लेक्स होते हैं जो सूक्ष्मनलिका गतिशीलता, केन्द्रकीयकरण और स्थिरीकरण को प्रभावित करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;सूचीबद्ध कारकों में से, कुछ सीधे सूक्ष्मनलिका केन्द्रकीयकरण को प्रभावित करते हैं, जबकि अन्य धुरी संयोजन के अलग-अलग पहलुओं जैसे सूक्ष्मनलिका संगठन, परिवहन या स्थिरता में योगदान करते हैं।\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;A. \u0026amp;gamma;-TuRCs (गामा-ट्यूबुलिन रिंग कॉम्प्लेक्स):\u0026lt;/strong\u0026gt; ये सूक्ष्मनलिका केन्द्रकीयकरण के लिए आवश्यक हैं। \u0026amp;gamma;-TuRCs सूक्ष्मनलिका निर्माण के लिए टेम्पलेट के रूप में कार्य करते हैं, \u0026amp;alpha;- और \u0026amp;beta;-ट्यूबुलिन डिमर्स को इकट्ठा करने के लिए एक पाड़ प्रदान करते हैं। वे केंद्रक और अन्य सूक्ष्मनलिका-संगठित केंद्रों (MTOCs) में स्थानीयकृत होते हैं और सूक्ष्मनलिका बहुलकीकरण की शुरुआत में प्रत्यक्ष भूमिका निभाते हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;B. ऑग्मिन:\u0026lt;/strong\u0026gt; यह प्रोटीन कॉम्प्लेक्स मौजूदा सूक्ष्मनलिकाओं में \u0026amp;gamma;-TuRCs की भर्ती करके धुरी के भीतर सूक्ष्मनलिका केन्द्रकीयकरण को बढ़ाता है। यह शाखित सूक्ष्मनलिका केन्द्रकीयकरण तंत्र समसूत्री विभाजन के दौरान धुरी संयोजन और स्थिरता में महत्वपूर्ण योगदान देता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;C. TPX2 (टारगेटिंग प्रोटीन फॉर Xklp2):\u0026lt;/strong\u0026gt; TPX2 एक अन्य महत्वपूर्ण कारक है जो सूक्ष्मनलिका केन्द्रकीयकरण को बढ़ावा देने में शामिल है। यह क्रोमैटिन के पास सूक्ष्मनलिकाओं के निर्माण की सुविधा प्रदान करता है और धुरी सूक्ष्मनलिकाओं को स्थिर करता है। यह धुरी गतिशीलता को नियंत्रित करने के लिए ऑरोरा A काइनेज जैसे अन्य कारकों के साथ समन्वय में भी काम करता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;D. डायनिन:\u0026lt;/strong\u0026gt; जबकि डायनिन एक महत्वपूर्ण मोटर प्रोटीन है जो धुरी संयोजन में शामिल है, यह मुख्य रूप से सूक्ष्मनलिका संगठन, कोशिकीय घटकों के परिवहन और धुरी स्थिति में योगदान देता है। यह सीधे सूक्ष्मनलिका केन्द्रकीयकरण में भाग नहीं लेता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Cellular Organization"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4518aa958c4957eed4157","title":"Cellular Organization"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":16.033078880407125,"attempts":{"correct":130,"incorrect":225,"partial":0,"skipped":824,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953abecc49566a430d8afd":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;C and D only\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Baroreceptors are specialized stretch receptors located in the carotid sinus and aortic arch. Their primary function is to sense changes in blood pressure by detecting the stretching of blood vessel walls caused by pressure changes.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Baroreceptors send neural signals to the brainstem (specifically, the medulla oblongata), which processes these signals and adjusts sympathetic and parasympathetic nervous system activity to maintain blood pressure within a normal range.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Baroreceptors are particularly sensitive to pulsatile changes in blood pressure rather than constant or static pressure. This dynamic sensitivity helps them respond rapidly to fluctuations in blood pressure.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement A:\u0026lt;/strong\u0026gt; This statement is incorrect. High blood pressure leads to increased baroreceptor discharge, which inhibits the tonic discharge of sympathetic nerves to blood vessels and the heart. This results in vasodilation, decreased heart rate, and reduced cardiac output, lowering blood pressure. Therefore, baroreceptors suppress sympathetic activity rather than stimulate it.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement B:\u0026lt;/strong\u0026gt; This statement is incorrect. A decline in pulse pressure without a change in mean pressure does not increase baroreceptor discharge. Baroreceptors are more responsive to pulsatile changes in blood pressure rather than constant or reduced pulse pressure.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement C:\u0026lt;/strong\u0026gt; This statement is correct. Baroreceptors are more sensitive to pulsatile changes in blood pressure than to constant blood pressure. Pulsatile pressure provides dynamic signals that the baroreceptors can detect and respond to more effectively.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement D:\u0026lt;/strong\u0026gt; This statement is correct. Increased baroreceptor discharge excites vagal (parasympathetic) innervations to the heart, leading to a decrease in heart rate (bradycardia) and helping to reduce blood pressure.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;केवल C और D\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;बैरोसेप्टर्स कैरोटिड साइनस और महाधमनी चाप में स्थित विशिष्ट स्ट्रेच रिसेप्टर्स हैं। उनका प्राथमिक कार्य रक्तचाप में परिवर्तन को समझना है, जो रक्त वाहिका की भित्तियों के खिंचाव का पता लगाकर दाब परिवर्तनों के कारण होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;बैरोसेप्टर्स ब्रेनस्टेम (विशेष रूप से, मेडुला ऑब्लोंगेटा) को तंत्रिका संकेत भेजते हैं, जो इन संकेतों को संसाधित करता है और सामान्य सीमा के भीतर रक्तचाप बनाए रखने के लिए सहानुभूति और पैरासिम्पेथेटिक तंत्रिका तंत्र की गतिविधि को समायोजित करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;बैरोरिसेप्टर स्थिर या स्थिर दाब की तुलना में रक्तचाप में स्पंदनात्मक परिवर्तनों के प्रति विशेष रूप से संवेदनशील होते हैं। यह गतिशील संवेदनशीलता उन्हें रक्तचाप में उतार-चढ़ाव के प्रति शीघ्र प्रतिक्रिया करने में मदद करती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन A:\u0026lt;/strong\u0026gt; यह कथन गलत है। उच्च रक्तचाप से बैरोसेप्टर डिस्चार्ज में वृद्धि होती है, जो रक्त वाहिकाओं और हृदय को सहानुभूति तंत्रिकाओं के टॉनिक डिस्चार्ज को रोकता है। इसके परिणामस्वरूप वासोडिलेशन, हृदय गति में कमी और कार्डियक आउटपुट में कमी आती है, जिससे रक्तचाप कम होता है। इसलिए, बैरोसेप्टर्स सहानुभूति गतिविधि को दबाते हैं, इसे उत्तेजित नहीं करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन B:\u0026lt;/strong\u0026gt; यह कथन गलत है। माध्य दाब में परिवर्तन के बिना पल्स प्रेशर में गिरावट बैरोसेप्टर डिस्चार्ज को नहीं बढ़ाती है। बैरोसेप्टर्स स्थिर या कम पल्स प्रेशर के बजाय रक्तचाप में स्पंदित परिवर्तनों के प्रति अधिक प्रतिक्रियाशील होते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन C:\u0026lt;/strong\u0026gt; यह कथन सही है। बैरोसेप्टर्स स्थिर रक्तचाप की तुलना में रक्तचाप के स्पंदित परिवर्तनों के प्रति अधिक संवेदनशील होते हैं। स्पंदित दाब गतिशील संकेत प्रदान करता है जिसे बैरोसेप्टर्स अधिक प्रभावी ढंग से पता लगा सकते हैं और प्रतिक्रिया दे सकते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन D:\u0026lt;/strong\u0026gt; यह कथन सही है। बैरोसेप्टर डिस्चार्ज में वृद्धि हृदय को वेगल (पैरासिम्पेथेटिक) इनरवेशन को उत्तेजित करती है, जिससे हृदय गति में कमी (ब्रेडीकार्डिया) होती है और रक्तचाप को कम करने में मदद मिलती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["System Physiology Animal"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a452e28f21ac91a2eba7a5","title":"System Physiology Animal"},"t":{"id":"63a452ea2b304a00e31e902a","title":"Cardiovascular System"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":17.27905004240884,"attempts":{"correct":77,"incorrect":203,"partial":0,"skipped":899,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953ad4a25b7b429e6d9f88":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;B and D only\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Vesicle formation, transport, and fusion are crucial processes in cellular transport systems. Vesicles coated with COPI or COPII proteins assist in transporting molecules between cellular compartments, such as the endoplasmic reticulum (ER), Golgi apparatus, and plasma membrane.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The protein Arf (ARF family of GTPases) plays a regulatory role in vesicle formation by cycling between active (GTP-bound) and inactive (GDP-bound) states. Its ability to hydrolyze GTP ensures proper vesicle formation and transport.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;A mutant Arf protein that is constitutively bound to GTP but defective in GTP hydrolysis disrupts normal vesicle dynamics, causing defects in membrane binding, vesicle fusion, and transport regulation.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement A: \u0026amp;quot;COPI-coated vesicles are only formed from their normal location.\u0026amp;quot;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is incorrect because the mutant Arf protein, being constitutively GTP-bound, disrupts normal vesicle formation processes. COPI-coated vesicle formation occurs aberrantly as Arf\u0026amp;nbsp;is always active and cannot hydrolyze GTP to regulate vesicle formation properly. Therefore, vesicles may form in unintended locations as well.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement B: \u0026amp;quot;Arf\u0026amp;nbsp;is constitutively bound to a membrane.\u0026amp;quot;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is correct because the mutant Arf\u0026amp;nbsp;protein cannot hydrolyze GTP. As a result, it remains in its active state, which ensures its continuous association with membranes, thereby preventing the normal cycling between membrane-bound and cytosolic states.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement C: \u0026amp;quot;COPII-coated vesicle fusion with the target membrane is aberrant.\u0026amp;quot;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is incorrect because the mutant Arf\u0026amp;nbsp;protein primarily affects COPI-coated vesicle dynamics rather than COPII-coated vesicle fusion. COPII vesicles are involved in transport from the ER to the Golgi, and their fusion processes are regulated by different proteins. Hence, the disruption of COPII vesicle fusion is not a direct consequence of the mutant Arf\u0026amp;nbsp;protein.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement D: \u0026amp;quot;COPI-coated vesicle fusion with the target membrane is disrupted.\u0026amp;quot;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is correct because the mutant Arf\u0026amp;nbsp;protein, being constitutively GTP-bound, disrupts the normal regulation of COPI-coated vesicle fusion. Proper GTP hydrolysis is necessary for vesicle tethering and fusion processes, which are impaired in this mutant scenario.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;केवल B और D\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;पुटिका निर्माण, परिवहन और संलयन कोशिकीय परिवहन प्रणालियों में महत्वपूर्ण प्रक्रियाएँ हैं। COPI या COPII प्रोटीनों से लेपित पुटिकाएँ कोशिकीय डिब्बों, जैसे एंडोप्लाज्मिक रेटिकुलम (ER), गोल्गी उपकरण और प्लाज्मा झिल्ली के बीच अणुओं के परिवहन में सहायता करती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;प्रोटीन Arf (ARF परिवार के GTPases) सक्रिय (GTP-बंधित) और निष्क्रिय (GDP-बंधित) अवस्थाओं के बीच चक्रण करके पुटिका निर्माण में एक नियामक भूमिका निभाता है। GTP को हाइड्रोलाइज़ करने की इसकी क्षमता उचित पुटिका निर्माण और परिवहन सुनिश्चित करती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;एक उत्परिवर्ती Arf प्रोटीन जो संरचनात्मक रूप से GTP से बंधा होता है लेकिन GTP हाइड्रोलिसिस में दोषपूर्ण है, सामान्य पुटिका गतिशीलता को बाधित करता है, जिससे झिल्ली बंधन, पुटिका संलयन और परिवहन नियमन में दोष उत्पन्न होते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन A: \u0026amp;quot;COPI-लेपित पुटिकाएँ केवल अपने सामान्य स्थान से ही बनती हैं।\u0026amp;quot;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन गलत है क्योंकि उत्परिवर्ती Arf प्रोटीन, संरचनात्मक रूप से GTP-बंधित होने के कारण, सामान्य पुटिका निर्माण प्रक्रियाओं को बाधित करता है। COPI-लेपित पुटिका निर्माण असामान्य रूप से होता है क्योंकि Arf हमेशा सक्रिय होता है और पुटिका निर्माण को ठीक से नियंत्रित करने के लिए GTP को हाइड्रोलाइज़ नहीं कर सकता है। इसलिए, पुटिकाएँ अनपेक्षित स्थानों पर भी बन सकती हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन B: \u0026amp;quot;Arf संरचनात्मक रूप से झिल्ली से बंधा होता है।\u0026amp;quot;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन सही है क्योंकि उत्परिवर्ती Arf प्रोटीन GTP को हाइड्रोलाइज़ नहीं कर सकता है। परिणामस्वरूप, यह अपनी सक्रिय अवस्था में रहता है, जो झिल्लियों के साथ इसके निरंतर जुड़ाव को सुनिश्चित करता है, जिससे झिल्ली-बंधित और कोशिकीय अवस्थाओं के बीच सामान्य चक्रण को रोका जा सकता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन C: \u0026amp;quot;COPII-लेपित पुटिका का लक्ष्य झिल्ली के साथ संलयन असामान्य है।\u0026amp;quot;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन गलत है क्योंकि उत्परिवर्ती Arf प्रोटीन मुख्य रूप से COPI-लेपित पुटिका गतिशीलता को प्रभावित करता है न कि COPII-लेपित पुटिका संलयन को। COPII पुटिकाएँ ER से गोल्गी तक परिवहन में शामिल होती हैं, और उनकी संलयन प्रक्रियाएँ विभिन्न प्रोटीनों द्वारा नियंत्रित होती हैं। इसलिए, COPII पुटिका संलयन का विघटन उत्परिवर्ती Arf प्रोटीन का प्रत्यक्ष परिणाम नहीं है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन D: \u0026amp;quot;COPl-लेपित पुटिका का लक्ष्य झिल्ली के साथ संलयन बाधित है।\u0026amp;quot;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन सही है क्योंकि उत्परिवर्ती Arf प्रोटीन, संरचनात्मक रूप से GTP-बंधित होने के कारण, COPI-लेपित पुटिका संलयन के सामान्य नियमन को बाधित करता है। पुटिका बंधन और संलयन प्रक्रियाओं के लिए उचित GTP हाइड्रोलिसिस आवश्यक है, जो इस उत्परिवर्ती परिदृश्य में बिगड़ा हुआ है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Cellular Organization"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4518aa958c4957eed4157","title":"Cellular Organization"},"t":{"id":"63a45197ebdb38d1b04bc5c6","title":"Intracellular organelles"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":19.31297709923663,"attempts":{"correct":56,"incorrect":248,"partial":0,"skipped":875,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953b1e3005e0e058597be0":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is\u0026amp;nbsp;\u0026lt;strong\u0026gt;A-T, B-F, C-T, D-F\u0026amp;nbsp;\u0026amp;nbsp;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The photorespiratory (C2) pathway is a process in plants that occurs when the enzyme RuBisCO oxygenates RuBP, leading to the production of 2-phosphoglycolate, which cannot directly enter the Calvin cycle. This pathway involves a cooperative interaction among three organelles: chloroplasts, peroxisomes, and mitochondria.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The photorespiratory pathway helps recover carbon from 2-phosphoglycolate but involves energy costs and the release of CO\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt;. It mitigates the loss of carbon and is considered a wasteful process compared to the Calvin cycle.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement A:\u0026lt;/strong\u0026gt; \u0026amp;quot;2-phosphoglycolate formed in the chloroplast is converted to glycolate by the action of phosphoglycolate phosphatase.\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is \u0026lt;strong\u0026gt;TRUE\u0026lt;/strong\u0026gt;. In the chloroplast, 2-phosphoglycolate is a by-product of RuBisCO activity when it reacts with oxygen. The enzyme phosphoglycolate phosphatase converts 2-phosphoglycolate into glycolate, which is then transported out of the chloroplast.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement B:\u0026lt;/strong\u0026gt; \u0026amp;quot;Glycolate exits chloroplast by diffusion and enters peroxisome through a glycolate transporter.\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is \u0026lt;strong\u0026gt;FALSE\u0026lt;/strong\u0026gt;. Glycolate does not exit the chloroplast by simple diffusion. Instead, glycolate is transported actively via specific glycolate transporters to the peroxisome.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement C:\u0026lt;/strong\u0026gt; \u0026amp;quot;In the peroxisomes, glycolate reacts with O\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt; and produces glyoxylate and H\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt;O\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt;.\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is \u0026lt;strong\u0026gt;TRUE\u0026lt;/strong\u0026gt;. In peroxisomes, glycolate oxidase catalyzes the oxidation of glycolate, producing glyoxylate and hydrogen peroxide (H\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt;O\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt;).\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement D:\u0026lt;/strong\u0026gt; \u0026amp;quot;Only serine:glyoxylate aminotransferase is involved in the conversion of glyoxylate into serine in a peroxisomal reaction.\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is \u0026lt;strong\u0026gt;FALSE\u0026lt;/strong\u0026gt;. The conversion of glyoxylate involves multiple enzymes and reactions, including the action of glycine and serine transamination reactions. It is not solely carried out by serine:glyoxylate aminotransferase.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img height=\u0026quot;704\u0026quot; src=\u0026quot;https://lh7-rt.googleusercontent.com/docsz/AD_4nXfi4HbbzGmpaSAH1I8s8_Cr-QCuJLyznUA5vV4frcKvOB1_pjRx-SswwxJT000V1kLNN8n_oXarGW60W1w0qUBDxnnZjoJc0adNnnqHnXN8qTLIfKGbHh_DEOjJW9kI20RI5YErtQ?key=Q7XzbCjRZhC28tqvjGFAyi5m\u0026quot; style=\u0026quot;color: rgb(33, 37, 41); white-space-collapse: preserve; margin-left: 0px; margin-top: 0px;\u0026quot; width=\u0026quot;458\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;A-T, B-F, C-T, D-F\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;प्रकाशश्वसन (C2) पथ पौधों में एक प्रक्रिया है जो तब होती है जब एंजाइम RuBisCO, RuBP को ऑक्सीजनित करता है, जिससे 2-फॉस्फोग्लाइकोलेट का उत्पादन होता है, जो सीधे केल्विन चक्र में प्रवेश नहीं कर सकता है। इस पथ में तीन कोशिकांगों की सहकारी अंतःक्रिया शामिल है: क्लोरोप्लास्ट, पेरोक्सिसोम और माइटोकॉन्ड्रिया।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;प्रकाशश्वसन पथ 2-फॉस्फोग्लाइकोलेट से कार्बन को पुनः प्राप्त करने में मदद करता है लेकिन इसमें ऊर्जा की लागत और CO\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt;\u0026amp;nbsp;का मोचन\u0026amp;nbsp;शामिल है। यह कार्बन के नुकसान को कम करता है और केल्विन चक्र की तुलना में इसे एक अपव्ययी प्रक्रिया माना जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन A:\u0026lt;/strong\u0026gt; \u0026amp;quot;क्लोरोप्लास्ट में बनने वाला 2-फॉस्फोग्लाइकोलेट, फॉस्फोग्लाइकोलेट फॉस्फेटेज की क्रिया द्वारा ग्लाइकोलेट में परिवर्तित हो जाता है।\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन \u0026lt;strong\u0026gt;सत्य\u0026lt;/strong\u0026gt; है। क्लोरोप्लास्ट में, 2-फॉस्फोग्लाइकोलेट RuBisCO गतिविधि का एक उप-उत्पाद है जब यह ऑक्सीजन के साथ प्रतिक्रिया करता है। एंजाइम फॉस्फोग्लाइकोलेट फॉस्फेटेज 2-फॉस्फोग्लाइकोलेट को ग्लाइकोलेट में परिवर्तित करता है, जिसे तब क्लोरोप्लास्ट से बाहर ले जाया जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन B:\u0026lt;/strong\u0026gt; \u0026amp;quot;ग्लाइकोलेट विसरण द्वारा क्लोरोप्लास्ट से बाहर निकलता है और एक ग्लाइकोलेट ट्रांसपोर्टर के माध्यम से पेरोक्सिसोम में प्रवेश करता है।\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन \u0026lt;strong\u0026gt;असत्य\u0026lt;/strong\u0026gt; है। ग्लाइकोलेट साधारण विसरण द्वारा क्लोरोप्लास्ट से बाहर नहीं निकलता है। इसके बजाय, ग्लाइकोलेट को विशिष्ट ग्लाइकोलेट ट्रांसपोर्टरों के माध्यम से सक्रिय रूप से पेरोक्सिसोम में ले जाया जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन C:\u0026lt;/strong\u0026gt; \u0026amp;quot;पेरोक्सिसोम में, ग्लाइकोलेट O\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt; के साथ अभिक्रिया करता है और ग्लाइऑक्सिलेट और H\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt;O\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt; उत्पन्न करता है।\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन \u0026lt;strong\u0026gt;सत्य\u0026lt;/strong\u0026gt; है। पेरोक्सिसोम में, ग्लाइकोलेट ऑक्सीडेज ग्लाइकोलेट के ऑक्सीकरण को उत्प्रेरित करता है, जिससे ग्लाइऑक्सिलेट और हाइड्रोजन पेरोक्साइड (H\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt;O\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt;) का उत्पादन होता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन D:\u0026lt;/strong\u0026gt; \u0026amp;quot;पेरोक्सिसोमल अभिक्रिया में ग्लाइऑक्सिलेट के सेरीन में रूपांतरण में केवल सेरीन:ग्लाइऑक्सिलेट एमिनोट्रांसफेरेज शामिल है।\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन \u0026lt;strong\u0026gt;असत्य\u0026lt;/strong\u0026gt; है। ग्लाइऑक्सिलेट के रूपांतरण में कई एंजाइम और अभिक्रियाएँ शामिल होती हैं, जिनमें ग्लाइसिन और सेरीन ट्रांसएमिनेशन अभिक्रियाएँ भी शामिल हैं। यह केवल सेरीन:ग्लाइऑक्सिलेट एमिनोट्रांस्फरेज़ द्वारा ही नहीं किया जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img height=\u0026quot;704\u0026quot; src=\u0026quot;https://lh7-rt.googleusercontent.com/docsz/AD_4nXfi4HbbzGmpaSAH1I8s8_Cr-QCuJLyznUA5vV4frcKvOB1_pjRx-SswwxJT000V1kLNN8n_oXarGW60W1w0qUBDxnnZjoJc0adNnnqHnXN8qTLIfKGbHh_DEOjJW9kI20RI5YErtQ?key=Q7XzbCjRZhC28tqvjGFAyi5m\u0026quot; style=\u0026quot;color: rgb(33, 37, 41); white-space-collapse: preserve; margin-left: 0px; margin-top: 0px;\u0026quot; width=\u0026quot;458\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["System Physiology Plant"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4526f5db927c0ec7fb376","title":"System Physiology Plant"},"t":{"id":"63a45275fb84f8fa3aec3144","title":"Photosynthesis"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":24.395250212044104,"attempts":{"correct":104,"incorrect":237,"partial":0,"skipped":838,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953b34a25b7b429e6da268":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;B, C, and D\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Airway resistance refers to the resistance to airflow within the respiratory tract and is influenced by several factors, including airway diameter, lung volume, and the viscosity of the gas being inhaled.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Airway resistance plays a critical role in respiratory physiology and is important for ensuring efficient ventilation and gas exchange in healthy lungs. It is primarily determined by the anatomical structure of the bronchial tree and changes dynamically during the respiratory cycle.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Airway resistance is highest in the larger airways (trachea and bronchi) and decreases as airways branch into smaller structures due to their cumulative cross-sectional area.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The smallest airways (terminal bronchioles) contribute minimally to airway resistance because of their large number and overall cross-sectional area.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Breathing a helium-oxygen mixture can reduce airway resistance by decreasing gas density and turbulent airflow.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Statement A:\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026amp;quot;The resistance to airflow increases with increasing lung volume.\u0026amp;quot;\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;This is incorrect because airway resistance decreases as lung volume increases. At higher lung volumes, the airways are stretched and their diameters enlarge, reducing resistance to airflow.\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement B:\u0026lt;/strong\u0026gt; \u0026amp;quot;The major site of airway resistance is in the first eight generations of airways.\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is correct. The majority of airway resistance occurs in the larger bronchi and trachea, which are within the first eight generations of branching. As the airways branch further into smaller airways (beyond the eighth generation), their combined cross-sectional area increases significantly, reducing resistance.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement C:\u0026lt;/strong\u0026gt; \u0026amp;quot;The smallest airways contribute very little to the overall total resistance of the bronchial tree.\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is correct. Despite their small individual diameters, the smallest airways (terminal bronchioles and alveolar ducts) contribute minimally to total airway resistance due to their vast number and large cumulative cross-sectional area, which facilitates airflow with low resistance.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement D:\u0026lt;/strong\u0026gt; \u0026amp;quot;Breathing a mixture of oxygen-helium instead of oxygen-nitrogen results in a decrease of airway resistance.\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is correct. Helium is a less dense gas compared to nitrogen, reducing turbulent flow and, consequently, airway resistance. This principle is sometimes applied in clinical settings to aid patients with obstructive airway conditions.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;B, C, और D\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;है।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;वायुमार्ग प्रतिरोध श्वसन पथ के भीतर वायुप्रवाह के प्रतिरोध को संदर्भित करता है और यह कई कारकों से प्रभावित होता है, जिसमें वायुमार्ग का व्यास, फेफड़ों का आयतन और साँस द्वारा ली जाने वाली गैस की श्यानता शामिल है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;वायुमार्ग प्रतिरोध श्वसन क्रिया विज्ञान में एक महत्वपूर्ण भूमिका निभाता है और स्वस्थ फेफड़ों में कुशल वेंटिलेशन और गैस विनिमय सुनिश्चित करने के लिए महत्वपूर्ण है। यह मुख्य रूप से ब्रोन्कियल ट्री की शारीरिक संरचना द्वारा निर्धारित होता है और श्वसन चक्र के दौरान गतिशील रूप से बदलता रहता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;वायुमार्ग प्रतिरोध बड़े वायुमार्गों (ट्रेकिआ और ब्रांकाई) में सबसे अधिक होता है और वायुमार्ग के संचयी अनुप्रस्थ काट क्षेत्र के कारण छोटी संरचनाओं में विभाजित होने पर यह कम हो जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;सबसे छोटे वायुमार्ग (टर्मिनल ब्रोन्किओल्स) अपनी बड़ी संख्या और समग्र अनुप्रस्थ काट क्षेत्र के कारण वायुमार्ग प्रतिरोध में न्यूनतम योगदान देते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;हीलियम-ऑक्सीजन मिश्रण को सांस के माध्यम से अंदर लेने से गैस घनत्व और अशांत वायु प्रवाह में कमी आने से वायुमार्ग प्रतिरोध कम हो सकता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;कथन A:\u0026lt;/span\u0026gt; \u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;quot;फेफड़ों के आयतन में वृद्धि के साथ वायु प्रवाह का प्रतिरोध बढ़ता है।\u0026amp;quot;\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;यह गलत है क्योंकि फेफड़ों का आयतन बढ़ने पर वायुमार्ग का प्रतिरोध कम हो जाता है। फेफड़ों का आयतन बढ़ने पर, वायुमार्ग खिंच जाते हैं और उनका व्यास बढ़ जाता है, जिससे वायुप्रवाह का प्रतिरोध कम हो जाता है।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन B:\u0026lt;/strong\u0026gt; \u0026amp;quot;वायुमार्ग प्रतिरोध का प्रमुख स्थान वायुमार्ग की पहली आठ पीढ़ियों में है।\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह सही है। वायुमार्ग प्रतिरोध का अधिकांश भाग बड़ी श्वसनी और श्वासनली में होता है, जो शाखाओं की पहली आठ पीढ़ियों के अंतर्गत होती हैं। जैसे-जैसे वायुमार्ग आगे छोटे वायुमार्गों (आठवीं पीढ़ी से आगे) में विभाजित होते हैं, उनका संयुक्त अनुप्रस्थ काट क्षेत्रफल उल्लेखनीय रूप से बढ़ जाता है, जिससे प्रतिरोध कम हो जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन C:\u0026lt;/strong\u0026gt; \u0026amp;quot;सबसे छोटे वायुमार्ग ब्रोन्कियल वृक्ष के समग्र प्रतिरोध में बहुत कम योगदान देते हैं।\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह सही है। अपने छोटे व्यक्तिगत व्यास के बावजूद, सबसे छोटे वायुमार्ग (टर्मिनल ब्रोन्कियोल्स और एल्वियोलर नलिकाएं) अपनी विशाल संख्या और बड़े संचयी अनुप्रस्थ काट\u0026amp;nbsp;क्षेत्र के कारण कुल वायुमार्ग प्रतिरोध में न्यूनतम योगदान देते हैं, जो कम प्रतिरोध के साथ वायु प्रवाह को सुगम बनाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन D:\u0026lt;/strong\u0026gt; \u0026amp;quot;ऑक्सीजन-नाइट्रोजन के बजाय ऑक्सीजन-हीलियम के मिश्रण को सांस के माध्यम से अंदर लेने से वायुमार्ग प्रतिरोध में कमी आती है।\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह सही है। हीलियम, नाइट्रोजन की तुलना में कम सघन गैस है, जो अशांत प्रवाह को कम करती है और परिणामस्वरूप, वायुमार्ग प्रतिरोध को भी कम करती है। इस सिद्धांत का प्रयोग कभी-कभी नैदानिक ​​स्थितियों में अवरोधक वायुमार्ग की समस्याओं वाले रोगियों की सहायता के लिए किया जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["System Physiology Animal"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a452e28f21ac91a2eba7a5","title":"System Physiology Animal"},"t":{"id":"63a452eeb69497f2c4439062","title":"Respiratory system"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":20.46649703138251,"attempts":{"correct":133,"incorrect":222,"partial":0,"skipped":824,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953b47cc49566a430d8de7":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Tropical, Boreal, Temperate, Subtropical\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The Food and Agriculture Organization (FAO) conducts periodic assessments of global forest resources. The 2020 FAO Global Forest Resources Assessment provides detailed data on the proportion and distribution of global forest area across different climatic domains.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Climatic domains refer to regions categorized by climate, which influences forest types and distribution. The four major climatic domains considered are Tropical, Boreal, Temperate, and Subtropical.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Forests in these domains play critical roles in biodiversity conservation, climate regulation, and supporting livelihoods. The distribution of forest area in these domains varies significantly based on geographical and climatic factors.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Tropical, Boreal, Temperate, Subtropical\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The Tropical domain has the largest proportion of the global forest area. Tropical forests, such as the Amazon, Congo, and Southeast Asian rainforests, are known for their high biodiversity and dense canopy cover.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The Boreal domain ranks second in terms of forest area. Boreal forests, primarily found in Canada, Russia, and Scandinavia, consist of coniferous trees and are critical for carbon storage.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The Temperate domain follows Boreal forests in global forest coverage. These forests are found in regions with moderate climates, such as Europe, North America, and parts of Asia, and include deciduous and mixed forests.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The Subtropical domain has the smallest proportion of global forest area. These forests are found in regions with hot and dry climates, such as parts of Australia, South America, and southern Africa.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage68aaeb4d093fb1212fdd1b64.png\u0026quot; style=\u0026quot;height: 196px; width: 450px;\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;em\u0026gt;Fig:Proportion and distribution of global forest area by climatic domain, 2020.​ (\u0026lt;a href=\u0026quot;https://commons.wikimedia.org/wiki/File:Proportion_and_distribution_of_global_forest_area_by_climatic_domain,_2020.svg\u0026quot;\u0026gt;Source\u0026lt;/a\u0026gt;)\u0026lt;/em\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;उष्णकटिबंधीय, बोरियल, शीतोष्ण, उपोष्णकटिबंधीय\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;खाद्य और कृषि संगठन (FAO) वैश्विक वन संसाधनों का आवधिक आकलन करता है। 2020 का FAO वैश्विक वन संसाधन आकलन विभिन्न जलवायु क्षेत्रों में वैश्विक वन क्षेत्र के अनुपात और वितरण पर विस्तृत डेटा प्रदान करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जलवायु क्षेत्र जलवायु द्वारा वर्गीकृत क्षेत्रों को संदर्भित करते हैं, जो वन प्रकारों और वितरण को प्रभावित करते हैं। चार प्रमुख जलवायु क्षेत्रों पर विचार किया जाता है: उष्णकटिबंधीय, बोरियल, शीतोष्ण और उपोष्णकटिबंधीय।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इन क्षेत्रों में वन जैव विविधता संरक्षण, जलवायु विनियमन और आजीविका को सहारा देने में महत्वपूर्ण भूमिका निभाते हैं। इन क्षेत्रों में वन क्षेत्र का वितरण भौगोलिक और जलवायु कारकों के आधार पर काफी भिन्न होता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;उष्णकटिबंधीय, बोरियल, शीतोष्ण, उपोष्णकटिबंधीय\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;उष्णकटिबंधीय क्षेत्र में वैश्विक वन क्षेत्र का सबसे बड़ा अनुपात है। अमेज़ॅन, कांगो और दक्षिण पूर्व एशियाई वर्षावन जैसे उष्णकटिबंधीय वन अपनी उच्च जैव विविधता और घने चंदवा आवरण के लिए जाने जाते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;वन क्षेत्र के मामले में बोरियल क्षेत्र दूसरे स्थान पर है। कनाडा, रूस और स्कैंडिनेविया में मुख्य रूप से पाए जाने वाले बोरियल वनों में शंकुधारी पेड़ होते हैं और ये कार्बन भंडारण के लिए महत्वपूर्ण हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;शीतोष्ण क्षेत्र वैश्विक वन कवरेज में बोरियल वनों का अनुसरण करता है। ये वन यूरोप, उत्तरी अमेरिका और एशिया के कुछ हिस्सों में समशीतोष्ण जलवायु वाले क्षेत्रों में पाए जाते हैं, और इनमें पर्णपाती और मिश्रित वन शामिल हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;उपोष्णकटिबंधीय क्षेत्र में वैश्विक वन क्षेत्र का सबसे छोटा अनुपात है। ये वन ऑस्ट्रेलिया, दक्षिण अमेरिका और दक्षिणी अफ्रीका के कुछ हिस्सों में गर्म और शुष्क जलवायु वाले क्षेत्रों में पाए जाते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage68aaeb4d093fb1212fdd1b64.png\u0026quot; style=\u0026quot;height: 196px; width: 450px;\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;em\u0026gt;चित्र: जलवायु क्षेत्र द्वारा वैश्विक वन क्षेत्र का अनुपात और वितरण, 2020। (\u0026lt;a href=\u0026quot;https://commons.wikimedia.org/wiki/File:Proportion_and_distribution_of_global_forest_area_by_climatic_domain,_2020.svg\u0026quot;\u0026gt;स्रोत\u0026lt;/a\u0026gt;)\u0026lt;/em\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Ecological Principles"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a45541e89684161ccd7911","title":"Ecological Principles"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":13.847328244274813,"attempts":{"correct":104,"incorrect":314,"partial":0,"skipped":761,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953bb74bf9040e58ef8a89":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is\u0026amp;nbsp;\u0026lt;strong\u0026gt;A - iii, B - i, C - iv, D - ii\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;A. Bacoside - (iii) Cognitive enhancer\u0026lt;/strong\u0026gt;:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Bacosides are bioactive compounds found in Bacopa monnieri, a plant commonly used in traditional medicine.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;They are known for their neuroprotective properties and are used to enhance memory and cognitive function.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;B. Vincristine - (i) Chemotherapy for leukemia and lymphoma\u0026lt;/strong\u0026gt;:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Vincristine is an alkaloid derived from the Madagascar periwinkle plant (Catharanthus roseus).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;It is used as an anti-cancer drug for treating leukemia, lymphoma, and other types of cancers due to its ability to inhibit cell division.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;C. Lanolin - (iv) Skin creams and moisturizers\u0026lt;/strong\u0026gt;:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Lanolin is a wax-like substance obtained from sheep\u0026amp;#39;s wool.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;It is widely used in the cosmetic industry for its emollient properties, making it an essential ingredient in skin creams and moisturizers.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;D. Shellac - (ii) Coating for pills and food glazing\u0026lt;/strong\u0026gt;:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Shellac is a resin secreted by the lac insect, Laccifer lacca.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;It is used as a coating material for pills to improve their appearance and as a food glaze to provide a shiny finish to candies and fruits.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;A - iii, B - i, C - iv, D - ii\u0026lt;/strong\u0026gt;\u0026amp;nbsp;है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;A. बैकोसाइड - (iii) संज्ञानात्मक बढ़ाने वाला:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;बैकोसाइड्स बैकोपा मोनिएरी में पाए जाने वाले जैविक रूप से सक्रिय यौगिक हैं, एक पौधा जो आमतौर पर पारंपरिक चिकित्सा में उपयोग किया जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;वे अपने न्यूरोप्रोटेक्टिव गुणों के लिए जाने जाते हैं और स्मृति और संज्ञानात्मक कार्य को बढ़ाने के लिए उपयोग किए जाते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;B. विन्क्रिस्टाइन - (i) ल्यूकेमिया और लिम्फोमा के लिए कीमोथेरेपी:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;विन्क्रिस्टाइन मेडागास्कर पेरिविंकल प्लांट (कैथारंथस रोज़ियस) से प्राप्त एक एल्कलॉइड है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह कोशिका विभाजन को रोकने की अपनी क्षमता के कारण ल्यूकेमिया, लिम्फोमा और अन्य प्रकार के कैंसर के इलाज के लिए एक कैंसर रोधी दवा के रूप में उपयोग किया जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;C. लेनोलिन - (iv) त्वचा क्रीम और मॉइस्चराइजर:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;लेनोलिन भेड़ के ऊन से प्राप्त एक मोम जैसा पदार्थ है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह अपने इमोलिएंट गुणों के लिए कॉस्मेटिक उद्योग में व्यापक रूप से उपयोग किया जाता है, जिससे यह त्वचा क्रीम और मॉइस्चराइजर में एक आवश्यक घटक बन जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;D. शेलैक - (ii) गोलियों के लिए कोटिंग और खाद्य ग्लेज़िंग:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;शेलैक लैक कीट, लैसिफर लैका द्वारा स्रावित एक राल है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह गोलियों के लिए एक कोटिंग सामग्री के रूप में उपयोग किया जाता है ताकि उनकी उपस्थिति में सुधार हो सके और कैंडी और फलों को चमकदार खत्म प्रदान करने के लिए एक खाद्य शीशा के रूप में उपयोग किया जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Applied Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a455cbce3d67ae7cc72e05","title":"Applied Biology"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":20.169635284139137,"attempts":{"correct":152,"incorrect":281,"partial":0,"skipped":746,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953c1fa25b7b429e6da4e5":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is\u0026lt;strong\u0026gt;\u0026amp;nbsp;A - iv, B - i, C - ii, D - iii\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Plants exhibit a complex response mechanism when faced with biotic stress, such as infections caused by pathogens, pests, or other organisms. This response involves various genes and their encoded proteins, which play a significant role in defending against these stresses.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Biotic stress response mechanisms include production of defense-related compounds, activation of transporters, and metabolic adjustments to mitigate pathogen invasion or damage.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Several genes and their corresponding proteins are key to these processes, each serving a specific role in plant immunity and defense.\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;A - SID1 (iii) MATE\u0026amp;nbsp;transporter:\u0026lt;/strong\u0026gt;\u0026amp;nbsp;MATE (Multidrug And Toxin Extrusion) transporters are a family of proteins that facilitate the efflux of various substances across cellular membranes, including drugs and toxins. SID1 in plants has been associated with the transport of small molecules that are important for plant defense and secondary metabolism.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;B - SID2 (i) Isochorismate synthase:\u0026lt;/strong\u0026gt; SID2 encodes isochorismate synthase, which is a pivotal enzyme in the biosynthesis of salicylic acid. Salicylic acid is a key signaling molecule in plant defense, especially against biotrophic pathogens.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;C - PAD3 (ii) Cytochrome P450 monooxygenase:\u0026lt;/strong\u0026gt; PAD3 encodes a cytochrome P450 monooxygenase, which is involved in the synthesis of antimicrobial compounds such as camalexin. These compounds help plants resist pathogen invasion.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;D - PEN3 (iv) ABC\u0026amp;nbsp;transporter:\u0026lt;/strong\u0026gt;\u0026amp;nbsp;ABC (ATP-Binding Cassette) transporters are a large family of proteins known for their role in transporting various molecules across cellular membranes using ATP hydrolysis for energy. PEN3 (Penetration 3) is an ABC transporter in \u0026lt;em\u0026gt;Arabidopsis \u0026lt;/em\u0026gt;that plays a significant role in plant immunity by extruding antimicrobial compounds to the cell surface, preventing pathogen infiltration and promoting defense responses.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर\u0026lt;strong\u0026gt;\u0026amp;nbsp;A - iv, B - i, C - ii, D - iii\u0026amp;nbsp;\u0026lt;/strong\u0026gt;है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;जब पौधे जैविक तनाव का सामना करते हैं, जैसे कि रोगजनकों, कीटों या अन्य जीवों के कारण होने वाले संक्रमण, तो वे एक जटिल प्रतिक्रिया तंत्र प्रदर्शित करते हैं। इस प्रतिक्रिया में विभिन्न जीन और उनके एन्कोडेड प्रोटीन शामिल होते हैं, जो इन तनावों से बचाव में महत्वपूर्ण भूमिका निभाते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जैविक तनाव प्रतिक्रिया तंत्र में रक्षा से संबंधित यौगिकों का उत्पादन, ट्रांसपोर्टरों का सक्रियण और रोगज़नक आक्रमण या क्षति को कम करने के लिए उपापचय समायोजन शामिल हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;कई जीन और उनके संगत प्रोटीन इन प्रक्रियाओं के लिए महत्वपूर्ण हैं, प्रत्येक पौधे की प्रतिरक्षा और रक्षा में एक विशिष्ट भूमिका निभाता है।\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;A - SID1 (iii) MATE ट्रांसपोर्टर:\u0026lt;/strong\u0026gt; MATE (मल्टीड्रग एंड टॉक्सिन एक्सट्रूज़न) ट्रांसपोर्टर प्रोटीन का एक परिवार है जो विभिन्न पदार्थों के कोशिकीय झिल्लियों में प्रवाह को सुविधाजनक बनाता है, जिसमें दवाएं और विषाक्त पदार्थ शामिल हैं। पौधों में SID1 को छोटे अणुओं के परिवहन से जोड़ा गया है जो पौधे की रक्षा और माध्यमिक उपापचय के लिए महत्वपूर्ण हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;B - SID2 (i) आइसोकोरिस्मेट सिंथेज़:\u0026lt;/strong\u0026gt; SID2 आइसोकोरिस्मेट सिंथेज़ को एन्कोड करता है, जो सैलिसिलिक अम्ल के जैव संश्लेषण में एक महत्वपूर्ण एंजाइम है। सैलिसिलिक अम्ल पौधे की रक्षा में एक प्रमुख संकेतन अणु है, खासकर बायोट्रॉफिक रोगजनकों के विरुद्ध।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;C - PAD3 (ii) साइटोक्रोम P450 मोनोऑक्सीजिनेज़:\u0026lt;/strong\u0026gt; PAD3 एक साइटोक्रोम P450 मोनोऑक्सीजिनेज़ को एन्कोड करता है, जो रोगाणुरोधी यौगिकों जैसे कैमेलैक्सिन के संश्लेषण में शामिल है। ये यौगिक पौधों को रोगज़नक आक्रमण का विरोध करने में मदद करते हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;D - PEN3 (iv) ABC ट्रांसपोर्टर:\u0026lt;/strong\u0026gt; ABC (ATP-बाइंडिंग कैसेट) ट्रांसपोर्टर प्रोटीन का एक बड़ा परिवार है जो ऊर्जा के लिए ATP हाइड्रोलिसिस का उपयोग करके विभिन्न अणुओं को कोशिकीय झिल्लियों में परिवहन करने में अपनी भूमिका के लिए जाना जाता है। PEN3 (पेनेट्रेशन 3) \u0026lt;em\u0026gt;अरेबिडोप्सिस\u0026lt;/em\u0026gt; में एक ABC ट्रांसपोर्टर है जो पौधे की प्रतिरक्षा में महत्वपूर्ण भूमिका निभाता है, रोगाणुरोधी यौगिकों को कोशिका की सतह पर बाहर निकालकर, रोगज़नक घुसपैठ को रोकता है और रक्षा प्रतिक्रियाओं को बढ़ावा देता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["System Physiology Plant"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4526f5db927c0ec7fb376","title":"System Physiology Plant"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":10.818490245971146,"attempts":{"correct":124,"incorrect":165,"partial":0,"skipped":890,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953c9aef177aa03fbaf73c":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A and C\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Promoters are DNA sequences that regulate the transcription of genes by providing binding sites for transcription factors.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Transcription factors like TF-X can act as activators (positive regulators) or repressors (negative regulators) of gene expression depending on the context.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Luciferase assays are commonly used to measure the activity of promoters in response to transcription factors. The luciferase enzyme activity is expressed in arbitrary units as an indicator of promoter activity.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement A:\u0026lt;/strong\u0026gt; \u0026amp;quot;TF-X is needed for basal activity of promoter A.\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Under native TF-X levels, the luciferase activity for promoter A is 9. When TF-X is silenced via RNAi, the activity drops to 2, suggesting that TF-X is necessary for maintaining the basal activity of promoter A.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is correct.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement B:\u0026lt;/strong\u0026gt; \u0026amp;quot;TF-X is needed for basal activity of promoter B.\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Under native TF-X levels, the luciferase activity for promoter B is 2, and it remains the same (2) even when TF-X is silenced via RNAi. This indicates that TF-X is not required for basal activity of promoter B.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is incorrect.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement C:\u0026lt;/strong\u0026gt; \u0026amp;quot;TF-X functions both as a positive and negative regulator for promoter A.\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;When TF-X is overexpressed, the luciferase activity for promoter A decreases from 9 (native TF-X levels) to 2, indicating that TF-X acts as a negative regulator for promoter A when present in high amounts.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;When TF-X is silenced via RNAi, the luciferase activity for promoter A drops from 9 to 2, indicating that TF-X also acts as a positive regulator for promoter A at its basal levels.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Thus, TF-X functions both as a positive and negative regulator for promoter A depending on its expression level.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is correct.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A और C\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;उन्नायक DNA अनुक्रम होते हैं जो अनुलेखन कारकों के लिए बंधन स्थल प्रदान करके जीन के अनुलेखन को नियंत्रित करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;TF-X जैसे अनुलेखन कारक संदर्भ के आधार पर जीन अभिव्यक्ति के उत्प्रेरक (धनात्मक नियामक) या दमनकारी (ऋणात्मक नियामक) के रूप में कार्य कर सकते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;ल्यूसिफरेज़ परख का उपयोग आमतौर पर अनुलेखन कारकों के प्रतिसाद में उन्नायकों की गतिविधि को मापने के लिए किया जाता है। उन्नायक गतिविधि के संकेतक के रूप में ल्यूसिफरेज़ एंजाइम गतिविधि को मनमाना इकाइयों में व्यक्त किया जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन A:\u0026lt;/strong\u0026gt; \u0026amp;quot;उन्नायक A की मूल गतिविधि के लिए TF-X आवश्यक है।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;मूल TF-X स्तरों के तहत, उन्नायक A के लिए ल्यूसिफरेज़ गतिविधि 9 है। जब TF-X को RNAi के माध्यम से मौन किया जाता है, तो गतिविधि घटकर 2 हो जाती है, यह सुझाव देते हुए कि उन्नायक A की मूल गतिविधि को बनाए रखने के लिए TF-X आवश्यक है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन सही है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन B:\u0026lt;/strong\u0026gt; \u0026amp;quot;उन्नायक B की मूल गतिविधि के लिए TF-X आवश्यक है।\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;मूल TF-X स्तरों के तहत, उन्नायक B के लिए ल्यूसिफरेज़ गतिविधि 2 है, और यह तब भी समान (2) रहती है जब TF-X को RNAi के माध्यम से मौन किया जाता है। यह इंगित करता है कि उन्नायक B की मूल गतिविधि के लिए TF-X आवश्यक नहीं है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन गलत है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन C:\u0026lt;/strong\u0026gt; \u0026amp;quot;TF-X उन्नायक A के लिए एक धनात्मक और ऋणात्मक नियामक दोनों के रूप में कार्य करता है।\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;जब TF-X का अति-अभिव्यक्ति होता है, तो उन्नायक A के लिए ल्यूसिफरेज़ गतिविधि 9 (मूल TF-X स्तर) से घटकर 2 हो जाती है, यह दर्शाता है कि उच्च मात्रा में मौजूद होने पर TF-X उन्नायक A के लिए एक ऋणात्मक नियामक के रूप में कार्य करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जब TF-X को RNAi के माध्यम से मौन किया जाता है, तो उन्नायक A के लिए ल्यूसिफरेज़ गतिविधि 9 से घटकर 2 हो जाती है, यह दर्शाता है कि TF-X अपने मूल स्तरों पर उन्नायक A के लिए एक धनात्मक नियामक के रूप में भी कार्य करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इस प्रकार, TF-X अपने अभिव्यक्ति स्तर के आधार पर उन्नायक A के लिए एक धनात्मक और ऋणात्मक नियामक दोनों के रूप में कार्य करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन सही है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Fundamental Processes"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a451aec9ba648bc86fbf43","title":"Fundamental Processes"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":15.061916878710766,"attempts":{"correct":45,"incorrect":189,"partial":0,"skipped":945,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953d6ac6cdfd92ecf7a497":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is\u0026lt;strong\u0026gt;\u0026amp;nbsp;A - iv, B - i, C - ii, D - iii\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Vertebrate eye development is a highly regulated process controlled by a network of genes. These genes play specific roles in the development of eye structures, eye field specification, and other processes critical for the formation of functional eyes.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Loss or gain of function mutations in these genes can lead to various phenotypic effects, ranging from defective eye structures to complete absence of eyes.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Key genes involved in eye development include \u0026lt;strong\u0026gt;Shh (Sonic hedgehog)\u0026lt;/strong\u0026gt;, \u0026lt;strong\u0026gt;Otx2\u0026lt;/strong\u0026gt;, and \u0026lt;strong\u0026gt;Mitf\u0026lt;/strong\u0026gt;.\u0026amp;nbsp;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;A - Loss of function of Shh:\u0026lt;/strong\u0026gt; The loss of Shh function leads to a failure to split the eye field, resulting in a single eye field instead of bilateral eye fields. Tis matches with \u0026lt;strong\u0026gt;(iv)\u0026lt;/strong\u0026gt;.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;B - Elevated levels of Shh in the prechordal plate:\u0026lt;/strong\u0026gt;\u0026amp;nbsp;The prechordal plate is an important signaling center that influences the development of the forebrain and eyes. Elevated levels of Shh in the prechordal plate can disrupt the balance of signals required for normal eye development. Excessive Shh can inhibit the formation of eye structures altogether, leading to anophthalmia (absence of eyes).\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;C - Loss of function of Otx2:\u0026lt;/strong\u0026gt;\u0026amp;nbsp;Otx2 is a crucial transcription factor for the development of the forebrain and midbrain. It is also essential for early head and eye development. When Otx2 function is lost, there is a failure in the proper development and specification of the anterior neural tube, leading to severe brain and craniofacial defects.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;D - Loss of function of Mitf:\u0026lt;/strong\u0026gt; Mitf is crucial for the development of pigmented cells in the retina. Its loss results in defective pigmented retina. This matches with \u0026lt;strong\u0026gt;(iii)\u0026lt;/strong\u0026gt;.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;A - iv, B - i, C - ii, D - iii\u0026amp;nbsp;\u0026lt;/strong\u0026gt;\u0026amp;nbsp;है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;कशेरुकी आँख का विकास एक उच्च स्तर पर विनियमित प्रक्रिया है जिसे जीन के एक नेटवर्क द्वारा नियंत्रित किया जाता है। ये जीन आँख संरचनाओं के विकास, आँख क्षेत्र विशिष्टता और कार्यात्मक आँखों के निर्माण के लिए महत्वपूर्ण अन्य प्रक्रियाओं में विशिष्ट भूमिका निभाते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इन जीनों में कार्य की हानि या लाभ उत्परिवर्तन विभिन्न फेनोटाइपिक प्रभावों को जन्म दे सकते हैं, जो दोषपूर्ण आँख संरचनाओं से लेकर आँखों की पूर्ण अनुपस्थिति तक होती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;आँख के विकास में शामिल प्रमुख जीनों में \u0026lt;strong\u0026gt;Shh (सोनिक हेजहॉग)\u0026lt;/strong\u0026gt;, \u0026lt;strong\u0026gt;Otx2\u0026lt;/strong\u0026gt; और \u0026lt;strong\u0026gt;Mitf\u0026lt;/strong\u0026gt; शामिल हैं।\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;A - Shh के कार्य की हानि:\u0026lt;/strong\u0026gt; Shh के कार्य की हानि से आँख के क्षेत्र को विभाजित करने में विफलता होती है, जिसके परिणामस्वरूप द्विपक्षीय नेत्र क्षेत्रों के बजाय एक एकल नेत्र क्षेत्र होता है। यह \u0026lt;strong\u0026gt;(iv)\u0026lt;/strong\u0026gt; से मेल खाता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;B - प्रीकार्डल प्लेट में Shh का उच्च स्तर:\u0026lt;/strong\u0026gt; प्रीकार्डल प्लेट एक महत्वपूर्ण सिग्नलिंग केंद्र है जो अग्रमस्तिष्क और आँखों के विकास को प्रभावित करता है। प्रीकार्डल प्लेट में Shh का उच्च स्तर सामान्य आँख के विकास के लिए आवश्यक संकेतों के संतुलन को बाधित कर सकता है। अत्यधिक Shh आँख संरचनाओं के निर्माण को पूरी तरह से रोक सकता है, जिससे एनोफ्थाल्मिया (आँखों की अनुपस्थिति) हो सकता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;C - Otx2 के कार्य की हानि:\u0026lt;/strong\u0026gt; Otx2 अग्रमस्तिष्क और मध्य मस्तिष्क के विकास के लिए एक महत्वपूर्ण ट्रांसक्रिप्शन कारक है। यह प्रारंभिक सिर और आँख के विकास के लिए भी आवश्यक है। जब Otx2 का कार्य खो जाता है, तो पूर्वकाल तंत्रिका नलिका के उचित विकास और विशिष्टता में विफलता होती है, जिससे गंभीर मस्तिष्क और कपाल संबंधी दोष होते हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;D - Mitf के कार्य की हानि:\u0026lt;/strong\u0026gt; Mitf रेटिना में रंजित कोशिकाओं के विकास के लिए महत्वपूर्ण है। इसके नुकसान से दोषपूर्ण रंजित रेटिना होता है। यह \u0026lt;strong\u0026gt;(iii)\u0026lt;/strong\u0026gt; से मेल खाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Developmental Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4523f152a060341b327ed","title":"Developmental Biology"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":16.750636132315552,"attempts":{"correct":90,"incorrect":253,"partial":0,"skipped":836,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953dc24bf9040e58ef9551":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is\u0026lt;strong\u0026gt;\u0026amp;nbsp;A - i, B - iv, C - i, D - ii\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;b\u0026gt;\u0026lt;u\u0026gt;Explanation:\u0026lt;/u\u0026gt;\u0026lt;/b\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;A. Jerdon\u0026amp;rsquo;s Courser (\u0026lt;em\u0026gt;Rhinoptilus bitorquatus\u0026lt;/em\u0026gt;):\u0026lt;/strong\u0026gt; Classified as \u0026lt;strong\u0026gt;Critically Endangered (i)\u0026lt;/strong\u0026gt; due to its extremely small and declining population. This nocturnal bird is endemic to the Eastern Ghats of India, and its habitat is under severe threat from human activities such as deforestation and agricultural expansion.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;B. Indian Star Tortoise (\u0026lt;em\u0026gt;Geochelone elegans\u0026lt;/em\u0026gt;):\u0026lt;/strong\u0026gt; Classified as \u0026lt;strong\u0026gt;Vulnerable (iv)\u0026lt;/strong\u0026gt; due to habitat loss, illegal pet trade, and poaching. Native to India and Sri Lanka, this species faces significant threats from human exploitation.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;C. Indian Dwarf Banana (\u0026lt;em\u0026gt;Musa mannii\u0026lt;/em\u0026gt;):\u0026lt;/strong\u0026gt; Classified as \u0026lt;strong\u0026gt;Least Concern (iii)\u0026lt;/strong\u0026gt;. This species is widely distributed and does not currently face significant threats to its population.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;D. Teak (\u0026lt;em\u0026gt;Tectona grandis\u0026lt;/em\u0026gt;):\u0026lt;/strong\u0026gt; Classified as \u0026lt;strong\u0026gt;Endangered (ii)\u0026lt;/strong\u0026gt;. This valuable timber species faces threats from overexploitation and habitat loss, making its conservation critical.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर\u0026lt;strong\u0026gt;\u0026amp;nbsp;A - i, B - iv, C - i, D - ii\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;है।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;b\u0026gt;\u0026lt;u\u0026gt;व्याख्या:\u0026lt;/u\u0026gt;\u0026lt;/b\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;A. जर्डन का कोर्सर (\u0026lt;em\u0026gt;राइनोप्टिलस बिटोरक्वाटस\u0026lt;/em\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;strong\u0026gt;):\u0026lt;/strong\u0026gt; अपनी अत्यंत छोटी और घटती आबादी के कारण \u0026lt;strong\u0026gt;गंभीर रूप से संकटग्रस्त (i)\u0026lt;/strong\u0026gt; के रूप में वर्गीकृत किया गया है। यह निशाचर पक्षी भारत के पूर्वी घाटों का स्थानिक है, और इसका आवास वनों की कटाई और कृषि विस्तार जैसी मानवीय गतिविधियों से गंभीर खतरे में है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;B. भारतीय स्टार कछुआ (\u0026lt;em\u0026gt;जियोचेलोन एलिगेंस\u0026lt;/em\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;strong\u0026gt;):\u0026lt;/strong\u0026gt; आवास विनाश, अवैध पालतू व्यापार और शिकार के कारण \u0026lt;strong\u0026gt;सुभेद्य (iv)\u0026lt;/strong\u0026gt; के रूप में वर्गीकृत किया गया है। भारत और श्रीलंका के मूल निवासी, यह प्रजाति मानव शोषण से महत्वपूर्ण खतरों का सामना करती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;C. भारतीय बौना केला (\u0026lt;em\u0026gt;मूसा मन्नी\u0026lt;/em\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;strong\u0026gt;):\u0026lt;/strong\u0026gt; \u0026lt;strong\u0026gt;न्यूनतम चिंता (iii)\u0026lt;/strong\u0026gt; के रूप में वर्गीकृत किया गया है। यह प्रजाति व्यापक रूप से वितरित है और वर्तमान में इसकी आबादी को महत्वपूर्ण खतरा नहीं है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;D. सागौन (\u0026lt;em\u0026gt;टेक्टोना ग्रैंडिस\u0026lt;/em\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;strong\u0026gt;):\u0026lt;/strong\u0026gt; \u0026lt;strong\u0026gt;संकटग्रस्त (ii)\u0026lt;/strong\u0026gt; के रूप में वर्गीकृत किया गया है। यह मूल्यवान लकड़ी की प्रजाति अत्यधिक दोहन और आवास विनाश से खतरों का सामना करती है, जिससे इसका संरक्षण महत्वपूर्ण हो जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Diversity of Life Forms"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a45511ef5b5403de57d744","title":"Diversity of Life Forms"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":16.43765903307888,"attempts":{"correct":39,"incorrect":332,"partial":0,"skipped":808,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953df2a2471c5930456ccc":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A and C\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Sucrose transport in plant cells involves both active transport and diffusion mechanisms.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Active transport requires energy (usually in the form of ATP) and is mediated by carrier proteins, which enable the uptake of sucrose against its concentration gradient.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Diffusion is a passive process where sucrose moves down its concentration gradient without the need for energy input.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The rate of sucrose uptake by soybean protoplasts can be studied by analyzing how external sucrose concentrations affect the transport mechanisms.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement A:\u0026lt;/strong\u0026gt; Sucrose uptake at low concentrations (\u0026amp;lt;10 mM) is facilitated by an energy-dependent process.\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is correct because active transport mechanisms typically dominate at low concentrations where sucrose needs to be moved against its concentration gradient into the cells.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Carrier proteins powered by ATP are involved in this process, making it energy-dependent.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement C:\u0026lt;/strong\u0026gt; At higher concentrations, sucrose enters the cells by diffusion down its concentration gradient.\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is correct because at higher external sucrose concentrations, the concentration gradient becomes favorable for passive diffusion.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Diffusion does not require energy and occurs naturally as sucrose moves from a region of higher concentration to lower concentration.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Incorrect Statements:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement B:\u0026lt;/strong\u0026gt; Sucrose uptake at low concentrations is a carrier-independent process.\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is incorrect because at low concentrations, sucrose uptake relies on carrier proteins, which are part of the active transport mechanism. Carrier proteins are essential to facilitate the movement of sucrose against its concentration gradient.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement D:\u0026lt;/strong\u0026gt; Inhibition of ATP synthesis with metabolic poison can block only the linear component.\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is incorrect because the linear component corresponds to diffusion, which is energy-independent and hence unaffected by ATP inhibition.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Metabolic poisons would block the active transport mechanism, not diffusion.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A और C\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;पौधे की कोशिकाओं में सुक्रोज परिवहन में सक्रिय परिवहन और विसरण दोनों तंत्र शामिल हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;सक्रिय परिवहन को ऊर्जा (आमतौर पर ATP के रूप में) की आवश्यकता होती है और यह वाहक प्रोटीन द्वारा मध्यस्थता किया जाता है, जो सुक्रोज के अवशोषण को उसकी सांद्रता प्रवणता के विरुद्ध सक्षम बनाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;विसरण एक निष्क्रिय प्रक्रिया है जहाँ सुक्रोज ऊर्जा इनपुट की आवश्यकता के बिना अपनी सांद्रता प्रवणता के नीचे गति करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;सोयाबीन प्रोटोप्लास्ट द्वारा सुक्रोज अवशोषण की दर का अध्ययन करके विश्लेषण किया जा सकता है कि बाह्य सुक्रोज सांद्रता परिवहन तंत्र को कैसे प्रभावित करती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन A:\u0026lt;/strong\u0026gt; कम सांद्रता (\u0026amp;lt;10 mM) पर सुक्रोज अवशोषण एक ऊर्जा-निर्भर प्रक्रिया द्वारा सुगम होता है।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह सही है क्योंकि सक्रिय परिवहन तंत्र आमतौर पर कम सांद्रता पर हावी होते हैं जहाँ सुक्रोज को कोशिकाओं में उसकी सांद्रता प्रवणता के विरुद्ध ले जाने की आवश्यकता होती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;ATP द्वारा संचालित वाहक प्रोटीन इस प्रक्रिया में शामिल हैं, जिससे यह ऊर्जा-निर्भर बन जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन C:\u0026lt;/strong\u0026gt; उच्च सांद्रता पर, सुक्रोज अपनी सांद्रता प्रवणता के नीचे विसरण द्वारा कोशिकाओं में प्रवेश करता है।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह सही है क्योंकि उच्च बाह्य सुक्रोज सांद्रता पर, सांद्रता प्रवणता निष्क्रिय विसरण के लिए अनुकूल हो जाती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;विसरण को ऊर्जा की आवश्यकता नहीं होती है और यह स्वाभाविक रूप से होता है क्योंकि सुक्रोज उच्च सांद्रता वाले क्षेत्र से निम्न सांद्रता वाले क्षेत्र में जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;गलत कथन:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन B:\u0026lt;/strong\u0026gt; कम सांद्रता पर सुक्रोज अवशोषण एक वाहक-स्वतंत्र प्रक्रिया है।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह गलत है क्योंकि कम सांद्रता में, सुक्रोज का अवशोषण वाहक प्रोटीन पर निर्भर करता है, जो सक्रिय परिवहन तंत्र का हिस्सा हैं। सुक्रोज की सांद्रता प्रवणता के विरुद्ध गति को सुगम बनाने के लिए वाहक प्रोटीन आवश्यक हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन D:\u0026lt;/strong\u0026gt; उपापचयी विष के साथ ATP संश्लेषण का निषेध केवल रैखिक घटक को अवरुद्ध कर सकता है।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह गलत है क्योंकि रैखिक घटक विसरण से मेल खाता है, जो ऊर्जा-स्वतंत्र है और इसलिए ATP निषेध से अप्रभावित है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;उपापचयी विष सक्रिय परिवहन तंत्र को अवरुद्ध करेंगे, विसरण को नहीं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["System Physiology Plant"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4526f5db927c0ec7fb376","title":"System Physiology Plant"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":16.14673452078032,"attempts":{"correct":144,"incorrect":145,"partial":0,"skipped":890,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953e05c6cdfd92ecf7a788":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Males are homogametic; the gene is located on the sex chromosome.\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Dioecious plant species have separate male and female individuals, and their reproductive traits (such as petal color) can follow specific inheritance patterns depending on the location of the gene responsible.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The inheritance pattern described in the question suggests a sex-linked trait, where the gene controlling petal color is located on a sex chromosome, and males are homogametic (having two identical sex chromosomes, e.g., XX).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In this species, the inheritance of petal color is determined by the combination of sex chromosomes and the location of the gene on one of these chromosomes.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Key Points Related to the Correct Answer:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Males in this species are homogametic (XX), while females are heterogametic (XY).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;When a true-breeding red female (XY) is crossed with a true-breeding white male (XX):\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Female gametes (X\u0026lt;sub\u0026gt;red\u0026lt;/sub\u0026gt; and Y\u0026lt;sub\u0026gt;red\u0026lt;/sub\u0026gt;) combine with male gametes (X\u0026lt;sub\u0026gt;white\u0026lt;/sub\u0026gt;) to produce F1 progeny.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;All males (XX) inherit one red allele from the female parent and one white allele from the male parent, resulting in red males (dominant trait).\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;All females (XY) inherit a white allele from the male parent and a red allele from the female parent, resulting in white females (dominant in females).\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In the reciprocal cross, where a red male is crossed with a white female, all progeny inherit red alleles, resulting in red males and red females.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Other Options:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;The gene is located in the mitochondrial genome.\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Mitochondrial inheritance is maternal, meaning traits controlled by mitochondrial genes are passed exclusively from the mother to all offspring.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;The observed inheritance pattern in the question does not match mitochondrial inheritance, as male and female progeny exhibit different petal colors depending on the parental cross.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Females are homogametic; the gene is located on the sex chromosome.\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;If females were homogametic (XX) and males heterogametic (XY), the inheritance pattern described would not result in the observed F1 progeny outcomes.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;The gene is located on an autosome.\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;If the gene were located on an autosome, the inheritance of petal color would not depend on the sex of the progeny, and the same petal color would be observed in males and females for both crosses.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर है-\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;नर समयुग्मकी हैं; जीन लिंग गुणसूत्र पर स्थित है।\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;द्विलिंगी पादप प्रजातियों में अलग-अलग नर और मादा व्यक्ति होते हैं, और उनके प्रजनन लक्षण (जैसे पंखुड़ी का रंग) जीन के स्थान के आधार पर विशिष्ट वंशानुगत पैटर्न का पालन कर सकते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;प्रश्न में वर्णित वंशानुगत पैटर्न एक लिंग-संबंधित लक्षण का सुझाव देता है, जहाँ पंखुड़ी के रंग को नियंत्रित करने वाला जीन एक लिंग गुणसूत्र पर स्थित होता है, और नर समयुग्मकी होते हैं (दो समान लिंग गुणसूत्र होते हैं, जैसे, XX)।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इस प्रजाति में, पंखुड़ी के रंग की वंशानुगतता लिंग गुणसूत्रों के संयोजन और इन गुणसूत्रों में से एक पर जीन के स्थान द्वारा निर्धारित की जाती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;सही उत्तर से संबंधित मुख्य बिंदु:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;इस प्रजाति में नर समयुग्मकी (XX) होते हैं, जबकि मादाएँ विषमयुग्मकी (XY) होती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जब एक सत्य प्रजनन लाल मादा (XY) को एक सत्य प्रजनन सफेद नर (XX) के साथ संकरण किया जाता है:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;मादा युग्मक (X\u0026lt;sub\u0026gt;लाल\u0026lt;/sub\u0026gt; और Y\u0026lt;sub\u0026gt;लाल\u0026lt;/sub\u0026gt;) नर युग्मक (X\u0026lt;sub\u0026gt;सफेद\u0026lt;/sub\u0026gt;) के साथ मिलकर F1 संतति का उत्पादन करते हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;सभी नर (XX) मादा जनक से एक लाल एलील और नर जनक से एक सफेद एलील प्राप्त करते हैं, जिसके परिणामस्वरूप लाल नर (प्रमुख लक्षण) होते हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;सभी मादाएँ (XY) नर जनक से एक सफेद एलील और मादा जनक से एक लाल एलील प्राप्त करती हैं, जिसके परिणामस्वरूप सफेद मादाएँ (मादाओं में प्रमुख) होती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;पारस्परिक संकरण में, जहाँ एक लाल नर को एक सफेद मादा के साथ संकरण किया जाता है, सभी संतति लाल एलील प्राप्त करती हैं, जिसके परिणामस्वरूप लाल नर और लाल मादाएँ होती हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;जीन माइटोकॉन्ड्रियल जीनोम में स्थित है।\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;माइटोकॉन्ड्रियल वंशानुगतता मातृ होती है, जिसका अर्थ है कि माइटोकॉन्ड्रियल जीन द्वारा नियंत्रित लक्षण विशेष रूप से माता से सभी संतानों को पारित होते हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;प्रश्न में देखा गया वंशानुगत पैटर्न माइटोकॉन्ड्रियल वंशानुगतता से मेल नहीं खाता है, क्योंकि नर और मादा संतति माता-पिता के संकरण के आधार पर अलग-अलग पंखुड़ी के रंग प्रदर्शित करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;मादाएँ समयुग्मकी हैं; जीन लिंग गुणसूत्र पर स्थित है।\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;यदि मादाएँ समयुग्मकी (XX) और नर विषमयुग्मकी (XY) होतीं, तो वर्णित वंशानुगत पैटर्न के परिणामस्वरूप देखी गई F1 संतति परिणाम नहीं होते।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;जीन एक अलिंगसूत्र पर स्थित है।\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;यदि जीन एक अलिंगसूत्र पर स्थित होता, तो पंखुड़ी के रंग की वंशानुगतता संतति के लिंग पर निर्भर नहीं होती, और दोनों संकरणों के लिए नर और मादा में समान पंखुड़ी का रंग देखा जाता।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Inheritance Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a453102b304a00e31e93c8","title":"Inheritance Biology"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":29.07718405428332,"attempts":{"correct":130,"incorrect":269,"partial":0,"skipped":780,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953e13cc49566a430d9ba0":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;2.5\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\n\t\u0026lt;li\u0026gt;In ecology, logistic growth describes how a population grows rapidly initially, then slows as it approaches the carrying capacity of its environment.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The carrying capacity (K) is the maximum population size that the environment can sustain indefinitely.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The logistic growth rate can be calculated using the formula:\u0026lt;br /\u0026gt;\n\t\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;dN/dt = rN(1 - N/K)\u0026lt;/span\u0026gt;\u0026lt;br /\u0026gt;\n\twhere:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;dN/dt = change in population size per unit time\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;r = intrinsic growth rate\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;N = current population size\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;K = carrying capacity\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The maximum growth rate occurs when the population is at half the carrying capacity (N = K/2).\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Calculation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;br /\u0026gt;\nThe maximum growth rate occurs when the population size (N) is half of the carrying capacity:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;N = K/2 = 200/2 = 100.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;Substitute N = 100, K = 200, and r = 0.05 into the formula: \u0026lt;strong\u0026gt;dN/dt = rN(1 - N/K)\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;dN/dt = 0.05 \u0026amp;times; 100 \u0026amp;times; (1 - 100/200)\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;dN/dt = 0.05 \u0026amp;times; 100 \u0026amp;times; (1 - 0.5)\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;dN/dt = 0.05 \u0026amp;times; 100 \u0026amp;times; 0.5\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;dN/dt = 2.5.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;2.5\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\n\t\u0026lt;li\u0026gt;पारिस्थितिकी में, लॉजिस्टिक\u0026amp;nbsp;वृद्धि से यह पता चलता है कि कैसे एक जनसंख्या शुरू में तेजी से बढ़ती है, फिर अपने पर्यावरण की वहन क्षमता के करीब पहुंचने पर धीमी हो जाती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;वहन क्षमता (K) अधिकतम जनसंख्या आकार है जिसे पर्यावरण अनिश्चित काल तक बनाए रख सकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;लॉजिस्टिक वृद्धि दर की गणना सूत्र का उपयोग करके की जा सकती है:\u0026lt;br /\u0026gt;\n\t\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;dN/dt = rN(1 - N/K)\u0026lt;/span\u0026gt;\u0026lt;br /\u0026gt;\n\tजहाँ:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;dN/dt = प्रति समय इकाई जनसंख्या आकार में परिवर्तन\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;r = आंतरिक वृद्धि दर\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;N = वर्तमान जनसंख्या आकार\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;K = वहन क्षमता\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;अधिकतम वृद्धि दर तब होती है जब जनसंख्या वहन क्षमता के आधे पर होती है (N = K/2)।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;गणना:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;br /\u0026gt;\nअधिकतम वृद्धि दर तब होती है जब जनसंख्या आकार (N) वहन क्षमता का आधा होता है:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;N = K/2 = 200/2 = 100।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;सूत्र में N = 100, K = 200, और r = 0.05 प्रतिस्थापित करें: \u0026lt;strong\u0026gt;dN/dt = rN(1 - N/K)\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;dN/dt = 0.05 x 100 x (1 - 100/200)\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;dN/dt = 0.05 x 100 x (1 - 0.5)\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;dN/dt = 0.05 x 100 x 0.5\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;dN/dt = 2.5।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Ecological Principles"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a45541e89684161ccd7911","title":"Ecological Principles"},"t":{"id":"63a4554f8f21ac91a2ebcf46","title":"Population Ecology"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":21.95165394402037,"attempts":{"correct":143,"incorrect":170,"partial":0,"skipped":866,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953e65f922825acdf60cc9":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;No change\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Real-time quantitative PCR (qPCR) is a technique used to amplify and simultaneously quantify a targeted DNA molecule. In this case, it is used to measure the expression levels of the viral gag gene and the host beta-tubulin gene.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The\u0026amp;nbsp;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative;  line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt; (cycle threshold) value is the cycle number at which the fluorescence signal crosses the threshold and becomes detectable. A lower \u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative;  line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt;value indicates higher levels of starting RNA (or DNA).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In this experiment, the\u0026amp;nbsp;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative;  line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt; values of gag gene transcripts in cells infected with the mutant strain \u0026amp;#39;A\u0026amp;#39; and wild-type strain (WT) were compared to determine the relative change in viral transcript levels.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The relative expression is calculated using the 2\u0026lt;sup\u0026gt;\u0026amp;minus;\u0026amp;Delta;\u0026amp;Delta;Ct\u0026lt;/sup\u0026gt; method, which compares the\u0026amp;nbsp;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative;  line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026amp;nbsp;values of the target gene (gag) normalized to the reference gene (beta-tubulin).\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;C\u0026lt;sub\u0026gt;t\u0026lt;/sub\u0026gt; Values:\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;For gag in \u0026amp;#39;A\u0026amp;#39;-infected cells: C\u0026lt;sub\u0026gt;t\u0026lt;/sub\u0026gt; = 22\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;For gag in WT-infected cells: C\u0026lt;sub\u0026gt;t\u0026lt;/sub\u0026gt; = 23\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;For beta-tubulin (reference gene): C\u0026lt;sub\u0026gt;t\u0026lt;/sub\u0026gt; values are 17 (A-infected), 18 (WT-infected), and 17 (uninfected).\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The \u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative;  line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt;values of gag are normalized to beta-tubulin (reference gene) to account for any variations in RNA quantity or quality.\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026amp;Delta;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative;  line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt;(A-infected) =\u0026amp;nbsp;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative;  line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt; (gag in A) -\u0026amp;nbsp;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative;  line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt; (beta-tubulin in A) = 22 - 17 = 5\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026amp;Delta;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative;  line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt; (WT-infected) = \u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative;  line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt;(gag in WT) - \u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative;  line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt;(beta-tubulin in WT) = 23 - 18 = 5\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Relative Change:\u0026lt;/strong\u0026gt; The relative fold change is calculated as 2\u0026lt;sup\u0026gt;\u0026amp;minus;\u0026amp;Delta;\u0026amp;Delta;Ct\u0026lt;/sup\u0026gt;, where \u0026amp;Delta;\u0026amp;Delta;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative;  line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt; = \u0026amp;Delta;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative;  line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt; (A-infected) - \u0026amp;Delta;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative;  line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt; (WT-infected).\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026amp;Delta;\u0026amp;Delta;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative;  line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt; = 5 - 5 = 0\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Relative fold change = 2\u0026lt;sup\u0026gt;\u0026amp;minus;0\u0026lt;/sup\u0026gt; = 1\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Since the relative fold change is 1, there is \u0026lt;strong\u0026gt;no change\u0026lt;/strong\u0026gt; in the gag transcript levels between \u0026amp;#39;A\u0026amp;#39;-infected and WT-infected cells.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर\u0026amp;nbsp;है- \u0026lt;strong\u0026gt;कोई परिवर्तन नहीं होता है\u0026lt;/strong\u0026gt;।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;रियल-टाइम क्वांटिटेटिव PCR (qPCR) एक ऐसी तकनीक है जिसका उपयोग लक्षित DNA अणु को प्रवर्धित करने और साथ ही उसकी मात्रा निर्धारित करने के लिए किया जाता है। इस मामले में, इसका उपयोग वायरल gag जीन और पोषी बीटा-ट्यूबुलिन जीन के अभिव्यक्ति स्तरों को मापने के लिए किया जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative; line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt; (चक्र सीमा) मान वह चक्र संख्या है जिस पर प्रतिदीप्ति संकेत सीमा को पार कर जाता है और पता लगाने योग्य हो जाता है। कम \u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative; line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt;मान प्रारंभिक RNA (या DNA) के उच्च स्तर को इंगित करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इस प्रयोग में, \u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative; line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt; उत्परिवर्ती स्ट्रेन \u0026amp;#39;A\u0026amp;#39; से संक्रमित कोशिकाओं में gag जीन प्रतिलेखों के मान वायरल अनुलेखित स्तरों में सापेक्ष परिवर्तन निर्धारित करने के लिए \u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative; line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span\u0026gt;\u0026amp;nbsp;मानों की तुलना संदर्भ जीन (बीटा-ट्यूबुलिन) से सामान्यीकृत लक्ष्य जीन (gag) के मानों से की जाती है।\u0026lt;/span\u0026gt;\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;C\u0026lt;sub\u0026gt;t\u0026lt;/sub\u0026gt; मान:\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026amp;#39;A\u0026amp;#39;-संक्रमित कोशिकाओं में gag के लिए: C\u0026lt;sub\u0026gt;t\u0026lt;/sub\u0026gt; = 22\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;WT-संक्रमित कोशिकाओं में gag के लिए: C\u0026lt;sub\u0026gt;t\u0026lt;/sub\u0026gt; = 23\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;बीटा-ट्यूबुलिन (संदर्भ जीन) के लिए: C\u0026lt;sub\u0026gt;t\u0026lt;/sub\u0026gt; मान 17 (A-संक्रमित), 18 (WT-संक्रमित), और 17 (असंक्रमित) हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative; line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt;RNA मात्रा या गुणवत्ता में किसी भी भिन्नता को ध्यान में रखते हुए gag के मानों को बीटा-ट्यूबुलिन (संदर्भ जीन) के लिए सामान्यीकृत किया जाता है।\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026amp;Delta;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative; line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt;(A-संक्रमित) =\u0026amp;nbsp;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative; line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt; (A में gag) -\u0026amp;nbsp;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative; line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt; (A में बीटा-ट्यूबुलिन) = 22 - 17 = 5\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026amp;Delta;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative; line-height: 0; vertical-align: आधार रेखा; नीचे: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt; (WT-संक्रमित) = \u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative; line-height: 0; vertical-align: आधार रेखा; नीचे: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt;(WT में gag) - \u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative; line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt;(WT में बीटा-ट्यूबुलिन) = 23 - 18 = 5\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;सापेक्ष परिवर्तन:\u0026lt;/strong\u0026gt; सापेक्ष गुना परिवर्तन की गणना 2\u0026lt;sup\u0026gt;\u0026amp;minus;\u0026amp;Delta;\u0026amp;Delta;Ct\u0026lt;/sup\u0026gt; के रूप में की जाती है, जहाँ \u0026amp;Delta;\u0026amp;Delta;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative; line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt; = \u0026amp;Delta;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative; line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt; (A-संक्रमित) - \u0026amp;Delta;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative; line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt; (WT-संक्रमित)।\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026amp;Delta;\u0026amp;Delta;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;C\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative; line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;t\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt; = 5 - 5 = 0\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;सापेक्ष फोल्ड परिवर्तन = 2\u0026lt;sup\u0026gt;\u0026amp;minus;0\u0026lt;/sup\u0026gt; = 1\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;चूँकि सापेक्ष फोल्ड परिवर्तन 1 है, इसलिए \u0026amp;#39;A\u0026amp;#39;-संक्रमित और WT-संक्रमित कोशिकाओं के बीच gag अनुलेखित\u0026amp;nbsp;स्तरों में \u0026lt;strong\u0026gt;कोई परिवर्तन\u0026lt;/strong\u0026gt; नहीं होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Methods in Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4566d978874fc5c7a0d11","title":"Methods in Biology"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":10.473282442748086,"attempts":{"correct":17,"incorrect":189,"partial":0,"skipped":973,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953ebc7ac09e469dee9272":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A - iii, B - i, C - iv, D - ii\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;The nervous system can be affected by various molecules, which work through different mechanisms to alter the functioning of neurons. These molecules can act as inhibitors or stimulators by targeting specific proteins, ion channels, or neurotransmitter pathways.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;A. Lidocaine - (iii):\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Lidocaine is a local anesthetic that works by binding to the amino acid residues lining the sodium channel pore.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This binding prevents the influx of sodium ions (Na+) into the neuron, which is essential for generating an action potential.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;By blocking the action potential, Lidocaine inhibits the transmission of nerve signals, resulting in localized pain relief.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;B. Botulinum toxin - (i):\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Botulinum toxin is a neurotoxin produced by the bacterium \u0026lt;i\u0026gt;Clostridium botulinum\u0026lt;/i\u0026gt;.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This toxin consists of two polypeptides: one facilitates the release of acetylcholine at synapses with muscle cells, allowing the protease to enter the cytosol of the axon terminal.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Once inside, the toxin cleaves specific proteins required for neurotransmitter release, effectively blocking the release of acetylcholine and causing muscle paralysis.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;C. Cocaine - (iv):\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Cocaine binds to the dopamine transporter, which is responsible for removing dopamine from the synaptic cleft.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;By inhibiting this transporter, cocaine prevents the reuptake of dopamine, leading to prolonged stimulation of postsynaptic neurons.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This action contributes to its addictive properties and stimulant effects.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;D. Desipramine - (ii):\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Desipramine is a tricyclic antidepressant that blocks the reuptake of norepinephrine at synapses.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This blockage prolongs the stimulation of postsynaptic neurons, enhancing the effects of norepinephrine and contributing to its antidepressant effects.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A - iii, B - i, C - iv, D - ii\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;है।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;तंत्रिका तंत्र विभिन्न अणुओं से प्रभावित हो सकता है, जो न्यूरॉन्स के कार्य को बदलने के लिए विभिन्न तंत्रों के माध्यम से काम करते हैं। ये अणु विशिष्ट प्रोटीन, आयन चैनलों या न्यूरोट्रांसमीटर मार्गों को लक्षित करके अवरोधक या उत्तेजक के रूप में कार्य कर सकते हैं।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;A. लाइडोकेन - (iii):\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;लाइडोकेन एक स्थानीय संवेदनाहारी है जो सोडियम चैनल छिद्र को पंक्तिबद्ध करने वाले एमिनो अम्ल अव्ययों से जुड़कर काम करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह बंधन न्यूरॉन में सोडियम आयनों (Na+) के प्रवाह को रोकता है, जो एक एक्शन पोटेंशियल उत्पन्न करने के लिए आवश्यक है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;एक्शन पोटेंशियल को अवरुद्ध करके, लाइडोकेन तंत्रिका संकेतों के संचरण को रोकता है, जिसके परिणामस्वरूप स्थानीय दर्द से राहत मिलती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;B. बोटुलिनम टॉक्सिन - (i):\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;बोटुलिनम टॉक्सिन एक न्यूरोटॉक्सिन है जो बैक्टीरिया \u0026lt;i\u0026gt;क्लोस्ट्रीडियम बोटुलिनम\u0026lt;/i\u0026gt; द्वारा उत्पादित होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इस टॉक्सिन में दो पॉलीपेप्टाइड होते हैं: एक पेशी कोशिकाओं के साथ सिनैप्स पर एसिटाइलकोलाइन के स्राव की सुविधा प्रदान करता है, जिससे प्रोटीज को एक्सॉन टर्मिनल के साइटोसोल में प्रवेश करने में सहायता\u0026amp;nbsp;मिलती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;एक बार अंदर जाने के बाद, टॉक्सिन न्यूरोट्रांसमीटर स्राव के लिए आवश्यक विशिष्ट प्रोटीन को काट देता है, प्रभावी रूप से एसिटाइलकोलाइन के स्राव को अवरुद्ध करता है और पेशियों के पक्षाघात का कारण बनता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;C. कोकेन - (iv):\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;कोकेन डोपामाइन ट्रांसपोर्टर से जुड़ता है, जो सिनेप्टिक क्लिफ्ट से डोपामाइन को हटाने के लिए उत्तरदायी है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इस ट्रांसपोर्टर को रोककर, कोकेन डोपामाइन के पुनः अवशोषण को रोकता है, जिससे पोस्टसिनेप्टिक न्यूरॉन्स की लंबी उत्तेजना होती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह क्रिया इसके व्यसनकारी गुणों और उत्तेजक प्रभावों में योगदान करती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;D. डेसिप्रेमाइन - (ii):\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;डेसिप्रेमाइन एक ट्राइसाइक्लिक एंटीडिप्रेसेंट है जो सिनैप्स पर नॉरएपिनेफ्रिन के पुनः अवशोषण को अवरुद्ध करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह रुकावट पोस्टसिनेप्टिक न्यूरॉन्स की उत्तेजना को लंबा करती है, नॉरएपिनेफ्रिन के प्रभावों को बढ़ाती है और इसके एंटीडिप्रेसेंट प्रभावों में योगदान करती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["System Physiology Animal"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a452e28f21ac91a2eba7a5","title":"System Physiology Animal"},"t":{"id":"63a452f1abc201e6b11e7e45","title":"Nervous system"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":17.72858354537742,"attempts":{"correct":96,"incorrect":241,"partial":0,"skipped":842,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953f3faf69335e70a01d0e":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;a - iv, b - v, c - iii, d - ii, e - i\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Sphingomyelin (a - iv):\u0026lt;/strong\u0026gt; Sphingomyelin is a type of sphingolipid that contains a phosphocholine head group. It is a significant component of the plasma membrane, particularly in nerve cells.\u0026amp;nbsp;\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Archaeal membrane lipid (b - v):\u0026lt;/strong\u0026gt; Archaeal membrane lipids are unique due to their very long branched-chain fatty acids. These lipids help archaea thrive in extreme environments by providing stability to their membranes.\u0026amp;nbsp;\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Non-polar lipids (c - iii):\u0026lt;/strong\u0026gt; Non-polar lipids, such as triacylglycerols, are primarily used for energy storage. They consist of glycerol esterified with three fatty acids, making them hydrophobic.\u0026amp;nbsp;\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Plasmalogens (d - ii):\u0026lt;/strong\u0026gt; Plasmalogens are ether-linked lipids that often contain an alkene group. They play a role in protecting cells from oxidative stress.\u0026amp;nbsp;\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Cerebrosides (e - i):\u0026lt;/strong\u0026gt; Cerebrosides are glycosphingolipids that consist of a sugar molecule (e.g., galactose) linked to ceramide. They are found abundantly in the nerve tissue.\u0026amp;nbsp;\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;a - iv, b - v, c - iii, d - ii, e - i\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026amp;nbsp;है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;स्फिंगोमाइलिन (a - iv):\u0026lt;/strong\u0026gt; स्फिंगोमाइलिन एक प्रकार का स्फिंगोलिपिड है जिसमें एक फॉस्फोकोलाइन हेड ग्रुप होता है। यह प्लाज्मा झिल्ली का एक महत्वपूर्ण घटक है, खासकर तंत्रिका कोशिकाओं में।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;आर्कियल झिल्ली लिपिड (b - v):\u0026lt;/strong\u0026gt; आर्कियल झिल्ली लिपिड अपने बहुत लंबे शाखित-शृंखला वसीय अम्ल के कारण अद्वितीय हैं। ये लिपिड आर्किया को चरम वातावरण में पनपने में मदद करते हैं, उनकी झिल्लियों को स्थिरता प्रदान करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;अध्रुवीय लिपिड (c - iii):\u0026lt;/strong\u0026gt; अध्रुवीय लिपिड, जैसे कि ट्राइऐसिलग्लिसरॉल, मुख्य रूप से ऊर्जा भंडारण के लिए उपयोग किए जाते हैं। इनमें तीन वसीय अम्ल के साथ एस्टरीकृत ग्लिसरॉल होता है, जो उन्हें हाइड्रोफोबिक बनाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;प्लाज्मेलोजेन्स (d - ii):\u0026lt;/strong\u0026gt; प्लाज्मेलोजेन्स ईथर-लिंक्ड लिपिड हैं जिनमें अक्सर एक एल्केन समूह होता है। वे ऑक्सीडेटिव तनाव से कोशिकाओं की रक्षा करने में भूमिका निभाते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;सेरेब्रोसाइड्स (e - i):\u0026lt;/strong\u0026gt; सेरेब्रोसाइड्स ग्लाइकोस्फिंगोलिपिड हैं जिनमें सेरेमाइड से जुड़ा एक शर्करा अणु (जैसे, गैलेक्टोज) होता है। ये तंत्रिका ऊतक में प्रचुर मात्रा में पाए जाते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Cellular Organization"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4518aa958c4957eed4157","title":"Cellular Organization"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":25.771840542832905,"attempts":{"correct":278,"incorrect":208,"partial":0,"skipped":693,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953f5fcc49566a430da0e2":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;P binds and exposes multiple sites on D, generating a banding pattern of D.\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;DNase I is an enzyme that cleaves DNA nonspecifically. When a DNA-binding protein interacts with DNA, it can either protect certain regions of DNA from DNase I cleavage or alter the accessibility of DNA by exposing new sites for cleavage.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This assay is used to study the mode of DNA-protein interactions by analyzing changes in the DNA banding pattern when resolved on a sequencing-grade polyacrylamide gel.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;When DNA is incubated with a protein and then treated with DNase I, differences in cleavage patterns reveal important information about how the protein interacts with the DNA.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;P does not bind to D, thereby generating a banding pattern of D:\u0026lt;/strong\u0026gt; This option is incorrect because if P does not bind to D, the DNase I cleavage pattern would remain unchanged, showing a normal banding pattern of DNA (D). The experiment indicates that P interacts with DNA, making this interpretation invalid.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;P binds to D at a specific site, generating a banding pattern of D:\u0026lt;/strong\u0026gt; This option is incorrect because binding to a single specific site would protect that region from DNase I cleavage, resulting in a localized absence of bands. The observed banding pattern suggests that P exposes multiple sites on D, not just a single site.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;P binds and exposes multiple sites on D, generating a banding pattern of D:\u0026lt;/strong\u0026gt; This is the correct answer. The DNase I assay results indicate that P alters the structure of D in a way that exposes multiple cleavage sites. This behavior is common for proteins that cause conformational changes in DNA, such as bending or unwinding, thereby increasing DNase I access to previously inaccessible regions.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;P binds to only the 5\u0026amp;#39; and 3\u0026amp;#39; ends of D, generating a banding pattern of D:\u0026lt;/strong\u0026gt; This option is incorrect because binding exclusively to the ends of DNA would likely protect those regions from DNase I cleavage rather than exposing multiple sites across the DNA. The banding pattern observed suggests widespread cleavage, ruling out this explanation.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर है -\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;P बंधता है और D पर कई स्थानों को उजागर करता है, जिससे D का बैंडिंग पैटर्न उत्पन्न होता है।\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारण:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;DNase I एक एंजाइम है जो DNA को अनिर्दिष्ट रूप से काटता है। जब एक DNA-बंधन प्रोटीन DNA के साथ परस्पर क्रिया करता है, तो यह या तो DNA के कुछ क्षेत्रों को DNase I विदलन से बचा सकता है या DNA की पहुँच को बदलकर विदलन के लिए नए स्थलों को उजागर कर सकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इस परख का उपयोग DNA-प्रोटीन परस्पर क्रियाओं के तरीके का अध्ययन करने के लिए किया जाता है, जब एक अनुक्रमण-ग्रेड पॉलीएक्रिलामाइड जेल पर हल किया जाता है, तो DNA बैंडिंग पैटर्न में परिवर्तनों का विश्लेषण करके।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जब DNA को एक प्रोटीन के साथ इनक्यूबेट किया जाता है और फिर DNase I के साथ उपचारित किया जाता है, तो विदलन पैटर्न में अंतर प्रोटीन DNA के साथ कैसे परस्पर क्रिया करता है, इसके बारे में महत्वपूर्ण जानकारी प्रकट करता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;P, D से बंधता नहीं है, जिससे D का बैंडिंग पैटर्न उत्पन्न होता है:\u0026lt;/strong\u0026gt; यह विकल्प गलत है क्योंकि यदि P, D से बंधता नहीं है, तो DNase I विदलन पैटर्न अपरिवर्तित रहेगा, जो DNA (D) का एक सामान्य बैंडिंग पैटर्न दिखाता है। प्रयोग इंगित करता है कि P, DNA के साथ परस्पर क्रिया करता है, जिससे यह व्याख्या अमान्य हो जाती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;P, D के एक विशिष्ट स्थान पर बंधता है, जिससे D का बैंडिंग पैटर्न उत्पन्न होता है:\u0026lt;/strong\u0026gt; यह विकल्प गलत है क्योंकि एक ही विशिष्ट स्थान पर बंधन उस क्षेत्र को DNase I विदलन से बचाएगा, जिसके परिणामस्वरूप बैंड की एक स्थानीय अनुपस्थिति होगी। अवलोकित बैंडिंग पैटर्न बताता है कि P, D पर कई स्थानों को उजागर करता है, न कि केवल एक ही स्थान।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;P बंधता है और D पर कई स्थानों को उजागर करता है, जिससे D का बैंडिंग पैटर्न उत्पन्न होता है:\u0026lt;/strong\u0026gt; यह सही उत्तर है। DNase I परख परिणाम इंगित करते हैं कि P, D की संरचना को इस तरह से बदलता है कि कई विदलन स्थलों को उजागर करता है। यह व्यवहार उन प्रोटीनों के लिए सामान्य है जो DNA में संरचनात्मक परिवर्तन करते हैं, जैसे कि झुकना या खोलना, जिससे DNase I की पहले दुर्गम क्षेत्रों तक पहुँच बढ़ जाती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;P केवल D के 5\u0026amp;#39; और 3\u0026amp;#39; सिरों से बंधता है, जिससे D का बैंडिंग पैटर्न उत्पन्न होता है:\u0026lt;/strong\u0026gt; यह विकल्प गलत है क्योंकि DNA के सिरों से विशेष रूप से बंधन उन क्षेत्रों को DNase I विदलन से बचाएगा, बजाय DNA में कई स्थानों को उजागर करने के। देखा गया बैंडिंग पैटर्न व्यापक विभाजन का संकेत देता है, जिससे यह स्पष्टीकरण खारिज हो जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Methods in Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4566d978874fc5c7a0d11","title":"Methods in Biology"},"t":{"id":"63a45673d3b5fd9703bb8159","title":"Molecular Biology Techniques"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":15.703138252756533,"attempts":{"correct":126,"incorrect":116,"partial":0,"skipped":937,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953f81f922825acdf612c0":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A and C only\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Transgenic mice technologies are advanced genetic engineering methods that allow researchers to manipulate the genome of mice to study gene function, human diseases, and potential therapies.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;CRISPR/Cas9 is a revolutionary tool in genetic engineering that allows for precise editing of DNA. It can be employed for gene activation, knockouts, and multiplex targeting.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Conditional systems, like Cre-lox, enable specific and targeted gene editing, allowing for greater control in research studies.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement A:\u0026lt;/strong\u0026gt; Catalytically inactive Cas9 fused to a transcription activator can be used to activate specific gene expression.\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is correct. Catalytically inactive Cas9, known as dead Cas9 (dCas9), can be fused with transcriptional activators (e.g., VP64 or p300) to enhance the expression of specific genes without cutting the DNA.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This method is part of CRISPR activation (CRISPRa) technology, which is widely used to study gene function and regulatory networks.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement C:\u0026lt;/strong\u0026gt; Using CRISPR/Cas9, many genes can be targeted at once by expressing many guide RNAs in the same cell.\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is correct. CRISPR/Cas9 is highly versatile and can target multiple genes simultaneously by introducing several guide RNAs (gRNAs) into the same cell.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This is referred to as multiplex genome editing and is particularly useful for studying complex traits or pathways where multiple genes are involved.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Other Statements:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement B:\u0026lt;/strong\u0026gt; Using CRISPR/Cas9, a precise gene replacement in a target locus can be accomplished by non-homologous end joining repair.\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is incorrect. Non-homologous end joining (NHEJ) is an error-prone repair pathway that typically results in small insertions or deletions at the cut site. It does not lead to precise gene replacement.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Precise gene replacement requires homology-directed repair (HDR), which uses a homologous template to repair the break.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement D:\u0026lt;/strong\u0026gt; All chimeric mice derived by injecting engineered mouse embryonic stem cells into blastocysts will carry the transgene in the germ line.\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is incorrect. Not all chimeric mice will carry the transgene in the germ line. The germline transmission depends on whether the injected engineered embryonic stem cells contribute to the germline. Only some chimeras will pass the transgene to their offspring.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement E:\u0026lt;/strong\u0026gt; In the Cre-lox conditional system, the Cre recombinase is inserted into the gene to be knocked out.\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is incorrect. In the Cre-lox system, the Cre recombinase is not inserted into the target gene. Instead, loxP sites are inserted into the genome flanking the gene of interest. Cre recombinase recognizes these loxP sites and catalyzes site-specific recombination, leading to deletion, inversion, or translocation of the flanked gene.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;केवल A और C\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;पारजीनी चूहों की तकनीकें उन्नत आनुवंशिक इंजीनियरिंग विधियाँ हैं जो शोधकर्ताओं को जीन फ़ंक्शन, मानव रोगों और संभावित उपचारों का अध्ययन करने के लिए चूहों के जीनोम में परिवर्तन करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;CRISPR/Cas9 आनुवंशिक इंजीनियरिंग में एक क्रांतिकारी उपकरण है जो डीएनए के सटीक संपादन की अनुमति देता है। इसका उपयोग जीन सक्रियण, नॉकआउट और मल्टीप्लेक्स टारगेटिंग के लिए किया जा सकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;सशर्त प्रणालियाँ, जैसे Cre-lox, अनुसंधान अध्ययनों में अधिक नियंत्रण की अनुमति देते हुए, विशिष्ट और लक्षित जीन संपादन को सक्षम बनाती हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन A:\u0026lt;/strong\u0026gt; उत्प्रेरक रूप से निष्क्रिय Cas9 को एक ट्रांसक्रिप्शन एक्टिवेटर से जोड़ा जा सकता है जिसका उपयोग विशिष्ट जीन अभिव्यक्ति को सक्रिय करने के लिए किया जा सकता है।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह सही है। उत्प्रेरक रूप से निष्क्रिय Cas9, जिसे डेड Cas9 (dCas9) के रूप में जाना जाता है, को ट्रांसक्रिप्शनल एक्टिवेटर (जैसे, VP64 या p300) के साथ जोड़ा जा सकता है ताकि डीएनए को काटे बिना विशिष्ट जीन की अभिव्यक्ति को बढ़ाया जा सके।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह विधि CRISPR सक्रियण (CRISPRa) तकनीक का हिस्सा है, जिसका व्यापक रूप से जीन फ़ंक्शन और नियामक नेटवर्क का अध्ययन करने के लिए उपयोग किया जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन C:\u0026lt;/strong\u0026gt; CRISPR/Cas9 का उपयोग करके, एक ही कोशिका में कई गाइड आरएनए व्यक्त करके एक साथ कई जीनों को लक्षित किया जा सकता है।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह सही है। CRISPR/Cas9 अत्यधिक बहुमुखी है और एक ही कोशिका में कई गाइड आरएनए (gRNAs) को पेश करके एक साथ कई जीनों को लक्षित कर सकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इसे मल्टीप्लेक्स जीनोम संपादन के रूप में जाना जाता है और यह जटिल लक्षणों या मार्गों का अध्ययन करने के लिए विशेष रूप से उपयोगी है जिसमें कई जीन शामिल हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;अन्य कथन:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन B:\u0026lt;/strong\u0026gt; CRISPR/Cas9 का उपयोग करके, एक लक्ष्य लोकास में एक सटीक जीन प्रतिस्थापन को नॉन-होमोलॉगस एंड जॉइनिंग रिपेयर द्वारा पूरा किया जा सकता है।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह गलत है। नॉन-होमोलॉगस एंड जॉइनिंग (NHEJ) एक त्रुटि-प्रवण मरम्मत पथ है जो आमतौर पर कट साइट पर छोटे सम्मिलन या विलोपन में परिणाम देता है। यह सटीक जीन प्रतिस्थापन की ओर नहीं ले जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;सटीक जीन प्रतिस्थापन के लिए होमोलॉजी-निर्देशित मरम्मत (HDR) की आवश्यकता होती है, जो ब्रेक की मरम्मत के लिए एक समरूप टेम्पलेट का उपयोग करती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन D:\u0026lt;/strong\u0026gt; ब्लास्टोसिस्ट में इंजीनियर किए गए माउस भ्रूणीय स्टेम कोशिकाओं को इंजेक्ट करके प्राप्त सभी काइमेरिक चूहों में जर्म लाइन में ट्रांसजीन होगा।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह गलत है। सभी काइमेरिक चूहों में जर्म लाइन में ट्रांसजीन नहीं होगा। जर्मलाइन ट्रांसमिशन इस बात पर निर्भर करता है कि इंजेक्ट की गई इंजीनियर की गई भ्रूणीय स्टेम कोशिकाएँ जर्मलाइन में योगदान करती हैं या नहीं। केवल कुछ काइमेरा अपने वंश को ट्रांसजीन पास करेंगे।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन E:\u0026lt;/strong\u0026gt; Cre-lox सशर्त प्रणाली में, Cre रिकॉम्बिनेज को नॉक आउट किए जाने वाले जीन में डाला जाता है।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह गलत है। Cre-lox सिस्टम में, Cre रिकॉम्बिनेज को लक्ष्य जीन में नहीं डाला जाता है। इसके बजाय, loxP साइट्स को रुचि के जीन को फ़्लैंक करते हुए जीनोम में डाला जाता है। Cre रिकॉम्बिनेज इन loxP साइट्स को पहचानता है और साइट-विशिष्ट पुनर्संयोजन को उत्प्रेरित करता है, जिससे फ़्लैंक किए गए जीन का विलोपन, उलटना या स्थानांतरण होता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Applied Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a455cbce3d67ae7cc72e05","title":"Applied Biology"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":12.870229007633586,"attempts":{"correct":88,"incorrect":174,"partial":0,"skipped":917,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953fa2fc94ccd72abfc4a0":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A: DNA Helicase; B: DNA Gyrase; C: DNA Primase; D: DNA pol III; E: DNA pol I; F: DNA Ligase\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The replication fork is the Y-shaped region where the parental DNA strands are unwound to allow replication of the DNA. Several key proteins are involved in this process, each performing a specific role.\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;DNA Helicase (A):\u0026lt;/strong\u0026gt; This enzyme unwinds the DNA double helix at the replication fork by breaking the hydrogen bonds between complementary base pairs, creating two single strands of DNA.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;DNA Gyrase (B):\u0026lt;/strong\u0026gt; A type of topoisomerase that relieves the supercoiling tension created ahead of the replication fork as the DNA unwinds. It prevents tangling and ensures smooth progression of the replication fork.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;DNA Primase (C):\u0026lt;/strong\u0026gt; This enzyme synthesizes a short RNA primer complementary to the DNA template. The primer serves as the starting point for DNA synthesis by DNA polymerase.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;DNA Polymerase III (D):\u0026lt;/strong\u0026gt; The primary enzyme responsible for synthesizing new DNA strands by adding nucleotides to the RNA primer in the 5\u0026amp;rsquo; to 3\u0026amp;rsquo; direction. It is highly processive and ensures rapid replication of the leading and lagging strands.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;DNA Polymerase I (E):\u0026lt;/strong\u0026gt; This enzyme removes RNA primers and replaces them with DNA nucleotides. It has both 5\u0026amp;#39; to 3\u0026amp;#39; polymerase activity and 5\u0026amp;#39; to 3\u0026amp;#39; exonuclease activity.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;DNA Ligase (F):\u0026lt;/strong\u0026gt; This enzyme joins the Okazaki fragments on the lagging strand by forming phosphodiester bonds between adjacent DNA fragments, creating a continuous strand of DNA.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage68ab20aeff8685b67bccfc04.png\u0026quot; style=\u0026quot;height: 187px; width: 450px;\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;em\u0026gt;Fig: Schematic representation of the replication fork\u0026amp;nbsp;\u0026lt;/em\u0026gt;\u0026lt;em\u0026gt;(\u0026lt;a href=\u0026quot;https://blog.naver.com/ht_wang/222012237100\u0026quot;\u0026gt;Source\u0026lt;/a\u0026gt;)\u0026lt;/em\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर है-\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A: DNA हेलीकेज़; B: DNA गाइरेज़; C: DNA प्राइमेज़; D: DNA pol III; E: DNA pol I; F: DNA लाइगेज\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;प्रतिकृति द्विशाख\u0026amp;nbsp;Y-आकार का क्षेत्र है जहाँ पैतृक DNA रज्जुक को DNA की प्रतिकृति में सहायता करने के लिए खोला जाता है। इस प्रक्रिया में कई प्रमुख प्रोटीन शामिल हैं, प्रत्येक एक विशिष्ट भूमिका निभाता है।\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;DNA हेलीकेज़ (A):\u0026lt;/strong\u0026gt; यह एंजाइम प्रतिकृति द्विशाख पर DNA द्वी कुंडली को खोलता है, पूरक क्षार युग्मों के बीच हाइड्रोजन बंधों को तोड़कर, DNA के दो एकल रज्जुक बनाता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;DNA गाइरेज़ (B):\u0026lt;/strong\u0026gt; टोपोइसोमेरेज़ का एक प्रकार जो प्रतिकृति द्विशाख के आगे बनाए गए सुपरकोइलिंग तनाव को दूर करता है क्योंकि DNA खुलता है। यह उलझाव को रोकता है और प्रतिकृति द्विशाख की सुचारू प्रगति सुनिश्चित करता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;DNA प्राइमेज़ (C):\u0026lt;/strong\u0026gt; यह एंजाइम DNA टेम्पलेट के पूरक एक छोटा RNA उपक्रामक संश्लेषित करता है। उपक्रामक DNA पोलीमरेज़ द्वारा DNA संश्लेषण के प्रारंभिक बिंदु के रूप में कार्य करता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;DNA पोलीमरेज़ III (D):\u0026lt;/strong\u0026gt; RNA उपक्रामक में न्यूक्लियोटाइड्स को 5\u0026amp;rsquo; से 3\u0026amp;rsquo; दिशा में जोड़कर नए DNA रज्जुक\u0026amp;nbsp;को संश्लेषित करने के लिए उत्तरदायी प्राथमिक एंजाइम। यह अत्यधिक प्रक्रियात्मक है और अग्रग\u0026amp;nbsp;और पश्चगामी\u0026amp;nbsp;रज्जुक की तेजी से प्रतिकृति सुनिश्चित करता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;DNA पोलीमरेज़ I (E):\u0026lt;/strong\u0026gt; यह एंजाइम RNA उपक्रामक को हटाता है और उन्हें DNA न्यूक्लियोटाइड्स से बदल देता है। इसमें 5\u0026amp;#39; से 3\u0026amp;#39; पोलीमरेज़ गतिविधि और 5\u0026amp;#39; से 3\u0026amp;#39; एक्सोन्यूक्लिऐज़ गतिविधि दोनों होती हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;DNA लाइगेज (F):\u0026lt;/strong\u0026gt; यह एंजाइम पश्चगामी\u0026amp;nbsp;रज्जुक पर ओकाज़ाकी खंडों को आसन्न DNA खंडों के बीच फॉस्फोडाइस्टर बंध बनाकर जोड़ता है, जिससे DNA का एक निरंतर रज्जुक बनता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage68ab20aeff8685b67bccfc04.png\u0026quot; style=\u0026quot;height: 187px; width: 450px;\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;em\u0026gt;चित्र: प्रतिकृति द्विशाख का योजनाबद्ध निरूपण \u0026lt;/em\u0026gt;\u0026lt;em\u0026gt;(\u0026lt;a href=\u0026quot;https://blog.naver.com/ht_wang/222012237100\u0026quot;\u0026gt;स्रोत\u0026lt;/a\u0026gt;)\u0026lt;/em\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Fundamental Processes"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a451aec9ba648bc86fbf43","title":"Fundamental Processes"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":30.826972010178086,"attempts":{"correct":248,"incorrect":284,"partial":0,"skipped":647,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953fce8aebc97d87cfec63":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Panel II is an example of a dominant DNA marker.\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;DNA markers are specific sequences of DNA used to identify individuals or species and to study genetic variation.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Dominant DNA markers are markers where the presence of one allele masks the effect of another allele in the heterozygous condition. This means that the dominant allele is observed in the phenotype or result, even when the recessive allele is present.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;PCR (Polymerase Chain Reaction)-based DNA markers are designed using specific primers that amplify unique regions of DNA in the genome, allowing for the identification of genetic differences between individuals.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In this case, primers X, Y, and Z are used to amplify specific regions of the wild-type (R) and mutant (r) alleles to study inheritance patterns in F2 progeny.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Panel II is an example of a dominant DNA marker:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;In Panel II, DNA bands are observed in all lanes except lane 1, representing the absence of amplification for a specific genotype.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;For dominant DNA markers, the presence of a single dominant allele (e.g., R) will lead to the amplification of the DNA fragment, whereas the recessive homozygous (rr) genotype may not show amplification depending on the primer design.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Therefore, Panel II represents a dominant marker, as the dominant allele leads to amplification, masking the contribution of the recessive allele in heterozygotes.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Other Options:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Panel III represents the pattern when primers Y and Z are used for amplification:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is incorrect because the pattern shown in Panel III may not necessarily correspond to primers Y and Z.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The pattern in Panel III represents co-dominant markers, where both wild-type and mutant alleles are distinguishable by different fragment sizes.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Primers Y and Z may amplify a region that produces a pattern different from what is shown in Panel III.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;The F2 progeny as represented in Panel II, will have 50% of the progeny showing no amplified fragment (lane 1):\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is incorrect because the F2 progeny follows Mendelian inheritance ratios. In the F2 generation of a monohybrid cross (e.g., RR \u0026amp;times; rr \u0026amp;rarr; F1 \u0026amp;rarr; selfed), the expected genotype ratio is 1:2:1 (RR:Rr:rr).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This means only 25% of the progeny (rr) will show no amplified fragment if the primers are designed to amplify only the dominant allele.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;A rare recombination event between the regions represented by primers X and Y will lead to changes in the amplification patterns observed in Panels II and III:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is incorrect because recombination events are rare and typically do not affect the standard amplification patterns unless the primers are located in regions prone to recombination.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The amplification patterns shown in Panels II and III are based on standard Mendelian inheritance, and recombination is not a consideration here.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर है-\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;पैनल II एक प्रभावी DNA चिन्हक का उदाहरण है।\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;DNA चिन्हक DNA के विशिष्ट अनुक्रम होते हैं जिनका उपयोग व्यक्तियों या प्रजातियों की पहचान करने और आनुवंशिक विविधता का अध्ययन करने के लिए किया जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;प्रभावी DNA चिन्हक वे चिन्हक होते हैं जहाँ विषमयुग्मी अवस्था में एक एलील की उपस्थिति दूसरे एलील के प्रभाव को छिपा देती है। इसका अर्थ है कि प्रभावी एलील, फेनोटाइप या परिणाम में तब भी देखा जाता है, जब अप्रभावी एलील मौजूद हो।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;PCR (पोलीमरेज़ चेन रिएक्शन) आधारित DNA चिन्हक विशिष्ट उपक्रामकों का उपयोग करके डिज़ाइन किए गए हैं जो जीनोम में DNA के विशिष्ट क्षेत्रों को बढ़ाते हैं, जिससे व्यक्तियों के बीच आनुवंशिक अंतर की पहचान संभव हो जाती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इस मामले में, उपक्रामक्स X, Y, और Z का उपयोग F2 संतानों में वंशागति पैटर्न का अध्ययन करने के लिए वाइल्ड-टाइप (R) और म्यूटेंट (r) एलील्स के विशिष्ट क्षेत्रों को बढ़ाने के लिए किया जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;स्पष्टीकरण:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;पैनल II एक प्रभावी DNA चिन्हक का उदाहरण है:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;पैनल II में, लेन 1 को छोड़कर सभी लेन में DNA बैंड देखे गए हैं, जो एक विशिष्ट जीनोटाइप के लिए प्रवर्धन की अनुपस्थिति को दर्शाते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;प्रभावी DNA चिन्हकों के लिए, एकल प्रभावी एलील (जैसे, R) की उपस्थिति DNA खंड के प्रवर्धन को जन्म देगी, जबकि अप्रभावी समयुग्मजी (rr) जीनोटाइप उपक्रामक डिजाइन के आधार पर प्रवर्धन नहीं दिखा सकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इसलिए, पैनल II एक प्रभावी चिन्हक का प्रतिनिधित्व करता है, क्योंकि प्रभावी एलील प्रवर्धन की ओर ले जाता है, जो विषमयुग्मजी में अप्रभावी एलील के योगदान को छुपाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;पैनल III उस पैटर्न को दर्शाता है जब उपक्रामक Y और Z का उपयोग प्रवर्धन के लिए किया जाता है:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह गलत है क्योंकि पैनल III में दिखाया गया पैटर्न आवश्यक रूप से उपक्रामक Y और Z के अनुरूप नहीं हो सकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;पैनल III में पैटर्न सह-प्रभावी चिन्हकों का प्रतिनिधित्व करता है, जहां जंगली-प्रकार और उत्परिवर्ती एलील दोनों अलग-अलग खंड आकारों द्वारा पहचाने जा सकते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;उपक्रामक Y और Z उस क्षेत्र को बढ़ा सकते हैं जो पैनल III में दिखाए गए पैटर्न से भिन्न पैटर्न उत्पन्न करता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;पैनल II में दर्शाए गए F2 संतति में 50% संतति में कोई प्रवर्धित खंड नहीं दिखेगा (लेन 1):\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह गलत है क्योंकि F2 संतति मेंडेलियन वंशानुक्रम अनुपात का पालन करती है। एक मोनोहाइब्रिड क्रॉस (जैसे, RR \u0026amp;times; rr \u0026amp;rarr; F1 \u0026amp;rarr; स्वपोषित) की F2 पीढ़ी में, अपेक्षित जीनोटाइप अनुपात 1:2:1 (RR:Rr:rr) होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इसका अर्थ यह है कि यदि उपक्रामकों को केवल प्रभावी एलील को बढ़ाने के लिए डिज़ाइन किया गया है, तो केवल 25% संतति (rr) में कोई प्रवर्धित खंड नहीं दिखेगा।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;उपक्रामक्स X और Y द्वारा दर्शाए गए क्षेत्रों के बीच एक दुर्लभ पुनर्संयोजन घटना पैनल II और III में देखे गए प्रवर्धन पैटर्न में परिवर्तन लाएगी:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह गलत है, क्योंकि पुनर्संयोजन की घटनाएं दुर्लभ होती हैं और आमतौर पर मानक प्रवर्धन पैटर्न को प्रभावित नहीं करती हैं, जब तक कि उपक्रामक पुनर्संयोजन के लिए प्रवण क्षेत्रों में स्थित न हों।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;पैनल II और III में दर्शाए गए प्रवर्धन पैटर्न मानक मेंडेलियन वंशानुक्रम पर आधारित हैं, तथा पुनर्संयोजन पर यहां विचार नहीं किया गया है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Methods in Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4566d978874fc5c7a0d11","title":"Methods in Biology"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":12.259541984732824,"attempts":{"correct":47,"incorrect":173,"partial":0,"skipped":959,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68953ffcf922825acdf614a3":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;Option 2\u0026lt;/strong\u0026gt;.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;b\u0026gt;\u0026lt;u\u0026gt;Explanation:\u0026lt;/u\u0026gt;\u0026lt;/b\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;A Northern blot is a technique used to study gene expression by detecting specific RNA molecules within a sample.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;It involves the separation of RNA by gel electrophoresis, transfer to a membrane, and hybridization with labeled probes that are complementary to the RNA of interest.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Probes can reveal the presence, size, and abundance of transcripts, helping to understand transcriptional organization, splicing patterns, and gene order within a locus.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Option 2\u0026lt;/strong\u0026gt; correctly represents the order of genes encoded in the genetic locus based on the Northern blot profile and the given information.\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The Northern blot shows that probes hybridize to specific transcripts derived from the locus. This indicates the sequence and splicing patterns of the transcripts.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Probes 1 and 2 detect strong bands in the long transcript - near 5\u0026amp;#39; end.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Probes 4 and 5 detect bands in all sizes -\u0026amp;gt; near 3\u0026amp;#39; end.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Probe 3 detects intermediate intensity -\u0026amp;gt; in the middle region.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Both full-length (~1050 bp) and shorter transcripts (~600 bp) are seen which suggests two TSS (transcription start sites).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;For TSS2, the intron is retained as per the question.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Comparing diagrams:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;TSS1\u0026amp;nbsp;\u0026amp;rarr;\u0026amp;nbsp;5\u0026amp;#39; region with probes 1 \u0026amp;amp; 2 \u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;rarr;\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026amp;nbsp;intron \u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;rarr;\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt;3\u0026amp;#39; end with\u0026lt;br /\u0026gt;\n\t\tprobes 4 \u0026amp;amp; 5.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;TSS2 starts within an intron, producing a shorter transcript but retains intron.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;विकल्प 2\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;b\u0026gt;\u0026lt;u\u0026gt;व्याख्या:\u0026lt;/u\u0026gt;\u0026lt;/b\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;एक नॉर्दर्न ब्लॉट एक तकनीक है जिसका उपयोग एक नमूने के भीतर विशिष्ट RNA अणुओं का पता लगाकर जीन अभिव्यक्ति का अध्ययन करने के लिए किया जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इसमें जेल इलेक्ट्रोफोरेसिस द्वारा RNA का पृथक्करण, झिल्ली में स्थानांतरण और लेबल किए गए जांच के साथ संकरण शामिल है जो रुचि के RNA के पूरक हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जांच अनुलेखों की उपस्थिति, आकार और प्रचुरता को प्रकट कर सकते हैं, जिससे लोकस के भीतर अनुलेखन संगठन, स्प्लिसिंग पैटर्न और जीन क्रम को समझने में मदद मिलती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;विकल्प 2\u0026lt;/strong\u0026gt; उत्तरी ब्लॉट प्रोफाइल और दी गई जानकारी के आधार पर आनुवंशिक लोकस में एन्कोड किए गए जीन के क्रम को सही ढंग से दर्शाता है।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;उत्तरी ब्लॉट दिखाता है कि जांच लोकस से प्राप्त विशिष्ट अनुलेखों के साथ संकरण करती हैं। यह अनुलेखों के क्रम और स्प्लिसिंग पैटर्न को इंगित करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जांच 1 और 2 लंबे अनुलेख में मजबूत बैंड का पता लगाती हैं - लगभग 5\u0026amp;#39; सिरे पर।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जांच 4 और 5 सभी आकारों में बैंड का पता लगाती हैं -\u0026amp;gt; लगभग 3\u0026amp;#39; सिरे पर।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जांच 3 मध्यवर्ती तीव्रता का पता लगाती है -\u0026amp;gt; मध्य क्षेत्र में।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;पूर्ण लंबाई (~1050 bp) और छोटे अनुलेख (~600 bp) दोनों देखे जाते हैं जो दो TSS (ट्रांसक्रिप्शन स्टार्ट साइट्स) का सुझाव देते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;TSS2 के लिए, प्रश्न के अनुसार इंट्रॉन को बरकरार रखा गया है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;आरेखों की तुलना करना:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;TSS1 \u0026amp;rarr; 5\u0026amp;#39; क्षेत्र जांच 1 और 2 के साथ \u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;rarr;\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt; \u0026lt;/span\u0026gt; इंट्रॉन \u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;rarr;\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt; \u0026lt;/span\u0026gt; 3\u0026amp;#39; अंत जांच 4 और 5 के साथ।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;TSS2 एक इंट्रॉन के भीतर शुरू होता है, एक छोटा अनुलेख उत्पन्न करता है लेकिन इंट्रॉन को बरकरार रखता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Methods in Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4566d978874fc5c7a0d11","title":"Methods in Biology"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":8.680237489397793,"attempts":{"correct":43,"incorrect":141,"partial":0,"skipped":995,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895400fef177aa03fbb0a36":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;98.83 \u0026amp;micro;A\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;A glucose biosensor typically operates based on enzymatic reactions, where the current response (I) is proportional to the rate of reaction.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The equation used to calculate the current response is derived from Michaelis-Menten kinetics:\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(I = \\frac{I_{\\text{max}} \\times [S]}{K_m + [S]} \\)\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;br /\u0026gt;\nWhere:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;I = Current response\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;I\u0026lt;sub\u0026gt;max\u0026lt;/sub\u0026gt; = Maximum current response (given as 250 \u0026amp;micro;A)\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;[S] = Substrate concentration (glucose concentration, given as 3.4 mM)\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;K\u0026lt;sub\u0026gt;m\u0026lt;/sub\u0026gt; = Michaelis constant (given as 5.2 mM)\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The formula calculates the biosensor\u0026amp;#39;s response based on how the substrate concentration relates to the enzyme\u0026amp;#39;s affinity for the substrate.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;Using the formula:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;I = (250 \u0026amp;times; 3.4) / (5.2 + 3.4)\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;I = (850) / (8.6)\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;I = 98.83 \u0026amp;micro;A\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;Therefore, the current response of the biosensor is \u0026lt;strong\u0026gt;98.83 \u0026amp;micro;A\u0026lt;/strong\u0026gt;.\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;98.83 \u0026amp;micro;A\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;ग्लूकोज बायोसेंसर आमतौर पर एंजाइमेटिक प्रतिक्रियाओं के आधार पर संचालित होता है, जहां वर्तमान प्रतिक्रिया (I) प्रतिक्रिया की दर के समानुपाती होती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;धारा प्रतिक्रिया की गणना करने के लिए उपयोग किया जाने वाला समीकरण माइकलिस-मेंटेन काइनेटिक्स से प्राप्त होता है:\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span class=\u0026quot;math-tex\u0026quot;\u0026gt;\\(I = \\frac{I_{\\text{max}} \\times [S]}{K_m + [S]} \\)\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;br /\u0026gt;\nजहाँ:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;I = धारा प्रतिक्रिया\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;I\u0026lt;sub\u0026gt;max\u0026lt;/sub\u0026gt; = अधिकतम धारा प्रतिक्रिया (250 \u0026amp;micro;A दिया गया है)\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;[S] = क्रियाधार सांद्रता (ग्लूकोज़ सांद्रता, 3.4 mM दिया गया है)\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;K\u0026lt;sub\u0026gt;m\u0026lt;/sub\u0026gt; = माइकलिस स्थिरांक (5.2 mM दिया गया है)\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;सूत्र यह गणना करता है कि क्रियाधार सांद्रता क्रियाधार के लिए एंजाइम की \u0026lt;span style=\u0026quot;display: none;\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt;आत्मीयता \u0026lt;span style=\u0026quot;display: none;\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt;से कैसे संबंधित है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;सूत्र का उपयोग करते हुए:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;I = (250 x 3.4) / (5.2 + 3.4)\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;I = (850) / (8.6)\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;I = 98.83 \u0026amp;micro;A\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;इसलिए, बायोसेंसर की धारा प्रतिक्रिया \u0026lt;strong\u0026gt;98.83 \u0026amp;micro;A\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Applied Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a455cbce3d67ae7cc72e05","title":"Applied Biology"},"t":{"id":"63a456647bcd5bdb5cf4d662","title":"Biosensors"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":9.913486005089068,"attempts":{"correct":62,"incorrect":163,"partial":0,"skipped":954,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689540397ac09e469dee981b":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;B, D, and E\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Body temperature regulation in humans is controlled by physiological processes such as sweating, blood vessel dilation, and metabolic changes. These mechanisms are influenced by environmental conditions, acclimatization, and the body\u0026amp;#39;s internal set points.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The hypothalamus acts as the body\u0026amp;#39;s thermostat, regulating heat production and heat loss to maintain a stable internal temperature.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Acclimatization refers to the body\u0026amp;#39;s ability to adapt to prolonged exposure to extreme temperatures, either hot or cold.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement B: Acclimatization to cold activates the uncoupling protein (UCP) in mitochondria.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is correct. UCPs (uncoupling proteins) are activated in response to cold exposure, especially in brown adipose tissue. These proteins uncouple oxidative phosphorylation, leading to the generation of heat instead of ATP. This mechanism helps maintain body temperature in cold environments.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement D: Sodium ion concentration in sweat decreases upon acclimatization to heat.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is correct. When humans acclimatize to heat, sweat becomes more dilute, conserving essential electrolytes like sodium. This adaptation helps prevent excessive loss of sodium ions during prolonged sweating in hot conditions.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement E: When the body temperature becomes high, the skin blood vessels undergo vasodilation.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is correct. Vasodilation occurs as a physiological response to high body temperature. It increases blood flow to the skin, facilitating heat dissipation through radiation and convection, effectively cooling the body.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Other Statements\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement A: As the skin temperature falls, the hypothalamic set point for sweating decreases.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is incorrect. The hypothalamic set point for sweating does not decrease with falling skin temperature. Sweating is primarily driven by the need to cool the body when internal temperature rises, rather than directly influenced by skin temperature.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement C: Acclimatization to heat decreases aldosterone secretion.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is incorrect. Acclimatization to heat typically increases aldosterone secretion, which helps retain sodium ions in the kidneys and reduce sodium loss in sweat, aiding in electrolyte balance during prolonged heat exposure.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;B, D, और E\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;मानवों में शरीर के तापमान का नियमन शारीरिक प्रक्रियाओं जैसे स्वेद, रक्त वाहिकाओं का फैलाव और चयापचय परिवर्तनों द्वारा नियंत्रित होता है। ये तंत्र पर्यावरणीय परिस्थितियों, अनुकूलन और शरीर के आंतरिक सेट पॉइंट्स से प्रभावित होते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;हाइपोथैलेमस शरीर के थर्मोस्टेट के रूप में कार्य करता है, जो स्थिर आंतरिक तापमान बनाए रखने के लिए ऊष्मा उत्पादन और ऊष्मा\u0026amp;nbsp;हानि को नियंत्रित करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;अनुकूलन शरीर की चरम तापमान, चाहे गर्म या ठंडा, के लंबे समय तक संपर्क में अनुकूलित करने की क्षमता को संदर्भित करता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन B: ठंड के अनुकूलन से माइटोकॉन्ड्रिया में अनकप्लिंग प्रोटीन (UCP) सक्रिय होता है।\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन सही है। UCP (अनकप्लिंग प्रोटीन) ठंड के संपर्क में आने पर सक्रिय होते हैं, खासकर भूरे एडिपोज ऊतक में। ये प्रोटीन ऑक्सीडेटिव फॉस्फोराइलेशन को अनकपल करते हैं, जिससे ATP के बजाय ऊष्मा उत्पन्न होती है। यह तंत्र ठंडे वातावरण में शरीर के तापमान को बनाए रखने में मदद करता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन D: ऊष्मा के अनुकूलन पर स्वेद में सोडियम आयन की सांद्रता कम हो जाती है।\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन सही है। जब मानव ऊष्मा\u0026amp;nbsp;के अनुकूल होते हैं, तो स्वेद अधिक पतला हो जाता है, जिससे सोडियम जैसे आवश्यक इलेक्ट्रोलाइट्स का संरक्षण होता है। यह अनुकूलन गर्म परिस्थितियों में लंबे समय तक स्वेद आने के दौरान सोडियम आयनों के अत्यधिक नुकसान को रोकने में मदद करता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन E: जब शरीर का तापमान अधिक हो जाता है, तो त्वचा की रक्त वाहिकाएँ वाहिकाविस्फार से गुजरती हैं।\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन सही है। उच्च शरीर के तापमान के लिए शारीरिक प्रतिक्रिया के रूप में वाहिकाविस्फार होता है। यह त्वचा में रक्त प्रवाह को बढ़ाता है, विकिरण और संवहन के माध्यम से ऊष्मा\u0026amp;nbsp;के अपव्यय की सुविधा प्रदान करता है, जिससे शरीर को प्रभावी ढंग से ठंडा किया जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य कथन\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन A: जैसे ही त्वचा का तापमान गिरता है, स्वेद के लिए हाइपोथैलेमिक सेट पॉइंट कम हो जाता है।\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन गलत है। स्वेद के लिए हाइपोथैलेमिक सेट पॉइंट त्वचा के तापमान में गिरावट के साथ कम नहीं होता है। स्वेद मुख्य रूप से शरीर को ठंडा करने की आवश्यकता से प्रेरित होता है जब आंतरिक तापमान बढ़ता है, न कि सीधे त्वचा के तापमान से प्रभावित होता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन C: ऊष्मा के अनुकूलन से एल्डोस्टेरोन स्राव कम हो जाता है।\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन गलत है। ऊष्मा के अनुकूलन से आमतौर पर एल्डोस्टेरोन स्राव बढ़ जाता है, जो गुर्दे में सोडियम आयनों को बनाए रखने और स्वेद में सोडियम के नुकसान को कम करने में मदद करता है, लंबे समय तक ऊष्मा के संपर्क में आने के दौरान इलेक्ट्रोलाइट संतुलन में सहायता करता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["System Physiology Animal"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a452e28f21ac91a2eba7a5","title":"System Physiology Animal"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":19.44105173876166,"attempts":{"correct":93,"incorrect":187,"partial":0,"skipped":899,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689540724bf9040e58efa5a0":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A, B, and C\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The study investigates the unwinding capability of translation regulator \u0026amp;#39;X\u0026amp;#39; on RNA substrates under specific conditions and how factors such as ATP and eIF4G influence its activity.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;RNA unwinding is critical for various cellular processes, including translation regulation. Translation regulators often require energy (like ATP) and other cofactors (e.g., eIF4G) to enhance their activity.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Polyacrylamide gel electrophoresis (PAGE) and autoradiography help visualize RNA species, providing insights into the unwinding activity of \u0026amp;#39;X\u0026amp;#39; under different experimental setups.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement A:\u0026lt;/strong\u0026gt; \u0026amp;quot;X unwinds substrates with a 5\u0026amp;#39; overhang.\u0026amp;quot;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;The gel patterns indicate that RNA substrates with a 5\u0026amp;#39; overhang were effectively unwound by \u0026amp;#39;X\u0026amp;#39;, as evidenced by the separation of individual RNA strands visible on the gel.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;This observation supports that \u0026amp;#39;X\u0026amp;#39; has specificity for substrates with a 5\u0026amp;#39; overhang, making this statement correct.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Many translation regulators (e.g., DEAD-box helicases) preferentially unwind substrates with a 5\u0026amp;#39; overhang.\u0026amp;nbsp;\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement B:\u0026lt;/strong\u0026gt; \u0026amp;quot;Substrates which can be unwound by \u0026amp;#39;X\u0026amp;#39; need ATP for efficient RNA unwinding.\u0026amp;quot;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;The gel results show that unwinding activity of \u0026amp;#39;X\u0026amp;#39; was significantly enhanced in the presence of ATP. Without ATP, the unwinding was either absent or inefficient.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;This confirms that ATP is essential for efficient RNA unwinding by \u0026amp;#39;X\u0026amp;#39;, making this statement correct.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement C:\u0026lt;/strong\u0026gt; \u0026amp;quot;X unwinding activity is enhanced by the presence of eIF4G.\u0026amp;quot;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;The gel patterns reveal an increase in RNA unwinding activity when eIF4G is present in the reaction mix. eIF4G likely acts as a cofactor that aids \u0026amp;#39;X\u0026amp;#39; in its function.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;This enhancement of unwinding activity by eIF4G validates this statement as correct.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;Thus, all the three statements are correct\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A, B और C\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह अध्ययन विशिष्ट परिस्थितियों में RNA क्रियाधार पर स्थानांतरण नियामक \u0026amp;#39;X\u0026amp;#39; की अनवाइंडिंग क्षमता और ATP और eIF4G जैसे कारक इसकी गतिविधि को कैसे प्रभावित करते हैं, इसकी जांच करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;RNA अनवाइंडिंग विभिन्न कोशिकीय प्रक्रियाओं, जिसमें स्थानांतरण नियमन भी शामिल है, के लिए महत्वपूर्ण है। स्थानांतरण नियामक अक्सर अपनी गतिविधि को बढ़ाने के लिए ऊर्जा (जैसे ATP) और अन्य सह-कारकों (जैसे, eIF4G) की आवश्यकता होती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;पॉलीएक्रिलामाइड जेल इलेक्ट्रोफोरेसिस (PAGE) और ऑटोरेडियोग्राफी विभिन्न प्रयोगात्मक सेटअप के तहत \u0026amp;#39;X\u0026amp;#39; की अनवाइंडिंग गतिविधि में अंतर्दृष्टि प्रदान करते हुए, RNA स्पीशीज को देखने में मदद करते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन A:\u0026lt;/strong\u0026gt; \u0026amp;quot;X 5\u0026amp;#39; ओवरहैंग वाले क्रियाधार को खोलता है।\u0026amp;quot;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;जेल पैटर्न इंगित करते हैं कि 5\u0026amp;#39; ओवरहैंग वाले RNA क्रियाधार को \u0026amp;#39;X\u0026amp;#39; द्वारा प्रभावी ढंग से खोला गया था, जैसा कि जेल पर दिखाई देने वाले अलग-अलग RNA रज्जुक के पृथक्करण से स्पष्ट है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह अवलोकन इस बात का समर्थन करता है कि \u0026amp;#39;X\u0026amp;#39; में 5\u0026amp;#39; ओवरहैंग वाले क्रियाधार के लिए विशिष्टता है, जिससे यह कथन सही हो जाता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;कई स्थानांतरण नियामक (जैसे, DEAD-box हेलीकेज़) अधिमानतः 5\u0026amp;#39; ओवरहैंग वाले क्रियाधार को खोलते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन B:\u0026lt;/strong\u0026gt; \u0026amp;quot;वे क्रियाधार जिन्हें \u0026amp;#39;X\u0026amp;#39; द्वारा खोला जा सकता है, उन्हें कुशल RNA अनवाइंडिंग के लिए ATP की आवश्यकता होती है।\u0026amp;quot;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;जेल के परिणाम दर्शाते हैं कि ATP की उपस्थिति में \u0026amp;#39;X\u0026amp;#39; की अनवाइंडिंग गतिविधि में काफी वृद्धि हुई थी। ATP के बिना, अनवाइंडिंग या तो अनुपस्थित थी या अकुशल थी।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह पुष्टि करता है कि \u0026amp;#39;X\u0026amp;#39; द्वारा कुशल RNA अनवाइंडिंग के लिए ATP आवश्यक है, जिससे यह कथन सही हो जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन C:\u0026lt;/strong\u0026gt; \u0026amp;quot;eIF4G की उपस्थिति से X की अनवाइंडिंग गतिविधि बढ़ जाती है।\u0026amp;quot;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;जेल पैटर्न प्रतिक्रिया मिश्रण में eIF4G मौजूद होने पर RNA अनवाइंडिंग गतिविधि में वृद्धि का खुलासा करते हैं। eIF4G संभवतः एक सह-कारक के रूप में कार्य करता है जो \u0026amp;#39;X\u0026amp;#39; को उसके कार्य में सहायता करता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;eIF4G द्वारा अनवाइंडिंग गतिविधि में यह वृद्धि इस कथन को सही सिद्ध करती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;इस प्रकार, तीनों कथन सही हैं।\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Fundamental Processes"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a451aec9ba648bc86fbf43","title":"Fundamental Processes"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":13.057675996607294,"attempts":{"correct":30,"incorrect":67,"partial":0,"skipped":1082,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895408a9eb05a9f9ac7ac9c":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Magnetite acts as a biological compass.\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Magnetite is a naturally occurring iron oxide mineral (Fe\u0026lt;sub\u0026gt;3\u0026lt;/sub\u0026gt;O\u0026lt;sub\u0026gt;4\u0026lt;/sub\u0026gt;) found in various organisms, including migratory animals.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;It plays a crucial role in magnetoreception, which is the ability of an organism to detect the Earth\u0026amp;rsquo;s magnetic field.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This ability is particularly important for migratory species, such as birds, sea turtles, and some fish, as it helps them navigate over long distances with remarkable accuracy.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Magnetite crystals in animals align with the Earth\u0026amp;rsquo;s magnetic field and act as a biological compass, providing directional information that aids navigation.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Magnetite as a Biological Compass:\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Magnetite crystals are believed to be located in specific sensory cells within an animal\u0026amp;rsquo;s body.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;These crystals align with the Earth\u0026amp;rsquo;s magnetic field, enabling the animal to detect its direction relative to the poles.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;This directional information is integrated with other sensory inputs (e.g., visual and olfactory cues) to guide migration.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;For example, migratory birds use this mechanism to maintain their flight paths over thousands of kilometers, even in conditions where visual landmarks are absent.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर है-\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;मैग्नेटाइट एक जैविक कम्पास के रूप में कार्य करता है।\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;मैग्नेटाइट एक प्राकृतिक रूप से पाया जाने वाला आयरन ऑक्साइड खनिज (Fe\u0026lt;sub\u0026gt;3\u0026lt;/sub\u0026gt;O\u0026lt;sub\u0026gt;4\u0026lt;/sub\u0026gt;) है जो विभिन्न जीवों में पाया जाता है, जिसमें प्रवासी जानवर भी शामिल हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह मैग्नेटोरिसेप्शन में एक महत्वपूर्ण भूमिका निभाता है, जो पृथ्वी के चुंबकीय क्षेत्र का पता लगाने की किसी जीव की क्षमता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह क्षमता विशेष रूप से प्रवासी प्रजातियों, जैसे पक्षी, समुद्री कछुए और कुछ मछलियों के लिए महत्वपूर्ण है, क्योंकि यह उन्हें अद्भुत सटीकता के साथ लंबी दूरी पर नेविगेट करने में मदद करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जानवरों में मैग्नेटाइट क्रिस्टल पृथ्वी के चुंबकीय क्षेत्र के साथ संरेखित होते हैं और एक जैविक कम्पास के रूप में कार्य करते हैं, दिशात्मक जानकारी प्रदान करते हैं जो नेविगेशन में सहायता करती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;जैविक कम्पास के रूप में मैग्नेटाइट:\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;माना जाता है कि मैग्नेटाइट क्रिस्टल किसी जानवर के शरीर के भीतर विशिष्ट संवेदी कोशिकाओं में स्थित होते हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;ये क्रिस्टल पृथ्वी के चुंबकीय क्षेत्र के साथ संरेखित होते हैं, जिससे जानवर ध्रुवों के सापेक्ष अपनी दिशा का पता लगा सकता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह दिशात्मक जानकारी अन्य संवेदी इनपुट (जैसे, दृश्य और घ्राण संकेत) के साथ एकीकृत होती है ताकि प्रवास का मार्गदर्शन किया जा सके।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;उदाहरण के लिए, प्रवासी पक्षी हजारों किलोमीटर तक अपने उड़ान पथ को बनाए रखने के लिए इस तंत्र का उपयोग करते हैं, यहां तक ​​कि उन परिस्थितियों में भी जहां दृश्य चिह्न अनुपस्थित होते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Evolution and Behavior"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4557fe52da32add2b08e9","title":"Evolution and Behavior"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":9.872773536895673,"attempts":{"correct":99,"incorrect":155,"partial":0,"skipped":925,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689540b6cc49566a430da76a":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A and B\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The immune system\u0026amp;rsquo;s response to tumors involves different mechanisms, with a focus on cytotoxic T lymphocytes (CTLs) and natural killer (NK) cells. Both CTLs and NK cells play crucial roles in tumor surveillance, but their actions depend on the expression of MHC class I molecules on tumor cells.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;MHC class I molecules are essential for the presentation of antigens to CTLs. Tumor cells that lack MHC class I expression can evade CTL-mediated destruction but may become targets for NK cells, which are designed to recognize and kill cells with reduced or absent MHC class I expression.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Nude mice lack functional T cells due to a genetic mutation, but they retain functional NK cells. This makes them an ideal model to study the role of NK cells in tumor immunity.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement A:\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;In normal mice, CTLs rely on the presence of MHC class I molecules to recognize and destroy tumor cells.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Tumors expressing MHC class I (wild type) are effectively controlled by CTLs in normal mice.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;However, when tumor cells lack MHC class I, CTLs cannot recognize or eliminate them, allowing the tumor to grow. This aligns with the observation that tumor growth is inhibited in normal mice only when MHC class I is present.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement B:\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;NK cells kill cells that lack MHC-I (\u0026amp;quot;missing-self hypothesis\u0026amp;quot;). In the absence of MHC-1, NK cells do not receive the inhibitory signal through their inhibitory receptors, thereby becoming activated and targeting these cells for destruction.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Nude mice lack T cells, so NK cells are active\u0026amp;nbsp;due to the absence of functional T cells.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Incorrect Options:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement C:\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;This statement suggests that CTLs and NK cells inhibit each other when MHC class I is present, but not when it is absent. There is no evidence to support such mutual inhibition between CTLs and NK cells.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Both CTLs and NK cells operate independently, with CTLs targeting MHC class I-presenting cells and NK cells targeting cells that lack MHC class I.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Statement D:\u0026lt;/span\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Nude mice lack T cells, including CD4 helper T cells, which are essential for antibody production. Thus, tumors lacking MHC class I cannot be controlled by CTLs or antibodies in nude mice.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;The statement that \u0026amp;quot;antibodies generated with the help of CD4 cells restrain tumor growth in nude mice\u0026amp;quot; is incorrect because nude mice cannot produce such antibodies due to the absence of functional T cells\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A और B\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;ट्यूमर के प्रति प्रतिरक्षा प्रणाली की प्रतिक्रिया में विभिन्न क्रियाविधि शामिल होती हैं, जिनमें साइटोटॉक्सिक टी लिम्फोसाइट्स (CTL) और प्राकृतिक मारक (NK) कोशिकाओं पर विशेष ध्यान दिया जाता है। CTL और NK कोशिकाएँ, दोनों ही ट्यूमर निगरानी में महत्वपूर्ण भूमिका निभाती हैं, लेकिन उनकी क्रियाएँ ट्यूमर कोशिकाओं पर MHC वर्ग I अणुओं की अभिव्यक्ति पर निर्भर करती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;MHC वर्ग I अणु, CTL के प्रतिजनों की प्रस्तुति के लिए आवश्यक हैं। जिन ट्यूमर कोशिकाओं में MHC वर्ग I अभिव्यक्ति का अभाव होता है, वे CTL-मध्यस्थ विनाश से बच सकती हैं, लेकिन NK कोशिकाओं का लक्ष्य बन सकती हैं, जो कम या अनुपस्थित MHC वर्ग I अभिव्यक्ति वाली कोशिकाओं को पहचानने और उन्हें मारने के लिए डिज़ाइन की गई हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;नग्न चूहों में आनुवंशिक उत्परिवर्तन के कारण क्रियात्मक T कोशिकाएँ नहीं होतीं, लेकिन उनमें क्रियात्मक NK कोशिकाएँ मौजूद रहती हैं। यह उन्हें ट्यूमर प्रतिरक्षा में NK कोशिकाओं की भूमिका का अध्ययन करने के लिए एक आदर्श मॉडल बनाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;स्पष्टीकरण:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन A:\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;सामान्य चूहों में, CTL ट्यूमर कोशिकाओं को पहचानने और नष्ट करने के लिए MHC वर्ग I अणुओं की उपस्थिति पर निर्भर करते हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;MHC वर्ग I (जंगली प्रकार) व्यक्त करने वाले ट्यूमर को सामान्य चूहों में CTL द्वारा प्रभावी रूप से नियंत्रित किया जाता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;हालाँकि, जब ट्यूमर कोशिकाओं में MHC वर्ग I की कमी होती है, तो CTL उन्हें पहचान या समाप्त नहीं कर पाते, जिससे ट्यूमर बढ़ता रहता है। यह इस अवलोकन से मेल खाता है कि सामान्य चूहों में ट्यूमर का विकास केवल तभी बाधित होता है जब MHC वर्ग I मौजूद होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन B:\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;NK कोशिकाएँ उन कोशिकाओं को मार देती हैं जिनमें MHC-I(\u0026amp;quot;विलुप्त-स्व परिकल्पना\u0026amp;quot;) नहीं होती। MHC-1 की अनुपस्थिति में, NK कोशिकाएँ अपने निरोधक ग्राही के माध्यम से निरोधात्मक संकेत प्राप्त नहीं कर पातीं, जिससे वे सक्रिय हो जाती हैं और इन कोशिकाओं को नष्ट करने के लिए लक्ष्य बनाती हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;नग्न चूहों में T कोशिकाओं का अभाव होता है, इसलिए क्रियात्मक T कोशिकाओं की अनुपस्थिति के कारण NK कोशिकाएं सक्रिय होती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;गलत विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन C:\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह कथन बताता है कि जब MHC वर्ग I मौजूद होता है, तो CTL और NK कोशिकाएँ एक-दूसरे को बाधित करती हैं, लेकिन जब यह अनुपस्थित होता है, तो नहीं। CTL और NK कोशिकाओं के बीच इस तरह के पारस्परिक अवरोध का समर्थन करने वाला कोई प्रमाण नहीं है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;CTL और NK दोनों कोशिकाएं स्वतंत्र रूप से कार्य करती हैं, CTL MHC वर्ग I प्रस्तुत करने वाली कोशिकाओं को लक्षित करती हैं और NK कोशिकाएं उन कोशिकाओं को लक्षित करती हैं जिनमें MHC वर्ग I का अभाव होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;कथन D:\u0026lt;/span\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;नग्न चूहों में T कोशिकाओं का अभाव होता है, जिनमें CD4 सहायक T कोशिकाएँ भी शामिल हैं, जो प्रतिरक्षी उत्पादन के लिए आवश्यक हैं। इसलिए, नग्न चूहों में MHC वर्ग I की कमी वाले ट्यूमर को CTL या प्रतिरक्षी द्वारा नियंत्रित नहीं किया जा सकता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह कथन कि \u0026amp;quot;CD4 कोशिकाओं की सहायता से उत्पन्न प्रतिरक्षी नग्न चूहों में ट्यूमर के विकास को रोकते हैं\u0026amp;quot; गलत है क्योंकि नग्न चूहे क्रियात्मक T कोशिकाओं की अनुपस्थिति के कारण ऐसे प्रतिरक्षी का उत्पादन नहीं कर सकते हैं\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Cell Communication and Cell Signaling"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a451cdef5b5403de57a575","title":"Cell Communication and Cell Signaling"},"t":{"id":"63a452398916ea6dfa277c06","title":"Immune System"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":11.42069550466497,"attempts":{"correct":23,"incorrect":42,"partial":0,"skipped":1114,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689541508aebc97d87cff372":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is\u0026lt;strong\u0026gt;\u0026amp;nbsp;(A)-(a)-(i); (B)-(c)-(ii); (C)-(a)-(i); (D)-(b)-(ii)\u0026amp;nbsp;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Gene expression in eukaryotes is tightly regulated through various mechanisms, including histone modifications. These modifications alter the structure of chromatin, influencing its accessibility to transcription machinery and ultimately affecting gene expression.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Histone modifications are specific chemical changes (e.g., methylation, acetylation) on histone proteins that interact with DNA to form chromatin. These modifications can either promote or suppress gene expression by altering chromatin structure.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Chromatin exists in two major types: open chromatin (euchromatin) and closed chromatin (heterochromatin). Open chromatin is transcriptionally active, while closed chromatin is transcriptionally silent.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;(A) H4K4me3:\u0026lt;/strong\u0026gt; This modification is typically associated with active transcription and open chromatin. It promotes gene expression, making genes \u0026amp;quot;ON.\u0026amp;quot; Hence, the correct association is (a)-(i).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;(B) H3K9me3:\u0026lt;/strong\u0026gt; This modification is linked with facultative heterochromatin and is strongly associated with gene repression. It keeps genes \u0026amp;quot;OFF.\u0026amp;quot; Therefore, the correct association is (c)-(ii).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;(C) H3K9ac:\u0026lt;/strong\u0026gt; This acetylation mark is associated with open chromatin and active transcription. It promotes gene expression, making genes \u0026amp;quot;ON.\u0026amp;quot; Hence, the correct association is (a)-(i).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;(D) H3K27me3:\u0026lt;/strong\u0026gt; This modification is associated with facultative heterochromatin and is linked with gene repression. It keeps genes \u0026amp;quot;OFF.\u0026amp;quot; Therefore, the correct association is (b)-(ii).\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;(A)-(a)-(i); (B)-(c)-(ii); (C)-(a)-(i); (D)-(b)-(ii)\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यूकैरियोट्स में जीन अभिव्यक्ति को विभिन्न तंत्रों, जिसमें हिस्टोन रूपांतरण शामिल हैं, के माध्यम से कड़ाई से नियंत्रित किया जाता है। ये रूपांतरण क्रोमैटिन की संरचना को बदलते हैं, अनुलेखन मशीनरी तक इसकी पहुँच को प्रभावित करते हैं और अंततः जीन अभिव्यक्ति को प्रभावित करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;हिस्टोन रूपांतरण हिस्टोन प्रोटीन पर विशिष्ट रासायनिक परिवर्तन (जैसे, मिथाइलेशन, एसिटिलेशन) हैं जो डीएनए के साथ क्रोमैटिन बनाने के लिए परस्पर क्रिया करते हैं। ये रूपांतरण क्रोमैटिन संरचना को बदलकर जीन अभिव्यक्ति को बढ़ावा दे सकते हैं या दबा सकते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;क्रोमैटिन दो प्रमुख प्रकारों में मौजूद है: खुला क्रोमैटिन (यूक्रोमैटिन) और बंद क्रोमैटिन (हेटरोक्रोमैटिन)। खुला क्रोमैटिन अनुलेखन रूप से सक्रिय है, जबकि बंद क्रोमैटिन अनुलेखन रूप से मौन है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;(A) H4K4me3:\u0026lt;/strong\u0026gt; यह रूपांतरण आमतौर पर सक्रिय अनुलेखन और खुले क्रोमैटिन से जुड़ा होता है। यह जीन अभिव्यक्ति को बढ़ावा देता है, जिससे जीन \u0026amp;quot;चालू\u0026amp;quot; हो जाते हैं। इसलिए, सही संबंध (a)-(i) है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;(B) H3K9me3:\u0026lt;/strong\u0026gt; यह रूपांतरण ऐच्छिक हेटरोक्रोमैटिन से जुड़ा हुआ है और जीन दमन के साथ दृढ़ता से जुड़ा हुआ है। यह जीन को \u0026amp;quot;बंद\u0026amp;quot; रखता है। इसलिए, सही संबंध (c)-(ii) है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;(C) H3K9ac:\u0026lt;/strong\u0026gt; यह एसिटिलेशन चिह्न खुले क्रोमैटिन और सक्रिय अनुलेखन से जुड़ा हुआ है। यह जीन अभिव्यक्ति को बढ़ावा देता है, जिससे जीन \u0026amp;quot;चालू\u0026amp;quot; हो जाते हैं। इसलिए, सही संबंध (a)-(i) है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;(D) H3K27me3:\u0026lt;/strong\u0026gt; यह रूपांतरण ऐच्छिक हेटरोक्रोमैटिन से जुड़ा हुआ है और जीन दमन से जुड़ा हुआ है। यह जीन को \u0026amp;quot;बंद\u0026amp;quot; रखता है। इसलिए, सही संबंध (b)-(ii) है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Fundamental Processes"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a451aec9ba648bc86fbf43","title":"Fundamental Processes"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":13.289228159457167,"attempts":{"correct":40,"incorrect":74,"partial":0,"skipped":1065,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689542717ac09e469deea44f":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A and D\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Glucagon is a peptide hormone produced by the alpha cells of the pancreas. It plays a critical role in maintaining blood glucose levels, particularly during fasting or low glucose conditions.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Its primary actions include promoting glycogenolysis (breakdown of glycogen into glucose) and gluconeogenesis (synthesis of glucose from non-carbohydrate sources) in the liver, as well as lipolysis (breaking down fats to release fatty acids).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Glucagon mainly acts on the liver, but its effects on muscle glycogen metabolism and lipolysis in other tissues are limited.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement A: It does not cause glycogenolysis in muscle:\u0026lt;/strong\u0026gt; Glucagon primarily acts on the liver and does not directly stimulate glycogenolysis in muscle tissues. Muscle glycogen breakdown is regulated by other factors, such as epinephrine, during physical activity or stress.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement B: It decreases ketone bodies formation in the liver:\u0026lt;/strong\u0026gt; This is incorrect. Glucagon promotes ketogenesis in the liver, leading to the production of ketone bodies during prolonged fasting or carbohydrate deprivation.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement C: It does not cause lipolysis in the liver:\u0026lt;/strong\u0026gt; This is incorrect. Glucagon stimulates lipolysis in the liver, leading to the breakdown of triglycerides into free fatty acids, which can be used for energy or converted into ketone bodies.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Statement D: It inhibits conversion of phosphoenolpyruvate to pyruvate in the liver:\u0026lt;/span\u0026gt;\u0026amp;nbsp;Glucagon inhibits glycolysis in the liver by reducing the activity of enzymes like pyruvate kinase, which catalyzes the conversion of phosphoenolpyruvate to pyruvate. This promotes gluconeogenesis and helps maintain blood glucose levels during fasting.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A और D\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;ग्लूकागॉन अग्न्याशय की अल्फा कोशिकाओं द्वारा उत्पादित एक पेप्टाइड हार्मोन है। यह रक्त ग्लूकोज के स्तर को बनाए रखने में महत्वपूर्ण भूमिका निभाता है, खासकर उपवास या कम ग्लूकोज की स्थिति में।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इसकी प्राथमिक क्रियाओं में यकृत में ग्लाइकोजेनोलिसिस (ग्लाइकोजन का ग्लूकोज में विघटन) और ग्लूकोनेोजेनेसिस (गैर-कार्बोहाइड्रेट स्रोतों से ग्लूकोज का संश्लेषण) को बढ़ावा देना, साथ ही लिपोलिसिस (वसा को तोड़कर फैटी एसिड मुक्त करना) शामिल हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;ग्लूकागॉन मुख्य रूप से यकृत पर कार्य करता है, लेकिन पेशियों के ग्लाइकोजन उपापचय और अन्य ऊतकों में लिपोलिसिस पर इसके प्रभाव सीमित हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन A: यह पेशियों में ग्लाइकोजेनोलिसिस का कारण नहीं बनता है:\u0026lt;/strong\u0026gt; ग्लूकागॉन मुख्य रूप से यकृत पर कार्य करता है और सीधे पेशी ऊतकों में ग्लाइकोजेनोलिसिस को उत्तेजित नहीं करता है। पेशी ग्लाइकोजन का टूटना अन्य कारकों द्वारा नियंत्रित होता है, जैसे कि शारीरिक गतिविधि या तनाव के दौरान एपिनेफ्रीन।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन B: यह यकृत में कीटोन निकायों के निर्माण को कम करता है:\u0026lt;/strong\u0026gt; यह गलत है। ग्लूकागॉन यकृत में कीटोजेनेसिस को बढ़ावा देता है, जिससे लंबे समय तक उपवास या कार्बोहाइड्रेट की कमी के दौरान कीटोन निकायों का उत्पादन होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन C: यह यकृत में लिपोलिसिस का कारण नहीं बनता है:\u0026lt;/strong\u0026gt; यह गलत है। ग्लूकागॉन यकृत में लिपोलिसिस को उत्तेजित करता है, जिससे ट्राइग्लिसराइड्स का मुक्त फैटी एसिड में टूटना होता है, जिसका उपयोग ऊर्जा के लिए किया जा सकता है या कीटोन निकायों में परिवर्तित किया जा सकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;कथन D: यह यकृत में फॉस्फोइनोलपाइरुवेट के पाइरुवेट में रूपांतरण को रोकता है:\u0026lt;/span\u0026gt; ग्लूकागॉन यकृत में ग्लाइकोलाइसिस को पाइरुवेट किनेज जैसे एंजाइमों की गतिविधि को कम करके रोकता है, जो फॉस्फोइनोलपाइरुवेट के पाइरुवेट में रूपांतरण को उत्प्रेरित करता है। यह ग्लूकोनियोजेनेसिस को बढ़ावा देता है और उपवास के दौरान रक्त ग्लूकोज के स्तर को बनाए रखने में मदद करता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["System Physiology Animal"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a452e28f21ac91a2eba7a5","title":"System Physiology Animal"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":18.949109414758272,"attempts":{"correct":75,"incorrect":165,"partial":0,"skipped":939,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68954297f922825acdf625f8":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Option 4\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;During early embryonic development in \u0026lt;em\u0026gt;Drosophila melanogaster\u0026lt;/em\u0026gt;, a precise pattern of gene expression establishes body segmentation. This process relies on interactions among maternal effect genes, gap genes, pair-rule genes, and segment polarity genes.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Maternal effect genes\u0026amp;nbsp;\u0026lt;/strong\u0026gt;provide mRNA or proteins to the embryo from the mother, establishing initial positional information (e.g., bicoid and nanos).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Gap genes\u0026amp;nbsp;\u0026lt;/strong\u0026gt;are zygotic genes activated by maternal effect gene products and define broad embryonic regions (e.g., hunchback, kruppel, and knirps).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The interplay between maternal effect genes and gap genes ensures the proper segmentation and polarity of the embryo.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Hunchback (Hb) is a maternal effect gene product that acts as a transcription factor. It is distributed in a concentration gradient, with high levels at the anterior end of the embryo. It activates the expression of the gap gene Krupple (Kr) in the central region of the embryo, where Hb concentration is at an intermediate level.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Krupple (Kr) is a gap gene product that acts as a repressor. It inhibits the expression of the gap gene Giant (Gt).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Giant (Gt) is a gap gene product that, like Hb, is a transcription factor. It is expressed in two domains, one in the anterior and one in the posterior region of the embryo. It inhibits the expression of Krupple (Kr).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\n\t\u0026lt;p\u0026gt;The interaction between Hb and Kr is activation, not mutual inhibition. The interaction between Kr and Gt is mutual inhibition, not mutual activation.\u0026lt;/p\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;Therefore, the diagram in option 4 is incorrect because it shows the following:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Mutual inhibition between Hb and Kr (incorrect; Hb activates Kr).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Activation of Gt by Kr (incorrect; Kr inhibits Gt).\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;विकल्प 4\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;em\u0026gt;ड्रोसोफिला मेलेनोगैस्टर\u0026lt;/em\u0026gt; में प्रारंभिक भ्रूणीय विकास के दौरान, जीन अभिव्यक्ति का एक सटीक पैटर्न शरीर के खंडीकरण को स्थापित करता है। यह प्रक्रिया मातृ प्रभाव जीन, गैप जीन, युग्म-नियम जीन और खंड ध्रुवता जीन के बीच परस्पर क्रियाओं पर निर्भर करती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;मातृ प्रभाव जीन\u0026lt;/strong\u0026gt; माता से भ्रूण को mRNA या प्रोटीन प्रदान करते हैं, जिससे प्रारंभिक स्थिति संबंधी जानकारी स्थापित होती है (जैसे, बाइकोइड और नैनोस)।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;गैप जीन\u0026lt;/strong\u0026gt; युग्मज जीन हैं जो मातृ प्रभाव जीन उत्पादों द्वारा सक्रिय होते हैं और व्यापक भ्रूणीय क्षेत्रों को परिभाषित करते हैं (जैसे, हंचबैक, क्रुपेल और नाइर्प्स)।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;मातृ प्रभाव जीन और गैप जीन के बीच परस्पर क्रिया भ्रूण के उचित खंडीकरण और ध्रुवता को सुनिश्चित करती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;हंचबैक (Hb) एक मातृ प्रभाव जीन उत्पाद है जो एक अनुलेखन कारक के रूप में कार्य करता है। यह एक सांद्रता प्रवणता में वितरित किया जाता है, जिसमें भ्रूण के पूर्वकाल छोर पर उच्च स्तर होते हैं। यह भ्रूण के मध्य क्षेत्र में गैप जीन क्रुपेल (Kr) की अभिव्यक्ति को सक्रिय करता है, जहाँ Hb सांद्रता मध्यवर्ती स्तर पर होती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;क्रुपेल (Kr) एक गैप जीन उत्पाद है जो एक दमनकारी के रूप में कार्य करता है। यह गैप जीन जायंट (Gt) की अभिव्यक्ति को रोकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जायंट (Gt) एक गैप जीन उत्पाद है जो Hb की तरह एक \u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;अनुलेखन\u0026amp;nbsp;\u0026lt;/span\u0026gt;कारक है। यह दो डोमेन में व्यक्त होता है, एक भ्रूण के अग्र भाग में और दूसरा पश्च भाग में। यह क्रुपेल (Kr) की अभिव्यक्ति को रोकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\n\t\u0026lt;p\u0026gt;Hb और Kr के बीच परस्पर क्रिया सक्रियण है, पारस्परिक निषेध नहीं। Kr और Gt के बीच परस्पर क्रिया पारस्परिक निषेध है, पारस्परिक सक्रियण नहीं।\u0026lt;/p\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;इसलिए, विकल्प 4 में आरेख गलत है क्योंकि यह निम्नलिखित दिखाता है:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Hb और Kr के बीच पारस्परिक निषेध (गलत; Hb Kr को सक्रिय करता है)।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Kr द्वारा Gt का सक्रियण (गलत; Kr Gt को रोकता है)।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Developmental Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4523f152a060341b327ed","title":"Developmental Biology"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":11.02629346904156,"attempts":{"correct":28,"incorrect":96,"partial":0,"skipped":1055,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895430d80817804fdcaf351":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is\u0026amp;nbsp;\u0026lt;strong\u0026gt;A - ii, B - i, C - ii, D - i, E - ii\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Lettuce seed germination exhibits a photo-reversible response controlled by the phytochrome system, which is sensitive to red (R) and far-red (FR) light.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Phytochromes are photoreceptor proteins in plants that regulate various physiological processes, including seed germination, based on light conditions.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In general:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Exposure to red light (R) activates the active form of phytochrome (Pfr), which promotes seed germination.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Far-red light (FR) converts the active form (Pfr) back to the inactive form (Pr), which inhibits germination.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;If seeds are kept in the dark, the inactive form (Pr) dominates, and germination is not stimulated.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/notesImages/noteImage659e8f01233946de8b66d5d2.png\u0026quot; style=\u0026quot;color: rgb(97, 106, 124); float: left;\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;nbsp;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;nbsp;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;nbsp;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;A - ii:\u0026lt;/strong\u0026gt; Inhibits seed germination. If seeds are kept in the dark, the inactive form (Pr) dominates, and germination is not stimulated.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;B - i:\u0026lt;/strong\u0026gt; Stimulates seed germination. If seeds are exposed to red light (R) after far-red light (FR), germination is stimulated because red light activates phytochrome to its active form (Pfr).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;C - ii:\u0026lt;/strong\u0026gt; Inhibits seed germination. Seeds kept in continuous far-red light remain in the inactive state (Pr), preventing germination.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;D - i:\u0026lt;/strong\u0026gt; Stimulates seed germination. Seeds exposed to continuous red light stay in the active state (Pfr), promoting germination.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;E - ii:\u0026lt;/strong\u0026gt; Inhibits seed germination. Seeds kept in the dark remain in the inactive state (Pr), as no light is available to convert Pr to Pfr.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;Thus, the correct combination is \u0026lt;strong\u0026gt;Option 4\u0026lt;/strong\u0026gt;.\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;A - ii, B - i, C - ii, D - i, E - ii\u0026amp;nbsp;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;है।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;लेट्यूस के बीजों के अंकुरण में फाइटोक्रोम प्रणाली द्वारा नियंत्रित एक प्रकाश-उत्क्रमणीय अभिक्रिया प्रदर्शित होती है, जो लाल (R) और दूर-लाल (FR) प्रकाश के प्रति संवेदनशील होती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;फाइटोक्रोम पौधों में प्रकाशग्राही प्रोटीन होते हैं जो प्रकाश की स्थिति के आधार पर बीज के अंकुरण सहित विभिन्न शारीरिक प्रक्रियाओं को नियंत्रित करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;सामान्य रूप से:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;लाल प्रकाश (R) के संपर्क में आने पर फाइटोक्रोम के सक्रिय रूप (Pfr) को सक्रिय किया जाता है, जो बीज के अंकुरण को बढ़ावा देता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;दूर-लाल प्रकाश (FR) सक्रिय रूप (Pfr) को निष्क्रिय रूप (Pr) में वापस परिवर्तित करता है, जो अंकुरण को रोकता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;यदि बीजों को अंधेरे में रखा जाता है, तो निष्क्रिय रूप (Pr) हावी होता है, और अंकुरण उत्तेजित नहीं होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/notesImages/noteImage659e8f01233946de8b66d5d2.png\u0026quot; style=\u0026quot;color: rgb(97, 106, 124); float: left;\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;nbsp;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;nbsp;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;nbsp;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;A - ii:\u0026lt;/strong\u0026gt; बीज के अंकुरण को रोकता है। यदि बीजों को अंधेरे में रखा जाता है, तो निष्क्रिय रूप (Pr) हावी होता है, और अंकुरण उत्तेजित नहीं होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;B - i:\u0026lt;/strong\u0026gt; बीज के अंकुरण को उत्तेजित करता है। यदि दूर-लाल प्रकाश (FR) के बाद बीजों को लाल प्रकाश (R) के संपर्क में लाया जाता है, तो अंकुरण उत्तेजित होता है क्योंकि लाल प्रकाश फाइटोक्रोम को इसके सक्रिय रूप (Pfr) में सक्रिय करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;C - ii:\u0026lt;/strong\u0026gt; बीज के अंकुरण को रोकता है। निरंतर दूर-लाल प्रकाश में रखे गए बीज निष्क्रिय अवस्था (Pr) में रहते हैं, जिससे अंकुरण नहीं होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;D - i:\u0026lt;/strong\u0026gt; बीज के अंकुरण को उत्तेजित करता है। निरंतर लाल प्रकाश के संपर्क में आने वाले बीज सक्रिय अवस्था (Pfr) में रहते हैं, जिससे अंकुरण होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;E - ii:\u0026lt;/strong\u0026gt; बीज के अंकुरण को रोकता है। अंधेरे में रखे गए बीज निष्क्रिय अवस्था (Pr) में रहते हैं, क्योंकि Pr को Pfr में बदलने के लिए कोई प्रकाश उपलब्ध नहीं है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;इस प्रकार, सही संयोजन \u0026lt;strong\u0026gt;विकल्प 4\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["System Physiology Plant"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4526f5db927c0ec7fb376","title":"System Physiology Plant"},"t":{"id":"63a45286ebdb38d1b04bd58a","title":"Sensory photobiology"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":17.96013570822729,"attempts":{"correct":75,"incorrect":106,"partial":0,"skipped":998,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895432ca2471c5930458886":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A and B\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Proteins destined for the nucleus possess a nuclear localization signal (NLS), which serves as a sorting signal.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The transport of these proteins into the nucleus occurs through nuclear pore complexes (NPCs), large protein assemblies embedded in the nuclear envelope.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The process involves specific interactions between the nuclear localization signal, nuclear import receptors, and components of the NPC.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This system ensures the selective import of proteins into the nucleus, critical for maintaining cellular function.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;A. The import receptor binds to the nuclear localization signal:\u0026lt;/strong\u0026gt; This is correct. Nuclear import receptors, also known as importins, recognize and bind to the nuclear localization signal (NLS) of cargo proteins. This interaction is essential to form a receptor-cargo complex that enables transport through the NPC.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;B. The import receptor contains several low-affinity binding sites for the nucleoporins:\u0026lt;/strong\u0026gt; This is correct. Import receptors interact with nucleoporins, which are components of the NPC. The nucleoporins have repeating motifs, such as FG (phenylalanine-glycine) sequences, that serve as binding sites for import receptors. These interactions facilitate the translocation of the receptor-cargo complex through the nuclear pore.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;C. The nuclear import receptor-cargo complex is dissociated by RanGDP in the nucleus:\u0026lt;/strong\u0026gt; This statement is incorrect. The dissociation of the receptor-cargo complex in the nucleus is triggered by RanGTP, not RanGDP. RanGTP binds to the import receptor in the nucleus, causing the release of the cargo protein.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;D. The nuclear import receptor-cargo complex binds to RanGTP in the cytosol and traverses the nuclear envelope:\u0026lt;/strong\u0026gt; This statement is incorrect. RanGTP is predominantly present in the nucleus due to the activity of RanGEF (Ran guanine nucleotide exchange factor). The receptor-cargo complex does not bind RanGTP in the cytosol; instead, it binds RanGTP in the nucleus for cargo release.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A और B\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;केन्द्रक के लिए नियत प्रोटीन में एक केन्द्रकीय स्थानीयकरण संकेत (NLS) होता है, जो एक छंटाई संकेत के रूप में कार्य करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इन प्रोटीनों का केन्द्रक में परिवहन केन्द्रकीय छिद्र परिसरों (NPC) के माध्यम से होता है, जो केन्द्रकीय आवरण में अंतर्निहित बड़े प्रोटीन समूह होते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इस प्रक्रिया में केन्द्रक स्थानीयकरण संकेत, केन्द्रक\u0026amp;nbsp;आयात ग्राही और NPC के घटकों के बीच विशिष्ट अंतःक्रियाएं शामिल होती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह प्रणाली केन्द्रक में प्रोटीन के चयनात्मक आयात को सुनिश्चित करती है, जो कोशिकीय कार्य को बनाए रखने के लिए महत्वपूर्ण है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;स्पष्टीकरण:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;A. आयात ग्राही केन्द्रकीय स्थानीयकरण संकेत से जुड़ता है:\u0026lt;/strong\u0026gt; यह सही है। केन्द्रकीय आयात ग्राही, जिन्हें आयातिन भी कहते हैं, कार्गो प्रोटीन के केन्द्रकीय स्थानीयकरण संकेत (NLS) को पहचानते हैं और उससे जुड़ते हैं। यह अंतःक्रिया एक ग्राही-कार्गो कॉम्प्लेक्स बनाने के लिए आवश्यक है जो NPC के माध्यम से परिवहन को सक्षम बनाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;B. आयात ग्राही में न्यूक्लियोपोरिन के लिए कई कम-बंधुता वाले बंधन स्थल होते हैं:\u0026lt;/strong\u0026gt; यह सही है। आयात ग्राही न्यूक्लियोपोरिन के साथ परस्पर क्रिया करते हैं, जो NPC के घटक हैं। न्यूक्लियोपोरिन में दोहराए जाने वाले रूपांकन होते हैं, जैसे कि एफजी (फेनिलएलनिन-ग्लाइसिन) अनुक्रम, जो आयात ग्राही के लिए बंधन स्थल के रूप में कार्य करते हैं। ये परस्पर क्रियाएँ ग्राही-कार्गो कॉम्प्लेक्स के केन्द्रकीय छिद्र से होकर स्थानांतरण को सुगम बनाती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;C. केन्द्रकीय आयात ग्राही-कार्गो कॉम्प्लेक्स का वियोजन केन्द्रक में RanGDP द्वारा होता है:\u0026lt;/strong\u0026gt; यह कथन गलत है। केन्द्रक में ग्राही-कार्गो कॉम्प्लेक्स का वियोजन RanGTP द्वारा होता है, RanGDP द्वारा नहीं। RanGTP केन्द्रक में आयात ग्राही से जुड़ता है, जिससे कार्गो प्रोटीन मुक्त होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;D. केन्द्रकीय आयात ग्राही-कार्गो कॉम्प्लेक्स कोशिकाद्रव्य में RanGTP से जुड़ता है और केन्द्रकीय आवरण को पार करता है:\u0026lt;/strong\u0026gt; यह कथन गलत है। RanGTP मुख्य रूप से RanGEF (Ran गुआनिन न्यूक्लियोटाइड विनिमय कारक) की क्रियाशीलता के कारण केन्द्रक में उपस्थित होता है। ग्राही-कार्गो कॉम्प्लेक्स कोशिकाद्रव्य में RanGTP से नहीं जुड़ता; बल्कि, यह कार्गो विमोचन के लिए केन्द्रक में RanGTP से जुड़ता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Cellular Organization"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4518aa958c4957eed4157","title":"Cellular Organization"},"t":{"id":"63a45197ebdb38d1b04bc5c6","title":"Intracellular organelles"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":16.92790500424088,"attempts":{"correct":73,"incorrect":114,"partial":0,"skipped":992,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68954345674f60740fae24ed":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A, B, C, and E\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Leaf development in plants is a highly regulated process involving a complex interplay of genetic, hormonal, and molecular mechanisms.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Key players in leaf development include transcription factors, small RNAs, and genes that regulate the polarity, identity, and complexity of leaf primordia.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement A:\u0026lt;/strong\u0026gt; \u0026amp;quot;The activity of KNOX1 and ARP are mutually repressive to help establish a separate identity for emerging leaf primordium.\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is correct. KNOX1 (KNOTTED1-like homeobox) genes are expressed in the shoot apical meristem (SAM) and are downregulated in leaf primordia. ARP (ASYMMETRIC LEAVES1/ROUGH SHEATH2/PHANTASTICA) genes repress KNOX1 in the leaf primordium to establish distinct shoot and leaf identities. This mutual repression ensures proper leaf development.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement B:\u0026lt;/strong\u0026gt; \u0026amp;quot;PHANTASTICA is required for adaxial cell fate during leaf development.\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is correct. The PHANTASTICA (PHAN) gene plays a vital role in specifying the adaxial (upper) side of the leaf. Mutations in PHAN can lead to defects in adaxial-abaxial polarity, resulting in abnormal leaf morphology.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement C:\u0026lt;/strong\u0026gt; \u0026amp;quot;KANADI genes promote abaxial cell fate during leaf development.\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is correct. The KANADI (KAN) family of transcription factors is essential for the establishment of abaxial (lower) cell fate. KAN genes work in opposition to adaxial-promoting genes such as PHAN to create leaf polarity.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement D:\u0026lt;/strong\u0026gt; \u0026amp;quot;miR166 binds to KANADI mRNA and degrades it on the abaxial side of the leaf primordium.\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is incorrect. miR166 does not target KANADI mRNA. Instead, miR166 binds to and degrades HD-ZIP III mRNAs, which are required for adaxial identity. This activity helps maintain polarity by restricting HD-ZIP III expression to the adaxial domain.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement E:\u0026lt;/strong\u0026gt; \u0026amp;quot;Overexpression of KNOX1 increases leaf complexity and indeterminacy.\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is correct. Overexpression of KNOX1 genes can lead to increased complexity and indeterminate growth in leaves, resulting in compound or lobed leaf forms.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A, B, C और E\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;पौधों में पत्ती का विकास एक अत्यधिक विनियमित प्रक्रिया है जिसमें आनुवंशिक, हार्मोनल और आणविक तंत्रों की एक जटिल अंतःक्रिया शामिल है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;पत्ती के विकास में प्रमुख खिलाड़ियों में अनुलेखन कारक, छोटे आरएनए और जीन शामिल हैं जो पत्ती प्राइमॉर्डिया की ध्रुवता, पहचान और जटिलता को नियंत्रित करते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन A:\u0026lt;/strong\u0026gt; \u0026amp;quot;KNOX1 और ARP की गतिविधि परस्पर दमनकारी होती है जो उभरते पत्ती प्राइमॉर्डियम के लिए एक अलग पहचान स्थापित करने में मदद करती है।\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह सही है। KNOX1 (KNOTTED1-like होम्योबॉक्स) जीन शूट एपिकल मेरिस्टेम (SAM) में व्यक्त किए जाते हैं और पत्ती प्राइमॉर्डिया में डाउनरेगुलेट किए जाते हैं। ARP (ASYMMETRIC LEAVES1/ROUGH SHEATH2/PHANTASTICA) जीन अलग शूट और पत्ती पहचान स्थापित करने के लिए पत्ती प्राइमॉर्डियम में KNOX1 को दबाते हैं। यह पारस्परिक दमन उचित पत्ती विकास सुनिश्चित करता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन B:\u0026lt;/strong\u0026gt; \u0026amp;quot;पत्ती के विकास के दौरान एडैक्सियल कोशिका भाग्य के लिए PHANTASTICA आवश्यक है।\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह सही है। PHANTASTICA (PHAN) जीन पत्ती के एडैक्सियल (ऊपरी) भाग को निर्दिष्ट करने में महत्वपूर्ण भूमिका निभाता है। PHAN में उत्परिवर्तन एडैक्सियल-एबेक्सियल ध्रुवता में दोष पैदा कर सकते हैं, जिसके परिणामस्वरूप असामान्य पत्ती आकारिकी होती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन C:\u0026lt;/strong\u0026gt; \u0026amp;quot;KANADI जीन पत्ती के विकास के दौरान एबेक्सियल कोशिका भाग्य को बढ़ावा देते हैं।\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह सही है। अनुलेखन कारकों का KANADI (KAN) कुल एबेक्सियल (निचले) कोशिका भाग्य की स्थापना के लिए आवश्यक है। पत्ती ध्रुवता बनाने के लिए KAN जीन PHAN जैसे एडैक्सियल-प्रोमोटिंग जीन के विरोध में काम करते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन D:\u0026lt;/strong\u0026gt; \u0026amp;quot;miR166 KANADI mRNA से जुड़ता है और इसे पत्ती प्राइमॉर्डियम के एबेक्सियल भाग पर नीचा दिखाता है।\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह गलत है। miR166 KANADI mRNA को लक्षित नहीं करता है। इसके बजाय, miR166 HD-ZIP III mRNAs से जुड़ता है और उन्हें नीचा दिखाता है, जो एडैक्सियल पहचान के लिए आवश्यक हैं। यह गतिविधि एडैक्सियल डोमेन में HD-ZIP III अभिव्यक्ति को प्रतिबंधित करके ध्रुवता को बनाए रखने में मदद करती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन E:\u0026lt;/strong\u0026gt; \u0026amp;quot;KNOX1 का अति-अभिव्यक्ति पत्ती की जटिलता और अनिश्चितता को बढ़ाता है।\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह सही है। KNOX1 जीन की अतिअभिव्यक्ति से पत्तियों में जटिलता और अनिश्चित वृद्धि बढ़ सकती है, जिसके परिणामस्वरूप मिश्रित या अर्धवृत्ताकार\u0026amp;nbsp;पत्ती के रूप बनते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Developmental Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4523f152a060341b327ed","title":"Developmental Biology"},"t":{"id":"63a4525f905ad063f1a84044","title":"Morphogenesis and organogenesis in plants"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":4.313825275657333,"attempts":{"correct":15,"incorrect":30,"partial":0,"skipped":1134,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689543c2762503510769636f":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;a - iv, b - i, c - ii, d - iii\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Sodium transport is an essential process in the renal tubule segments, where different sodium transporters are located in the apical membrane of tubular cells. Each segment of the renal tubule has a specific sodium transporter, which facilitates the movement of sodium ions into the tubular cells and contributes to the physiological functions of the kidney.\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Proximal tubule (a - iv):\u0026lt;/strong\u0026gt; The proximal tubule is responsible for the reabsorption of a significant portion of sodium and other solutes. It utilizes the Na+-amino acid co-transporter to absorb amino acids along with sodium ions. This process is vital for conserving nutrients and maintaining electrolyte balance.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Collecting duct (b - i):\u0026lt;/strong\u0026gt; The collecting duct plays a role in the fine regulation of sodium reabsorption under the influence of hormones like aldosterone. Sodium reabsorption here occurs via epithelial sodium channels (ENaC), which are highly selective for sodium ions.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Thick ascending limb (c - ii):\u0026lt;/strong\u0026gt; The thick ascending limb of the loop of Henle is a critical site for sodium reabsorption, utilizing the Na+-K+-2Cl- co-transporter. This transporter moves sodium, potassium, and chloride ions together and is crucial for creating the concentration gradient in the medulla, which facilitates water reabsorption downstream.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Distal convoluted tubule (d - iii):\u0026lt;/strong\u0026gt; The distal convoluted tubule reabsorbs sodium through the Na+-Cl- co-transporter. This segment helps in fine-tuning sodium and chloride levels in the filtrate before it reaches the collecting duct.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;a - iv, b - i, c - ii, d - iii\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;सोडियम परिवहन वृक्कीय नलिका खंडों में एक आवश्यक प्रक्रिया है, जहाँ नलिका कोशिकाओं के शीर्ष झिल्ली में विभिन्न सोडियम परिवहन स्थित होते हैं। वृक्कीय नलिका के प्रत्येक खंड में एक विशिष्ट सोडियम परिवहन होता है, जो सोडियम आयनों को नलिका कोशिकाओं में ले जाने की सुविधा प्रदान करता है और वृक्क के शारीरिक कार्यों में योगदान देता है।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;निकटवर्ती नलिका (a - iv):\u0026lt;/strong\u0026gt; निकटवर्ती नलिका सोडियम और अन्य विलेयों के एक महत्वपूर्ण हिस्से के पुनरावशोषण के लिए जिम्मेदार है। यह Na+-एमिनो अम्ल सह-परिवहन का उपयोग सोडियम आयनों के साथ एमिनो एसिड को अवशोषित करने के लिए करता है। यह प्रक्रिया पोषक तत्वों के संरक्षण और इलेक्ट्रोलाइट संतुलन को बनाए रखने के लिए महत्वपूर्ण है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;संग्राहक वाहिनी (b - i):\u0026lt;/strong\u0026gt; संग्राहक वाहिनी एल्डोस्टेरोन जैसे हार्मोन के प्रभाव में सोडियम पुनरावशोषण के सूक्ष्म नियमन में भूमिका निभाती है। यहाँ सोडियम पुनरावशोषण उपकला सोडियम चैनलों (ENaC) के माध्यम से होता है, जो सोडियम आयनों के लिए अत्यधिक चयनात्मक होते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;घना आरोही अंग (c - ii):\u0026lt;/strong\u0026gt; हेनले के पाश का घना आरोही अंग सोडियम पुनरावशोषण के लिए एक महत्वपूर्ण स्थल है, जो Na+-K+-2Cl- सह-परिवहन का उपयोग करता है। यह परिवाहक सोडियम, पोटेशियम और क्लोराइड आयनों को एक साथ गति प्रदान करता है और मेडुला में सांद्रता प्रवणता बनाने के लिए महत्वपूर्ण है, जो नीचे की ओर जल पुनःअवशोषण को सुगम बनाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;दूरस्थ कुंडलित नलिका (d - iii):\u0026lt;/strong\u0026gt; दूरस्थ कुंडलित नलिका Na+-Cl- सह-परिवहन के माध्यम से सोडियम को पुनरावशोषित करती है। यह खंड संग्राहक वाहिनी तक पहुँचने से पहले निस्पंद में सोडियम और क्लोराइड के स्तर को ठीक करने में मदद करता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["System Physiology Animal"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a452e28f21ac91a2eba7a5","title":"System Physiology Animal"},"t":{"id":"63a452f95db927c0ec7fbbd7","title":"Excretory system"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":13.266327396098385,"attempts":{"correct":94,"incorrect":109,"partial":0,"skipped":976,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689543dc8aebc97d87d000e6":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A, B, and D\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The Satpura Hypothesis suggests that the Satpura Range in central India served as a biogeographic corridor for the migration of Malayan taxa (flora and fauna) into peninsular India. This hypothesis was proposed to explain similarities in biodiversity between peninsular India and south-east Asia.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;However, alternative explanations challenge the Satpura Hypothesis, arguing that other processes or events might better explain the observed patterns of biodiversity. These include convergent evolution, dispersal in the opposite direction (out-of-India), and environmental conditions like glaciation facilitating species migration.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement A: Convergent evolution in similar environments.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This suggests that shared characteristics between Malayan and peninsular Indian taxa could be due to species independently evolving similar traits to adapt to similar ecological niches, rather than migration through the Satpura Range.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Convergent evolution is a well-documented phenomenon and is a plausible explanation for similarities in biodiversity.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement B: Out-of-India dispersal.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;According to this explanation, the flora and fauna originated in the Indian subcontinent and later dispersed into southeast Asia. This challenges the idea of unidirectional migration from southeast Asia into India.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This \u0026amp;quot;out-of-India\u0026amp;quot; hypothesis has been supported by some paleobiogeographic studies, especially for certain groups of organisms.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement D: Pleistocene glaciation facilitating dispersal.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;During the Pleistocene glaciation, climatic changes created conditions that could have enabled the dispersal of high-altitude Himalayan taxa to lower latitudes, including the Western Ghats.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This suggests that glaciation events, rather than the Satpura Range, could explain some of the shared biodiversity between these regions.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A, B और D\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;सतपुड़ा परिकल्पना यह सुझाव देती है कि मध्य भारत में सतपुड़ा पर्वत शृंखला मलायन टैक्सा (वनस्पति और जीवों) के प्रायद्वीपीय भारत में प्रवास के लिए एक जैव-भौगोलिक गलियारे के रूप में कार्य करती थी। यह परिकल्पना प्रायद्वीपीय भारत और दक्षिण-पूर्व एशिया के बीच जैव विविधता में समानता को समझाने के लिए प्रस्तावित की गई थी।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;हालांकि, वैकल्पिक स्पष्टीकरण सतपुड़ा परिकल्पना को चुनौती देते हैं, यह तर्क देते हुए कि अन्य प्रक्रियाओं या घटनाओं द्वारा अवलोकित जैव विविधता के पैटर्न को बेहतर ढंग से समझाया जा सकता है। इनमें अभिसारी विकास, विपरीत दिशा में फैलाव (भारत से बाहर), और हिमनदीकरण जैसी पर्यावरणीय स्थितियाँ शामिल हैं जो प्रजातियों के प्रवास को सुविधाजनक बनाती हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन A: समान वातावरण में अभिसारी विकास\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह सुझाव देता है कि मलय और प्रायद्वीपीय भारतीय वनों के बीच साझा विशेषताएँ सतपुड़ा रेंज के माध्यम से प्रवास के बजाय, समान पारिस्थितिक निचे के अनुकूल होने के लिए स्वतंत्र रूप से विकसित समान लक्षणों के कारण हो सकती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;अभिसारी विकास एक अच्छी तरह से प्रलेखित घटना है और जैव विविधता में समानता के लिए एक प्रशंसनीय स्पष्टीकरण है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन B: भारत से बाहर फैलाव\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;इस स्पष्टीकरण के अनुसार, वनस्पति और जीव भारत के उपमहाद्वीप में उत्पन्न हुए और बाद में दक्षिण पूर्व एशिया में फैल गए। यह दक्षिण पूर्व एशिया से भारत में एकतरफा प्रवास के विचार को चुनौती देता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इस \u0026amp;quot;भारत से बाहर\u0026amp;quot; परिकल्पना को कुछ पैलियोबायोग्राफिक अध्ययनों द्वारा समर्थित किया गया है, विशेष रूप से जीवों के कुछ समूहों के लिए।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन D: प्लीस्टोसीन हिमनदीकरण फैलाव की सुविधा प्रदान करता है\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;प्लीस्टोसीन हिमयुग के दौरान, जलवायु परिवर्तन ने ऐसी परिस्थितियां उत्पन्न कीं, जिनके कारण उच्च ऊंचाई वाले हिमालयी वनों का पश्चिमी घाट सहित निचले अक्षांशों तक फैलाव संभव हो सका।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इससे पता चलता है कि सतपुड़ा पर्वतमाला के बजाय हिमनदीकरण की घटनाएं इन क्षेत्रों के बीच साझा जैव विविधता की व्याख्या कर सकती हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Evolution and Behavior"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4557fe52da32add2b08e9","title":"Evolution and Behavior"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":8.492790500424107,"attempts":{"correct":22,"incorrect":39,"partial":0,"skipped":1118,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689543f976250351076965a1":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;B only\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Izumo and Juno are proteins expressed on sperm and egg cells, respectively, and are essential for their interaction during fertilization. Izumo is found on the sperm surface, while Juno is located on the egg membrane.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The interaction between Izumo and Juno is vital for successful sperm-egg binding, leading to fertilization. Without this interaction, fertilization does not occur.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Experiment A:\u0026lt;/strong\u0026gt; This experiment demonstrates that knocking out Izumo in male mice prevents sperm from fertilizing eggs. While this highlights the importance of Izumo in fertilization, it does not directly demonstrate the interaction between Izumo and Juno specifically. Therefore, Experiment A is insufficient to confirm their interaction.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Experiment B:\u0026lt;/strong\u0026gt; This experiment involves two kidney cell lines expressing Izumo and Juno, respectively. When the two cell types are mixed, they aggregate, suggesting a direct interaction between Izumo and Juno proteins. This is a clear demonstration of their specific binding behavior and is the reason why Option 2 is correct.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Experiment C:\u0026lt;/strong\u0026gt; Immunostaining shows that Izumo is localized on sperm, and Juno is localized on eggs. While this confirms their presence on respective cells, it does not demonstrate their interaction. Localization alone does not provide evidence of direct binding or functional interaction.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;केवल B\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;इज़ुमो और जूनो क्रमशः शुक्राणु और अंडे की कोशिकाओं पर व्यक्त प्रोटीन हैं, और निषेचन के दौरान उनकी परस्पर क्रिया के लिए आवश्यक हैं। इज़ुमो शुक्राणु की सतह पर पाया जाता है, जबकि जूनो अंडे की झिल्ली पर स्थित होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इज़ुमो और जूनो के बीच परस्पर क्रिया सफल शुक्राणु-अंडे बंधन के लिए महत्वपूर्ण है, जिससे निषेचन होता है। इस परस्पर क्रिया के बिना, निषेचन नहीं होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;प्रयोग A:\u0026lt;/strong\u0026gt; यह प्रयोग दर्शाता है कि नर चूहों में इज़ुमो को नॉक आउट करने से शुक्राणु अंडों को निषेचित करने से रोकता है। जबकि यह निषेचन में इज़ुमो के महत्व को उजागर करता है, यह सीधे तौर पर विशेष रूप से इज़ुमो और जूनो के बीच परस्पर क्रिया को प्रदर्शित नहीं करता है। इसलिए, प्रयोग A उनकी परस्पर क्रिया की पुष्टि करने के लिए अपर्याप्त है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;प्रयोग B:\u0026lt;/strong\u0026gt; इस प्रयोग में इज़ुमो और जूनो को क्रमशः व्यक्त करने वाली दो किडनी कोशिका रेखाएँ शामिल हैं। जब दो कोशिका प्रकारों को मिलाया जाता है, तो वे एकत्रित होते हैं, जो इज़ुमो और जूनो प्रोटीन के बीच प्रत्यक्ष परस्पर क्रिया का सुझाव देते हैं। यह उनके विशिष्ट बंधन व्यवहार का एक स्पष्ट प्रदर्शन है और यही कारण है कि विकल्प 2 सही है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;प्रयोग C:\u0026lt;/strong\u0026gt; इम्यूनोस्टेनिंग से पता चलता है कि इज़ुमो शुक्राणु पर और जूनो अंडों पर स्थित है। हालाँकि यह संबंधित कोशिकाओं पर उनकी उपस्थिति की पुष्टि करता है, लेकिन यह उनकी परस्पर क्रिया को प्रदर्शित नहीं करता है। केवल स्थानीयकरण ही प्रत्यक्ष बंधन या कार्यात्मक परस्पर क्रिया का प्रमाण नहीं देता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Developmental Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4523f152a060341b327ed","title":"Developmental Biology"},"t":{"id":"63a4524c29660bb626fcd934","title":"Gametogenesis, fertilization and early development"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":13.54028837998304,"attempts":{"correct":66,"incorrect":79,"partial":0,"skipped":1034,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68954419af69335e70a03688":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;-298.3 kJ/mol\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The stability of the canonical Watson-Crick G:C base pair in DNA is influenced by three hydrogen bonds formed between the guanine (G) and cytosine (C) bases. Each hydrogen bond involves an interaction between a donor atom (+0.25e) and an acceptor atom (-0.35e).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The electrostatic interaction energy between these charges is determined using Coulomb\u0026amp;#39;s law, which is modified to include the dielectric constant (D) of the medium and the distance (r) between the charges:\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;E = (k \u0026amp;times; q₁ \u0026amp;times; q₂) / (D \u0026amp;times; r)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Here:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;k:\u0026lt;/strong\u0026gt; Modified Coulomb\u0026amp;#39;s constant = 1389 kJ/mol\u0026amp;middot;nm\u0026amp;middot;e\u0026lt;sup\u0026gt;-2\u0026lt;/sup\u0026gt;\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;q₁ and q₂:\u0026lt;/strong\u0026gt; Charges on the donor and acceptor atoms (+0.25e and -0.35e, respectively)\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;r:\u0026lt;/strong\u0026gt; Distance between the donor and acceptor atoms = 2.9 \u0026amp;Aring; = 0.29 nm\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;D:\u0026lt;/strong\u0026gt; Dielectric constant of the medium (4 for the DNA core and 78.5 for water)\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;The total electrostatic interaction energy for all three hydrogen bonds is calculated for two scenarios: when the base pair is buried in the DNA core (D = 4) and when it is fully exposed to solvent (D = 78.5).\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Calculation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Calculate energy in the DNA core (D = 4):\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;For one hydrogen bond:\u0026lt;br /\u0026gt;\n\tE\u0026lt;sub\u0026gt;core \u0026lt;/sub\u0026gt;= (1389 \u0026amp;times; 0.25 \u0026amp;times; -0.35) / (4 \u0026amp;times; 0.29) = -104.7 kJ/mol\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;For three hydrogen bonds:\u0026lt;br /\u0026gt;\n\t\u0026lt;em\u0026gt;Total \u0026lt;/em\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;E\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative;  line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;core\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;em\u0026gt;= \u0026lt;/em\u0026gt;3 \u0026amp;times; (-104.7) = -314.1 kJ/mol\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Calculate energy in solvent (D = 78.5):\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;For one hydrogen bond:\u0026lt;br /\u0026gt;\n\tE\u0026lt;sub\u0026gt;solvent \u0026lt;/sub\u0026gt;= (1389 \u0026amp;times; 0.25 \u0026amp;times; -0.35) / (78.5 \u0026amp;times; 0.29) = -5.338 kJ/mol\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;For three hydrogen bonds:\u0026lt;br /\u0026gt;\n\tTotal\u0026amp;nbsp;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;E\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative;  line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;solvent\u0026amp;nbsp;\u0026lt;/span\u0026gt; = 3 \u0026amp;times; (-5.338) = -16.014 kJ/mol\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Calculate the difference in energy:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026amp;Delta;E = E\u0026lt;sub\u0026gt;core\u0026lt;/sub\u0026gt; - E\u0026lt;sub\u0026gt;solvent \u0026lt;/sub\u0026gt;= -314.1 - (-16.014) = -298.3 kJ/mol\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;-298.3 kJ/mol\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;DNA में कैनोनिकल वाटसन-क्रिक G:C क्षार युग्म की स्थिरता ग्वानिन (G) और साइटोसिन (C) क्षारों के बीच बने तीन हाइड्रोजन बंधों से प्रभावित होती है। प्रत्येक हाइड्रोजन बंध में एक दाता परमाणु (+0.25e) और एक ग्राही परमाणु (-0.35e) के बीच परस्पर क्रिया शामिल होती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इन आवेशों के बीच इलेक्ट्रोस्टैटिक संपर्क ऊर्जा कूलम्ब के नियम का उपयोग करके निर्धारित की जाती है, जिसे माध्यम के परावैद्युत स्थिरांक (D) और आवेशों के बीच की दूरी (r) को शामिल करने के लिए संशोधित किया जाता है:\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;E = (k x q₁ x q₂) / (D x r)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;यहाँ:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;k:\u0026lt;/strong\u0026gt; संशोधित कूलम्ब का स्थिरांक = 1389 kJ/mol\u0026amp;middot;nm\u0026amp;middot;e\u0026lt;sup\u0026gt;-2\u0026lt;/sup\u0026gt;\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;q₁ और q₂:\u0026lt;/strong\u0026gt; दाता और ग्राही परमाणुओं पर आवेश (+0.25e और -0.35e, क्रमशः)\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;r:\u0026lt;/strong\u0026gt; दाता और ग्राही परमाणुओं के बीच की दूरी = 2.9 \u0026amp;Aring; = 0.29 nm\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;D:\u0026lt;/strong\u0026gt; माध्यम का ढांकता हुआ स्थिरांक (DNA कोर के लिए 4 और पानी के लिए 78.5)\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;तीनों हाइड्रोजन बंधों के लिए कुल इलेक्ट्रोस्टैटिक संपर्क ऊर्जा की गणना दो परिदृश्यों के लिए की जाती है: जब क्षार युग्म DNA कोर में दबा होता है (D = 4) और जब यह विलायक के लिए पूरी तरह से विलायक के संपर्क में होता है (D = 78.5).\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;गणना:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;DNA कोर (D = 4) में ऊर्जा की गणना करें:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;एक हाइड्रोजन बंध के लिए:\u0026lt;br /\u0026gt;\n\tE\u0026lt;sub\u0026gt;कोर \u0026lt;/sub\u0026gt;= (1389 x 0.25 x -0.35) / (4 x 0.29) = -104.7 kJ/mol\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;तीन हाइड्रोजन बंधों के लिए:\u0026lt;br /\u0026gt;\n\t\u0026lt;em\u0026gt;कुल \u0026lt;/em\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;E\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative;  line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;कोर \u0026lt;/span\u0026gt;\u0026lt;em\u0026gt;= \u0026lt;/em\u0026gt;3 x (-104.7) = -314.1 kJ/mol\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;विलायक (D = 78.5) में ऊर्जा की गणना करें:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;एक हाइड्रोजन बंध के लिए:\u0026lt;br /\u0026gt;\n\tE\u0026lt;sub\u0026gt;विलायक \u0026lt;/sub\u0026gt;= (1389 x 0.25 x -0.35) / (78.5 x 0.29) = -5.338 kJ/mol\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;तीन हाइड्रोजन बंधों के लिए:\u0026lt;br /\u0026gt;\n\tकुल \u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;E\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;position: relative;  line-height: 0; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\u0026quot;\u0026gt;विलायक \u0026lt;/span\u0026gt; = 3 x (-5.338) = -16.014 kJ/mol\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;ऊर्जा में अंतर की गणना करें:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026amp;Delta;E = E\u0026lt;sub\u0026gt;कोर\u0026lt;/sub\u0026gt; - E\u0026lt;sub\u0026gt;विलायक \u0026lt;/sub\u0026gt;= -314.1 - (-16.014) = -298.3 kJ/mol\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Biochemistry"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a45131905ad063f1a82ade","title":"Biochemistry"},"t":{"id":"63a4517b0955dea17f0eda8d","title":"Conformation of Proteins and Nucleic acids"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":5.530958439355387,"attempts":{"correct":12,"incorrect":20,"partial":0,"skipped":1147,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689544480a8eb3d597543278":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A and E\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Circadian rhythms are internal biological clocks that regulate physiological and behavioral functions in organisms over a 24-hour cycle.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;These rhythms are influenced by both endogenous (internal) mechanisms and exogenous (external) environmental cues such as light, temperature, and other external stimuli.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In the context of calling activity in crickets, the circadian rhythm determines when they call, and this can be either influenced by environmental cues (entrained cycle) or persist without these cues (free-running cycle).\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement A (Correct):\u0026lt;/strong\u0026gt; Calling activity under constant light (LL) represents a free-running cycle because, in the absence of external cues (like the light-dark cycle), the crickets exhibit an internal rhythm that dictates their calling activity. On the other hand, calling activity under a light-dark cycle (LD) is entrained because the external light-dark cues synchronize their rhythm to the environment.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement E (Correct):\u0026lt;/strong\u0026gt; The circadian control of calling activity in crickets involves both endogenous and exogenous components. Endogenous mechanisms are demonstrated by the free-running cycle in LL conditions, where the calling activity persists without external cues. Exogenous components are evident in the LD cycle, where external light cues entrain the rhythm.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement C (Incorrect):\u0026lt;/strong\u0026gt; The circadian control is not exclusively endogenous. The experiment shows that external cues (light-dark cycles) influence the rhythm, indicating the presence of exogenous components.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement D (Incorrect):\u0026lt;/strong\u0026gt; The circadian control is not exclusively exogenous. The free-running cycle observed under LL conditions demonstrates the presence of endogenous mechanisms.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement B (Incorrect):\u0026lt;/strong\u0026gt;\u0026amp;nbsp;Under LL conditions, the cycle is free-running (not entrained), and under LD conditions, the cycle is entrained (not free-running).\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A और E\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;सर्केडियन लय आंतरिक जैविक घड़ियां हैं जो 24 घंटे के चक्र में जीवों में शारीरिक और व्यवहारिक कार्यों को नियंत्रित करती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;ये लय अंतर्जात (आंतरिक) तंत्र और बाह्यजात (बाहरी) पर्यावरणीय संकेतों जैसे प्रकाश, तापमान और अन्य बाहरी उत्तेजनाओं दोनों से प्रभावित होती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;क्रिकेट में कॉलिंग गतिविधि के संदर्भ में, सर्कैडियन लय यह निर्धारित करती है कि वे कब कॉल करते हैं, और यह या तो पर्यावरणीय संकेतों (प्रेरित चक्र) से प्रभावित हो सकता है या इन संकेतों के बिना (मुक्त-चलने वाला चक्र) बना रह सकता है।\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन A (सही):\u0026lt;/strong\u0026gt; निरंतर प्रकाश (LL) के तहत कॉलिंग गतिविधि एक मुक्त-चलने वाले चक्र का प्रतिनिधित्व करती है क्योंकि, बाहरी संकेतों (जैसे प्रकाश-अंधेरे चक्र) की अनुपस्थिति में, क्रिकेट एक आंतरिक लय प्रदर्शित करते हैं जो उनकी कॉलिंग गतिविधि को निर्धारित करती है। दूसरी ओर, प्रकाश-अंधेरे चक्र (LD) के तहत कॉलिंग गतिविधि प्रेरित होती है क्योंकि बाहरी प्रकाश-अंधेरे संकेत उनकी लय को पर्यावरण के साथ सिंक्रनाइज़ करते हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन E (सही):\u0026lt;/strong\u0026gt; क्रिकेट में कॉलिंग गतिविधि के सर्कैडियन नियंत्रण में अंतर्जात और बाह्यजात दोनों घटक शामिल हैं। अंतर्जात तंत्र LL स्थितियों में मुक्त-चलने वाले चक्र द्वारा प्रदर्शित होते हैं, जहाँ कॉलिंग गतिविधि बाहरी संकेतों के बिना बनी रहती है। बाह्यजात घटक LD चक्र में स्पष्ट हैं, जहाँ बाहरी प्रकाश संकेत लय को प्रेरित करते हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन C (गलत):\u0026lt;/strong\u0026gt; सर्कैडियन नियंत्रण विशेष रूप से अंतर्जात नहीं है। प्रयोग से पता चलता है कि बाहरी संकेत (प्रकाश-अंधेरे चक्र) लय को प्रभावित करते हैं, जो बाह्यजात घटकों की उपस्थिति का संकेत देते हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन D (गलत):\u0026lt;/strong\u0026gt; सर्कैडियन नियंत्रण विशेष रूप से बाह्यजात नहीं है। LL स्थितियों में देखे गए मुक्त-चलने वाले चक्र अंतर्जात तंत्र की उपस्थिति को दर्शाते हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन B (गलत):\u0026lt;/strong\u0026gt; LL स्थितियों के तहत, चक्र मुक्त-चलने वाला (प्रेरित नहीं) होता है, और LD स्थितियों के तहत, चक्र प्रेरित (मुक्त-चलने वाला नहीं) होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Evolution and Behavior"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4557fe52da32add2b08e9","title":"Evolution and Behavior"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":8.191687871077177,"attempts":{"correct":36,"incorrect":17,"partial":0,"skipped":1126,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68954462da7d16ef574c660b":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is\u0026lt;strong\u0026gt;\u0026amp;nbsp;A: True; B: True; C: False: D: True\u0026amp;nbsp;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Genetics and linkage mapping are essential tools in plant breeding and biology. They help researchers understand the inheritance of traits and identify genetic markers associated with specific phenotypes. Important concepts include Near-Isogenic Lines (NILs), genetic and physical distances, Quantitative Trait Loci (QTLs), and association mapping.\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;True:\u0026lt;/strong\u0026gt; Near-Isogenic Lines (NILs) are genetically identical populations except for specific regions of interest. These lines are considered \u0026amp;quot;immortal\u0026amp;quot; because they can be preserved and propagated indefinitely through vegetative reproduction or self-pollination, ensuring their genetic makeup remains unchanged.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;True:\u0026lt;/strong\u0026gt; Physical distance (measured in base pairs) between two genetic markers on a chromosome does not always correspond linearly to genetic distance (measured in centimorgans). This is because recombination frequency varies across different regions of the genome. Hotspots of recombination can create discrepancies between physical and genetic distances.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;False:\u0026lt;/strong\u0026gt; Quantitative Trait Loci (QTLs) do not always contribute equally to a trait\u0026amp;#39;s value. QTLs can have varying effects based on their genetic makeup, environment, and interactions with other loci. Some QTLs may have a major effect, while others may have minor effects.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;True:\u0026lt;/strong\u0026gt; Association mapping, also known as genome-wide association studies (GWAS), is conducted using unrelated individuals from the same population. This approach leverages natural genetic variation to identify associations between genetic markers and traits of interest.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;A: सत्य; B: सत्य; C: असत्य: D: सत्य\u0026lt;/strong\u0026gt;\u0026amp;nbsp;है।\u0026lt;strong\u0026gt; \u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;आनुवंशिकी और संयोजन मानचित्रण पादप प्रजनन और जीव विज्ञान में आवश्यक उपकरण हैं। वे शोधकर्ताओं को लक्षणों की वंशानुगतता को समझने और विशिष्ट लक्षणों से जुड़े आनुवंशिक चिन्हकों की पहचान करने में मदद करते हैं। महत्वपूर्ण अवधारणाओं में निकट-समजात रेखाएँ (NILs), आनुवंशिक और भौतिक दूरियाँ, मात्रात्मक लक्षण लोकी (QTLs) और सहयोगी मानचित्रण शामिल हैं।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;सत्य:\u0026lt;/strong\u0026gt; निकट-समजात रेखाएँ (NILs) आनुवंशिक रूप से समान आबादियाँ हैं, सिवाय रुचि के विशिष्ट क्षेत्रों के। इन रेखाओं को \u0026amp;quot;अमर\u0026amp;quot; माना जाता है क्योंकि इन्हें वानस्पतिक प्रजनन या स्व-परागण के माध्यम से अनिश्चित काल तक संरक्षित और प्रसारित किया जा सकता है, जिससे यह सुनिश्चित होता है कि उनकी आनुवंशिक संरचना अपरिवर्तित रहे।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;सत्य:\u0026lt;/strong\u0026gt; गुणसूत्र पर दो आनुवंशिक चिन्हकों के बीच भौतिक दूरी (क्षार युग्म\u0026amp;nbsp;में मापी गई) हमेशा आनुवंशिक दूरी (सेंटीमॉर्गन में मापी गई) के साथ रैखिक रूप से मेल नहीं खाती है। ऐसा इसलिए है क्योंकि पुनर्संयोजन आवृत्ति जीनोम के विभिन्न क्षेत्रों में भिन्न होती है। पुनर्संयोजन के हॉटस्पॉट भौतिक और आनुवंशिक दूरियों के बीच विसंगतियाँ उत्पन्न कर सकते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;असत्य:\u0026lt;/strong\u0026gt; मात्रात्मक लक्षण लोकी (QTLs) हमेशा किसी लक्षण के मान में समान रूप से योगदान नहीं करते हैं। QTLs के आनुवंशिक संरचना, पर्यावरण और अन्य लोकाई के साथ अंतःक्रिया के आधार पर अलग-अलग प्रभाव हो सकते हैं। कुछ QTLs का प्रमुख प्रभाव हो सकता है, जबकि अन्य का मामूली प्रभाव हो सकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;सत्य:\u0026lt;/strong\u0026gt; सहयोगी मानचित्रण, जिसे जीनोम-वाइड एसोसिएशन अध्ययन (GWAS) के रूप में भी जाना जाता है, एक ही आबादी के असंबंधित व्यक्तियों का उपयोग करके किया जाता है। यह दृष्टिकोण आनुवंशिक चिन्हकों और रुचि के लक्षणों के बीच संबंधों की पहचान करने के लिए प्राकृतिक आनुवंशिक भिन्नता का लाभ उठाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Methods in Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4566d978874fc5c7a0d11","title":"Methods in Biology"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":9.99406276505514,"attempts":{"correct":46,"incorrect":34,"partial":0,"skipped":1099,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895448d9eb05a9f9ac7bf17":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is\u0026lt;strong\u0026gt; A, B, and C\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt; \u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Flow cytometry is a widely used technique in biology and medicine to analyze the physical and chemical characteristics of cells or particles. Histograms generated from flow cytometry data represent the distribution of specific measurements for the samples analyzed. The analysis often involves identifying patterns in data to understand variability within and between groups, and statistical tests like ANOVA are used to determine the significance of observed differences.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026amp;nbsp;\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Figure A (Statement A):\u0026lt;/strong\u0026gt;\u0026amp;nbsp;\u0026amp;nbsp;Figure A represents three distributions with more variation within groups than between groups.\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;When observing the histogram, the peaks are closer to each other, indicating that the groups\u0026amp;#39; means are not very different.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;However, the spread (variance) within each group is higher, resulting in overlapping distributions.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This is consistent with the statement that Figure A represents three normal distributions with more variation within groups than between groups.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Figure B (Statement B):\u0026lt;/strong\u0026gt;\u0026amp;nbsp;Figure B represents three distributions with more variation between groups than within groups.\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;In the histogram of Figure B, the peaks of the distributions are farther apart, suggesting that the groups\u0026amp;#39; means differ significantly. Additionally, the spread (variance) within each group is relatively low, resulting in less overlap between the distributions.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This matches the statement that Figure B represents three normal distributions with more variation between groups than within groups.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;nbsp;\u0026lt;strong\u0026gt;ANOVA-F Test\u0026lt;/strong\u0026gt; \u0026lt;strong\u0026gt;(Statement C):\u0026lt;/strong\u0026gt;\u0026amp;nbsp;ANOVA (Analysis of Variance) is a statistical test used to compare means of multiple groups and determine whether the differences between them are statistically significant.\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The F-test in ANOVA evaluates the ratio of between-group variability to within-group variability. A higher ratio indicates that the groups differ significantly from each other.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In Figure B, the between-group variability is much higher relative to within-group variability. This increases the likelihood of a statistically significant result when applying the ANOVA-F test.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In Figure A, the within-group variability is higher relative to between-group variability, making it less likely for the ANOVA-F test to yield a statistically significant result.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;Therefore, the statement that the ANOVA-F test is likely to be significant for Figure B but not for Figure A is correct.\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;A, B और C\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;प्रवाह कोशिकामापी जीव विज्ञान और चिकित्सा में कोशिकाओं या कणों की भौतिक और रासायनिक विशेषताओं का विश्लेषण करने के लिए व्यापक रूप से उपयोग की जाने वाली तकनीक है। प्रवाह कोशिकामापी डेटा से उत्पन्न हिस्टोग्राम विश्लेषण किए गए नमूनों के लिए विशिष्ट मापों के वितरण का प्रतिनिधित्व करते हैं। विश्लेषण में अक्सर डेटा में पैटर्न की पहचान करना शामिल होता है ताकि समूहों के भीतर और बीच परिवर्तनशीलता को समझा जा सके, और ANOVA जैसे सांख्यिकीय परीक्षणों का उपयोग देखे गए अंतरों के महत्व को निर्धारित करने के लिए किया जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;चित्र A (कथन A):\u0026lt;/strong\u0026gt; चित्र A समूहों के बीच की तुलना में समूहों के भीतर अधिक भिन्नता वाले तीन वितरणों का प्रतिनिधित्व करता है।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;हिस्टोग्राम का अवलोकन करने पर, चोटियाँ एक-दूसरे के करीब होती हैं, जो दर्शाता है कि समूहों के माध्य बहुत भिन्न नहीं हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;हालाँकि, प्रत्येक समूह के भीतर प्रसार (प्रसरण) अधिक होता है, जिसके परिणामस्वरूप अतिव्यापी वितरण होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह इस कथन के अनुरूप है कि चित्र A समूहों के बीच की तुलना में समूहों के भीतर अधिक भिन्नता वाले तीन सामान्य वितरणों का प्रतिनिधित्व करता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;चित्र B (कथन B):\u0026lt;/strong\u0026gt; चित्र B समूहों के भीतर की तुलना में समूहों के बीच अधिक भिन्नता वाले तीन वितरणों का प्रतिनिधित्व करता है।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;चित्र B के हिस्टोग्राम में, वितरणों की चोटियाँ एक-दूसरे से दूर हैं, यह सुझाव देते हुए कि समूहों के माध्य में काफी अंतर है। इसके अतिरिक्त, प्रत्येक समूह के भीतर प्रसार (प्रसरण) अपेक्षाकृत कम है, जिसके परिणामस्वरूप वितरणों के बीच कम ओवरलैप होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह इस कथन से मेल खाता है कि चित्र B समूहों के भीतर की तुलना में समूहों के बीच अधिक भिन्नता वाले तीन सामान्य वितरणों का प्रतिनिधित्व करता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;ANOVA-F परीक्षण (कथन C):\u0026lt;/strong\u0026gt; ANOVA (प्रसरण का विश्लेषण) एक सांख्यिकीय परीक्षण है जिसका उपयोग कई समूहों के माध्यों की तुलना करने और यह निर्धारित करने के लिए किया जाता है कि उनके बीच के अंतर सांख्यिकीय रूप से महत्वपूर्ण हैं या नहीं।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;ANOVA में F-परीक्षण समूह-समूह परिवर्तनशीलता के अनुपात का मूल्यांकन करता है समूह-के-भीतर परिवर्तनशीलता के लिए। एक उच्च अनुपात इंगित करता है कि समूह एक दूसरे से काफी भिन्न हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;चित्र B में, समूह-समूह परिवर्तनशीलता समूह-के-भीतर परिवर्तनशीलता के सापेक्ष बहुत अधिक है। इससे ANOVA-F परीक्षण लागू करते समय सांख्यिकीय रूप से महत्वपूर्ण परिणाम की संभावना बढ़ जाती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;चित्र A में, समूह-के-भीतर परिवर्तनशीलता समूह-समूह परिवर्तनशीलता के सापेक्ष अधिक है, जिससे ANOVA-F परीक्षण का सांख्यिकीय रूप से महत्वपूर्ण परिणाम प्राप्त करने की संभावना कम हो जाती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;इसलिए, यह कथन कि ANOVA-F परीक्षण चित्र B के लिए महत्वपूर्ण होने की संभावना है लेकिन चित्र A के लिए नहीं, सही है।\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Methods in Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4566d978874fc5c7a0d11","title":"Methods in Biology"},"t":{"id":"63a456cbd3b5fd9703bb87c8","title":"Biostatistical Methods"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":10.530958439355388,"attempts":{"correct":25,"incorrect":62,"partial":0,"skipped":1092,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689544b4cc49566a430dba62":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;\u0026amp;nbsp;A and B only\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The study involves a successional chronosequence on sand dunes, examining how different plant species dominate at different stages of succession over 30\u0026amp;ndash;400 years.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Succession refers to the natural progression of plant communities over time, transitioning from pioneer species (like dune grasses) to late successional species (like pine trees).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The study investigates seedling emergence (proportion of viable seeds germinating) across dunes of different ages and explores the effect of seed predation on seedling emergence.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement A:\u0026lt;/strong\u0026gt; \u0026amp;quot;Late successional species can establish on younger dunes but may be limited by seed dispersal.\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is valid because the experimental seed addition shows that late successional species\u0026amp;#39; seedlings can emerge on younger dunes when seeds are artificially introduced. This suggests that seed dispersal, rather than substrate constraints, limits their establishment on younger dunes.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement B:\u0026lt;/strong\u0026gt; \u0026amp;quot;Seed predation reduces the establishment of late successional species on younger dunes.\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is valid because the data in Panel 2 indicates that seed predation has a significant negative effect on seedling emergence, particularly for late successional species on younger dunes. Predators likely consume seeds before they can germinate.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement C:\u0026lt;/strong\u0026gt; \u0026amp;quot;Facilitation has stronger influence than colonization or seed predation on successional change.\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is incorrect. There is no direct evidence in the data provided to support the idea that facilitation (positive interactions between plants) plays a stronger role than colonization or seed predation in driving succession. The data focuses on seedling emergence and predation effects, not facilitation processes.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement D:\u0026lt;/strong\u0026gt; \u0026amp;quot;Late successional species cannot establish on younger dunes because of the sandy substrate.\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is incorrect. The experimental seed addition shows that late successional species\u0026amp;#39; seedlings can germinate on younger dunes, indicating that the sandy substrate itself is not a limiting factor. The actual limitation appears to be seed dispersal and predation.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;केवल A और B\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026amp;nbsp;।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;इस अध्ययन में रेत के टीलों पर एक क्रमबद्ध कालानुक्रमिक अनुक्रम शामिल है, जिसमें यह जांच की जाती है कि 30-400 वर्षों में उत्तराधिकार के विभिन्न चरणों में विभिन्न पादप प्रजातियाँ कैसे हावी होती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;उत्तराधिकार समय के साथ पादप समुदायों की प्राकृतिक प्रगति को संदर्भित करता है, जो अग्रणी प्रजातियों (जैसे ड्यून घास) से देर से आने वाली प्रजातियों (जैसे देवदार के पेड़) में संक्रमित होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह अध्ययन विभिन्न आयु के टीलों पर पौधों के अंकुरण (अंकुरित होने वाले व्यवहार्य बीजों का अनुपात) की जांच करता है और पौधों के अंकुरण पर बीज भक्षण के प्रभाव का पता लगाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन A:\u0026lt;/strong\u0026gt; \u0026amp;quot;देर से आने वाली प्रजातियाँ युवा टीलों पर स्थापित हो सकती हैं लेकिन बीज प्रकीर्णन द्वारा सीमित हो सकती हैं।\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह मान्य है क्योंकि प्रायोगिक बीज जोड़ने से पता चलता है कि जब बीज कृत्रिम रूप से पेश किए जाते हैं, तो देर से आने वाली प्रजातियों के पौधे युवा टीलों पर उग सकते हैं। इससे पता चलता है कि क्रियाधार की बाधाओं के बजाय, बीज प्रकीर्णन, युवा टीलों पर उनकी स्थापना को सीमित करता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन B:\u0026lt;/strong\u0026gt; \u0026amp;quot;बीज भक्षण युवा टीलों पर देर से आने वाली प्रजातियों की स्थापना को कम करता है।\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह मान्य है क्योंकि पैनल 2 में दिए गए आंकड़ों से संकेत मिलता है कि बीज भक्षण का पौधों के अंकुरण पर महत्वपूर्ण नकारात्मक प्रभाव पड़ता है, खासकर युवा टीलों पर देर से आने वाली प्रजातियों के लिए। शिकारी संभवतः अंकुरित होने से पहले ही बीजों का सेवन कर लेते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन C:\u0026lt;/strong\u0026gt; \u0026amp;quot;क्रमबद्ध परिवर्तन पर उपनिवेशीकरण या बीज भक्षण की तुलना में सुविधा का अधिक प्रभाव होता है।\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह गलत है। उपलब्ध कराए गए आंकड़ों में इस विचार का समर्थन करने वाला कोई प्रत्यक्ष प्रमाण नहीं है कि सुविधाकरण (पौधों के बीच सकारात्मक अंतःक्रियाएँ) उत्तराधिकार को आगे बढ़ाने में उपनिवेशीकरण या बीज परभक्षण की तुलना में अधिक महत्वपूर्ण भूमिका निभाता है। आंकड़े अंकुरों के उद्भव और परभक्षण के प्रभावों पर केंद्रित हैं, सुविधाकरण प्रक्रियाओं पर नहीं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन D:\u0026lt;/strong\u0026gt; \u0026amp;quot;रेतीले क्रियाधार के कारण देर से आने वाली प्रजातियाँ युवा टीलों पर स्थापित नहीं हो सकती हैं।\u0026amp;quot;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह गलत है। प्रायोगिक बीज जोड़ने से पता चलता है कि देर से आने वाली प्रजातियों के पौधे युवा टीलों पर अंकुरित हो सकते हैं, यह दर्शाता है कि रेतीला क्रियाधार अपने आप में एक सीमित कारक नहीं है। वास्तविक सीमा बीज प्रकीर्णन और भक्षण प्रतीत होती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Ecological Principles"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a45541e89684161ccd7911","title":"Ecological Principles"},"t":{"id":"63a4555d5db927c0ec7fdc3c","title":"Ecological Succession"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":8.489397794741294,"attempts":{"correct":7,"incorrect":21,"partial":0,"skipped":1151,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689544d0ef177aa03fbb1ffb":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A-Phenols, B-Lignin, C-Cellulose, D-Sugars\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Plant litter decomposition is a key process in the nutrient cycling of ecosystems. Different constituents of plant litter decompose at varying rates depending on their chemical composition.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Major components of plant litter include cellulose, lignin, phenolic compounds, and sugars. These components have distinct decomposition patterns influenced by microbial activity, environmental conditions, and chemical properties.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The decomposition rate of these components determines their role in the ecosystem, including nutrient release and carbon cycling:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;A-Phenols:\u0026lt;/strong\u0026gt; Phenols are complex aromatic compounds that decompose slower than sugars and cellulose due to their structural stability.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;B-Lignin:\u0026lt;/strong\u0026gt; Lignin is a highly recalcitrant polymer found in plant cell walls. It decomposes very slowly because of its complex structure and resistance to microbial enzymes.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;C-Cellulose:\u0026lt;/strong\u0026gt; Cellulose is a polysaccharide that is more readily decomposed compared to lignin but slower than sugars because of its crystalline structure.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;D-Sugars:\u0026lt;/strong\u0026gt; Sugars are simple organic molecules that decompose rapidly. They are the most readily available source of energy for microorganisms.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A-फीनॉल, B-लिग्निन, C-सेलूलोज, D-शर्करा\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;पादप\u0026amp;nbsp;के कूड़े का अपघटन पारिस्थितिक तंत्रों में पोषक तत्व चक्रण में एक प्रमुख प्रक्रिया है। पादप कूड़ा के विभिन्न घटक अपनी रासायनिक संरचना के आधार पर अलग-अलग दरों पर विघटित होते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;पादप के कूड़े के प्रमुख घटकों में सेलूलोज, लिग्निन, फेनोलिक यौगिक और शर्करा शामिल हैं। इन घटकों में सूक्ष्मजीवों की गतिविधि, पर्यावरणीय परिस्थितियों और रासायनिक गुणों से प्रभावित विशिष्ट अपघटन पैटर्न होते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इन घटकों की अपघटन दर पारिस्थितिक तंत्र में उनकी भूमिका को निर्धारित करती है, जिसमें पोषक तत्वों का विमोचन\u0026amp;nbsp;और कार्बन चक्रण शामिल है:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;A-फीनॉल:\u0026lt;/strong\u0026gt; फीनॉल जटिल सुगंधित यौगिक हैं जो अपनी संरचनात्मक स्थिरता के कारण शर्करा और सेलूलोज की तुलना में धीमी गति से विघटित होते हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;B-लिग्निन:\u0026lt;/strong\u0026gt; लिग्निन एक अत्यधिक प्रतिरोधी बहुलक है जो पादप कोशिका भित्तियों में पाया जाता है। यह अपनी जटिल संरचना और सूक्ष्मजीवों के एंजाइमों के प्रति प्रतिरोध के कारण बहुत धीरे-धीरे विघटित होता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;C-सेलूलोज:\u0026lt;/strong\u0026gt; सेलूलोज एक पॉलीसेकेराइड है जो लिग्निन की तुलना में अधिक आसानी से विघटित होता है, लेकिन इसकी क्रिस्टलीय संरचना के कारण शर्करा की तुलना में धीमा होता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;D-शर्करा:\u0026lt;/strong\u0026gt; शर्करा सरल कार्बनिक अणु हैं जो तेजी से विघटित होते हैं। वे सूक्ष्मजीवों के लिए ऊर्जा का सबसे आसानी से उपलब्ध स्रोत हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Ecological Principles"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a45541e89684161ccd7911","title":"Ecological Principles"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":10.025445292620882,"attempts":{"correct":45,"incorrect":108,"partial":0,"skipped":1026,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689545447625035107696e1c":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A-iii, B-iv, C-v, D-ii\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;A. Phylum Platyhelminthes - (iii):\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Members of this phylum are flatworms.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;They exhibit bilateral symmetry and are acoelomates (lacking a true body cavity).\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;They are triploblastic (three germ layers) and have a flattened body to facilitate diffusion of gases and nutrients.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;They typically have an incomplete digestive tract or may lack one entirely (e.g., tapeworms).\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;B. Phylum Annelida - (iv):\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Annelids, such as earthworms and leeches, exhibit segmentation (metamerism).\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;They have a true coelom (body cavity) and a closed circulatory system.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Most annelids possess chitinous chaetae (bristle-like structures) for movement.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;They are bilaterally symmetrical and triploblastic.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;C. Class Insecta - (v):\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Insects are characterized by their exoskeleton made of chitin.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;They have three distinct body regions: head, thorax, and abdomen.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Insects possess six legs and, in most cases, wings in their adult stage.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Examples include ants, butterflies, and beetles.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;D. Phylum Echinodermata - (ii):\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Echinoderms, such as sea stars and sea urchins, exhibit radial symmetry in adulthood (often pentamerous).\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;They possess a unique water vascular system used for locomotion, feeding, and respiration.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;They are exclusively marine and belong to the deuterostome group of animals.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;They have a calcareous endoskeleton and no segmentation.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A-iii, B-iv, C-v, D-ii\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026amp;nbsp;है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;A. संघ प्लेटीहेल्मिन्थीज - (iii):\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;इस संघ के सदस्य चपटे कृमि हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;वे द्विपार्श्व सममिति प्रदर्शित करते हैं और असीलोमेट (वास्तविक शरीर गुहा की कमी) होते हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;वे त्रिस्तरीय (तीन जनन परतें) हैं और गैसों और पोषक तत्वों के प्रसार की सुविधा के लिए एक चपटा शरीर रखते हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;उनके पास आमतौर पर एक अपूर्ण पाचन तंत्र होता है या वे पूरी तरह से अनुपस्थित हो सकते हैं (जैसे, टैपवर्म)।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;B. संघ एनेलिडा - (iv):\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;केंचुए और जोंक जैसे एनेलिड्स, खंडन (मेटामेरिज्म) प्रदर्शित करते हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;उनके पास एक वास्तविक सीलोम (शरीर गुहा) और एक बंद परिसंचरण तंत्र है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;अधिकांश एनेलिड्स में गति के लिए काइटिनस शैटा (ब्रिसल जैसे संरचनाएं) होती हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;वे द्विपार्श्व सममित और त्रिस्तरीय होते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;C. वर्ग इंसेक्टा - (v):\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;कीटों को काइटिन से बने उनके एक्सोस्केलेटन की विशेषता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;उनके तीन अलग-अलग शरीर के क्षेत्र होते हैं: सिर, वक्ष और उदर।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;कीटों में छह पैर होते हैं और ज्यादातर मामलों में, उनके वयस्क चरण में पंख होते हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;उदाहरणों में चींटियाँ, तितलियाँ और भृंग शामिल हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;D. संघ इकाइनोडर्मेटा - (ii):\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;समुद्री तारे और समुद्री अर्चिन जैसे इकाइनोडर्म, वयस्कता में अरीय सममिति (अक्सर पंचतयी) प्रदर्शित करते हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;उनके पास एक अनोखा जल संवहन तंत्र होता है जिसका उपयोग गति, भोजन और श्वसन के लिए किया जाता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;वे विशेष रूप से समुद्री हैं और जानवरों के ड्यूटेरोस्टोम समूह से संबंधित हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;उनके पास एक कैल्केरियस एंडोस्केलेटन और कोई खंडन नहीं होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Diversity of Life Forms"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a45511ef5b5403de57d744","title":"Diversity of Life Forms"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":27.53011026293469,"attempts":{"correct":214,"incorrect":102,"partial":0,"skipped":863,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895458faf69335e70a03d66":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A-(ii), B-(iii), C-(ii), D-(i)\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Panama disease of Banana (A - Fungal):\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Panama disease is caused by the fungus \u0026lt;em\u0026gt;Fusarium oxysporum f. sp. cubense\u0026lt;/em\u0026gt;.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;This fungal infection affects the vascular system of banana plants, leading to wilting and eventual death.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Red ring disease of Coconut (B - Nematode):\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Red ring disease is caused by the nematode \u0026lt;em\u0026gt;Bursaphelenchus cocophilus\u0026lt;/em\u0026gt;.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;The disease results in a characteristic red ring in the cross-section of the stem and leads to stunted growth and death in coconuts.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Malformation of Mango (C - Fungal):\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Malformation in mango trees is caused by fungal infections, predominantly \u0026lt;em\u0026gt;Fusarium moniliforme var. subglutinans\u0026lt;/em\u0026gt;.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;This condition leads to abnormal growth and reduced fruit yield.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Citrus Canker (D - Bacterial):\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Citrus canker is caused by the bacterium \u0026lt;em\u0026gt;Xanthomonas axonopodis pv. citri\u0026lt;/em\u0026gt;.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;The disease leads to lesions on leaves, stems, and fruit, significantly affecting citrus crop yield.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A-(ii), B-(iii), C-(ii), D-(i)\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;केले का पनामा रोग (A - कवक):\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;पनामा रोग \u0026lt;em\u0026gt;फ्यूसेरियम ऑक्सीस्पोरम एफ. एस.पी. क्यूबेंस\u0026lt;/em\u0026gt; कवक के कारण होता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह कवक संक्रमण केले के पौधों की संवहन प्रणाली को प्रभावित करता है, जिससे मुरझाना और अंततः मृत्यु होती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;नारियल का लाल वलय रोग (B - सूत्रकृमि):\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;लाल वलय रोग\u0026lt;em\u0026gt; बर्सफेलेंचस कोकोफिलस\u0026lt;/em\u0026gt; सूत्रकृमि के कारण होता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;इस रोग के परिणामस्वरूप तने के अनुप्रस्थ काट में एक विशिष्ट लाल वलय बनता है और नारियल में रूका हुआ विकास और मृत्यु होती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;आम का विकृति (C - कवक):\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;आम के पेड़ों में विकृति मुख्य रूप से \u0026lt;em\u0026gt;फ्यूसेरियम मोनिलिफोर्मे संस्करण\u0026amp;nbsp;सबग्लूटिनन्स \u0026lt;/em\u0026gt;कवक संक्रमण के कारण होती है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह स्थिति असामान्य वृद्धि और कम फल उत्पादन की ओर ले जाती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;नींबू कैंकर (D - जीवाणु):\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;नींबू कैंकर\u0026lt;em\u0026gt; ज़ैंथोमोनस एक्सोनोपोडिस पी.वी. सिट्री \u0026lt;/em\u0026gt;जीवाणु के कारण होता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह रोग पत्तियों, तनों और फलों पर घावों का कारण बनता है, जिससे नींबू की फसल की उपज पर महत्वपूर्ण प्रभाव पड़ता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Diversity of Life Forms"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a45511ef5b5403de57d744","title":"Diversity of Life Forms"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":19.309584393553873,"attempts":{"correct":120,"incorrect":153,"partial":0,"skipped":906,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689545ada2471c5930459781":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:rgb(33, 37, 41);\u0026quot;\u0026gt;A and C\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Urokinase Plasminogen Activator (uPA) is an enzyme that plays a significant role in cancer metastasis. It facilitates the breakdown of the extracellular matrix, enabling cancer cells to invade surrounding tissues and enter the bloodstream.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The interaction between uPA and its receptor (uPAR) is critical for metastasis. Disruption of this interaction can significantly reduce the metastatic potential of cancer cells.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Genetically modifying cancer cells to alter uPA or uPAR expression or functionality can provide insights into their roles in tumor formation and metastasis.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Observation A:\u0026lt;/strong\u0026gt; Overexpressing a mutant version of the uPA protein that does not bind to its receptor led to tumor formation but reduced metastasis.\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The inability of the mutant uPA to bind to its receptor (uPAR) disrupts the uPA-uPAR interaction, which is essential for metastasis.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This disruption reduces the metastatic potential of the cancer cells while still allowing tumor formation, as other pathways might still support tumor growth.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Observation C:\u0026lt;/strong\u0026gt; Overexpressing a secreted version of the uPA receptor led to tumor formation but reduced metastasis.\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The secreted form of the uPA receptor acts as a \u0026amp;quot;decoy,\u0026amp;quot; binding to uPA and preventing its interaction with the cell-surface receptor.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This mechanism inhibits metastasis while still allowing tumor growth, as other factors might contribute to tumor formation.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;span id=\u0026quot;cke_bm_20696C\u0026quot; style=\u0026quot;display: none;\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/span\u0026gt;Together, Observations A and C indicate that disrupting the uPA-uPAR interaction reduces metastasis but does not necessarily prevent tumor formation. Hence, the correct answer is Option 1 (A and C).\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:rgb(33, 37, 41);\u0026quot;\u0026gt;A और C\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यूरोकाइनेज प्लास्मिनोजेन एक्टिवेटर (uPA) एक एंजाइम है जो कैंसर के मेटास्टेसिस में महत्वपूर्ण भूमिका निभाता है। यह बाह्य कोशिकीय आधात्री के टूटने की सुविधा प्रदान करता है, जिससे कैंसर कोशिकाएँ आसपास के ऊतकों पर आक्रमण कर सकती हैं और रक्तप्रवाह में प्रवेश कर सकती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;uPA और इसके ग्राही (uPAR) के बीच परस्पर क्रिया मेटास्टेसिस के लिए महत्वपूर्ण है। इस परस्पर क्रिया का विघटन कैंसर कोशिकाओं की मेटास्टेटिक क्षमता को काफी कम कर सकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;आनुवंशिक रूप से कैंसर कोशिकाओं को संशोधित करने से uPA या uPAR अभिव्यक्ति या कार्यक्षमता को बदलने से ट्यूमर के निर्माण और मेटास्टेसिस में उनकी भूमिकाओं में अंतर्दृष्टि मिल सकती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;अवलोकन A:\u0026lt;/strong\u0026gt; uPA प्रोटीन के एक उत्परिवर्ती संस्करण को अति-व्यक्त करने से, जो इसके ग्राही से बंधता नहीं है, ट्यूमर का निर्माण हुआ लेकिन मेटास्टेसिस कम हो गया।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;उत्परिवर्ती uPA की इसके ग्राही (uPAR) से बंधने में असमर्थता uPA-uPAR परस्पर क्रिया को बाधित करती है, जो मेटास्टेसिस के लिए आवश्यक है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह विघटन कैंसर कोशिकाओं की मेटास्टेटिक क्षमता को कम करता है जबकि अभी भी ट्यूमर का निर्माण करने में सहायता करता है, क्योंकि अन्य मार्ग अभी भी ट्यूमर के विकास में सहायता कर सकते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;अवलोकन C:\u0026lt;/strong\u0026gt; uPA ग्राही के एक स्रावित संस्करण को अति-व्यक्त करने से ट्यूमर का निर्माण हुआ लेकिन मेटास्टेसिस कम हो गया।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;uPA ग्राही का स्रावित रूप एक \u0026amp;quot;डिकॉय\u0026amp;quot; के रूप में कार्य करता है, uPA से बंधता है और कोशिका-सतह ग्राही के साथ इसकी परस्पर क्रिया को रोकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह तंत्र मेटास्टेसिस को रोकता है जबकि अभी भी ट्यूमर के विकास की अनुमति देता है, क्योंकि अन्य कारक ट्यूमर के निर्माण में योगदान कर सकते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;साथ में, अवलोकन A और C इंगित करते हैं कि uPA-uPAR परस्पर क्रिया को बाधित करने से मेटास्टेसिस कम हो जाता है लेकिन ट्यूमर के निर्माण को जरूरी नहीं कि रोका जा सके। इसलिए, सही उत्तर विकल्प 1 (A और C) है।\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Cell Communication and Cell Signaling"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a451cdef5b5403de57a575","title":"Cell Communication and Cell Signaling"},"t":{"id":"63a4523531b306cb01f71b3f","title":"Cancer"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":8.72519083969466,"attempts":{"correct":13,"incorrect":23,"partial":0,"skipped":1143,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689545f2dad2443a135220bf":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;In hypothesis testing, statistical errors occur when a decision is made about a null hypothesis (H\u0026lt;sub\u0026gt;0\u0026lt;/sub\u0026gt;) based on sample data. The errors are classified into two types: \u0026lt;strong\u0026gt;Type I error\u0026lt;/strong\u0026gt; and \u0026lt;strong\u0026gt;Type II error\u0026lt;/strong\u0026gt;.\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The null hypothesis (H\u0026lt;sub\u0026gt;0\u0026lt;/sub\u0026gt;) represents the default assumption (e.g., no effect or no difference), and the alternative hypothesis (H\u0026lt;sub\u0026gt;1\u0026lt;/sub\u0026gt;) represents the opposite of the null hypothesis.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Type I error occurs when H\u0026lt;sub\u0026gt;0\u0026lt;/sub\u0026gt; is rejected even though it is true.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Type II error occurs when H\u0026lt;sub\u0026gt;0\u0026lt;/sub\u0026gt; is not rejected even though it is false.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Type I Error (False Positive):\u0026lt;/strong\u0026gt; This error occurs when you reject the null hypothesis (H\u0026lt;sub\u0026gt;0\u0026lt;/sub\u0026gt;) even though it is actually true. For example, concluding there is a difference when there is none. This is denoted by the significance level (\u0026amp;alpha;).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Type II Error (False Negative):\u0026lt;/strong\u0026gt; This error occurs when you fail to reject the null hypothesis (H\u0026lt;sub\u0026gt;0\u0026lt;/sub\u0026gt;) even though it is actually false. For example, concluding there is no difference when there is one. This is denoted by the probability (\u0026amp;beta;).\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Option 2 (A):\u0026lt;/strong\u0026gt; Correctly represents the relationship between Type I and Type II errors:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Type I Error: Rejecting H\u0026lt;sub\u0026gt;0\u0026lt;/sub\u0026gt; when it is true.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Type II Error: Failing to reject H\u0026lt;sub\u0026gt;0\u0026lt;/sub\u0026gt; when it is false.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;परिकल्पना परीक्षण में, सांख्यिकीय त्रुटियाँ तब होती हैं जब नमूना डेटा के आधार पर शून्य परिकल्पना (H\u0026lt;sub\u0026gt;0\u0026lt;/sub\u0026gt;) के बारे में निर्णय लिया जाता है। त्रुटियों को दो प्रकारों में वर्गीकृत किया जाता है: \u0026lt;strong\u0026gt;प्रकार I त्रुटि\u0026lt;/strong\u0026gt; और \u0026lt;strong\u0026gt;प्रकार II त्रुटि\u0026lt;/strong\u0026gt;।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;शून्य परिकल्पना (H\u0026lt;sub\u0026gt;0\u0026lt;/sub\u0026gt;) डिफ़ॉल्ट धारणा का प्रतिनिधित्व करती है (जैसे, कोई प्रभाव नहीं या कोई अंतर नहीं), और वैकल्पिक परिकल्पना (H\u0026lt;sub\u0026gt;1\u0026lt;/sub\u0026gt;) शून्य परिकल्पना के विपरीत का प्रतिनिधित्व करती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;प्रकार I त्रुटि तब होती है जब H\u0026lt;sub\u0026gt;0\u0026lt;/sub\u0026gt; को अस्वीकार कर दिया जाता है, भले ही वह सत्य हो।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;प्रकार II त्रुटि तब होती है जब H\u0026lt;sub\u0026gt;0\u0026lt;/sub\u0026gt; को अस्वीकार नहीं किया जाता है, भले ही वह असत्य हो।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;प्रकार I त्रुटि (गलत सकारात्मक):\u0026lt;/strong\u0026gt; यह त्रुटि तब होती है जब आप शून्य परिकल्पना (H\u0026lt;sub\u0026gt;0\u0026lt;/sub\u0026gt;) को अस्वीकार करते हैं, भले ही वह वास्तव में सत्य हो। उदाहरण के लिए, यह निष्कर्ष निकालना कि अंतर है जब कोई अंतर नहीं है। इसे महत्व स्तर (\u0026amp;alpha;) द्वारा दर्शाया जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;प्रकार II त्रुटि (गलत नकारात्मक):\u0026lt;/strong\u0026gt; यह त्रुटि तब होती है जब आप शून्य परिकल्पना (H\u0026lt;sub\u0026gt;0\u0026lt;/sub\u0026gt;) को अस्वीकार करने में विफल रहते हैं, भले ही वह वास्तव में असत्य हो। उदाहरण के लिए, यह निष्कर्ष निकालना कि कोई अंतर नहीं है जब अंतर है। इसे प्रायिकता (\u0026amp;beta;) द्वारा दर्शाया जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;विकल्प 2 (A):\u0026lt;/strong\u0026gt; प्रकार I और प्रकार II त्रुटियों के बीच संबंध को सही ढंग से दर्शाता है:​\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;प्रकार I त्रुटि: H\u0026lt;sub\u0026gt;0\u0026lt;/sub\u0026gt; को अस्वीकार करना जब यह सत्य हो।\u0026lt;br /\u0026gt;\n\tप्रकार II त्रुटि: H\u0026lt;sub\u0026gt;0\u0026lt;/sub\u0026gt; को अस्वीकार करने में विफल होना जब यह असत्य हो।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Methods in Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4566d978874fc5c7a0d11","title":"Methods in Biology"},"t":{"id":"63a456cbd3b5fd9703bb87c8","title":"Biostatistical Methods"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":5.1382527565733636,"attempts":{"correct":23,"incorrect":15,"partial":0,"skipped":1141,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689546478aebc97d87d00d6d":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A-D-C-B\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Transformation experiments\u0026amp;nbsp;\u0026lt;/strong\u0026gt;are performed to study the transfer of genetic material between bacterial strains.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In this case, two strains of \u0026lt;em\u0026gt;Pneumococcal\u0026lt;/em\u0026gt; bacteria were used: one resistant to four drugs (A, B, C, D) and the other sensitive to all four drugs.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;When the two strains are mixed, genetic material from the resistant strain may be taken up by the sensitive strain, leading to the acquisition of drug resistance. The sequence of gene transfer can be inferred based on the number of colonies that grow in the presence of combinations of the drugs.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The number of colonies observed on different drug-containing plates indicates how closely the resistance genes are located to one another on the bacterial chromosome. Genes that are closer together are more likely to be transferred together during transformation.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;To determine the order of the drug-resistance genes, we analyze the number of colonies growing in the presence of different drug combinations.\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Plates with fewer colonies indicate that multiple genes must be transferred together to confer resistance, which happens less frequently due to the larger size of the transferred DNA segment.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;For example:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;When only one drug is added (e.g., A, B, C, or D), a large number of colonies are observed (e.g., 1156 for A). This is because a single gene is sufficient to confer resistance, and single-gene transfer is frequent.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;When two drugs are added (e.g., AB or AD), fewer colonies are observed (e.g., 46 for AB), because resistance to both drugs requires the transfer of two genes.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;When three or four drugs are added (e.g., ABC or ABCD), very few colonies are observed (e.g., 30 for ABCD), as this requires the simultaneous transfer of three or four genes, which is rare.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The pattern of colony numbers suggests the physical order of the genes on the chromosome.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Genes that are farther apart are less likely to be transferred together, as larger DNA segments are less frequently taken up by the recipient bacteria.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Based on the data, the most likely order of the genes is \u0026lt;strong\u0026gt;A-D-C-B\u0026lt;/strong\u0026gt;. This order explains the observed colony counts because:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;AD (942) and CD (786) indicates that A, D and C are close\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;AB (46) and BC (51) indcates that B is far.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;Gene B is the last in the sequence.\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A-D-C-B\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;रूपांतरण प्रयोग\u0026lt;/strong\u0026gt; बैक्टीरिया के स्ट्रेन के बीच आनुवंशिक पदार्थ के स्थानांतरण का अध्ययन करने के लिए किए जाते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इस मामले में, \u0026lt;em\u0026gt;न्यूमोकोकल\u0026lt;/em\u0026gt; बैक्टीरिया के दो स्ट्रेन का उपयोग किया गया था: एक चार दवाओं (A, B, C, D) के प्रतिरोधी और दूसरा चारों दवाओं के प्रति संवेदनशील।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जब दो स्ट्रेन मिलाए जाते हैं, तो प्रतिरोधी स्ट्रेन से आनुवंशिक पदार्थ संवेदनशील स्ट्रेन द्वारा लिया जा सकता है, जिससे दवा प्रतिरोध का अधिग्रहण होता है। जीन स्थानांतरण का क्रम दवाओं के संयोजनों की उपस्थिति में बढ़ने वाली कॉलोनियों की संख्या के आधार पर अनुमान लगाया जा सकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;विभिन्न दवा-युक्त प्लेटों पर देखी गई कॉलोनियों की संख्या यह दर्शाती है कि जीवाणु गुणसूत्र पर प्रतिरोध जीन एक-दूसरे के कितने निकट स्थित हैं। जो जीन एक-दूसरे के निकट होते हैं, उनके रूपांतरण के दौरान एक साथ स्थानांतरित होने की संभावना अधिक होती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;दवा-प्रतिरोध जीन के क्रम का निर्धारण करने के लिए, हम विभिन्न दवा संयोजनों की उपस्थिति में बढ़ने वाली कॉलोनियों की संख्या का विश्लेषण करते हैं।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;कम कॉलोनियों वाली प्लेटें इंगित करती हैं कि प्रतिरोध प्रदान करने के लिए कई जीनों को एक साथ स्थानांतरित किया जाना चाहिए, जो स्थानांतरित डीएनए खंड के बड़े आकार के कारण कम बार होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;उदाहरण के लिए:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;जब केवल एक दवा जोड़ी जाती है (जैसे, A, B, C, या D), तो बड़ी संख्या में कॉलोनियाँ देखी जाती हैं (जैसे, A के लिए 1156)। ऐसा इसलिए है क्योंकि प्रतिरोध प्रदान करने के लिए एक एकल जीन पर्याप्त है, और एकल-जीन स्थानांतरण बार-बार होता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;जब दो दवाएँ जोड़ी जाती हैं (जैसे, AB या AD), तो कम कॉलोनियाँ देखी जाती हैं (जैसे, AB के लिए 46), क्योंकि दोनों दवाओं के प्रतिरोध के लिए दो जीनों के स्थानांतरण की आवश्यकता होती है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;जब तीन या चार दवाएँ जोड़ी जाती हैं (जैसे, ABC या ABCD), तो बहुत कम कॉलोनियाँ देखी जाती हैं (जैसे, ABCD के लिए 30), क्योंकि इसके लिए तीन या चार जीनों के एक साथ स्थानांतरण की आवश्यकता होती है, जो दुर्लभ है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;कॉलोनी संख्याओं का पैटर्न गुणसूत्र पर जीन के भौतिक क्रम का सुझाव देता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जो जीन दूर होते हैं, उनके एक साथ स्थानांतरित होने की संभावना कम होती है, क्योंकि बड़े डीएनए खंड प्राप्तकर्ता बैक्टीरिया द्वारा कम बार लिए जाते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;डेटा के आधार पर, जीन का सबसे संभावित क्रम \u0026lt;strong\u0026gt;A-D-C-B\u0026lt;/strong\u0026gt; है। यह क्रम देखी गई कॉलोनी गणनाओं की व्याख्या करता है क्योंकि:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;AD (942) और CD (786) इंगित करता है कि A, D और C पास हैं\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;AB (46) और BC (51) इंगित करता है कि B दूर है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;जीन B क्रम में अंतिम है।\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Inheritance Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a453102b304a00e31e93c8","title":"Inheritance Biology"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":13.211195928753186,"attempts":{"correct":47,"incorrect":18,"partial":0,"skipped":1114,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68954676ab662f534f48d226":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;B and C\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Gene imprinting refers to an epigenetic phenomenon where one allele of a gene is silenced depending on its parental origin.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026amp;quot;Maternally imprinted\u0026amp;quot; means the allele inherited from the mother is silenced, while \u0026amp;quot;paternally imprinted\u0026amp;quot; means the allele inherited from the father is silenced.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;A loss-of-function mutation in gene X leads to a disorder in adults. The pedigree analysis helps us determine inheritance patterns based on imprinted genes and mutant alleles.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Individuals carrying the mutant allele are marked with a dot, while those showing the disorder are shaded. The disorder manifests only when the functional allele is silenced due to imprinting.\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement B (Correct):\u0026lt;/strong\u0026gt; Individual III.6 carries an imprinted allele. Since gene X is imprinted, the allele inherited from one parent is silenced depending on the parental origin. Based on the pedigree, individual III.6 carries the mutant allele and an imprinted functional allele, but does not show the disorder, confirming the presence of an imprinted allele.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement C (Correct):\u0026lt;/strong\u0026gt; If individuals III.4 (carrier) and III.5 (carrier) have a child, the probability that the child will carry at least one mutant allele is 0.75. This is calculated as follows:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Each parent has one mutant allele and one normal allele.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;The offspring can inherit combinations: mutant-mutant, mutant-normal, normal-mutant, or normal-normal.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Out of four possibilities, three scenarios involve inheriting at least one mutant allele, resulting in a probability of 0.75.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement A (Incorrect):\u0026lt;/strong\u0026gt; Gene X is maternally imprinted. Maternally imprinted means the allele inherited from the mother is silenced. However, based on the pedigree, the pattern suggests paternal imprinting, where the allele inherited from the father is silenced. Thus, this statement is incorrect.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement D (Incorrect):\u0026lt;/strong\u0026gt; If individuals III.4 and III.5 have a child, the probability that it will show the disorder is 0.75. This statement is incorrect because showing the disorder depends on both inheritance of the mutant allele and imprinting of the functional allele. If the functional allele inherited from the father is not imprinted, the disorder will not occur, making the probability lower than 0.75.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;B और C\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;।\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;जीन मुद्रांकन एक एपिजेनेटिक घटना को संदर्भित करता है जहाँ जीन के एक एलील को उसके पैतृक मूल के आधार पर मौन किया जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026amp;quot;मातृ रूप से मुद्रांकित\u0026amp;quot; का अर्थ है कि माँ से प्राप्त एलील को मौन किया जाता है, जबकि \u0026amp;quot;पितृ रूप से मुद्रांकित\u0026amp;quot; का अर्थ है कि पिता से प्राप्त एलील को मौन किया जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जीन X में कार्यक्षमता का नुकसान वयस्कों में एक विकार की ओर ले जाता है। वंशावली विश्लेषण हमें मुद्रांकित जीन और उत्परिवर्ती एलील के आधार पर वंशानुगत पैटर्न निर्धारित करने में मदद करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;उत्परिवर्ती एलील वाले व्यष्टियों को एक बिंदु से चिह्नित किया जाता है, जबकि विकार दिखाने वालों को छायांकित किया जाता है। विकार तभी प्रकट होता है जब मुद्रांकन के कारण क्रियात्मक एलील को मौन किया जाता है।\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन B (सही):\u0026lt;/strong\u0026gt; व्यष्टि III.6 एक मुद्रांकित एलील रखता है। चूँकि जीन X मुद्रांकित है, इसलिए एक माता-पिता से प्राप्त एलील को पैतृक मूल के आधार पर मौन किया जाता है। वंशावली के आधार पर, व्यष्टि III.6 उत्परिवर्ती एलील और एक मुद्रांकित क्रियात्मक एलील रखता है, लेकिन विकार नहीं दिखाता है, जो एक मुद्रांकित एलील की उपस्थिति की पुष्टि करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन C (सही):\u0026lt;/strong\u0026gt; यदि व्यष्टि III.4 (वाहक) और III.5 (वाहक) का एक बच्चा है, तो बच्चे में कम से कम एक उत्परिवर्ती एलील होने की संभावना 0.75 है। इसकी गणना इस प्रकार की जाती है:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;प्रत्येक माता-पिता के पास एक उत्परिवर्ती एलील और एक सामान्य एलील होता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;संतान उत्परिवर्ती-उत्परिवर्ती, उत्परिवर्ती-सामान्य, सामान्य-उत्परिवर्ती या सामान्य-सामान्य संयोजन प्राप्त कर सकती है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;चार संभावनाओं में से, तीन परिदृश्यों में कम से कम एक उत्परिवर्ती एलील प्राप्त करना शामिल है, जिसके परिणामस्वरूप 0.75 की संभावना होती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन A (गलत):\u0026lt;/strong\u0026gt; जीन X मातृ रूप से मुद्रांकित है। मातृ रूप से मुद्रांकित का अर्थ है कि माँ से प्राप्त एलील को मौन किया जाता है। हालाँकि, वंशावली के आधार पर, पैटर्न पितृ मुद्रांकन का सुझाव देता है, जहाँ पिता से प्राप्त एलील को मौन किया जाता है। इस प्रकार, यह कथन गलत है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन D (गलत):\u0026lt;/strong\u0026gt; यदि व्यष्टि III.4 और III.5 का एक बच्चा है, तो इसके विकार दिखाने की संभावना 0.75 है। यह कथन गलत है क्योंकि विकार दिखाना उत्परिवर्ती एलील की विरासत और क्रियात्मक एलील के मुद्रांकन दोनों पर निर्भर करता है। यदि पिता से प्राप्त क्रियात्मक एलील मुद्रांकित नहीं है, तो विकार उत्पन्न नहीं होगा, जिससे संभावना 0.75 से कम हो जाएगी।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Inheritance Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a453102b304a00e31e93c8","title":"Inheritance Biology"},"t":{"id":"63a4533129660bb626fce529","title":"Human genetics"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":17.765903307888028,"attempts":{"correct":30,"incorrect":52,"partial":0,"skipped":1097,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689546cfa2471c5930459d09":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;B has the highest consumption efficiency, but C has the highest assimilation efficiency.\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Energy transfer in ecosystems involves the movement of energy through different trophic levels, starting from producers to herbivores and predators.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Key terms related to energy transfer efficiency include:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Consumption Efficiency:\u0026lt;/strong\u0026gt; The proportion of net primary productivity (NPP) ingested by herbivores.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Assimilation Efficiency:\u0026lt;/strong\u0026gt; The proportion of ingested energy that is assimilated (not lost to egestion).\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The efficiency values help in understanding the energy flow and trophic dynamics in ecosystems.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Consumption efficiency \u0026lt;/strong\u0026gt;is calculated as the percentage of NPP ingested. For herbivores A, B, and C, the respective values are: Hence, C has the highest consumption efficiency, not B.\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;A: (4000/10000) \u0026amp;times; 100 = 40%\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;B: (6000/10000) \u0026amp;times; 100 = 60%\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;C: (8000/10000) \u0026amp;times; 100 = 80%\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Assimilation efficiency\u0026lt;/strong\u0026gt; is calculated as the percentage of ingested energy that is assimilated (ingestion minus egestion). For herbivores A, B, and C, the respective values are: Hence, A and B have the highest assimilation efficiencies, not C.\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;A: [(4000 - 2000)/4000] \u0026amp;times; 100 = 50%\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;B: [(6000 - 3000)/6000] \u0026amp;times; 100 = 50%\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;C: [(8000 - 6000)/8000] \u0026amp;times; 100 = 25%\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;Therefore, the Option B is incorrect\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर है-\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;B में सबसे अधिक उपभोग दक्षता है, लेकिन C में सबसे अधिक स्वांगीकरण दक्षता है।\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;पारिस्थितिक तंत्रों में ऊर्जा अंतरण में उत्पादकों से लेकर शाकाहारियों और परभक्षियों तक विभिन्न पोषी स्तरों के माध्यम से ऊर्जा की गति शामिल है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;ऊर्जा अंतरण दक्षता से संबंधित प्रमुख शब्दों में शामिल हैं:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;उपभोग दक्षता:\u0026lt;/strong\u0026gt; शाकाहारियों द्वारा ग्रहण की गई शुद्ध प्राथमिक उत्पादकता (NPP) का अनुपात।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;स्वांगीकरण दक्षता:\u0026lt;/strong\u0026gt; ग्रहण की गई ऊर्जा का वह अनुपात जो स्वांगीकरण किया जाता है (उत्सर्जन के लिए नहीं खोया जाता है)।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;दक्षता मान पारिस्थितिक तंत्रों में ऊर्जा प्रवाह और ट्राफिक गतिशीलता को समझने में मदद करते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;उपभोग दक्षता\u0026lt;/strong\u0026gt; की गणना ग्रहण की गई NPP के प्रतिशत के रूप में की जाती है। शाकाहारियों A, B और C के लिए, संबंधित मान इस प्रकार हैं: इसलिए, C में सबसे अधिक उपभोग दक्षता है, B नहीं।\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;A: (4000/10000) x 100 = 40%\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;B: (6000/10000) x 100 = 60%\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;C: (8000/10000) x 100 = 80%\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;स्वांगीकरण दक्षता\u0026lt;/strong\u0026gt; की गणना ग्रहण की गई ऊर्जा के उस प्रतिशत के रूप में की जाती है जो स्वांगीकरण की जाती है (ग्रहण ऋण उत्सर्जन)। शाकाहारियों A, B और C के लिए, संबंधित मान इस प्रकार हैं: इसलिए, A और B में सबसे अधिक स्वांगीकरण दक्षताएँ हैं, C नहीं।\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;A: [(4000 - 2000)/4000] x 100 = 50%\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;B: [(6000 - 3000)/6000] x 100 = 50%\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;C: [(8000 - 6000)/8000] x 100 = 25%\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;इसलिए, विकल्प B गलत है।\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Ecological Principles"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a45541e89684161ccd7911","title":"Ecological Principles"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":16.117048346055963,"attempts":{"correct":51,"incorrect":51,"partial":0,"skipped":1077,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689547607ac09e469deebc87":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is\u0026amp;nbsp;\u0026lt;strong\u0026gt;A - (iii) B - (v) C - (iv) D - (vi) E - (vii)\u0026amp;nbsp;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;A - X-ray crystallography:\u0026lt;/strong\u0026gt; This technique is primarily used to determine the atomic and molecular structure of crystals. It uses X-ray diffraction (iii), which reveals the arrangement of atoms within a crystal by analyzing the pattern of X-rays scattered by the crystal lattice.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;B - NMR spectroscopy:\u0026lt;/strong\u0026gt; Nuclear Magnetic Resonance (NMR) spectroscopy measures chemical shifts (v). It is widely used for studying the structure, dynamics, and interactions of molecules, especially organic compounds, by analyzing the behavior of atomic nuclei in a magnetic field.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;C - Raman spectroscopy:\u0026lt;/strong\u0026gt; Raman spectroscopy measures wave numbers (iv) and provides information about vibrational, rotational, and other low-frequency modes in a system. It is often used in material science and chemistry to study molecular vibrations and bonding properties.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;D - CD spectroscopy:\u0026lt;/strong\u0026gt; Circular Dichroism (CD) spectroscopy measures ellipticity (vi). It is commonly used to study the secondary and tertiary structures of biomolecules like proteins and DNA by analyzing the differential absorption of left- and right-handed circularly polarized light.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;E - Colorimetry:\u0026lt;/strong\u0026gt; Colorimetry measures absorbance (vii). It is a technique used to determine the concentration of colored compounds in a solution by analyzing the intensity of light absorbed at a specific wavelength.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर\u0026amp;nbsp;\u0026lt;strong\u0026gt;A - (iii) B - (v) C - (iv) D - (vi) E - (vii)\u0026amp;nbsp;\u0026lt;/strong\u0026gt;है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;A - X-ray क्रिस्टलोग्राफी:\u0026lt;/strong\u0026gt; यह तकनीक मुख्य रूप से क्रिस्टल की परमाणु और आणविक संरचना निर्धारित करने के लिए उपयोग की जाती है। यह X-ray विवर्तन (iii) का उपयोग करती है, जो क्रिस्टल जालक द्वारा बिखरे हुए X-rays के पैटर्न का विश्लेषण करके क्रिस्टल के भीतर परमाणुओं की व्यवस्था को प्रकट करती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;B - NMR स्पेक्ट्रोस्कोपी:\u0026lt;/strong\u0026gt; न्यूक्लियर मैग्नेटिक रेजोनेंस (NMR) स्पेक्ट्रोस्कोपी रासायनिक शिफ्ट (v) को मापता है। इसका उपयोग चुंबकीय क्षेत्र में परमाणु केन्द्रकों के व्यवहार का विश्लेषण करके अणुओं, विशेष रूप से कार्बनिक यौगिकों की संरचना, गतिशीलता और अंतःक्रियाओं के अध्ययन के लिए व्यापक रूप से किया जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;C - रामन स्पेक्ट्रोस्कोपी:\u0026lt;/strong\u0026gt; रामन स्पेक्ट्रोस्कोपी तरंग संख्या (iv) को मापता है और किसी सिस्टम में कंपन, घूर्णन और अन्य निम्न-आवृत्ति मोड के बारे में जानकारी प्रदान करता है। यह अक्सर सामग्री विज्ञान और रसायन विज्ञान में आणविक कंपन और बंधन गुणों का अध्ययन करने के लिए उपयोग किया जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;D - CD स्पेक्ट्रोस्कोपी:\u0026lt;/strong\u0026gt; सर्कुलर डाइक्रोइज़्म (CD) स्पेक्ट्रोस्कोपी दीर्घवृत्ताकारता (vi) को मापता है। इसका उपयोग आमतौर पर प्रोटीन और DNA जैसे जैव-अणुओं की द्वितीयक और तृतीयक संरचनाओं का अध्ययन करने के लिए किया जाता है, इसके लिए बाएँ और दाएँ वृत्तीय ध्रुवीकृत प्रकाश के विभेदक अवशोषण का विश्लेषण किया जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;E - कलरीमेट्री:\u0026lt;/strong\u0026gt; कलरीमेट्री अवशोषण (vii) को मापता है। यह एक विशिष्ट तरंग दैर्ध्य पर अवशोषित प्रकाश की तीव्रता का विश्लेषण करके किसी घोल में रंगीन यौगिकों की सांद्रता निर्धारित करने के लिए उपयोग की जाने वाली एक तकनीक है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Methods in Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4566d978874fc5c7a0d11","title":"Methods in Biology"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":20.005089058524167,"attempts":{"correct":148,"incorrect":89,"partial":0,"skipped":942,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895478fef177aa03fbb2e86":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;C and D\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Steroid synthesis in adrenal cortical cells involves specialized enzymes that are compartmentalized within subcellular organelles. These enzymes play distinct roles in the biosynthesis of steroid hormones such as glucocorticoids, mineralocorticoids, and sex steroids.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The two main locations where steroid-synthesizing enzymes are localized in adrenal cortical cells are the mitochondria and the smooth endoplasmic reticulum (SER). Each enzyme\u0026amp;#39;s localization reflects its specific function in the steroidogenic pathway.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement C:\u0026lt;/strong\u0026gt; 11\u0026amp;beta;-Hydroxylase is present in the mitochondria.\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;11\u0026amp;beta;-Hydroxylase (encoded by CYP11B1) is a key mitochondrial enzyme involved in the synthesis of cortisol and aldosterone. It catalyzes the conversion of 11-deoxycortisol to cortisol and 11-deoxycorticosterone to corticosterone.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;The localization in the mitochondria is essential for its activity, as mitochondrial enzymes are closely associated with other steps of steroidogenesis such as cholesterol conversion to pregnenolone.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement D:\u0026lt;/strong\u0026gt; 21\u0026amp;beta;-Hydroxylase is present in the smooth endoplasmic reticulum.\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;21\u0026amp;beta;-Hydroxylase (encoded by CYP21A2) is a critical enzyme in the adrenal steroidogenic pathway. It catalyzes the hydroxylation of progesterone and 17-hydroxyprogesterone to produce 11-deoxycorticosterone and 11-deoxycortisol, respectively.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Its localization in the smooth endoplasmic reticulum (SER) is consistent with the role of SER in lipid and steroid metabolism.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//storage.googleapis.com/tb-img/production/24/03/F1_Teaching_Arbaz_5-3-24_D44.png\u0026quot; style=\u0026quot;color: rgb(33, 37, 41); width: 545px; height: 451px;\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage68acaa196580bfb8ebb1cd3b.png\u0026quot; style=\u0026quot;height: 275px; width: 450px;\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;C और D\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;अधिवृक्क कॉर्टिकल कोशिकाओं में स्टेरॉयड संश्लेषण में विशिष्ट एंजाइम शामिल होते हैं जो उपकोशिकीय कोशिकांग\u0026amp;nbsp;के भीतर कंपार्टमेंटलाइज्ड होते हैं। ये एंजाइम ग्लुकोकॉर्टिकोइड्स, मिनरलोकॉर्टिकोइड्स और सेक्स स्टेरॉयड जैसे स्टेरॉयड हार्मोन के जैव संश्लेषण में विशिष्ट भूमिका निभाते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;दो मुख्य स्थान जहाँ अधिवृक्क कॉर्टिकल कोशिकाओं में स्टेरॉयड-संश्लेषण एंजाइम स्थानीयकृत होते हैं, वे हैं माइटोकॉन्ड्रिया और चिकनी अन्तः प्रदव्ययी जलिका (SER)। प्रत्येक एंजाइम का स्थानीयकरण स्टेरॉयडोजेनिक मार्ग में इसके विशिष्ट कार्य को दर्शाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन C:\u0026lt;/strong\u0026gt; 11\u0026amp;beta;-हाइड्रॉक्सिलेज माइटोकॉन्ड्रिया में मौजूद है।\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;11\u0026amp;beta;-हाइड्रॉक्सिलेज (CYP11B1 द्वारा एन्कोडेड) कोर्टिसोल और एल्डोस्टेरोन के संश्लेषण में शामिल एक प्रमुख माइटोकॉन्ड्रियल एंजाइम है। यह 11-डीऑक्सीकोर्टिसोल को कोर्टिसोल और 11-डीऑक्सीकोर्टिकोस्टेरोन को कॉर्टिकोस्टेरोन में बदलने का उत्प्रेरण करता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;माइटोकॉन्ड्रिया में स्थानीयकरण इसकी गतिविधि के लिए आवश्यक है, क्योंकि माइटोकॉन्ड्रियल एंजाइम स्टेरॉयडोजेनेसिस के अन्य चरणों जैसे कोलेस्ट्रॉल के प्रीग्नेनोलोन में रूपांतरण के साथ निकटता से जुड़े हुए हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन D:\u0026lt;/strong\u0026gt; 21\u0026amp;beta;-हाइड्रॉक्सिलेज चिकनी अन्तः प्रदव्ययी जलिका में मौजूद है।\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;21\u0026amp;beta;-हाइड्रॉक्सिलेज (CYP21A2 द्वारा एन्कोडेड) अधिवृक्क स्टेरॉयडोजेनिक मार्ग में एक महत्वपूर्ण एंजाइम है। यह क्रमशः प्रोजेस्टेरोन और 17-हाइड्रॉक्सिप्रोजेस्टेरोन के हाइड्रॉक्सिलेशन को उत्प्रेरित करके 11-डीऑक्सीकोर्टिकोस्टेरोन और 11-डीऑक्सीकोर्टिसोल का उत्पादन करता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;चिकनी अन्तः प्रदव्ययी जलिका (SER) में इसका स्थानीयकरण SER की भूमिका के अनुरूप है जो लिपिड और स्टेरॉयड उपापचय में होती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//storage.googleapis.com/tb-img/production/24/03/F1_Teaching_Arbaz_5-3-24_D44.png\u0026quot; style=\u0026quot;color: rgb(33, 37, 41); width: 545px; height: 451px;\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage68acaa196580bfb8ebb1cd3b.png\u0026quot; style=\u0026quot;height: 275px; width: 450px;\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["System Physiology Animal"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a452e28f21ac91a2eba7a5","title":"System Physiology Animal"},"t":{"id":"63a4530b978874fc5c79d2e6","title":"Endocrinology and Reproduction"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":4.620016963528417,"attempts":{"correct":12,"incorrect":24,"partial":0,"skipped":1143,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689547a20cd2e93d3488e30f":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Devonian, Triassic, Ordovician, Permian\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Mass extinction events refer to significant and widespread losses of species across the planet in a relatively short geological time frame.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;These events are typically classified based on the percentage of species lost, their timing in Earth\u0026amp;#39;s history, and the causes that led to these extinctions.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The five major mass extinction events in Earth\u0026amp;#39;s history are the Ordovician, Devonian, Permian, Triassic, and Cretaceous mass extinctions, often referred to as the \u0026amp;quot;Big Five.\u0026amp;quot;\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The correct increasing order of percentage loss of species is Devonian, Triassic, Ordovician, and Permian.\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Devonian Extinction:\u0026lt;/strong\u0026gt; Occurred approximately 375\u0026amp;ndash;360 million years ago. It is estimated that around 19% of all families and 70% of all species went extinct. Primarily affected marine species, particularly reef builders.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Triassic Extinction:\u0026lt;/strong\u0026gt; Occurred approximately 201 million years ago. Around 23% of families and 76% of all species went extinct. This paved the way for the dominance of dinosaurs in the Jurassic period.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Ordovician Extinction:\u0026lt;/strong\u0026gt; Occurred around 444 million years ago. Approximately 27% of all families and 85% of all species were lost. This extinction is linked to severe climatic changes, such as glaciation and sea-level changes.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Permian Extinction:\u0026lt;/strong\u0026gt; Known as \u0026amp;quot;The Great Dying,\u0026amp;quot; it occurred about 252 million years ago. It is the largest mass extinction event, with 57% of families and 96% of all species going extinct. The causes include volcanic eruptions, climate changes, and ocean anoxia.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage68acab5efb24564f842070ec.png\u0026quot; style=\u0026quot;height: 336px; width: 450px;\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;em\u0026gt;Fig:\u0026amp;nbsp;Big Five Mass Extinctions. Source: \u0026lt;a href=\u0026quot;http://budcharles.deviantart.com\u0026quot;\u0026gt;budcharles.deviantart.com\u0026lt;/a\u0026gt;\u0026lt;/em\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;डेवोनियन, ट्राइएसिक, ऑर्डोविसियन, पर्मियन\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;सामूहिक विलुप्ति घटनाएँ अपेक्षाकृत कम भूवैज्ञानिक समय सीमा में ग्रह भर में प्रजातियों के महत्वपूर्ण और व्यापक नुकसान को संदर्भित करती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;ये घटनाएँ आमतौर पर खोई हुई प्रजातियों के प्रतिशत, पृथ्वी के इतिहास में उनके समय और इन विलुप्तियों के कारणों के आधार पर वर्गीकृत की जाती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;पृथ्वी के इतिहास में पाँच प्रमुख सामूहिक विलुप्ति घटनाएँ ऑर्डोविसियन, डेवोनियन, पर्मियन, ट्राइएसिक और क्रिटेशियस सामूहिक विलुप्ति हैं, जिन्हें अक्सर \u0026amp;quot;बिग फाइव\u0026amp;quot; के रूप में जाना जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;प्रजातियों के प्रतिशत नुकसान का सही बढ़ता क्रम डेवोनियन, ट्राइएसिक, ऑर्डोविसियन और पर्मियन है।\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;डेवोनियन विलुप्ति:\u0026lt;/strong\u0026gt; लगभग 375-360 मिलियन वर्ष पहले हुई थी। अनुमान है कि लगभग 19% सभी कुल और 70% सभी प्रजातियाँ विलुप्त हो गईं। मुख्य रूप से समुद्री प्रजातियों, विशेष रूप से रीफ बिल्डरों को प्रभावित किया।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;ट्राइएसिक विलुप्ति:\u0026lt;/strong\u0026gt; लगभग 201 मिलियन वर्ष पहले हुई थी। लगभग 23% कुल और 76% सभी प्रजातियाँ विलुप्त हो गईं। इसने जुरासिक काल में डायनासोर के प्रभुत्व का मार्ग प्रशस्त किया।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;ऑर्डोविसियन विलुप्ति:\u0026lt;/strong\u0026gt; लगभग 444 मिलियन वर्ष पहले हुई थी। लगभग 27% सभी कुल और 85% सभी प्रजातियाँ नष्ट हो गईं। यह विलुप्ति गंभीर जलवायु परिवर्तनों, जैसे कि हिमनद और समुद्र-स्तर में परिवर्तन से जुड़ी है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;पर्मियन विलुप्ति:\u0026lt;/strong\u0026gt; जिसे \u0026amp;quot;द ग्रेट डाइंग\u0026amp;quot; के रूप में जाना जाता है, यह लगभग 252 मिलियन वर्ष पहले हुई थी। यह सबसे बड़ी सामूहिक विलुप्ति घटना है, जिसमें 57% कुल और 96% सभी प्रजातियाँ विलुप्त हो गईं। इसके कारणों में ज्वालामुखी विस्फोट, जलवायु परिवर्तन और समुद्र एनोक्सिया शामिल हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage68acab5efb24564f842070ec.png\u0026quot; style=\u0026quot;height: 336px; width: 450px;\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;em\u0026gt;चित्र: बिग फाइव मास एक्सटिंक्शन। स्रोत: \u0026lt;a href=\u0026quot;http://budcharles.deviantart.com\u0026quot;\u0026gt;budcharles.deviantart.com\u0026lt;/a\u0026gt;\u0026lt;/em\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Evolution and Behavior"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4557fe52da32add2b08e9","title":"Evolution and Behavior"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":9.740458015267167,"attempts":{"correct":68,"incorrect":95,"partial":0,"skipped":1016,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689547bafc94ccd72abfe9db":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A and C\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;In early amphibian development, the ectodermal cells are influenced by the presence or absence of Bone Morphogenetic Protein 4 (BMP4) activity.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;When BMP4 activity is present, ectodermal cells are directed towards an epidermal ectoderm fate (non-neural tissues like skin).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In the absence of BMP4 activity, ectodermal cells adopt the neural ectoderm fate, giving rise to neural tissues like the brain and spinal cord.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;BMP inhibitors like noggin play a crucial role in promoting neural ectoderm development by dorsalizing the ectodermal cells and counteracting BMP4 activity.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The concept of \u0026amp;quot;default fate\u0026amp;quot; suggests that in the absence of external signaling (such as BMP4), ectodermal cells inherently become neural tissue, which is referred to as the \u0026amp;quot;default neural model.\u0026amp;quot;\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement A:\u0026lt;/strong\u0026gt; \u0026amp;quot;The default fate of the ectoderm is to become neural tissue.\u0026amp;quot;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;This is correct. In the absence of BMP4 signaling, ectodermal cells naturally become neural tissue. This is supported by experiments where BMP inhibitors like noggin dorsalize ectodermal cells to promote neural development.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement B:\u0026lt;/strong\u0026gt; \u0026amp;quot;Noggin mRNA will be depleted in lithium chloride treated gastrula.\u0026amp;quot;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;This is incorrect. Lithium chloride treatment typically enhances dorsalization by mimicking the Wnt pathway, which leads to increased expression of dorsalizing factors like noggin. Thus, noggin mRNA would likely increase, not deplete, in such treated gastrula.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement C:\u0026lt;/strong\u0026gt; \u0026amp;quot;Injection of noggin mRNA into UV-radiated embryos at 1-cell stage rescued dorsal development.\u0026amp;quot;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;This is correct. UV radiation disrupts dorsal development, leading to ventralized embryos. However, injection of noggin mRNA can rescue this by promoting the formation of dorsal structures, as noggin inhibits BMP4 activity and restores dorsalization.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Key Points:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The ectodermal cells\u0026amp;#39; fate is influenced by BMP4 signaling. BMP activity promotes epidermal ectoderm fate, while its inhibition promotes neural ectoderm fate.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Noggin is a BMP inhibitor that counteracts BMP4 activity, thereby dorsalizing the ectoderm and promoting neural development.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In the absence of BMP4, the \u0026amp;quot;default\u0026amp;quot; fate of ectodermal cells is to develop into neural tissue.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;UV radiation causes ventralization by disrupting dorsalizing signals, but noggin mRNA injection can restore dorsal development in such cases.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Other Options:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Option 1 (A only):\u0026lt;/strong\u0026gt; Incorrect because while statement A is correct, statement C is also correct, and this option does not consider statement C.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Option 2 (B only):\u0026lt;/strong\u0026gt; Incorrect because statement B is incorrect. Noggin mRNA is not depleted in lithium chloride treated gastrula.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Option 4 (B and C):\u0026lt;/strong\u0026gt; Incorrect because while statement C is correct, statement B is incorrect.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A और C\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;प्रारंभिक उभयचर विकास में, बहिर्जनस्तरीय कोशिकाएँ बोन मोर्फोजेनेटिक प्रोटीन 4 (BMP4) गतिविधि की उपस्थिति या अनुपस्थिति से प्रभावित होती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जब BMP4 गतिविधि मौजूद होती है, तो बहिर्जनस्तरीय कोशिकाओं को एपिडर्मल बाह्यत्वचा नियति (त्वचा जैसे गैर-तंत्रिका ऊतक) की ओर निर्देशित किया जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;BMP4 गतिविधि की अनुपस्थिति में, बहिर्जनस्तरीय कोशिकाएँ तंत्रिका बाह्यत्वचा नियति को अपनाती हैं, जिससे मस्तिष्क और स्पाइनल कॉर्ड जैसे तंत्रिका ऊतक बनते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;BMP अवरोधक जैसे नोगिन बहिर्जनस्तरीय कोशिकाओं को पृष्ठीय करके और BMP4 गतिविधि का प्रतिकार करके तंत्रिका बाह्यत्वचा विकास को बढ़ावा देने में महत्वपूर्ण भूमिका निभाते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026amp;quot;डिफ़ॉल्ट नियति\u0026amp;quot; की अवधारणा बताती है कि बाहरी संकेतन (जैसे BMP4) की अनुपस्थिति में, बहिर्जनस्तरीय कोशिकाएँ स्वाभाविक रूप से तंत्रिका ऊतक बन जाती हैं, जिसे \u0026amp;quot;डिफ़ॉल्ट तंत्रिका मॉडल\u0026amp;quot; कहा जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन A:\u0026lt;/strong\u0026gt; \u0026amp;quot;बाह्यत्वचा का डिफ़ॉल्ट नियति तंत्रिका ऊतक बनना है।\u0026amp;quot;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह सही है। BMP4 संकेतन की अनुपस्थिति में, बहिर्जनस्तरीय कोशिकाएँ स्वाभाविक रूप से तंत्रिका ऊतक बन जाती हैं। यह उन प्रयोगों द्वारा समर्थित है जहाँ BMP अवरोधक जैसे नोगिन तंत्रिका विकास को बढ़ावा देने के लिए बहिर्जनस्तरीय कोशिकाओं को पृष्ठीय बनाते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन B:\u0026lt;/strong\u0026gt; \u0026amp;quot;नोगिन mRNA लिथियम क्लोराइड से उपचारित गैस्ट्रुला में समाप्त हो जाएगा।\u0026amp;quot;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह गलत है। लिथियम क्लोराइड उपचार आमतौर पर Wnt मार्ग की नकल करके पृष्ठीयकरण को बढ़ाता है, जिससे नोगिन जैसे पृष्ठीय कारकों की अभिव्यक्ति में वृद्धि होती है। इस प्रकार, नोगिन mRNA इस तरह के उपचारित गैस्ट्रुला में संभवतः बढ़ेगा, समाप्त नहीं होगा।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन C:\u0026lt;/strong\u0026gt; \u0026amp;quot;1-कोशिका अवस्था में UV-विकिरणित भ्रूणों में नोगिन mRNA के इंजेक्शन ने पृष्ठीय विकास को बचाया।\u0026amp;quot;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह सही है। UV विकिरण पृष्ठीय विकास को बाधित करता है, जिससे उदरीय भ्रूण बनते हैं। हालांकि, नोगिन mRNA का इंजेक्शन पृष्ठीय संरचनाओं के निर्माण को बढ़ावा देकर इसे बचा सकता है, क्योंकि नोगिन BMP4 गतिविधि को रोकता है और पृष्ठीयकरण को पुनर्स्थापित करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;मुख्य बिंदु:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;बहिर्जनस्तरीय कोशिकाओं का नियति BMP4 संकेतन से प्रभावित होता है। BMP गतिविधि एपिडर्मल बाह्यत्वचा नियति को बढ़ावा देती है, जबकि इसके निषेध से तंत्रिका बाह्यत्वचा नियति को बढ़ावा मिलता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;नोगिन एक BMP अवरोधक है जो BMP4 गतिविधि का प्रतिकार करता है, जिससे बाह्यत्वचा को पृष्ठीय बनाया जाता है और तंत्रिका विकास को बढ़ावा मिलता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;BMP4 की अनुपस्थिति में, बहिर्जनस्तरीय कोशिकाओं का \u0026amp;quot;डिफ़ॉल्ट\u0026amp;quot; नियति तंत्रिका ऊतक में विकसित होना है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;UV विकिरण पृष्ठीय संकेतों को बाधित करके उदरीयकरण का कारण बनता है, लेकिन नोगिन mRNA इंजेक्शन ऐसे मामलों में पृष्ठीय विकास को बहाल कर सकता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;विकल्प 1 (केवल A):\u0026lt;/strong\u0026gt; गलत क्योंकि जबकि कथन A सही है, कथन C भी सही है, और यह विकल्प कथन C पर विचार नहीं करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;विकल्प 2 (केवल B):\u0026lt;/strong\u0026gt; गलत क्योंकि कथन B गलत है। नोगिन mRNA लिथियम क्लोराइड से उपचारित गैस्ट्रुला में समाप्त नहीं होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;विकल्प 4 (B और C):\u0026lt;/strong\u0026gt; गलत क्योंकि जबकि कथन C सही है, कथन B गलत है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Developmental Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4523f152a060341b327ed","title":"Developmental Biology"},"t":{"id":"63a452591af18910c978b122","title":"Morphogenesis and organogenesis in animals"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":8.802374893977943,"attempts":{"correct":41,"incorrect":29,"partial":0,"skipped":1109,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895480b674f60740fae3c90":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A - ii, B - i, C - iv, D - iii\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Insects have specialized sensory structures that help them perceive and process environmental information. These structures are associated with specific functions that allow insects to navigate, locate food, avoid predators, and reproduce.\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Dorsal rim area (A - ii): Polarization vision\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;The dorsal rim area in insects is a specialized part of the compound eye that detects polarized light. This capability helps insects navigate using the polarization pattern of sunlight in the sky, even on cloudy days.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Mushroom body (B - i): Learning and memory\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;The mushroom body is a key structure in the insect brain responsible for processing sensory information and is heavily involved in learning and memory. It integrates information from various sensory modalities to assist in decision-making and adaptive behaviors.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Antennal lobe (C - iv): Mechanosensation\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;The antennal lobe is the primary olfactory center in insects, but it also plays a role in mechanosensation, which involves the detection of mechanical stimuli such as touch, vibration, or air currents.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Central complex (D - iii): Motor control\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;The central complex is a brain structure involved in motor control and coordination. It plays a critical role in regulating locomotion and orientation during movement.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;A - ii, B - i, C - iv, D - iii\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026amp;nbsp;है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;कीटों में विशिष्ट संवेदी संरचनाएँ होती हैं जो उन्हें पर्यावरणीय जानकारी को समझने और संसाधित करने में मदद करती हैं। ये संरचनाएँ विशिष्ट कार्यों से जुड़ी होती हैं जो कीटों को नेविगेट करने, भोजन का पता लगाने, शिकारियों से बचने और प्रजनन करने में सहायता करती\u0026amp;nbsp;हैं।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;पृष्ठीय रिम क्षेत्र (A - ii): ध्रुवीकरण दृष्टि\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;कीटों में पृष्ठीय रिम क्षेत्र कंपाउंड आँख का एक विशिष्ट भाग है जो ध्रुवीकृत प्रकाश का पता लगाता है। यह क्षमता कीटों को बादलों के दिनों में भी, आकाश में सूर्य के प्रकाश के ध्रुवीकरण पैटर्न का उपयोग करके नेविगेट करने में मदद करती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;मशरूम काय (B - i): सीखना और स्मृति\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;मशरूम काय कीट के मस्तिष्क में एक प्रमुख संरचना है जो संवेदी जानकारी को संसाधित करने के लिए उत्तरदायी है और सीखने और स्मृति में बहुत अधिक शामिल है। यह निर्णय लेने और अनुकूली व्यवहार में सहायता के लिए विभिन्न संवेदी तौर-तरीकों से जानकारी को एकीकृत करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;ऐंटीना लोब (C - iv): यांत्रिक संवेदना\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;ऐंटीना लोब कीटों में प्राथमिक घ्राण केंद्र है, लेकिन यह यांत्रिक संवेदना में भी भूमिका निभाता है, जिसमें स्पर्श, कंपन या वायु धाराओं जैसे यांत्रिक उत्तेजनाओं का पता लगाना शामिल है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;केंद्रीय कॉम्प्लेक्स (D - iii): मोटर नियंत्रण\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;केंद्रीय कॉम्प्लेक्स मोटर नियंत्रण और समन्वय में शामिल एक मस्तिष्क संरचना है। यह गति के दौरान गति और अभिविन्यास को नियंत्रित करने में महत्वपूर्ण भूमिका निभाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Diversity of Life Forms"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a45511ef5b5403de57d744","title":"Diversity of Life Forms"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":11.765055131467346,"attempts":{"correct":52,"incorrect":80,"partial":0,"skipped":1047,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895483aef177aa03fbb30fb":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A \u0026amp;lt; B \u0026amp;lt; C \u0026amp;lt; D\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Species-abundance distributions describe how individuals of different species are distributed across an ecological community. The evenness in community structure reflects how evenly individuals are distributed among species.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Four niche-oriented models\u0026amp;mdash;Dominance-preemption, Random fraction, MacArthur fraction, and Dominance-decay\u0026amp;mdash;propose different mechanisms of niche division during community assembly by successive species invasion.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The evenness in community structure depends on the niche division mechanism, with more even distributions resulting in more equal representation of species.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;A \u0026amp;lt; B \u0026amp;lt; C \u0026amp;lt; D. This sequence represents the increasing order of evenness in community structure produced by the four models. Here\u0026amp;rsquo;s why:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Dominance-preemption model (A):\u0026lt;/strong\u0026gt; This model results in the least evenness because dominant species take over a large portion (50% or more) of the remaining niche space during each invasion. Subsequent species are left with smaller and smaller niches, leading to a highly uneven community structure.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Random fraction model (B):\u0026lt;/strong\u0026gt; This model introduces randomness in niche division. All species, irrespective of dominance, are subjected to niche division with equal probability. This leads to slightly higher evenness than the dominance-preemption model.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;MacArthur fraction model (C):\u0026lt;/strong\u0026gt; Larger niches are preferentially invaded by new species, which produces moderately even distributions compared to the Random fraction model. Species with larger niches tend to lose a portion of their space, balancing the community structure more effectively.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Dominance-decay model (D):\u0026lt;/strong\u0026gt; This model results in the highest evenness because the largest niche is always subject to subsequent random division. Over time, this leads to smaller differences in niche sizes among species, producing a more balanced community structure.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A \u0026amp;lt; B \u0026amp;lt; C \u0026amp;lt; D\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;प्रजातियों की प्रचुरता वितरण यह वर्णन करते हैं कि विभिन्न प्रजातियों के व्यक्ति एक पारिस्थितिक समुदाय में कैसे वितरित होते हैं। समुदाय संरचना में समता दर्शाती है कि प्रजातियों के बीच व्यक्ति कितने समान रूप से वितरित हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;चार आला-उन्मुख मॉडल-प्रभुत्व-पूर्वग्रहण, यादृच्छिक अंश, मैकार्थर अंश और प्रभुत्व-क्षय-क्रमिक प्रजातियों के आक्रमण द्वारा समुदाय संयोजन के दौरान आला विभाजन के विभिन्न तंत्रों का प्रस्ताव करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;समुदाय संरचना में समता आला विभाजन तंत्र पर निर्भर करती है, अधिक समान वितरण के परिणामस्वरूप प्रजातियों का अधिक समान प्रतिनिधित्व होता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;A \u0026amp;lt; B \u0026amp;lt; C \u0026amp;lt; D. यह क्रम चार मॉडलों द्वारा उत्पादित समुदाय संरचना में समता के बढ़ते क्रम का प्रतिनिधित्व करता है। यहाँ कारण दिया गया है:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;प्रभुत्व-पूर्वग्रहण मॉडल (A):\u0026lt;/strong\u0026gt; इस मॉडल के परिणामस्वरूप सबसे कम समता प्राप्त होती है क्योंकि प्रत्येक आक्रमण के दौरान प्रमुख प्रजातियाँ शेष निकेत स्थान के एक बड़े हिस्से (50% या अधिक) पर कब्ज़ा कर लेती हैं। बाद की प्रजातियों के पास छोटे-छोटे निकेत रह जाते हैं, जिससे समुदाय संरचना अत्यधिक असमान हो जाती है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;यादृच्छिक अंश मॉडल (B):\u0026lt;/strong\u0026gt; यह मॉडल आला विभाजन में यादृच्छिकता का परिचय देता है। सभी प्रजातियाँ, प्रभुत्व के बावजूद, समान संभावना के साथ आला विभाजन के अधीन हैं। इससे प्रभुत्व-पूर्वग्रहण मॉडल की तुलना में थोड़ी अधिक समता होती है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;मैकार्थर अंश मॉडल (C):\u0026lt;/strong\u0026gt; बड़े आलाओं में नई प्रजातियों द्वारा आक्रमण की संभावना अधिक होती है, जो यादृच्छिक अंश मॉडल की तुलना में मध्यम रूप से समान वितरण उत्पन्न करता है। बड़े आला वाली प्रजातियाँ अपने स्थान के एक हिस्से को खो देती हैं, जिससे समुदाय संरचना अधिक प्रभावी ढंग से संतुलित होती है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;प्रभुत्व-क्षय मॉडल (D):\u0026lt;/strong\u0026gt; यह मॉडल उच्चतम समता में परिणाम देता है क्योंकि सबसे बड़ा आला हमेशा बाद के यादृच्छिक विभाजन के अधीन होता है। समय के साथ, इससे प्रजातियों के बीच आला आकारों में छोटे अंतर होते हैं, जिससे अधिक संतुलित समुदाय संरचना बनती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Ecological Principles"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a45541e89684161ccd7911","title":"Ecological Principles"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":8.130619168787085,"attempts":{"correct":4,"incorrect":15,"partial":0,"skipped":1160,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689548550cd2e93d3488e637":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;200\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The polymerase chain reaction (PCR) is a technique used to amplify specific DNA sequences, exponentially increasing the number of copies of a target region.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;PCR involves three main steps: denaturation, annealing, and extension, which are repeated in cycles to amplify the DNA.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Each cycle doubles the number of DNA molecules, assuming 100% efficiency.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In the first few PCR cycles, the product includes both the desired target region and flanking sequences, but after the third cycle, double-stranded DNA molecules consisting of only the target region begin to accumulate.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Initial template:\u0026lt;/strong\u0026gt; The process begins with 100 double-stranded DNA (dsDNA) molecules, each containing the 200 bp target region along with flanking sequences.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;After the first cycle, the total number of dsDNA molecules becomes 200 (100 original + 100 new copies). However, none of these molecules consist solely of the target region at this point.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;After the second cycle, the total number of dsDNA molecules becomes 400. Among these, 200 are intermediate products containing the target region and flanking sequences, while the rest are copies of the original DNA.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;At the end of the third cycle, the total number of dsDNA molecules is 800. Among these, \u0026lt;strong\u0026gt;200 molecules consist of only the desired 200 bp target region\u0026lt;/strong\u0026gt;. This is because the third cycle is the first cycle where the target-only fragments begin to appear.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;The number of copies of the desired 200 bp fragment at the end of the third cycle is \u0026lt;strong\u0026gt;200\u0026lt;/strong\u0026gt;.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;The simplified formula for exact length products after \u0026amp;#39;n\u0026amp;#39; cycles, starting with \u0026amp;#39;N\u0026amp;#39; initial templates, is N x\u0026amp;nbsp;(2\u0026lt;sup\u0026gt;n\u0026lt;/sup\u0026gt;- 2n)\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;For N =100 and n =3\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;100 x (2\u0026lt;sup\u0026gt;3\u0026lt;/sup\u0026gt; - 2 x 3) = 100 x (8-6) = 100 x 2 = 200\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;200\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;पॉलीमरेज़ चेन रिएक्शन (PCR) एक तकनीक है जिसका उपयोग विशिष्ट DNA अनुक्रमों को प्रवर्धित करने के लिए किया जाता है, जिससे लक्ष्य क्षेत्र की प्रतियों की संख्या तेजी से बढ़ जाती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;PCR में तीन मुख्य चरण शामिल हैं: विकृतीकरण, एनीलिंग और दीर्घीकरण, जो DNA को प्रवर्धित करने के लिए चक्रों में दोहराए जाते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;100% दक्षता मानते हुए, प्रत्येक चक्र DNA अणुओं की संख्या को दोगुना कर देता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;पहले कुछ PCR चक्रों में, उत्पाद में वांछित लक्ष्य क्षेत्र और आस-पास के अनुक्रम दोनों शामिल होते हैं, लेकिन तीसरे चक्र के बाद, केवल लक्ष्य क्षेत्र वाले द्वी-रज्जुक DNA अणु जमा होना शुरू हो जाते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;प्रारंभिक टेम्पलेट:\u0026lt;/strong\u0026gt; यह प्रक्रिया 100 द्वी-रज्जुक DNA (dsDNA) अणुओं से शुरू होती है, जिनमें से प्रत्येक में आस-पास के अनुक्रमों के साथ 200 bp लक्ष्य क्षेत्र होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;पहले चक्र के बाद, dsDNA अणुओं की कुल संख्या 200 (100 मूल + 100 नई प्रतियाँ) हो जाती है। हालाँकि, इस समय इनमें से कोई भी अणु केवल लक्ष्य क्षेत्र से युक्त नहीं है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;दूसरे चक्र के बाद, dsDNA अणुओं की कुल संख्या 400 हो जाती है। इनमें से, 200 मध्यवर्ती उत्पाद हैं जिनमें लक्ष्य क्षेत्र और आस-पास के अनुक्रम शामिल हैं, जबकि बाकी मूल DNA की प्रतियाँ हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;तीसरे चक्र के अंत में, dsDNA अणुओं की कुल संख्या 800 है। इनमें से, \u0026lt;strong\u0026gt;200 अणुओं में केवल वांछित 200 bp लक्ष्य क्षेत्र होता है\u0026lt;/strong\u0026gt;। ऐसा इसलिए है क्योंकि तीसरा चक्र पहला चक्र है जहाँ लक्ष्य-केवल टुकड़े दिखाई देने लगते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;तीसरे चक्र के अंत में वांछित 200 bp खंड की प्रतियों की संख्या \u0026lt;strong\u0026gt;200\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;#39;n\u0026amp;#39; चक्रों के बाद सटीक लंबाई वाले उत्पादों के लिए सरलीकृत सूत्र, \u0026amp;#39;N\u0026amp;#39; प्रारंभिक टेम्पलेट से शुरू होकर, N x (2\u0026lt;sup\u0026gt;n\u0026lt;/sup\u0026gt;- 2n) है\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;N =100 और n =3 के लिए\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;100 x (2\u0026lt;sup\u0026gt;3\u0026lt;/sup\u0026gt; - 2 x 3) = 100 x (8-6) = 100 x 2 = 200\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Methods in Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4566d978874fc5c7a0d11","title":"Methods in Biology"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":10.748939779474137,"attempts":{"correct":51,"incorrect":61,"partial":0,"skipped":1067,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689548777ac09e469deec156":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"The correct answer is \u0026lt;strong\u0026gt;A ~ P; A \u0026amp;lt; Q; A \u0026amp;lt; R\u0026lt;/strong\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Thermal melting curves of proteins are used to analyze their thermostability by measuring the unfolding of proteins as a function of temperature.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Thermostability is indicated by the temperature at which a protein unfolds (melts) significantly, also known as the melting temperature (T\u0026lt;sub\u0026gt;m\u0026lt;/sub\u0026gt;).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;A higher melting temperature (T\u0026lt;sub\u0026gt;m\u0026lt;/sub\u0026gt;) indicates greater thermostability, while a lower T\u0026lt;sub\u0026gt;m\u0026lt;/sub\u0026gt; indicates reduced thermostability.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The X-axis in the given graph represents temperature, and the Y-axis shows the concentration of unfolded protein. The steep increase in the curve indicates the temperature at which the protein unfolds.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;By observing the thermal melting curves:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Protein A and Protein P have similar melting temperatures (T\u0026lt;sub\u0026gt;m\u0026lt;/sub\u0026gt;), indicating that their thermostabilities are approximately equal (A ~ P).\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Protein Q has a higher melting temperature compared to Protein A, indicating that Protein Q is more thermostable than Protein A (A \u0026amp;lt; Q).\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Protein R has the highest melting temperature among the compared proteins, making it the most thermostable. Thus, Protein A is less thermostable than Protein R (A \u0026amp;lt; R).\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;A ~ P; A \u0026amp;lt; Q; A \u0026amp;lt; R\u0026amp;nbsp;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;है।\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;स्पष्टीकरण:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;प्रोटीन के तापीय गलनांक वक्रों का उपयोग तापमान के फलन के रूप में प्रोटीन के विकास को मापकर उनकी तापस्थिरता का विश्लेषण करने के लिए किया जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;तापस्थिरता उस तापमान से इंगित होती है जिस पर एक प्रोटीन महत्वपूर्ण रूप से विकसित होता है, जिसे गलनांक (T\u0026lt;sub\u0026gt;m\u0026lt;/sub\u0026gt;) भी कहा जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;उच्च गलनांक (T\u0026lt;sub\u0026gt;m\u0026lt;/sub\u0026gt;) अधिक तापस्थिरता को दर्शाता है, जबकि कम T\u0026lt;sub\u0026gt;m\u0026lt;/sub\u0026gt; कम तापस्थिरता को दर्शाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;दिए गए आरेख में X-अक्ष तापमान को दर्शाता है\u0026amp;nbsp;और Y-अक्ष विकसित प्रोटीन की सांद्रता को दर्शाता है। वक्र में तीव्र वृद्धि उस तापमान को दर्शाती है जिस पर प्रोटीन विकसित होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;तापीय गलनांक वक्रों का अवलोकन करने पर:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;प्रोटीन A और प्रोटीन P के गलनांक समान (T\u0026lt;sub\u0026gt;m\u0026lt;/sub\u0026gt;) हैं, जो दर्शाता है कि उनकी तापस्थिरताएँ लगभग बराबर (A ~ P) हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;प्रोटीन Q का गलनांक प्रोटीन A की तुलना में अधिक है, जो दर्शाता है कि प्रोटीन Q, प्रोटीन A की तुलना में अधिक तापस्थायी है (A \u0026amp;lt; Q)।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;तुलनात्मक प्रोटीनों में प्रोटीन R का गलनांक सर्वाधिक है, जिससे यह सबसे अधिक तापस्थायी है। इस प्रकार, प्रोटीन A, प्रोटीन R की तुलना में कम तापस्थायी है (A \u0026amp;lt; R)।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Biochemistry"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a45131905ad063f1a82ade","title":"Biochemistry"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":15.919423240033922,"attempts":{"correct":49,"incorrect":58,"partial":0,"skipped":1072,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68954899ef177aa03fbb331f":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A and B only\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;When a child injures their toe, the immune system initiates a series of events to detect and respond to the infection caused by pathogens, such as \u0026lt;i\u0026gt;Staphylococcus aureus\u0026lt;/i\u0026gt;.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The immune response involves both innate and adaptive immunity, with key players including macrophages, lymph nodes, high endothelial venules (HEVs), fibroblastic reticular cells, and lymphocytes like B and T cells.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement A: The pathogen is conveyed to draining lymph nodes by macrophages.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is correct. Macrophages, which are part of the innate immune system, play a crucial role in phagocytosing pathogens like \u0026lt;i\u0026gt;Staphylococcus aureus\u0026lt;/i\u0026gt;.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;After engulfing the pathogen, macrophages migrate to the draining lymph nodes, where they present antigens to naive T cells, activating the adaptive immune response.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement B: Danger signals are conveyed to high endothelial venules of draining lymph nodes through the fibroblastic reticular conduit system.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is also correct. Fibroblastic reticular cells (FRCs) form a conduit system in lymph nodes, which helps transport immune signals, including danger signals like cytokines and chemokines.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;These signals can guide immune cells, such as naive lymphocytes, to high endothelial venules (HEVs), facilitating their entry into lymph nodes and their role in the immune response.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement C: Naive B cells and T cells enter draining lymph nodes from high endothelial venules by a process that is initiated by ICAM-1-mediated rolling.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is incorrect. The entry of naive B and T cells into lymph nodes via HEVs is mediated by a multi-step process involving rolling, adhesion, and diapedesis.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Rolling is primarily facilitated by selectins (such as L-selectin) and their ligands, not ICAM-1. ICAM-1 (Intercellular Adhesion Molecule-1) plays a role in later stages, such as firm adhesion and transmigration, but not rolling.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement D: Naive B cells exit circulation at the site of injury and undergo clonal expansion in response to bacterial LPS.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is incorrect. Naive B cells do not exit the circulation at the site of injury. Instead, they remain in secondary lymphoid organs, such as lymph nodes, where they encounter antigens.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Clonal expansion of B cells occurs in the lymph nodes after they are activated by specific antigens and signals from helper T cells, not directly in response to bacterial lipopolysaccharide (LPS).\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;केवल A और B\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;जब एक बच्चे के पैर के अंगूठे में चोट लगती है, तो प्रतिरक्षा तंत्र रोगजनकों, जैसे \u0026lt;i\u0026gt;स्टाफीलोकोकस ऑरीअस\u0026lt;/i\u0026gt; के कारण होने वाले संक्रमण का पता लगाने और उसका जवाब देने के लिए घटनाओं की एक शृंखला शुरू करता\u0026amp;nbsp;है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;प्रतिरक्षा प्रतिक्रिया में जन्मजात और अनुकूली प्रतिरक्षा दोनों शामिल हैं, जिसमें प्रमुख खिलाड़ी मैक्रोफेज, लिम्फ नोड्स, उच्च एंडोथेलियल वेन्यूल्स (HEVs), फाइब्रोब्लास्टिक रेटिकुलर कोशिकाएँ और लिम्फोसाइट्स जैसे B और T कोशिकाएँ शामिल हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन A: रोगज़नक़ मैक्रोफेज द्वारा जल निकास लिम्फ नोड्स तक पहुँचाया जाता है।\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह सही है। मैक्रोफेज, जो जन्मजात प्रतिरक्षा प्रणाली का हिस्सा हैं, \u0026lt;i\u0026gt;स्टाफीलोकोकस ऑरीअस\u0026lt;/i\u0026gt; जैसे रोगजनकों के फागोसाइटोसिस में महत्वपूर्ण भूमिका निभाते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;रोगज़नक़ को निगलने के बाद, मैक्रोफेज जल निकास लिम्फ नोड्स में चले जाते हैं, जहाँ वे भोली T कोशिकाओं को एंटीजन प्रस्तुत करते हैं, जिससे अनुकूली प्रतिरक्षा प्रतिक्रिया सक्रिय होती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन B: खतरे के संकेत फाइब्रोब्लास्टिक रेटिकुलर कंड्यूट सिस्टम के माध्यम से जल निकास लिम्फ नोड्स के उच्च एंडोथेलियल वेन्यूल्स तक पहुँचाए जाते हैं।\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह भी सही है। फाइब्रोब्लास्टिक रेटिकुलर कोशिकाएँ (FRCs) लिम्फ नोड्स में एक कंड्यूट सिस्टम बनाती हैं, जो साइटोकिन्स और कीमोकिन्स जैसे खतरे के संकेतों को परिवहन करने में मदद करती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;ये संकेत प्रतिरक्षा कोशिकाओं, जैसे भोली लिम्फोसाइट्स, को उच्च एंडोथेलियल वेन्यूल्स (HEVs) तक ले जा सकते हैं, जिससे लिम्फ नोड्स में उनके प्रवेश और प्रतिरक्षा प्रतिक्रिया में उनकी भूमिका की सुविधा मिलती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन C: भोली B कोशिकाएँ और T कोशिकाएँ उच्च एंडोथेलियल वेन्यूल्स से जल निकास लिम्फ नोड्स में प्रवेश करती हैं, एक ऐसी प्रक्रिया द्वारा जो ICAM-1-मध्यस्थता रोलिंग द्वारा शुरू की जाती है।\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन गलत है। HEVs के माध्यम से लिम्फ नोड्स में भोली B और T कोशिकाओं का प्रवेश एक बहु-चरणीय प्रक्रिया द्वारा मध्यस्थता किया जाता है जिसमें रोलिंग, आसंजन और डायपेडेसिस शामिल हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;रोलिंग मुख्य रूप से सेलेक्टिन्स (जैसे L-सेलेक्टिन) और उनके लिगैंड्स द्वारा सुगम होता है, न कि ICAM-1 द्वारा। ICAM-1 (इंटरसेल्युलर एडहेसन मॉलिक्यूल-1) बाद के चरणों में भूमिका निभाता है, जैसे कि दृढ़ आसंजन और ट्रांसमाइग्रेशन, लेकिन रोलिंग में नहीं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन D: भोली B कोशिकाएँ चोट स्थल पर परिसंचरण से बाहर निकलती हैं और बैक्टीरियल LPS की प्रतिक्रिया में क्लोनल विस्तार से गुजरती हैं।\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन गलत है। भोली B कोशिकाएँ चोट स्थल पर परिसंचरण से बाहर नहीं निकलती हैं। इसके बजाय, वे माध्यमिक लिम्फोइड अंगों, जैसे लिम्फ नोड्स में रहते हैं, जहाँ वे एंटीजन का सामना करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;B कोशिकाओं का क्लोनल विस्तार लिम्फ नोड्स में होता है, जब वे विशिष्ट एंटीजन और सहायक T कोशिकाओं से संकेतों द्वारा सक्रिय हो जाते हैं, न कि सीधे बैक्टीरियल लिपोपॉलीसेकेराइड (LPS) की प्रतिक्रिया में।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Cell Communication and Cell Signaling"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a451cdef5b5403de57a575","title":"Cell Communication and Cell Signaling"},"t":{"id":"63a452398916ea6dfa277c06","title":"Immune System"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":5.963528413910092,"attempts":{"correct":9,"incorrect":36,"partial":0,"skipped":1134,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689548cdcc49566a430dce07":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Overexpression of gene expressing enzyme X and knockout of gene expressing enzyme Y\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Lignin is an essential metabolite in plants, contributing to structural integrity and defense mechanisms.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The hypothetical metabolic pathway for lignin production involves three enzymes: X, Y, and Z, where enzyme Z is regulated by feedback inhibition.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Feedback inhibition is a regulatory mechanism wherein the end product of a pathway inhibits an earlier step, preventing overproduction of the product.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In this pathway, enhancing lignin production requires overcoming feedback inhibition while ensuring efficient substrate conversion.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Overexpression of enzyme X increases the initial substrate availability and drives the pathway forward.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Knocking out enzyme Y ensures that the intermediate metabolite is not diverted into alternative pathways, channeling it exclusively toward lignin production.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Since enzyme Z is regulated by feedback inhibition, removing competition from enzyme Y reduces the likelihood of excess intermediate accumulation that could trigger inhibition of enzyme Z.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This combined approach ensures maximum efficiency in lignin synthesis.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Overexpression of the genes expressing enzyme X:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;While overexpression of enzyme X increases substrate availability, it does not address the competition caused by enzyme Y or the feedback inhibition of enzyme Z.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Thus, this strategy alone will not yield the highest levels of lignin.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Knockout of the gene expressing enzyme Y:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Knocking out enzyme Y eliminates competition and ensures intermediates flow toward lignin production.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;However, without overexpression of enzyme X, the pathway may lack sufficient substrate to maximize lignin synthesis.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This strategy alone is insufficient for achieving the highest lignin levels.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Overexpression of the genes expressing enzymes X and Z:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Overexpressing enzyme X increases substrate availability, but overexpression of enzyme Z may not overcome its feedback inhibition.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Feedback inhibition ensures enzyme Z activity is regulated, preventing overproduction of lignin.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर है-\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;एंजाइम X को व्यक्त करने वाले जीन का अति-अभिव्यक्ति और एंजाइम Y को व्यक्त करने वाले जीन का नॉकआउट\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;लिंगिन पौधों में एक आवश्यक मेटाबोलाइट है, जो संरचनात्मक अखंडता और रक्षा तंत्र में योगदान देता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;लिंगिन उत्पादन के लिए काल्पनिक उपापचय मार्ग में तीन एंजाइम शामिल हैं: X, Y और Z, जहाँ एंजाइम Z प्रतिपुष्टि निषेध द्वारा नियंत्रित होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;प्रतिपुष्टि निषेध एक नियामक तंत्र है जिसमें एक मार्ग का अंतिम उत्पाद पहले चरण को रोकता है, उत्पाद के अति उत्पादन को रोकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इस मार्ग में, लिंगिन उत्पादन को बढ़ाने के लिए प्रतिपुष्टि निषेध पर काबू पाने की आवश्यकता होती है जबकि कुशल क्रियाधार रूपांतरण सुनिश्चित किया जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;एंजाइम X का अति-अभिव्यक्ति प्रारंभिक क्रियाधार उपलब्धता को बढ़ाता है और मार्ग को आगे बढ़ाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;एंजाइम Y को नॉक आउट करने से यह सुनिश्चित होता है कि मध्यवर्ती मेटाबोलाइट को वैकल्पिक मार्गों में नहीं मोड़ा जाता है, इसे विशेष रूप से लिंगिन उत्पादन की ओर निर्देशित किया जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;चूँकि एंजाइम Z प्रतिपुष्टि निषेध द्वारा नियंत्रित होता है, इसलिए एंजाइम Y से प्रतिस्पर्धा को दूर करने से अतिरिक्त मध्यवर्ती संचय की संभावना कम हो जाती है जो एंजाइम Z के निषेध को ट्रिगर कर सकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह संयुक्त दृष्टिकोण लिंगिन संश्लेषण में अधिकतम दक्षता सुनिश्चित करता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;एंजाइम X को व्यक्त करने वाले जीनों का अति-अभिव्यक्ति:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;जबकि एंजाइम X का अति-अभिव्यक्ति क्रियाधार उपलब्धता को बढ़ाता है, यह एंजाइम Y के कारण प्रतिस्पर्धा या एंजाइम Z के प्रतिपुष्टि निषेध को संबोधित नहीं करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इस प्रकार, यह रणनीति अकेले लिंगिन के उच्चतम स्तर नहीं देगी।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;एंजाइम Y को व्यक्त करने वाले जीन का नॉकआउट:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;एंजाइम Y को नॉक आउट करने से प्रतिस्पर्धा समाप्त हो जाती है और यह सुनिश्चित होता है कि मध्यवर्ती लिंगिन उत्पादन की ओर प्रवाहित होते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;हालांकि, एंजाइम X के अति-अभिव्यक्ति के बिना, मार्ग में लिंगिन संश्लेषण को अधिकतम करने के लिए पर्याप्त क्रियाधार का अभाव हो सकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह रणनीति अकेले उच्चतम लिंगिन स्तर प्राप्त करने के लिए अपर्याप्त है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;एंजाइम X और Z को व्यक्त करने वाले जीनों का अति-अभिव्यक्ति:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;एंजाइम X का अति-अभिव्यक्ति क्रियाधार उपलब्धता को बढ़ाता है, लेकिन एंजाइम Z का अति-अभिव्यक्ति इसके प्रतिपुष्टि निषेध पर काबू नहीं पा सकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;प्रतिपुष्टि निषेध सुनिश्चित करता है कि एंजाइम Z गतिविधि को नियंत्रित किया जाता है, लिंगिन के अति उत्पादन को रोकता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["System Physiology Plant"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4526f5db927c0ec7fb376","title":"System Physiology Plant"},"t":{"id":"63a45290ce3d67ae7cc6f198","title":"Secondary metabolites"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":9.234944868532642,"attempts":{"correct":69,"incorrect":35,"partial":0,"skipped":1075,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68954939c6cdfd92ecf7e3b9":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A - i, B - ii, C - iii, D - iv\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Antibiotics are chemical substances used to inhibit the growth of or kill bacteria. Many antibiotics achieve this by targeting bacterial protein synthesis, which is an essential process for bacterial survival and proliferation.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Bacterial protein synthesis occurs on ribosomes, and specific antibiotics target either the 30S or 50S subunits of bacterial ribosomes to disrupt translation.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;A - Erythromycin:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Erythromycin binds specifically to the 23S rRNA in the 50S ribosomal subunit of the bacterial ribosome.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This prevents the elongation of the peptide chain by blocking the exit tunnel through which newly synthesized polypeptides pass, effectively halting protein synthesis.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Thus, the correct match is \u0026lt;strong\u0026gt;A - i\u0026lt;/strong\u0026gt;.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;B - Chloramphenicol:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Chloramphenicol binds to the 50S ribosomal subunit and inhibits peptidyl transferase activity, which is crucial for the elongation of the peptide chain during translation.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;It prevents the addition of amino acids to the growing peptide chain, disrupting bacterial protein synthesis.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Thus, the correct match is \u0026lt;strong\u0026gt;B - ii\u0026lt;/strong\u0026gt;.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;C - Tetracycline:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Tetracycline binds to the 30S ribosomal subunit of the bacterial ribosome, specifically interfering with the binding of aminoacyl-tRNA to the A-site of the ribosome.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This action prevents the incorporation of new amino acids into the growing peptide chain, effectively inhibiting bacterial protein synthesis.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Thus, the correct match is \u0026lt;strong\u0026gt;C - iii\u0026lt;/strong\u0026gt;.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;D - Streptomycin:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Streptomycin binds to the 16S rRNA within the 30S ribosomal subunit, causing misreading of mRNA. This leads to the incorporation of incorrect amino acids into the polypeptide chain, resulting in nonfunctional or toxic proteins.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Additionally, it interferes with the initiation of protein synthesis.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Thus, the correct match is \u0026lt;strong\u0026gt;D - iv\u0026lt;/strong\u0026gt;.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A - i, B - ii, C - iii, D - iv\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;एंटीबायोटिक्स रासायनिक पदार्थ हैं जिनका उपयोग बैक्टीरिया के विकास को रोकने या उन्हें मारने के लिए किया जाता है। कई एंटीबायोटिक्स बैक्टीरिया के प्रोटीन संश्लेषण को लक्षित करके ऐसा करते हैं, जो बैक्टीरिया के जीवित रहने और प्रसार के लिए एक आवश्यक प्रक्रिया है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;बैक्टीरिया का प्रोटीन संश्लेषण राइबोसोम पर होता है, और विशिष्ट एंटीबायोटिक्स बैक्टीरिया के राइबोसोम के 30S या 50S उपएकक को स्थानांतरण को बाधित करने के लिए लक्षित करते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;A - एरिथ्रोमाइसिन:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;एरिथ्रोमाइसिन बैक्टीरिया के राइबोसोम के 50S राइबोसोमल उपएकक में 23S rRNA से विशेष रूप से जुड़ता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह पेप्टाइड शृंखला के बढ़ाव को अवरुद्ध करता है जिससे नए संश्लेषित पॉलीपेप्टाइड्स गुजरते हैं, जिससे प्रोटीन संश्लेषण प्रभावी रूप से रुक जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इस प्रकार, सही मिलान \u0026lt;strong\u0026gt;A - i\u0026lt;/strong\u0026gt; है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;B - क्लोराम्फेनिकॉल:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;क्लोराम्फेनिकॉल 50S राइबोसोमल उपएकक से जुड़ता है और पेप्टिडिल ट्रांसफेरेज़ गतिविधि को रोकता है, जो स्थानांतरण के दौरान पेप्टाइड शृंखला के बढ़ाव के लिए महत्वपूर्ण है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह बढ़ते पेप्टाइड शृंखला में अमीनो अम्ल के जुड़ाव को रोकता है, जिससे बैक्टीरिया का प्रोटीन संश्लेषण बाधित होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इस प्रकार, सही मिलान \u0026lt;strong\u0026gt;B - ii\u0026lt;/strong\u0026gt; है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;C - टेट्रासाइक्लिन:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;टेट्रासाइक्लिन बैक्टीरिया के राइबोसोम के 30S राइबोसोमल उपएकक से जुड़ता है, विशेष रूप से राइबोसोम के A-साइट पर एमिनोएसिल-tRNA के बंधन में हस्तक्षेप करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यह बढ़ते पेप्टाइड शृंखला में नए अमीनो अम्ल के समावेश को रोकता है, जिससे बैक्टीरिया का प्रोटीन संश्लेषण प्रभावी रूप से बाधित होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इस प्रकार, सही मिलान \u0026lt;strong\u0026gt;C - iii\u0026lt;/strong\u0026gt; है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;D - स्ट्रेप्टोमाइसिन:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;स्ट्रेप्टोमाइसिन 30S राइबोसोमल उपएकक के भीतर 16S rRNA से जुड़ता है, जिससे mRNA का गलत पढ़ना होता है। इससे पॉलीपेप्टाइड शृंखला में गलत अमीनो अम्ल का समावेश होता है, जिसके परिणामस्वरूप गैर-कार्यात्मक या विषाक्त प्रोटीन बनते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इसके अतिरिक्त, यह प्रोटीन संश्लेषण की शुरुआत में हस्तक्षेप करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इस प्रकार, सही मिलान \u0026lt;strong\u0026gt;D - iv\u0026lt;/strong\u0026gt; है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Fundamental Processes"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a451aec9ba648bc86fbf43","title":"Fundamental Processes"},"t":{"id":"63a451beef5b5403de57a495","title":"Protein synthesis and processing"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":12.468193384223927,"attempts":{"correct":75,"incorrect":84,"partial":0,"skipped":1020,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68954989a2471c593045aaea":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;C is an herbaceous plant and its stem is more likely to transmit vibrations more effectively when compared to plant species A and B which are woody.\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Plants can transmit vibrations through their stems, which some caterpillars use as a defensive mechanism to deter predators. These vibrations depend on the physical and mechanical properties of the plant stem.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;One important property is the \u0026lt;strong\u0026gt;Young\u0026amp;#39;s modulus\u0026lt;/strong\u0026gt;, which measures the stiffness of a material. A higher Young\u0026amp;#39;s modulus indicates a stiffer plant stem, which may not transmit vibrations as effectively as a less stiff stem.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The amplitude of vibrations and the latency to predator attack are key indicators of how effectively the defensive vibrations work.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The correct explanation is that plant species C is an herbaceous plant, which has the lowest Young\u0026amp;#39;s modulus (45 MPa) compared to species A (250 MPa) and B (110 MPa).\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;This lower stiffness allows vibrations to travel more effectively through the stem, but the vibration amplitude (0.7 \u0026amp;micro;m) generated by the caterpillar is lower, likely due to its structural properties.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Predators detect vibrations more easily on plant C, as reflected by the shortest latency to attack (1.3 seconds).\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In contrast, plant species A and B, which are likely woody plants with higher Young\u0026amp;#39;s modulus values, are stiffer and dissipate vibrational energy more quickly, reducing the effectiveness of the vibrations as a defense mechanism.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर है-\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;C एक शाकिय पौधा है और इसका तना पौधे की प्रजातियों A और B की तुलना में कंपन को अधिक प्रभावी ढंग से संचारित करने की अधिक संभावना है जो कि काष्ठीय हैं।\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;पौधे अपने तनों के माध्यम से कंपन संचारित कर सकते हैं, जिसका उपयोग कुछ इल्लियाँ शिकारियों को रोकने के लिए एक रक्षात्मक तंत्र के रूप में करती हैं। ये कंपन पौधे के तने के भौतिक और यांत्रिक गुणों पर निर्भर करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;एक महत्वपूर्ण गुण \u0026lt;strong\u0026gt;यंग मापांक\u0026lt;/strong\u0026gt; है, जो किसी पदार्थ की कठोरता को मापता है। एक उच्च यंग मापांक एक कठोर पौधे के तने को इंगित करता है, जो कम कठोर तने की तुलना में कंपन को उतनी प्रभावी ढंग से संचारित नहीं कर सकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;कंपन का आयाम और शिकारी हमले में विलंब रक्षात्मक कंपन कितने प्रभावी ढंग से काम करते हैं, इसके प्रमुख संकेतक हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;सही व्याख्या यह है कि पौधे की प्रजाति C एक शाकिय पौधा है, जिसका यंग मापांक (45 MPa) प्रजाति A (250 MPa) और B (110 MPa) की तुलना में सबसे कम है।\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह कम कठोरता कंपन को तने के माध्यम से अधिक प्रभावी ढंग से यात्रा संभव बनाती\u0026amp;nbsp;है, लेकिन इल्ली द्वारा उत्पन्न कंपन का आयाम (0.7 \u0026amp;micro;m) कम है, संभवतः इसके संरचनात्मक गुणों के कारण।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;शिकारी पौधे C पर कंपन का पता अधिक आसानी से लगा लेते हैं, जैसा कि हमले में सबसे कम विलंब (1.3 सेकंड) से पता चलता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इसके विपरीत, पौधे की प्रजातियाँ A और B, जो उच्च यंग मापांक मानों वाले काष्ठीय पौधे होने की संभावना है, अधिक कठोर हैं और कंपन ऊर्जा को अधिक तेज़ी से नष्ट कर देती हैं, जिससे रक्षात्मक तंत्र के रूप में कंपन की प्रभावशीलता कम हो जाती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Evolution and Behavior"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4557fe52da32add2b08e9","title":"Evolution and Behavior"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":5.351993214588624,"attempts":{"correct":15,"incorrect":18,"partial":0,"skipped":1146,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"6895499a0cd2e93d3488eca5":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;6195 kJ/mol\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;b\u0026gt;\u0026lt;u\u0026gt;Explanation:\u0026lt;/u\u0026gt;\u0026lt;/b\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The stability of an alpha helix is influenced by hydrogen bonding and peptide resonance stabilization.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Hydrogen bonds contribute to the stability of the helix by lowering the energy of the folded state. The number of hydrogen bonds in an alpha helix can be calculated based on the number of residues in the helix.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Peptide bonds exhibit resonance stabilization in their folded state. Upon unfolding, this stabilization is partially disrupted, leading to an energy cost per peptide bond.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The net energetic difference between the folded (alpha helix) and unfolded state is determined by the energy gained from hydrogen bonding and the energy lost from peptide resonance disruption.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Calculation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The alpha helix has 30 residues, which means there are 25 hydrogen bonds stabilizing the structure (as stated in the question).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The energy of each hydrogen bond is approximately 10 kJ/mol. Therefore, the total energy contributed by hydrogen bonding in the folded state is:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Energy from hydrogen bonds = 25 \u0026amp;times; 10 = 250 kJ/mol\u0026lt;/strong\u0026gt;\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Disruption in peptide resonance stabilization results in an energy loss of 205 kJ/mol per peptide bond upon unfolding. Since there are 30 residues, there are 29 peptide bonds (since the number of peptide bonds = number of residues - 1).\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Energy lost from peptide resonance disruption = 29 \u0026amp;times; 205 = 5945 kJ/mol\u0026lt;/strong\u0026gt;\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The net energetic difference between the folded and unfolded state is the sum of the energy lost from peptide resonance disruption and the energy gained from hydrogen bonding:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Net energetic difference = 5945 (resonance disruption) + 250 (hydrogen bonding) = 6195 kJ/mol\u0026lt;/strong\u0026gt;\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;6195 kJ/mol\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;b\u0026gt;\u0026lt;u\u0026gt;व्याख्या:\u0026lt;/u\u0026gt;\u0026lt;/b\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;एक अल्फा कुंडली की स्थिरता हाइड्रोजन बंधन और पेप्टाइड अनुनाद स्थिरीकरण से प्रभावित होती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;हाइड्रोजन बंध वलित अवस्था की ऊर्जा को कम करके कुंडली की स्थिरता में योगदान करते हैं। एक अल्फा कुंडली में हाइड्रोजन बंधों की संख्या कुंडली में अव्ययों की संख्या के आधार पर गणना की जा सकती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;पेप्टाइड बंध अपनी वलित अवस्था में अनुनाद स्थिरीकरण प्रदर्शित करते हैं। खोलने पर, यह स्थिरीकरण आंशिक रूप से बाधित हो जाता है, जिससे प्रति पेप्टाइड बंध ऊर्जा की लागत होती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;वलित (अल्फा कुंडली) और खुली हुई अवस्था के बीच शुद्ध ऊर्जावान अंतर हाइड्रोजन बंधन से प्राप्त ऊर्जा और पेप्टाइड अनुनाद व्यवधान से खोई हुई ऊर्जा द्वारा निर्धारित किया जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;गणना:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;अल्फा कुंडली में 30 अव्यय हैं, जिसका अर्थ है कि संरचना को स्थिर करने वाले 25 हाइड्रोजन बंध हैं (जैसा कि प्रश्न में बताया गया है)।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;प्रत्येक हाइड्रोजन बंध की ऊर्जा लगभग 10 kJ/mol है। इसलिए, वलित अवस्था में हाइड्रोजन बंधन द्वारा योगदान की गई कुल ऊर्जा है:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;हाइड्रोजन बंधों से ऊर्जा = 25 x 10 = 250 kJ/mol\u0026lt;/strong\u0026gt;\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;पेप्टाइड अनुनाद स्थिरीकरण में व्यवधान के परिणामस्वरूप खोलने पर प्रति पेप्टाइड बंध 205 kJ/mol की ऊर्जा का नुकसान होता है। चूँकि 30 अव्यय हैं, इसलिए 29 पेप्टाइड बंध हैं (चूँकि पेप्टाइड बंधों की संख्या = अव्ययों की संख्या - 1)।\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;पेप्टाइड अनुनाद व्यवधान से खोई हुई ऊर्जा = 29 x 205 = 5945 kJ/mol\u0026lt;/strong\u0026gt;\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;वलित और खुली हुई अवस्था के बीच शुद्ध ऊर्जावान अंतर पेप्टाइड अनुनाद व्यवधान से खोई हुई ऊर्जा और हाइड्रोजन बंधन से प्राप्त ऊर्जा का योग है:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;शुद्ध ऊर्जावान अंतर = 5945 (अनुनाद व्यवधान) + 250 (हाइड्रोजन बंधन) = 6195 kJ/mol\u0026lt;/strong\u0026gt;\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Biochemistry"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a45131905ad063f1a82ade","title":"Biochemistry"},"t":{"id":"63a45181fb84f8fa3aec21f3","title":"Stability of Proteins and Nucleic acids"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":3.363019508057676,"attempts":{"correct":5,"incorrect":14,"partial":0,"skipped":1160,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689549b7cc49566a430dd213":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;B and D only\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Tetrapod limb development is a complex process involving interactions between various signaling pathways. These pathways regulate the growth, patterning, and differentiation of limb structures.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Key signaling centers involved in limb development include the Zone of Polarizing Activity (ZPA), the Apical Ectodermal Ridge (AER), and the dorsal/ventral ectoderm.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Critical signaling molecules include Sonic hedgehog (Shh), Fibroblast growth factors (FGFs), and Wnt signaling proteins, which coordinate to ensure proper limb formation.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement B:\u0026lt;/strong\u0026gt; FGFs released by the AER activate Shh expression in the ZPA.\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is correct because FGFs secreted by the AER play a pivotal role in maintaining Shh expression in the ZPA. Shh is crucial for anterior-posterior patterning of the limb.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The interaction between FGFs and Shh creates a feedback loop that sustains the signaling required for limb development.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement D:\u0026lt;/strong\u0026gt; Overactivation of Wnt signaling in the ventral ectoderm causes an overgrowth of AER and formation of extra digits.\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is correct because Wnt signaling is a key regulator of AER formation and maintenance.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Overactivation of Wnt signaling in the ventral ectoderm can lead to excessive AER activity, resulting in abnormal limb outgrowth and polydactyly (extra digits).\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Incorrect Statements:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement A:\u0026lt;/strong\u0026gt; Shh released by the ZPA inhibits Fgf8 signaling in the AER.\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is incorrect. Shh does not inhibit Fgf8 signaling; rather, Shh and FGFs form a positive feedback loop to sustain their respective signaling centers (ZPA and AER). This coordination is essential for proper limb development.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement C:\u0026lt;/strong\u0026gt; Wnt7a expression in the dorsal ectoderm plays a role in limiting Shh expression in the ZPA.\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is incorrect. Wnt7a expression in the dorsal ectoderm is involved in dorsal-ventral patterning and does not directly limit Shh expression in the ZPA.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Instead, Wnt7a contributes to the activation of Lmx1b, a transcription factor responsible for dorsal limb identity.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;केवल B और D\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;चतुष्पाद अवयव विकास एक जटिल प्रक्रिया है जिसमें विभिन्न संकेतन पथों के बीच परस्पर क्रिया शामिल है। ये पथ अवयव संरचनाओं के विकास, प्रतिरूपण और विभेदन को नियंत्रित करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;अवयव विकास में शामिल प्रमुख संकेतन केंद्रों में ध्रुवीकरण गतिविधि का क्षेत्र (ZPA), शीर्ष एपिडर्मल रिज (AER), और पृष्ठीय/उदर एक्टोडर्म शामिल हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;महत्वपूर्ण संकेतन अणुओं में सोनिक हेजहोग (Shh), फाइब्रोब्लास्ट विकास कारक (FGFs), और Wnt संकेतन प्रोटीन शामिल हैं, जो उचित अवयव निर्माण सुनिश्चित करने के लिए समन्वय करते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन B:\u0026lt;/strong\u0026gt; AER द्वारा छोड़े गए FGFs, ZPA में Shh अभिव्यक्ति को सक्रिय करते हैं।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन सही है क्योंकि AER द्वारा स्रावित FGFs, ZPA में Shh अभिव्यक्ति को बनाए रखने में एक महत्वपूर्ण भूमिका निभाते हैं। Shh अवयव के पूर्वकाल-पश्च सिरे के प्रतिरूपण के लिए महत्वपूर्ण है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;FGFs और Shh के बीच परस्पर क्रिया एक प्रतिक्रिया पाश बनाती है जो अवयव विकास के लिए आवश्यक संकेतन को बनाए रखती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन D:\u0026lt;/strong\u0026gt; उदर एक्टोडर्म में Wnt संकेतन का अतिसक्रियण AER के अतिवृद्धि और अतिरिक्त अंगुलियों के निर्माण का कारण बनता है।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन सही है क्योंकि Wnt संकेतन AER के निर्माण और रखरखाव का एक प्रमुख नियामक है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;उदर एक्टोडर्म में Wnt संकेतन के अतिसक्रियण से अत्यधिक AER गतिविधि हो सकती है, जिसके परिणामस्वरूप असामान्य अवयव वृद्धि और पॉलीडेक्टिली (अतिरिक्त अंगुलियाँ) हो सकती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;गलत कथन:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन A:\u0026lt;/strong\u0026gt; ZPA द्वारा छोड़ा गया Shh, AER में Fgf8 संकेतन को रोकता है।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन गलत है। Shh Fgf8 संकेतन को रोकता नहीं है; बल्कि, Shh और FGFs अपने संबंधित संकेतन केंद्रों (ZPA और AER) को बनाए रखने के लिए एक सकारात्मक प्रतिक्रिया पाश बनाते हैं। यह समन्वय उचित अवयव विकास के लिए आवश्यक है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन C:\u0026lt;/strong\u0026gt; पृष्ठीय एक्टोडर्म में Wnt7a अभिव्यक्ति, ZPA में Shh अभिव्यक्ति को सीमित करने में भूमिका निभाता है।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन गलत है। पृष्ठीय एक्टोडर्म में Wnt7a अभिव्यक्ति पृष्ठीय-उदर प्रतिरूपण में शामिल है और ZPA में Shh अभिव्यक्ति को सीधे सीमित नहीं करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इसके बजाय, Wnt7a, Lmx1b के सक्रियण में योगदान करता है, जो पृष्ठीय अवयव पहचान के लिए उत्तरदायी एक अनुलेखन कारक है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Developmental Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4523f152a060341b327ed","title":"Developmental Biology"},"t":{"id":"63a452591af18910c978b122","title":"Morphogenesis and organogenesis in animals"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":7.148430873621724,"attempts":{"correct":14,"incorrect":39,"partial":0,"skipped":1126,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689549d1a2471c593045ab9b":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Designating a lectotype because the original material consisted of syntypes.\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Under the International Code of Nomenclature (ICN), the designation of types is crucial for stabilizing the names of organisms.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;A type specimen acts as the reference point for the application of a scientific name.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;If the original author of a name did not explicitly designate a single specimen (holotype), multiple specimens cited in the original description are referred to as syntypes.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In cases where syntypes exist, a taxonomist can select one of them as the lectotype to provide clarity and stabilize the name.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Lectotype designation:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;In the given scenario, the 19th-century phycologist cited three herbarium sheets (X, Y, and Z) but did not designate a holotype.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;These three sheets are syntypes because all were equally representative of the species in the absence of a holotype.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In 2024, the taxonomist selected sheet Z as the lectotype. A lectotype is chosen from the syntypes when no holotype was originally designated.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This ensures stability and clarity in the application of the name \u0026amp;quot;Nostoc arcus.\u0026amp;quot;\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Other Options:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Designating a neotype because the original material was not sufficient:\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;This is incorrect because neotype designation is done when no original material (holotype, syntypes, etc.) exists or is available.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;In this case, original material (syntypes) is available, so a neotype is not needed.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Designating a holotype because the best specimen is being chosen:\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;This is incorrect because a holotype can only be designated at the time of the original description of the species.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Since the phycologist did not designate a holotype, a lectotype is being chosen instead.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Designating an epitype because morphological details are clear:\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;This is incorrect because an epitype is designated to complement an existing type specimen when additional details (e.g., morphological or genetic) are needed for clarification.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;In this case, the taxonomist is selecting a lectotype from the original syntypes, not adding an epitype.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर है-\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;एक चयनप्ररूप नामित करना क्योंकि मूल सामग्री में सहप्ररुप शामिल थे।\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;अंतर्राष्ट्रीय नामकरण संहिता (ICN) के तहत, जीवों के नामों को स्थिर करने के लिए प्रकारों का नामकरण महत्वपूर्ण है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;एक प्रकार का नमूना वैज्ञानिक नाम के अनुप्रयोग के लिए संदर्भ बिंदु के रूप में कार्य करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;यदि किसी नाम के मूल लेखक ने स्पष्ट रूप से एक नमूना (होलोटाइप) नामित नहीं किया है, तो मूल विवरण में उद्धृत कई नमूनों को सहप्ररुप कहा जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;ऐसे मामलों में जहां सहप्ररुप मौजूद हैं, एक टैक्सोनॉमिस्ट उनमें से एक को चयनप्ररूप के रूप में चुन सकता है ताकि स्पष्टता प्रदान की जा सके और नाम को स्थिर किया जा सके।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;चयनप्ररूप नामकरण:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;दी गई स्थिति में, 19वीं सदी के फाइकोलॉजिस्ट ने तीन हर्बेरियम शीट्स (X, Y और Z) का उल्लेख किया लेकिन कोई होलोटाइप नामित नहीं किया।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;ये तीन शीट सहप्ररुप हैं क्योंकि होलोटाइप की अनुपस्थिति में सभी प्रजातियों के समान रूप से प्रतिनिधि थे।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;2024 में, टैक्सोनॉमिस्ट ने शीट Z को चयनप्ररूप के रूप में चुना। जब मूल रूप से कोई होलोटाइप नामित नहीं किया गया था, तो सहप्ररुप से एक चयनप्ररूप चुना जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इससे \u0026amp;quot;नॉस्टॉक आर्कस\u0026amp;quot; नाम के अनुप्रयोग में स्थिरता और स्पष्टता सुनिश्चित होती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;एक नवप्ररूप नामित करना क्योंकि मूल सामग्री पर्याप्त नहीं थी:\u0026lt;/strong\u0026gt;\n\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह गलत है क्योंकि नवप्ररूप नामकरण तब किया जाता है जब कोई मूल सामग्री (होलोटाइप, सहप्ररुप, आदि) मौजूद नहीं है या उपलब्ध नहीं है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;इस मामले में, मूल सामग्री (सहप्ररुप) उपलब्ध है, इसलिए एक नवप्ररूप की आवश्यकता नहीं है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;एक होलोटाइप नामित करना क्योंकि सबसे अच्छा नमूना चुना जा रहा है:\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह गलत है क्योंकि प्रजातियों के मूल विवरण के समय ही एक होलोटाइप नामित किया जा सकता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;चूँकि फाइकोलॉजिस्ट ने कोई होलोटाइप नामित नहीं किया था, इसलिए इसके बजाय एक चयनप्ररूप चुना जा रहा है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;एक एपिटाइप नामित करना क्योंकि रूपात्मक विवरण स्पष्ट हैं:\u0026lt;/strong\u0026gt;\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;यह गलत है क्योंकि एक एपिटाइप को मौजूदा प्रकार के नमूने के पूरक के रूप में नामित किया जाता है जब स्पष्टीकरण के लिए अतिरिक्त विवरण (जैसे, रूपात्मक या आनुवंशिक) की आवश्यकता होती है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;इस मामले में, टैक्सोनॉमिस्ट मूल सहप्ररुप से एक चयनप्ररूप का चयन कर रहा है, न कि कोई एपिटाइप जोड़ रहा है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Diversity of Life Forms"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a45511ef5b5403de57d744","title":"Diversity of Life Forms"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":6.630195080576762,"attempts":{"correct":24,"incorrect":42,"partial":0,"skipped":1113,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"689549e7cc49566a430dd3db":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;C and E only\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Mapping populations are crucial in genetic studies as they help identify genetic markers linked to specific traits in crop species. These populations are developed through specific breeding methods depending on the reproductive system of the crop species (self-pollinating or cross-pollinating).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Genetic mapping relies on the principle of linkage analysis, where markers close to a trait of interest are identified, enabling marker-assisted selection in crop improvement programs.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Breeding techniques like single-seed descent and pedigree selection are used to develop populations for genetic analysis, but they do not increase genetic variability as they work on selecting and fixing existing variation in the population.\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement A:\u0026lt;/strong\u0026gt; This statement is \u0026lt;strong\u0026gt;correct\u0026lt;/strong\u0026gt;. In self-pollinating species, both F2 populations and F1-derived doubled haploids (DHs) are commonly used as mapping populations. Self-pollinating species exhibit high levels of homozygosity, making these populations ideal for genetic mapping.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement B:\u0026lt;/strong\u0026gt; This statement is \u0026lt;strong\u0026gt;correct\u0026lt;/strong\u0026gt;. In cross-pollinating species, F1 populations can be used for genetic mapping because they exhibit high heterozygosity, allowing the segregation of traits and the identification of genetic linkages.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement C:\u0026lt;/strong\u0026gt; This statement is \u0026lt;strong\u0026gt;incorrect\u0026lt;/strong\u0026gt;. Bulk segregant analysis (BSA) is often used to identify linked markers for traits governed by a single major gene rather than complex traits involving multiple genes and environmental influences. BSA involves pooling individuals with contrasting phenotypes to identify markers linked to the trait of interest.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement D:\u0026lt;/strong\u0026gt; This statement is \u0026lt;strong\u0026gt;correct\u0026lt;/strong\u0026gt;. Sets of different breeding lines, such as recombinant inbred lines (RILs) or advanced backcross lines (ABLs), can be used for mapping traits in crop plants. These populations are highly valuable for identifying quantitative trait loci (QTLs) and dissecting complex traits.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Statement E:\u0026lt;/strong\u0026gt; This statement is \u0026lt;strong\u0026gt;incorrect\u0026lt;/strong\u0026gt;. Breeding methods like single-seed descent and pedigree selection are used for fixing genetic variability in segregating populations, not promoting genetic variability. These methods aim to stabilize genetic lines for further analysis or breeding purposes.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;केवल C और E\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;मानचित्रण आबादी आनुवंशिक अध्ययन में महत्वपूर्ण हैं क्योंकि वे फसल प्रजातियों में विशिष्ट लक्षणों से जुड़े आनुवंशिक चिन्हकों की पहचान करने में मदद करते हैं। ये आबादी फसल प्रजातियों की प्रजनन तंत्र (स्व-परागण या पर-परागण) के आधार पर विशिष्ट प्रजनन विधियों के माध्यम से विकसित की जाती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;आनुवंशिक मानचित्रण संबंध विश्लेषण के सिद्धांत पर निर्भर करता है, जहाँ रुचि के लक्षण के करीब चिन्हकों की पहचान की जाती है, जिससे फसल सुधार कार्यक्रमों में चिन्हक-सहायता प्राप्त चयन सक्षम होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;एकल-बीज वंश और वंशावली चयन जैसी प्रजनन तकनीकों का उपयोग आनुवंशिक विश्लेषण के लिए आबादी विकसित करने के लिए किया जाता है, लेकिन वे आनुवंशिक परिवर्तनशीलता में वृद्धि नहीं करते हैं क्योंकि वे आबादी में मौजूदा भिन्नता का चयन और निर्धारण करने पर काम करते हैं।\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन A:\u0026lt;/strong\u0026gt; यह कथन \u0026lt;strong\u0026gt;सही\u0026lt;/strong\u0026gt; है। स्व-परागण प्रजातियों में, F2 आबादी और F1-व्युत्पन्न दोगुने हैप्लॉइड (DHs) दोनों आमतौर पर मानचित्रण आबादी के रूप में उपयोग किए जाते हैं। स्व-परागण प्रजातियाँ उच्च स्तर की समयुग्मता प्रदर्शित करती हैं, जिससे ये आबादी आनुवंशिक मानचित्रण के लिए आदर्श होती हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन B:\u0026lt;/strong\u0026gt; यह कथन \u0026lt;strong\u0026gt;सही\u0026lt;/strong\u0026gt; है। क्रॉस-परागण प्रजातियों में, आनुवंशिक मानचित्रण के लिए F1 आबादी का उपयोग किया जा सकता है क्योंकि वे उच्च विषमयुग्मता प्रदर्शित करते हैं, जिससे लक्षणों का पृथक्करण और आनुवंशिक संबंधों की पहचान होती है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन C:\u0026lt;/strong\u0026gt; यह कथन \u0026lt;strong\u0026gt;गलत\u0026lt;/strong\u0026gt; है। बल्क सेग्रीगेंट विश्लेषण (BSA) का उपयोग अक्सर एकल प्रमुख जीन द्वारा नियंत्रित लक्षणों के लिए जुड़े चिन्हकों की पहचान करने के लिए किया जाता है, न कि कई जीनों और पर्यावरणीय प्रभावों वाले जटिल लक्षणों के लिए। BSA में विपरीत फेनोटाइप वाले व्यक्तियों को एक साथ मिलाकर रुचि के लक्षण से जुड़े चिन्हकों की पहचान करना शामिल है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन D:\u0026lt;/strong\u0026gt; यह कथन \u0026lt;strong\u0026gt;सही\u0026lt;/strong\u0026gt; है। पुनर्संयोजक इनब्रेड लाइन्स (RILs) या उन्नत बैकक्रॉस लाइन्स (ABLs) जैसी विभिन्न प्रजनन लाइनों के सेट का उपयोग फसल पौधों में लक्षणों के मानचित्रण के लिए किया जा सकता है। ये आबादी मात्रात्मक लक्षण लोकी (QTLs) की पहचान करने और जटिल लक्षणों को विच्छेदित करने के लिए अत्यधिक मूल्यवान हैं।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;कथन E:\u0026lt;/strong\u0026gt; यह कथन \u0026lt;strong\u0026gt;गलत\u0026lt;/strong\u0026gt; है। एकल-बीज वंश और वंशावली चयन जैसी प्रजनन विधियों का उपयोग पृथक्करण आबादी में आनुवंशिक परिवर्तनशीलता को स्थिर करने के लिए किया जाता है, न कि आनुवंशिक परिवर्तनशीलता को बढ़ावा देने के लिए। इन विधियों का उद्देश्य आगे के विश्लेषण या प्रजनन उद्देश्यों के लिए आनुवंशिक लाइनों को स्थिर करना है।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Applied Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a455cbce3d67ae7cc72e05","title":"Applied Biology"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":5.828668363019506,"attempts":{"correct":8,"incorrect":26,"partial":0,"skipped":1145,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68954a1dda7d16ef574c8082":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is\u0026amp;nbsp;\u0026lt;strong\u0026gt;P = (V-C)/2, Q = V, R = 0, S = (V/2)\u0026amp;nbsp;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The Hawk-Dove game is a fundamental model in evolutionary game theory used to study conflict resolution between individuals competing for a resource. Players can adopt one of two strategies: Hawk (aggressive) or Dove (peaceful).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In this game, the value of the resource (denoted as \u0026lt;strong\u0026gt;V\u0026lt;/strong\u0026gt;) and the cost of engaging in a fight (denoted as \u0026lt;strong\u0026gt;C\u0026lt;/strong\u0026gt;) determine the payoffs for different interactions.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The payoff matrix considers four possible outcomes: Hawk vs. Hawk, Hawk vs. Dove, Dove vs. Hawk, and Dove vs. Dove.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The payoffs are calculated based on the costs and benefits associated with each interaction.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;In this scenario, the payoffs are correctly represented as:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;P = (V-C)/2:\u0026lt;/strong\u0026gt; When two Hawks meet, they split the value of the resource after fighting, but the cost of the fight reduces the payoff.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Q = V:\u0026lt;/strong\u0026gt; When a Hawk encounters a Dove, the Hawk wins the resource entirely without any fight or cost.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;R = 0:\u0026lt;/strong\u0026gt; When a Dove meets a Hawk, the Dove backs down and receives no payoff.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;S = (V/2):\u0026lt;/strong\u0026gt; When two Doves meet, they share the resource peacefully, splitting its value equally.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;Option 2 accurately represents the underlying dynamics of the Hawk-Dove game based on the definitions of \u0026lt;strong\u0026gt;V\u0026lt;/strong\u0026gt; (value of the resource) and \u0026lt;strong\u0026gt;C\u0026lt;/strong\u0026gt; (cost of fighting).\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;nbsp;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर\u0026amp;nbsp;\u0026lt;strong\u0026gt;P = (V-C)/2, Q = V, R = 0, S = (V/2)\u0026amp;nbsp;\u0026lt;/strong\u0026gt;\u0026amp;nbsp;है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;हॉक-डव गेम विकासवादी खेल सिद्धांत में एक मौलिक मॉडल है जिसका उपयोग किसी संसाधन के लिए प्रतिस्पर्धा करने वाले व्यक्तियों के बीच संघर्ष समाधान का अध्ययन करने के लिए किया जाता है। खिलाड़ी दो रणनीतियों में से एक को अपना सकते हैं: हॉक (आक्रामक) या डव (शांतिपूर्ण).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इस गेम में, संसाधन का मान (\u0026lt;strong\u0026gt;V\u0026lt;/strong\u0026gt; के रूप में दर्शाया गया है) और लड़ाई में शामिल होने की लागत (\u0026lt;strong\u0026gt;C\u0026lt;/strong\u0026gt; के रूप में दर्शाया गया है) विभिन्न अंतःक्रियाओं के लिए भुगतान निर्धारित करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;भुगतान मैट्रिक्स चार संभावित परिणामों पर विचार करता है: हॉक बनाम हॉक, हॉक बनाम डव, डव बनाम हॉक और डव बनाम डव।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;भुगतान प्रत्येक अंतःक्रिया से जुड़ी लागतों और लाभों के आधार पर गणना किए जाते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इस परिदृश्य में, भुगतान को सही ढंग से इस प्रकार दर्शाया गया है:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;P = (V-C)/2:\u0026lt;/strong\u0026gt; जब दो हॉक मिलते हैं, तो वे लड़ाई के बाद संसाधन के मूल्य को विभाजित करते हैं, लेकिन लड़ाई की लागत भुगतान को कम कर देती है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Q = V:\u0026lt;/strong\u0026gt; जब एक हॉक एक डव से मिलता है, तो हॉक बिना किसी लड़ाई या लागत के संसाधन को पूरी तरह से जीत लेता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;R = 0:\u0026lt;/strong\u0026gt; जब एक डव एक हॉक से मिलता है, तो डव पीछे हट जाता है और उसे कोई भुगतान नहीं मिलता है।\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;S = (V/2):\u0026lt;/strong\u0026gt; जब दो डव मिलते हैं, तो वे शांतिपूर्वक संसाधन को साझा करते हैं, इसके मूल्य को समान रूप से विभाजित करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;विकल्प 2 \u0026lt;strong\u0026gt;V\u0026lt;/strong\u0026gt; (संसाधन का मान) और \u0026lt;strong\u0026gt;C\u0026lt;/strong\u0026gt; (लड़ाई की लागत) की परिभाषाओं के आधार पर हॉक-डव गेम की अंतर्निहित गतिशीलता का सही ढंग से प्रतिनिधित्व करता है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026amp;nbsp;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Evolution and Behavior"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4557fe52da32add2b08e9","title":"Evolution and Behavior"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":5.902459711620019,"attempts":{"correct":10,"incorrect":13,"partial":0,"skipped":1156,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68954a7b183f51898b41e198":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;2.0 \u0026amp;times; 10\u0026lt;sup\u0026gt;7\u0026lt;/sup\u0026gt; min\u0026lt;sup\u0026gt;-1\u0026lt;/sup\u0026gt; to 2.1 \u0026amp;times; 10\u0026lt;sup\u0026gt;7\u0026lt;/sup\u0026gt; min\u0026lt;sup\u0026gt;-1\u0026lt;/sup\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;.\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;b\u0026gt;\u0026lt;u\u0026gt;Explanation:\u0026lt;/u\u0026gt;\u0026lt;/b\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Turnover number (k\u0026lt;sub\u0026gt;cat\u0026lt;/sub\u0026gt;)\u0026amp;nbsp;\u0026lt;/strong\u0026gt;is a measure of the catalytic activity of an enzyme. It represents the number of substrate molecules converted into product by one enzyme molecule per unit time under conditions of saturation (at V\u0026lt;sub\u0026gt;max\u0026lt;/sub\u0026gt;).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The formula to calculate k\u0026lt;sub\u0026gt;cat\u0026lt;/sub\u0026gt; is\u0026amp;nbsp;\u0026lt;strong\u0026gt;k\u0026lt;sub\u0026gt;cat\u0026lt;/sub\u0026gt; = V\u0026lt;sub\u0026gt;max\u0026lt;/sub\u0026gt; / [E]\u0026lt;/strong\u0026gt;,\u0026lt;br /\u0026gt;\n\twhere V\u0026lt;sub\u0026gt;max\u0026lt;/sub\u0026gt; is the maximum rate of reaction, and [E] is the enzyme concentration in moles.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The molecular weight (M\u0026lt;sub\u0026gt;r\u0026lt;/sub\u0026gt;) of carbonic anhydrase is given as 30,000, which means 1 mole of the enzyme weighs 30,000 g.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Given data:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;Mass of enzyme = 10 \u0026amp;micro;g = 10 \u0026amp;times; 10\u0026lt;sup\u0026gt;-6\u0026lt;/sup\u0026gt; g.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Mass of CO\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt; hydrated = 0.30 g.\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;Reaction time = 1 min.\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Calculation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;The number of moles of the enzyme:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;[E] = Mass of enzyme / M\u0026lt;sub\u0026gt;r\u0026lt;/sub\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;[E] = (10 \u0026amp;times; 10\u0026lt;sup\u0026gt;-6\u0026lt;/sup\u0026gt; g) / (30,000 g/mol) = 3.33 \u0026amp;times; 10\u0026lt;sup\u0026gt;-10\u0026lt;/sup\u0026gt; mol.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;The number of moles of CO\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt; hydrated:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Molar mass of CO\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt; = 44 g/mol.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Moles of CO\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt; = Mass of CO\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt; / Molar mass of CO\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt;\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Moles of CO\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt; = 0.30 g / 44 g/mol \u0026amp;asymp; 6.82 \u0026amp;times; 10\u0026lt;sup\u0026gt;-3\u0026lt;/sup\u0026gt; mol.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;Since 0.30 g of CO\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt; is hydrated in 1 min, the reaction rate (V\u0026lt;sub\u0026gt;max\u0026lt;/sub\u0026gt;) is 6.82 \u0026amp;times; 10\u0026lt;sup\u0026gt;-3\u0026lt;/sup\u0026gt; mol/min.\u0026lt;br /\u0026gt;\n\u0026lt;strong\u0026gt;k\u0026lt;sub\u0026gt;cat\u0026lt;/sub\u0026gt; = V\u0026lt;sub\u0026gt;max\u0026lt;/sub\u0026gt; / [E]\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;k\u0026lt;sub\u0026gt;cat\u0026lt;/sub\u0026gt; = (6.82 \u0026amp;times; 10\u0026lt;sup\u0026gt;-3\u0026lt;/sup\u0026gt; mol/min) / (3.33 \u0026amp;times; 10\u0026lt;sup\u0026gt;-10\u0026lt;/sup\u0026gt; mol)\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;k\u0026lt;sub\u0026gt;cat\u0026lt;/sub\u0026gt; \u0026amp;asymp; 2.05 \u0026amp;times; 10\u0026lt;sup\u0026gt;7\u0026lt;/sup\u0026gt; min\u0026lt;sup\u0026gt;-1\u0026lt;/sup\u0026gt;.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;2.0 x 10\u0026lt;sup\u0026gt;7\u0026lt;/sup\u0026gt; min\u0026lt;sup\u0026gt;-1\u0026lt;/sup\u0026gt; से 2.1 x 10\u0026lt;sup\u0026gt;7\u0026lt;/sup\u0026gt; min\u0026lt;sup\u0026gt;-1\u0026lt;/sup\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;b\u0026gt;\u0026lt;u\u0026gt;व्याख्या:\u0026lt;/u\u0026gt;\u0026lt;/b\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;टर्नओवर नंबर (k\u0026lt;sub\u0026gt;cat\u0026lt;/sub\u0026gt;)\u0026lt;/strong\u0026gt; एक एंजाइम की उत्प्रेरक गतिविधि का माप है। यह संतृप्ति की स्थितियों (V\u0026lt;sub\u0026gt;max\u0026lt;/sub\u0026gt; पर) में प्रति इकाई समय में एक एंजाइम अणु द्वारा उत्पाद में परिवर्तित क्रियाधार अणुओं की संख्या का प्रतिनिधित्व करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;k\u0026lt;sub\u0026gt;cat\u0026lt;/sub\u0026gt; की गणना करने का सूत्र है \u0026lt;strong\u0026gt;k\u0026lt;sub\u0026gt;cat\u0026lt;/sub\u0026gt; = V\u0026lt;sub\u0026gt;max\u0026lt;/sub\u0026gt; / [E]\u0026lt;/strong\u0026gt;,\u0026lt;br /\u0026gt;\n\tजहाँ V\u0026lt;sub\u0026gt;max\u0026lt;/sub\u0026gt; अभिक्रिया की अधिकतम दर है, और [E] मोल में एंजाइम सांद्रता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;कार्बोनिक एनहाइड्रेज़ का आणविक भार (M\u0026lt;sub\u0026gt;r\u0026lt;/sub\u0026gt;) 30,000 दिया गया है, जिसका अर्थ है कि एंजाइम का 1 मोल 30,000 ग्राम वज़न का होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;दिया गया डेटा:\n\t\u0026lt;ul\u0026gt;\n\t\t\u0026lt;li\u0026gt;एंजाइम का द्रव्यमान = 10 माइक्रोग्राम = 10 x 10\u0026lt;sup\u0026gt;-6\u0026lt;/sup\u0026gt; ग्राम\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;जलयोजित CO\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt; का द्रव्यमान = 0.30 ग्राम\u0026lt;/li\u0026gt;\n\t\t\u0026lt;li\u0026gt;अभिक्रिया का समय = 1 मिनट\u0026lt;/li\u0026gt;\n\t\u0026lt;/ul\u0026gt;\n\t\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;गणना:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;एंजाइम के मोलों की संख्या:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;[E] = एंजाइम का द्रव्यमान / M\u0026lt;sub\u0026gt;r\u0026lt;/sub\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;[E] = (10 x 10\u0026lt;sup\u0026gt;-6\u0026lt;/sup\u0026gt; ग्राम) / (30,000 ग्राम/मोल) = 3.33 x 10\u0026lt;sup\u0026gt;-10\u0026lt;/sup\u0026gt; मोल\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;जलयोजित CO\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt; के मोलों की संख्या:\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;CO\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt; का मोलर द्रव्यमान = 44 ग्राम/मोल।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;CO\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt; के मोल = CO\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt; का द्रव्यमान / CO\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt; का मोलर द्रव्यमान\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;CO\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt; के मोल = 0.30 ग्राम / 44 ग्राम/मोल \u0026amp;asymp; 6.82 x 10\u0026lt;sup\u0026gt;-3\u0026lt;/sup\u0026gt; मोल\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;चूँकि 0.30 ग्राम CO\u0026lt;sub\u0026gt;2\u0026lt;/sub\u0026gt; 1 मिनट में जलयोजित होता है, इसलिए अभिक्रिया दर (V\u0026lt;sub\u0026gt;max\u0026lt;/sub\u0026gt;) 6.82 x 10\u0026lt;sup\u0026gt;-3\u0026lt;/sup\u0026gt; मोल/मिनट है\u0026lt;br /\u0026gt;\n\u0026lt;strong\u0026gt;k\u0026lt;sub\u0026gt;cat\u0026lt;/sub\u0026gt; = V\u0026lt;sub\u0026gt;max\u0026lt;/sub\u0026gt; / [E]\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;k\u0026lt;sub\u0026gt;cat\u0026lt;/sub\u0026gt; = (6.82 x 10\u0026lt;sup\u0026gt;-3\u0026lt;/sup\u0026gt; मोल/मिनट) / (3.33 x 10\u0026lt;sup\u0026gt;-10\u0026lt;/sup\u0026gt; मोल)\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;k\u0026lt;sub\u0026gt;cat\u0026lt;/sub\u0026gt; \u0026amp;asymp; 2.05 x 10\u0026lt;sup\u0026gt;7\u0026lt;/sup\u0026gt; min\u0026lt;sup\u0026gt;-1\u0026lt;/sup\u0026gt;\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Biochemistry"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a45131905ad063f1a82ade","title":"Biochemistry"},"t":{"id":"63a4517685167a4f7de4ee9d","title":"Enzymes and Enzyme kinetics"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":2.618320610687021,"attempts":{"correct":9,"incorrect":8,"partial":0,"skipped":1162,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68954a93c6cdfd92ecf7eaa6":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;B and C\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;TAL (Transcription Activator-Like) effectors\u0026amp;nbsp;\u0026lt;/strong\u0026gt;are proteins secreted by certain plant-pathogenic bacteria, particularly members of the genus \u0026lt;em\u0026gt;Xanthomonas\u0026lt;/em\u0026gt;, that manipulate host plant cells to promote infection or trigger defense responses.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;TAL effectors are recognized as key virulence factors, facilitating bacterial pathogenesis. They also function as avirulence factors when recognized by the plant\u0026amp;#39;s immune system.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;They are translocated into plant cells via the \u0026lt;strong\u0026gt;Type III secretion system (T3SS)\u0026lt;/strong\u0026gt;, not the Type IV secretion system. TAL effectors interact with plant cellular machinery to influence gene expression.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement A: \u0026amp;quot;They are bacterial proteins that are translocated into the host plant cells using the type IV secretion system.\u0026amp;quot;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is incorrect. TAL effectors are translocated into plant cells using the Type III secretion system, not the Type IV secretion system.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The Type III system is specifically adapted for injecting bacterial effector proteins directly into the host cytoplasm to manipulate host cellular processes.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement B: \u0026amp;quot;They harbor a central DNA-binding region comprising a tandem array of nearly identical repeats.\u0026amp;quot;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is correct. TAL effectors contain a unique and conserved DNA-binding domain consisting of tandem repeats, typically 34 amino acids long.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;These repeats determine the specificity of DNA binding, allowing TAL effectors to target specific genes in the host plant genome. Each repeat recognizes a single base pair in the DNA sequence.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement C: \u0026amp;quot;They can act as both virulence factors as well as avirulence factors.\u0026amp;quot;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is correct. TAL effectors act as virulence factors by activating host genes that promote susceptibility to bacterial infection, aiding pathogen survival and spread. However, in resistant plant varieties, TAL effectors can act as avirulence factors by activating plant defense genes, leading to a hypersensitive response that limits bacterial infection.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Statement D: \u0026amp;quot;They are only restricted to members of the Xanthomonas species that infect rice.\u0026amp;quot;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is incorrect. While TAL effectors are primarily associated with \u0026lt;em\u0026gt;Xanthomonas\u0026lt;/em\u0026gt; species, they are not restricted to species that infect rice.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;TAL effectors are found in various \u0026lt;em\u0026gt;Xanthomonas\u0026lt;/em\u0026gt; species that infect different plant hosts, including citrus, cotton, and tomatoes.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Key Points:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;TAL effectors are bacterial proteins used by pathogens to manipulate host gene expression for their benefit.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;They have a DNA-binding domain composed of tandem repeats, which determines specificity for target genes.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;They play dual roles as virulence factors promoting infection and avirulence factors triggering plant immune responses in resistant hosts.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;They are translocated into host cells via the Type III secretion system, not Type IV.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;TAL effectors are not limited to \u0026lt;em\u0026gt;Xanthomonas\u0026lt;/em\u0026gt; species infecting rice; they are found across various plant-pathogenic \u0026lt;em\u0026gt;Xanthomonas\u0026lt;/em\u0026gt; species.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;B और C\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;TAL (ट्रांसक्रिप्शन एक्टिवेटर-लाइक) प्रभावक\u0026lt;/strong\u0026gt; कुछ पौधे-रोगजनक जीवाणुओं, विशेष रूप से \u0026lt;em\u0026gt;ज़ैंथोमोनास\u0026lt;/em\u0026gt; जीनस के सदस्यों द्वारा स्रावित प्रोटीन हैं, जो संक्रमण को बढ़ावा देने या रक्षा प्रतिक्रियाओं को ट्रिगर करने के लिए पोषी पौधे की कोशिकाओं में परिवर्तन\u0026amp;nbsp;करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;TAL प्रभावकों को प्रमुख विषाणु कारकों के रूप में पहचाना जाता है, जो जीवाणु रोगजनन को सुगम बनाते हैं। वे पौधे की प्रतिरक्षा तंत्र द्वारा पहचाने जाने पर अविसाणु कारकों के रूप में भी कार्य करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;वे \u0026lt;strong\u0026gt;टाइप III स्राव प्रणाली (T3SS)\u0026lt;/strong\u0026gt; के माध्यम से पौधे की कोशिकाओं में स्थानांतरित होते हैं, न कि टाइप IV स्राव प्रणाली के माध्यम से। TAL प्रभावक जीन अभिव्यक्ति को प्रभावित करने के लिए पौधे के कोशिकीय तंत्र के साथ अंतःक्रिया करते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन A: \u0026amp;quot;वे जीवाणु प्रोटीन हैं जो टाइप IV स्राव प्रणाली का उपयोग करके पोषी पौधे की कोशिकाओं में स्थानांतरित होते हैं।\u0026amp;quot;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन गलत है। TAL प्रभावक टाइप III स्राव प्रणाली का उपयोग करके पौधे की कोशिकाओं में स्थानांतरित होते हैं, न कि टाइप IV स्राव प्रणाली का।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;टाइप III प्रणाली विशेष रूप से पोषी कोशिकीय प्रक्रियाओं में परिवर्तन करने के लिए पोषी कोशिका द्रव्य में सीधे जीवाणु प्रभावक प्रोटीन को इंजेक्ट करने के लिए अनुकूलित है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन B: \u0026amp;quot;वे लगभग समान पुनरावृत्तियों की एक टंडेम सरणी वाले एक केंद्रीय DNA-बंधन क्षेत्र को रखते हैं।\u0026amp;quot;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन सही है। TAL प्रभावकों में एक अद्वितीय और संरक्षित DNA-बंधन डोमेन होता है जिसमें टंडेम पुनरावृत्तियाँ होती हैं, जो आमतौर पर 34 एमिनो एसिड लंबी होती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;ये पुनरावृत्तियाँ DNA बंधन की विशिष्टता को निर्धारित करती हैं, जिससे TAL प्रभावक पोषी पौधे के जीनोम में विशिष्ट जीन को लक्षित कर सकते हैं। प्रत्येक पुनरावृत्ति DNA अनुक्रम में एकल क्षार युग्म\u0026amp;nbsp;को पहचानती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन C: \u0026amp;quot;वे दोनों ही विषाणु कारक और अविसाणु कारक के रूप में कार्य कर सकते हैं।\u0026amp;quot;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन सही है। TAL प्रभावक पोषी जीन को सक्रिय करके विषाणु कारक के रूप में कार्य करते हैं जो जीवाणु संक्रमण के प्रति संवेदनशीलता को बढ़ावा देते हैं, रोगज़नक के जीवित रहने और प्रसार में सहायता करते हैं। हालांकि, प्रतिरोधी पौधे की किस्मों में, TAL प्रभावक पौधे के रक्षा जीन को सक्रिय करके अविसाणु कारक के रूप में कार्य कर सकते हैं, जिससे एक अतिसंवेदनशील प्रतिक्रिया होती है जो जीवाणु संक्रमण को सीमित करती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कथन D: \u0026amp;quot;वे केवल ज़ैंथोमोनास प्रजातियों के सदस्यों तक ही सीमित हैं जो चावल को संक्रमित करते हैं।\u0026amp;quot;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन गलत है। जबकि TAL प्रभावक मुख्य रूप से \u0026lt;em\u0026gt;ज़ैंथोमोनास\u0026lt;/em\u0026gt; प्रजातियों से जुड़े होते हैं, वे केवल उन प्रजातियों तक सीमित नहीं हैं जो चावल को संक्रमित करती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;TAL प्रभावक विभिन्न \u0026lt;em\u0026gt;ज़ैंथोमोनास\u0026lt;/em\u0026gt; प्रजातियों में पाए जाते हैं जो विभिन्न पौधों के पोषीों को संक्रमित करते हैं, जिनमें खट्टे फल, कपास और टमाटर शामिल हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;मुख्य बिंदु:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;TAL प्रभावक जीवाणु प्रोटीन हैं जिनका उपयोग रोगजनकों द्वारा अपने लाभ के लिए पोषी जीन अभिव्यक्ति में परिवर्तन करने के लिए किया जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;उनमें टंडेम पुनरावृत्तियों से बना एक DNA-बंधन डोमेन होता है, जो लक्ष्य जीन के लिए विशिष्टता निर्धारित करता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;वे संक्रमण को बढ़ावा देने वाले विषाणु कारकों और प्रतिरोधी पोषीों में पौधे की प्रतिरक्षा प्रतिक्रियाओं को ट्रिगर करने वाले अविसाणु कारकों के रूप में दोहरी भूमिका निभाते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;वे टाइप III स्राव प्रणाली के माध्यम से पोषी कोशिकाओं में स्थानांतरित होते हैं, न कि टाइप IV के माध्यम से।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;TAL प्रभावक चावल को संक्रमित करने वाली \u0026lt;em\u0026gt;ज़ैंथोमोनास\u0026lt;/em\u0026gt; प्रजातियों तक सीमित नहीं हैं; वे विभिन्न पौधे-रोगजनक \u0026lt;em\u0026gt;ज़ैंथोमोनास\u0026lt;/em\u0026gt; प्रजातियों में पाए जाते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Fundamental Processes"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a451aec9ba648bc86fbf43","title":"Fundamental Processes"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":4.3562340966921145,"attempts":{"correct":17,"incorrect":22,"partial":0,"skipped":1140,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68954afca2471c593045b3a5":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A - ii, B - iv, C - iii, D - i, E - v\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;Chromosomal ploidy refers to the number of sets of chromosomes in a cell. Different cultivated crops exhibit specific ploidy levels due to their evolutionary history or artificial breeding processes.​\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Banana (A - ii):\u0026lt;/strong\u0026gt; Bananas are triploid (3n) in most cultivated varieties. This triploidy makes them seedless and easier to consume, which is a desirable trait for commercial purposes.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Bread Wheat (B - iv):\u0026lt;/strong\u0026gt; Bread wheat (\u0026lt;em\u0026gt;Triticum aestivum\u0026lt;/em\u0026gt;) is hexaploid (6n). This hexaploidy arises from the hybridization of three diploid species, giving it genetic diversity and adaptability to different environments.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Brown Mustard (C - iii):\u0026lt;/strong\u0026gt; Brown mustard (\u0026lt;em\u0026gt;Brassica juncea\u0026lt;/em\u0026gt;) is tetraploid (4n). Its tetraploidy is a result of hybridization between two diploid species, contributing to its robustness and oil-producing properties.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Cauliflower (D - i):\u0026lt;/strong\u0026gt; Cauliflower is diploid (2n). It has a simpler genetic structure compared to polyploid crops, making it a typical example of a diploid vegetable crop.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;Sugarcane (E - v):\u0026lt;/strong\u0026gt; Sugarcane, particularly the cultivated varieties, is often octaploid (8n). This high level of ploidy contributes to its high sugar content and adaptability to various climates..\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A - ii, B - iv, C - iii, D - i, E - v\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026amp;nbsp;है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;गुणसूत्रीय गुणसूत्रता एक कोशिका में गुणसूत्रों के समूहों की संख्या को संदर्भित करता है। विभिन्न खेती की जाने वाली फसलें अपने विकासवादी इतिहास या कृत्रिम प्रजनन प्रक्रियाओं के कारण विशिष्ट गुणसूत्रता स्तर प्रदर्शित करती हैं।\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;केला (A - ii):\u0026lt;/strong\u0026gt; अधिकांश खेती की जाने वाली किस्मों में केले त्रिगुणित (3n) होते हैं। यह त्रिगुणितता उन्हें बीज रहित और उपभोग में आसान बनाती है, जो व्यावसायिक उद्देश्यों के लिए एक वांछनीय लक्षण है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;गेहूँ (B - iv):\u0026lt;/strong\u0026gt; गेहूँ (\u0026lt;em\u0026gt;ट्रिटिकम एस्टिवम\u0026lt;/em\u0026gt;) षट्गुणित (6n) है। यह षट्गुणितता तीन द्विगुणित प्रजातियों के संकरण से उत्पन्न होती है, जो इसे विभिन्न वातावरणों के लिए आनुवंशिक विविधता और अनुकूलनशीलता प्रदान करती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;भूरा सरसों (C - iii):\u0026lt;/strong\u0026gt; भूरा सरसों (\u0026lt;em\u0026gt;ब्रैसिका जुन्सिया\u0026lt;/em\u0026gt;) चतुर्गुणित (4n) है। इसकी चतुर्गुणितता दो द्विगुणित प्रजातियों के बीच संकरण का परिणाम है, जो इसके मजबूती और तेल उत्पादक गुणों में योगदान करती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;फूलगोभी (D - i):\u0026lt;/strong\u0026gt; फूलगोभी द्विगुणित (2n) है। बहुगुणित फसलों की तुलना में इसकी एक सरल आनुवंशिक संरचना है, जो इसे द्विगुणित सब्जी फसल का एक विशिष्ट उदाहरण बनाती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026lt;strong\u0026gt;गन्ना (E - v):\u0026lt;/strong\u0026gt; गन्ना, विशेष रूप से खेती की जाने वाली किस्में, अक्सर अष्टगुणित (8n) होती हैं। गुणसूत्रता का यह उच्च स्तर इसकी उच्च शर्करा सामग्री और विभिन्न जलवायु में अनुकूलनशीलता में योगदान करता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Applied Biology"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a455cbce3d67ae7cc72e05","title":"Applied Biology"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":13.814249363867685,"attempts":{"correct":61,"incorrect":120,"partial":0,"skipped":998,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68954b0d381c5064a096ab92":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;The nucleus does not burst, but the heterochromatin leaches out first\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Human lymphocytes, like other cells, contain a nucleus where chromatin is organized into euchromatin and heterochromatin. These structures reflect different levels of DNA packaging and gene activity.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Chromatin is sensitive to environmental factors, including changes in ionic concentrations such as sodium chloride (NaCl).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;When exposed to increasing concentrations of NaCl, the ionic strength of the solution affects the stability of chromatin structure and its interactions within the nucleus.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;The nucleus does not burst, but the heterochromatin leaches out first.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Heterochromatin is tightly packed DNA and protein complexes that are less transcriptionally active compared to euchromatin.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;When NaCl concentration increases, ionic changes destabilize the interactions that maintain chromatin structure.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Heterochromatin, being less stable, becomes solubilized and leaches out of the nucleus first.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The nucleus itself remains intact and does not burst, preserving its structural integrity at higher salt concentrations.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Other Options:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;The nucleus bursts at low NaCl concentrations, liberating the chromatin into the cytosol.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is incorrect. At low NaCl concentrations, the nucleus maintains its integrity and does not burst. Bursting of the nucleus typically occurs under extreme physical or chemical stress, not under moderate ionic changes.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;At higher salt concentration, the heterochromatin gets converted into euchromatin and comes out of the nucleus.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is incorrect. Heterochromatin does not convert into euchromatin under high salt conditions.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;The nucleus does not burst, but the euchromatin leaches out first.\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is incorrect. Euchromatin is more loosely packed but is more stable compared to heterochromatin under ionic stress.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर है \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;केन्द्रक फटता नहीं है, बल्कि हेटरोक्रोमैटिन पहले बाहर निकल जाता है\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;स्पष्टीकरण:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;मानव लिम्फोसाइटों में, अन्य कोशिकाओं की तरह, एक केंद्रक होता है जहाँ क्रोमेटिन यूक्रोमेटिन और हेटरोक्रोमेटिन में व्यवस्थित होता है। ये संरचनाएँ डीएनए पैकेजिंग और जीन गतिविधि के विभिन्न स्तरों को दर्शाती हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;क्रोमेटिन पर्यावरणीय कारकों के प्रति संवेदनशील है, जिसमें सोडियम क्लोराइड (NaCl) जैसे आयनिक सांद्रता में परिवर्तन भी शामिल है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;NaCl की बढ़ती सांद्रता के संपर्क में आने पर, विलयन की आयनिक शक्ति क्रोमेटिन संरचना की स्थिरता और केन्द्रक के भीतर इसकी अंतःक्रियाओं को प्रभावित करती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;केन्द्रक फटता नहीं है, लेकिन हेटरोक्रोमैटिन पहले बाहर निकल जाता है।\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;हेटरोक्रोमैटिन सघन रूप से पैक किया गया डीएनए और प्रोटीन कॉम्प्लेक्स है, जो यूक्रोमैटिन की तुलना में कम अनुलेखन रूप से सक्रिय होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जब NaCl की सांद्रता बढ़ जाती है, तो आयनिक परिवर्तन क्रोमेटिन संरचना को बनाए रखने वाली अंतःक्रियाओं को अस्थिर कर देते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;हेटरोक्रोमैटिन कम स्थिर होने के कारण घुलनशील हो जाता है तथा सबसे पहले केन्द्रक से बाहर निकल जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;केन्द्रक स्वयं अक्षुण्ण रहता है और फटता नहीं है, जिससे उच्च नमक सांद्रता पर भी इसकी संरचनात्मक अखंडता बनी रहती है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;कम NaCl सांद्रता पर केन्द्रक फट जाता है, जिससे क्रोमेटिन साइटोसोल में मुक्त हो जाता है।\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह गलत है। कम NaCl सांद्रता पर, केन्द्रक अपनी अखंडता बनाए रखता है और फटता नहीं है। केन्द्रक का फटना आमतौर पर अत्यधिक भौतिक या रासायनिक तनाव के तहत होता है, मध्यम आयनिक परिवर्तनों के तहत नहीं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;उच्च नमक सांद्रता पर, हेटरोक्रोमैटिन यूक्रोमैटिन में परिवर्तित हो जाता है और केन्द्रक से बाहर आ जाता है।\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह गलत है। उच्च लवणीय परिस्थितियों में हेटेरोक्रोमैटिन, यूक्रोमैटिन में परिवर्तित नहीं होता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;केन्द्रक फटता नहीं है, लेकिन यूक्रोमेटिन पहले बाहर निकल जाता है।\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह गलत है। यूक्रोमैटिन ज़्यादा शिथिल रूप से पैक होता है, लेकिन आयनिक तनाव के तहत हेटरोक्रोमैटिन की तुलना में ज़्यादा स्थिर होता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Cellular Organization"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4518aa958c4957eed4157","title":"Cellular Organization"},"t":{"id":"63a4519c5fcd1b1e5d1f5f99","title":"Genes and chromosomes"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":9.67175572519084,"attempts":{"correct":28,"incorrect":76,"partial":0,"skipped":1075,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68954b31ab662f534f48e664":{"correctOption":"4","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;B and D\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The biosynthesis of heme and chlorophyll involves distinct but interconnected metabolic pathways. Disrupting enzymes such as \u0026amp;quot;Ferrochelatase\u0026amp;quot; (involved in the heme biosynthesis pathway) and \u0026amp;quot;Chlorophyllide a oxygenase\u0026amp;quot; (involved in the chlorophyll biosynthesis pathway) can significantly influence plant metabolism.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026amp;quot;Ferrochelatase\u0026amp;quot; catalyzes the insertion of iron into protoporphyrin IX to form heme, while \u0026amp;quot;Chlorophyllide a oxygenase\u0026amp;quot; is responsible for converting chlorophyllide a into chlorophyll b, which plays an essential role in light harvesting during photosynthesis.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;The synthesis of \u0026amp;quot;Chlorophyll b\u0026amp;quot; will be completely inhibited:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Disruption of \u0026amp;quot;Chlorophyllide a oxygenase\u0026amp;quot; prevents the conversion of chlorophyllide a into chlorophyll b.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Since chlorophyll b is dependent on this enzyme, its production will cease entirely.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;The metabolic flux will shift towards the biosynthesis of \u0026amp;quot;Chlorophyll a\u0026amp;quot;:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;When \u0026amp;quot;Chlorophyllide a oxygenase\u0026amp;quot; is inhibited, the pathway for chlorophyll b synthesis is blocked.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;This leads to a metabolic shift, where more resources are diverted to the synthesis of chlorophyll a, as chlorophyllide a accumulates and gets converted into chlorophyll a instead of chlorophyll b.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage68ad587bb2bfb456adeff107.png\u0026quot; style=\u0026quot;height: 351px; width: 450px;\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;em\u0026gt;Fig: Chlorophyll a oxygenase (CAO) is involved in chlorophyll b formation from chlorophyll a\u0026lt;/em\u0026gt;\u0026amp;nbsp;\u0026lt;a href=\u0026quot;https://www.pnas.org/doi/10.1073/pnas.95.21.12719\u0026quot;\u0026gt;(Source)\u0026lt;/a\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Other Options:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;The content of \u0026amp;quot;Heme\u0026amp;quot; molecule will be higher compared to wild-type plants:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This is incorrect because the disruption of \u0026amp;quot;Ferrochelatase\u0026amp;quot; inhibits the final step of heme synthesis, where iron is inserted into protoporphyrin IX. As a result, heme content will decrease rather than increase compared to wild-type plants.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage68ad587cb2bfb456adeff10d.png\u0026quot; style=\u0026quot;height: 297px; width: 450px;\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;em\u0026gt;Fig:\u0026amp;nbsp;Heme biosynthesis pathway. Enzymes are indicated in blue. Erythropoietic porphyrias are indicated in red boxes in front of the corresponding enzyme dysfunction. CEP: congenital erythropoietic porphyria; EPP: erythropoietic protoporphyria; XLPP: X-linked protoporphyria.\u0026amp;nbsp;\u0026lt;/em\u0026gt;\u0026lt;a href=\u0026quot;https://www.mdpi.com/2218-1989/11/12/798\u0026quot;\u0026gt;(Source)\u0026lt;/a\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;B और D\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;हीम और क्लोरोफिल के जैव संश्लेषण में अलग लेकिन परस्पर जुड़े उपापचय मार्ग शामिल हैं। \u0026amp;quot;फेरोकेलेटेज़\u0026amp;quot; (हीम जैव संश्लेषण पथ में शामिल) और \u0026amp;quot;क्लोरोफिलिड a ऑक्सीजनेज़\u0026amp;quot; (क्लोरोफिल जैव संश्लेषण पथ में शामिल) जैसे एंजाइमों को बाधित करने से पौधे के उपापचय को महत्वपूर्ण रूप से प्रभावित किया जा सकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026amp;quot;फेरोकेलेटेज़\u0026amp;quot; प्रोटोपोर्फिरिन IX में आयरन के समावेश को उत्प्रेरित करके हीम बनाता है, जबकि \u0026amp;quot;क्लोरोफिलिड a ऑक्सीजनेज़\u0026amp;quot; क्लोरोफिलिड a को क्लोरोफिल b में बदलने के लिए उत्तरदायी है, जो प्रकाश संश्लेषण के दौरान प्रकाश संग्रह में एक आवश्यक भूमिका निभाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026amp;quot;क्लोरोफिल b\u0026amp;quot; का संश्लेषण पूरी तरह से बाधित होगा:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;\u0026amp;quot;क्लोरोफिलिड a ऑक्सीजनेज़\u0026amp;quot; का विघटन क्लोरोफिलिड a को क्लोरोफिल b में बदलने से रोकता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;चूँकि क्लोरोफिल b इस एंजाइम पर निर्भर है, इसलिए इसका उत्पादन पूरी तरह से बंद हो जाएगा।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;उपापचय प्रवाह \u0026amp;quot;क्लोरोफिल a\u0026amp;quot; के जैव संश्लेषण की ओर स्थानांतरित होगा:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;जब \u0026amp;quot;क्लोरोफिलिड a ऑक्सीजनेज़\u0026amp;quot; बाधित होता है, तो क्लोरोफिल b संश्लेषण का मार्ग अवरुद्ध हो जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इससे एक उपापचय बदलाव होता है, जहाँ अधिक संसाधन क्लोरोफिल a के संश्लेषण के लिए आवंटित किए जाते हैं, क्योंकि क्लोरोफिलिड a जमा होता है और क्लोरोफिल b के बजाय क्लोरोफिल a में परिवर्तित हो जाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage68ad587bb2bfb456adeff107.png\u0026quot; style=\u0026quot;height: 351px; width: 450px;\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;em\u0026gt;चित्र: क्लोरोफिल a ऑक्सीजनेज़ (CAO) क्लोरोफिल a से क्लोरोफिल b के निर्माण में शामिल है\u0026lt;/em\u0026gt; \u0026lt;a href=\u0026quot;https://www.pnas.org/doi/10.1073/pnas.95.21.12719\u0026quot;\u0026gt;(स्रोत)\u0026lt;/a\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अन्य विकल्प:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;जंगली प्रकार के पौधों की तुलना में \u0026amp;quot;हीम\u0026amp;quot; अणु की मात्रा अधिक होगी:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह गलत है क्योंकि \u0026amp;quot;फेरोकेलेटेज़\u0026amp;quot; का विघटन हीम संश्लेषण के अंतिम चरण को रोकता है, जहाँ आयरन प्रोटोपोर्फिरिन IX में डाला जाता है। परिणामस्वरूप, जंगली प्रकार के पौधों की तुलना में हीम की मात्रा बढ़ने के बजाय घट जाएगी।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;img alt=\u0026quot;\u0026quot; src=\u0026quot;//cdn.testbook.com/images/production/quesImages/qImage68ad587cb2bfb456adeff10d.png\u0026quot; style=\u0026quot;height: 297px; width: 450px;\u0026quot; /\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;em\u0026gt;चित्र: हीम जैव संश्लेषण पथ। एंजाइम नीले रंग में दर्शाए गए हैं। एरिथ्रोपोएटिक पोर्फिरियास को संबंधित एंजाइम शिथिलता के सामने लाल बक्सों में दर्शाया गया है। CEP: जन्मजात एरिथ्रोपोएटिक पोर्फिरिया; EPP: एरिथ्रोपोएटिक प्रोटोपोर्फिरिया; XLPP: X-लिंक्ड प्रोटोपोर्फिरिया। \u0026lt;/em\u0026gt;\u0026lt;a href=\u0026quot;https://www.mdpi.com/2218-1989/11/12/798\u0026quot;\u0026gt;(स्रोत)\u0026lt;/a\u0026gt;\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["System Physiology Plant"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4526f5db927c0ec7fb376","title":"System Physiology Plant"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":5.144189991518237,"attempts":{"correct":10,"incorrect":25,"partial":0,"skipped":1144,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68954b48af69335e70a05856":{"correctOption":"1","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;Option 1\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Concept:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;MicroRNAs (miRNAs) are small, non-coding RNA molecules that play a key role in regulating gene expression by targeting messenger RNA (mRNA) for degradation or translational repression.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The seed region of a miRNA typically spans from the 2nd to the 8th nucleotide of the miRNA sequence, and it is critical for the recognition of complementary sequences in the mRNA\u0026amp;#39;s 3\u0026amp;#39; untranslated region (3\u0026amp;#39; UTR).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The binding of the miRNA seed region to the complementary target sequence in the mRNA is governed by base-pairing rules.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;The given miRNA sequence is: \u0026lt;strong\u0026gt;5\u0026amp;#39; - UAGCUUAUCAGACUGAUGUUGA - 3\u0026amp;#39;\u0026lt;/strong\u0026gt;.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The seed region spans the 2\u0026lt;sup\u0026gt;nd \u0026lt;/sup\u0026gt;to 8\u0026lt;sup\u0026gt;th\u0026lt;/sup\u0026gt; nucleotides, which are \u0026lt;strong\u0026gt;AGCUUAU\u0026lt;/strong\u0026gt;.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The seed region will bind to its complementary sequence in the mRNA, which is \u0026lt;strong\u0026gt;5\u0026amp;#39; - AUAAGCU - 3\u0026amp;#39;\u0026lt;/strong\u0026gt; (remember, RNA base pairing involves A-U and G-C matching).\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;Option 1 provides an mRNA sequence containing the complementary seed match \u0026lt;strong\u0026gt;AUAGCUU\u0026lt;/strong\u0026gt;, making it the correct answer.\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;विकल्प 1\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;अवधारणा:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;माइक्रोRNA (miRNAs) छोटे, गैर-कोडिंग RNA अणु होते हैं जो दूत RNA (mRNA) को क्षरण या स्थानांतरीय\u0026amp;nbsp;दमन के लिए लक्षित करके जीन अभिव्यक्ति को विनियमित करने में महत्वपूर्ण भूमिका निभाते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;एक miRNA का बीज क्षेत्र आमतौर पर miRNA अनुक्रम के दूसरे से आठवें न्यूक्लियोटाइड तक फैला होता है, और यह mRNA के 3\u0026amp;#39; स्थानांतरित क्षेत्र (3\u0026amp;#39; UTR) में पूरक अनुक्रमों की पहचान के लिए महत्वपूर्ण है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;mRNA में पूरक लक्ष्य अनुक्रम के लिए miRNA बीज क्षेत्र का बंधन क्षार\u0026amp;nbsp;-युग्मन नियमों द्वारा नियंत्रित होता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;दिया गया miRNA क्रम है: \u0026lt;strong\u0026gt;5\u0026amp;#39; - UAGCUUAUCAGACUGAUGUUGA - 3\u0026amp;#39;\u0026lt;/strong\u0026gt;।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;बीज क्षेत्र 2\u0026lt;sup\u0026gt;nd\u0026lt;/sup\u0026gt; से 8\u0026lt;sup\u0026gt;th\u0026lt;/sup\u0026gt; न्यूक्लियोटाइड्स तक फैला है, जो \u0026lt;strong\u0026gt;AGCUUAU\u0026lt;/strong\u0026gt; हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;बीज क्षेत्र mRNA में अपने पूरक अनुक्रम से जुड़ जाएगा, जो \u0026lt;strong\u0026gt;5\u0026amp;#39; - AUAAGCU - 3\u0026amp;#39;\u0026lt;/strong\u0026gt; है (याद रखें, RNA क्षार युग्मन\u0026amp;nbsp;में A-U और G-C मिलान शामिल है)।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;विकल्प 1 एक mRNA अनुक्रम प्रदान करता है जिसमें पूरक बीज मिलान \u0026lt;strong\u0026gt;AUAGCUU\u0026lt;/strong\u0026gt; है, जो इसे सही उत्तर बनाता है।\u0026lt;/p\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Fundamental Processes"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a451aec9ba648bc86fbf43","title":"Fundamental Processes"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":18.626802374893984,"attempts":{"correct":26,"incorrect":63,"partial":0,"skipped":1090,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68954b62c6cdfd92ecf7eeed":{"correctOption":"2","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":1,"posMarks":4,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A, B, D and E\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;Explanation:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;A. Indole-3-butyric acid is converted to IAA (Indole-3-acetic acid) by \u0026amp;beta;-oxidation in peroxisomes:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is correct.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Indole-3-butyric acid (IBA) is a precursor of the auxin Indole-3-acetic acid (IAA).\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The conversion of IBA to IAA involves \u0026amp;beta;-oxidation, which occurs in the peroxisomes of plant cells.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;B. The gibberellin precursor, geranylgeranyl diphosphate, is synthesized in the plastids:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is correct.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Geranylgeranyl diphosphate (GGPP) is a key intermediate in the biosynthesis of gibberellins, a class of phytohormones that promote stem elongation and seed germination.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;GGPP is synthesized in the plastids, where the early steps of gibberellin biosynthesis occur.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;C. Cytokinins are synthesized from adenine nucleotides and dimethylallyl diphosphate in the mitochondria:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is incorrect.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Cytokinin biosynthesis primarily occurs in the plastids and cytosol, not in the mitochondria.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Cytokinins are derived from adenine nucleotides and dimethylallyl diphosphate, with the key rate-limiting enzyme being isopentenyltransferase.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;D. The oxidative reactions that convert xanthoxin to abscisic acid occur in the cytosol:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is correct.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Abscisic acid (ABA) is synthesized from xanthoxin, an intermediate that is produced in the plastids and then transported to the cytosol.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The final steps of ABA biosynthesis, including oxidative reactions, occur in the cytosol.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;E. Cytochrome P450 monooxygenase enzyme family associated with the endoplasmic reticulum catalyzes most of the reactions in brassinosteroid biosynthesis:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;This statement is correct.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Brassinosteroids are a class of phytohormones involved in cell elongation and division.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;The Cytochrome P450 monooxygenase enzyme family, located in the endoplasmic reticulum, plays a major role in the hydroxylation and oxidation reactions during brassinosteroid biosynthesis.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;A, B, D और E\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt; है।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u\u0026gt;\u0026lt;strong\u0026gt;व्याख्या:\u0026lt;/strong\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;A. इंडोल-3-ब्यूटिरिक एसिड को पेरोक्सिसोम में \u0026amp;beta;-ऑक्सीकरण द्वारा IAA (इंडोल-3-एसिटिक एसिड) में परिवर्तित किया जाता है:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन सही है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;इंडोल-3-ब्यूटिरिक एसिड (IBA) ऑक्सिन इंडोल-3-एसिटिक एसिड (IAA) का एक पूर्वगामी है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;IBA से IAA के रूपांतरण में \u0026amp;beta;-ऑक्सीकरण शामिल है, जो पादप कोशिकाओं के पेरोक्सिसोम में होता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;B. जिबरेलिन पूर्वगामी, जेरानिल जेरानिल डाइफॉस्फेट, प्लास्टिड में संश्लेषित होता है:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन सही है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;जेरानिल जेरानिल डाइफॉस्फेट (GGPP) जिबरेलिन के जैव संश्लेषण में एक प्रमुख मध्यवर्ती है, जो फाइटोहॉर्मोन का एक वर्ग है जो तने की लम्बाई और बीज अंकुरण को बढ़ावा देता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;GGPP प्लास्टिड में संश्लेषित होता है, जहाँ जिबरेलिन जैव संश्लेषण के प्रारंभिक चरण होते हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;C. साइटोकाइनिन एडेनिन न्यूक्लियोटाइड्स और डाइमेथिलएलील डाइफॉस्फेट से माइटोकॉन्ड्रिया में संश्लेषित होते हैं:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन गलत है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;साइटोकाइनिन जैव संश्लेषण मुख्य रूप से प्लास्टिड और कोशिका द्रव्य में होता है, माइटोकॉन्ड्रिया में नहीं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;साइटोकाइनिन एडेनिन न्यूक्लियोटाइड्स और डाइमेथिलएलील डाइफॉस्फेट से प्राप्त होते हैं, जिसमें प्रमुख दर-सीमित एंजाइम आइसोपेंटेनाइलट्रांसफेरेज है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;D. ऑक्सीडेटिव अभिक्रियाएँ जो ज़ैंथोक्सिन को एब्सिसिक एसिड में परिवर्तित करती हैं, कोशिका द्रव्य में होती हैं:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन सही है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;एब्सिसिक एसिड (ABA) ज़ैंथोक्सिन से संश्लेषित होता है, एक मध्यवर्ती जो प्लास्टिड में उत्पन्न होता है और फिर कोशिका द्रव्य में पहुँचाया जाता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;ABA जैव संश्लेषण के अंतिम चरण, जिसमें ऑक्सीडेटिव अभिक्रियाएँ शामिल हैं, कोशिका द्रव्य में होती हैं।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;E. अन्तः प्रदव्ययी जलिका से जुड़ा साइटोक्रोम P450 मोनोऑक्सीजिनेज एंजाइम कुल ब्रासिनोस्टेरॉइड जैव संश्लेषण में अधिकांश अभिक्रियाओं को उत्प्रेरित करता है:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;यह कथन सही है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;ब्रासिनोस्टेरॉइड पौधों के हार्मोन का एक वर्ग है जो कोशिका बढ़ाव और विभाजन में शामिल है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;साइटोक्रोम P450 मोनोऑक्सीजिनेज एंजाइम कुल, जो अन्तः प्रदव्ययी जलिका में स्थित है, ब्रासिनोस्टेरॉइड जैव संश्लेषण के दौरान हाइड्रॉक्सिलेशन और ऑक्सीकरण अभिक्रियाओं में एक प्रमुख भूमिका निभाता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["System Physiology Plant"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a4526f5db927c0ec7fb376","title":"System Physiology Plant"},"t":{"id":"63a45283ef5b5403de57b185","title":"Plant hormones"},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":12.754028837998298,"attempts":{"correct":27,"incorrect":40,"partial":0,"skipped":1112,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":3,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}},"68954fc280817804fdcb2750":{"correctOption":"3","multiCorrectOptions":null,"range":{"start":"","end":""},"negMarks":0.5,"posMarks":2,"skipMarks":0,"partialM":{"type":"","marks":0},"isPartialMarking":false,"sol":{"en":{"value":"\u0026lt;p\u0026gt;The correct answer is \u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;To increase reproductive success in response to uncertainty in pollination\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;Explanation:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;Cleistogamous flowers are closed, self-pollinating flowers, while chasmogamous flowers are open, allowing cross-pollination. Many plant species produce both types of flowers to maximize reproductive success under varying environmental conditions. This dual strategy provides flexibility, ensuring reproduction when pollinators are scarce or environmental conditions are suboptimal for cross-pollination.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Cleistogamous flowers do not open and rely on self-pollination, which guarantees seed production even when pollinators or favorable conditions for cross-pollination are absent. On the other hand, chasmogamous flowers open and depend on external agents (like wind or insects) for cross-pollination.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Producing cleistogamous flowers ensures reproductive success in unpredictable environments where pollinators may be limited or absent. This is a survival strategy to ensure the continuation of the species.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;Cleistogamous flowers are less energy-intensive to produce compared to chasmogamous flowers, as they do not need to develop showy petals or nectar to attract pollinators.\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;By having both types of flowers, plants reduce their dependency on external factors such as pollinators, ensuring seed production under diverse conditions.\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"hn":{"value":"\u0026lt;p\u0026gt;सही उत्तर है-\u0026amp;nbsp;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:(33, 37, 41);\u0026quot;\u0026gt;परागण में अनिश्चितता की प्रतिक्रिया में प्रजनन सफलता बढ़ाने के लिए\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;।\u0026lt;/p\u0026gt;\n\n\u0026lt;p\u0026gt;\u0026lt;u style=\u0026quot;color: rgb(33, 37, 41);\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;font-weight: bolder;\u0026quot;\u0026gt;व्याख्या:\u0026lt;/span\u0026gt;\u0026lt;/u\u0026gt;\u0026lt;/p\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\t\u0026lt;li\u0026gt;क्लेस्टोगैमस फूल बंद, स्व-परागित फूल होते हैं, जबकि कैसमोगैमस फूल खुले होते हैं, जिससे पार-परागण होता है। कई पादप प्रजातियाँ विभिन्न पर्यावरणीय परिस्थितियों में प्रजनन सफलता को अधिकतम करने के लिए दोनों प्रकार के फूल पैदा करती हैं। यह दोहरी रणनीति लचीलापन प्रदान करती है, जिससे परागणकर्ता दुर्लभ होने या पार-परागण के लिए पर्यावरणीय परिस्थितियाँ अनुकूल न होने पर भी प्रजनन सुनिश्चित होता है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;क्लेस्टोगैमस फूल नहीं खुलते हैं और स्व-परागण पर निर्भर करते हैं, जो परागणकर्ताओं या पार-परागण के लिए अनुकूल परिस्थितियों के अनुपस्थित होने पर भी बीज उत्पादन की गारंटी देता है। दूसरी ओर, कैसमोगैमस फूल खुलते हैं और पार-परागण के लिए बाहरी कारकों (जैसे हवा या कीड़े) पर निर्भर करते हैं।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;क्लेस्टोगैमस फूलों का उत्पादन अप्रत्याशित वातावरण में प्रजनन सफलता सुनिश्चित करता है जहाँ परागणकर्ता सीमित या अनुपस्थित हो सकते हैं। यह प्रजातियों की निरंतरता सुनिश्चित करने के लिए एक उत्तरजीविता रणनीति है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;क्लेस्टोगैमस फूलों का उत्पादन कैसमोगैमस फूलों की तुलना में कम ऊर्जा-गहन होता है, क्योंकि उन्हें परागणकों को आकर्षित करने के लिए आकर्षक पंखुड़ियों या अमृत को विकसित करने की आवश्यकता नहीं होती है।\u0026lt;/li\u0026gt;\n\t\u0026lt;li\u0026gt;दोनों प्रकार के फूल होने से पौधे परागण जैसे बाह्य कारकों पर अपनी निर्भरता कम कर देते हैं, जिससे विविध परिस्थितियों में बीज उत्पादन सुनिश्चित होता है।\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\n","type":"tb","videoSol":""},"te":{"value":"","type":"","videoSol":""},"mr":{"value":"","type":"","videoSol":""},"bn":{"value":"","type":"","videoSol":""},"ml":{"value":"","type":"","videoSol":""},"gu":{"value":"","type":"","videoSol":""},"kn":{"value":"","type":"","videoSol":""},"ta":{"value":"","type":"","videoSol":""},"or":{"value":"","type":"","videoSol":""},"as":{"value":"","type":"","videoSol":""},"ks":{"value":"","type":"","videoSol":""},"kok":{"value":"","type":"","videoSol":""},"mni":{"value":"","type":"","videoSol":""},"ne":{"value":"","type":"","videoSol":""},"pa":{"value":"","type":"","videoSol":""},"sd":{"value":"","type":"","videoSol":""},"ur":{"value":"","type":"","videoSol":""},"sat":{"value":"","type":"","videoSol":""},"mai":{"value":"","type":"","videoSol":""},"brx":{"value":"","type":"","videoSol":""},"doi":{"value":"","type":"","videoSol":""},"sa":{"value":"","type":"","videoSol":""},"grt":{"value":"","type":"","videoSol":""},"kha":{"value":"","type":"","videoSol":""},"lus":{"value":"","type":"","videoSol":""},"bo":{"value":"","type":"","videoSol":""},"trp":{"value":"","type":"","videoSol":""}},"tags":["Diversity of Life Forms"],"globalConcept":[{"s":{"id":"63a451295db927c0ec7f9e6e","title":"Life Sciences"},"c":{"id":"63a45511ef5b5403de57d744","title":"Diversity of Life Forms"},"t":{"id":""},"st":{"id":""},"st1":{"id":""},"st2":{"id":""},"st3":{"id":""},"st4":{"id":""}}],"stats":{"totalStudents":1179,"bestTime":0,"averageTime":17.70059372349448,"attempts":{"correct":183,"incorrect":256,"partial":0,"skipped":740,"skipOptionSelected":0},"sectionNo":0,"subSectionNo":0},"votes":0,"SSNo":2,"SSSNo":0,"marksObtained":0,"studentResStatus":"","studentResponse":{"time":0,"visits":null}}},"curTime":"2026-10-17T06:34:44.997Z"}
